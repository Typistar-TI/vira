{
  "name": "vira",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --root frontend",
    "check": "astro check --root frontend",
    "build": "astro build --root frontend",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:local": "wrangler d1 migrations apply vira --local --config frontend/wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply vira --remote --config frontend/wrangler.jsonc",
    "preview": "astro preview --root frontend",
    "astro": "astro --root frontend"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-core": "^5.104.0",
    "astro": "^7.3.5",
    "daisyui": "^5.7.46",
    "jose": "^6.2.12",
    "stripe": "^22.6.2",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.141.0"
  }
}
