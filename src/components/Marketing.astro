---
import Base from '@/layouts/Base.astro';
import { publicPrices, type Plan } from '@/server/billing';
import { rootDomain } from '@/server/config';
interface Props { lang: 'pt' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const domain = await rootDomain();
const prices = await publicPrices();
const currency = en ? 'usd' : 'brl';
const displayPrice = (plan: Plan) => {
  const row = prices.find(item => item.plan === plan && item.currency === currency);
  return row?.amount_minor ? new Intl.NumberFormat(en ? 'en-US' : 'pt-BR', { style: 'currency', currency: currency.toUpperCase() }).format(row.amount_minor / 100) : null;
};
const t = en ? {
  nav: 'Start free', eyebrow: 'Your next page starts here', titleA: 'Put your idea', titleB: 'out there.',
  intro: 'A page that looks like your business. Choose a layout, edit every detail, and publish in minutes.',
  cta: 'Try 7 days free', demo: 'See how it works', section: 'Everything in one place',
  sectionText: 'From the first draft to your own domain, Vira keeps the work simple.',
  features: [['Choose a layout', 'Three responsive starting points with room for your content.'], ['Make it yours', 'Edit images, benefits, numbers, testimonials and a product catalog.'], ['Publish and learn', 'Use your domain and see page views and button clicks.']],
  plans: 'Choose your plan', plansText: 'Start without a card. Pick a plan when you are ready.',
  monthly: 'Monthly', yearly: 'Yearly', lifetime: 'Lifetime',
  monthlyDesc: 'Keep your page live with a flexible monthly subscription.', yearlyDesc: 'One annual payment for a full year.', lifetimeDesc: 'Pay once and keep access to your page.',
  priceLater: 'Price at checkout', included: ['One published page', 'Three layouts', 'Your own www domain', 'Images and basic analytics'],
  select: 'Select plan', footer: 'A clear place for what you do.',
} : {
  nav: 'Começar grátis', eyebrow: 'Sua próxima página começa aqui', titleA: 'Coloque sua ideia', titleB: 'no mundo.',
  intro: 'Uma página com a cara do seu negócio. Escolha um layout, edite cada detalhe e publique em minutos.',
  cta: 'Testar 7 dias grátis', demo: 'Ver como funciona', section: 'Tudo em um só lugar',
  sectionText: 'Do primeiro rascunho ao seu domínio, o Vira deixa o caminho simples.',
  features: [['Escolha um layout', 'Três pontos de partida responsivos com espaço para seu conteúdo.'], ['Deixe com a sua cara', 'Edite imagens, benefícios, números, depoimentos e um catálogo.'], ['Publique e acompanhe', 'Use seu domínio e veja visualizações e cliques nos botões.']],
  plans: 'Escolha seu plano', plansText: 'Comece sem cartão. Escolha um plano quando estiver pronto.',
  monthly: 'Mensal', yearly: 'Anual', lifetime: 'Vitalício',
  monthlyDesc: 'Mantenha sua página no ar com uma assinatura flexível.', yearlyDesc: 'Um pagamento para o ano inteiro.', lifetimeDesc: 'Pague uma vez e mantenha o acesso à sua página.',
  priceLater: 'Valor no checkout', included: ['Uma página publicada', 'Três layouts', 'Domínio www próprio', 'Imagens e estatísticas básicas'],
  select: 'Escolher plano', footer: 'Um lugar claro para mostrar o que você faz.',
};
---
<Base title={en ? 'Vira — Put your idea out there' : 'Vira — Coloque sua ideia no mundo'} description={t.intro} lang={lang}>
  <link slot="head" rel="alternate" hreflang="pt-BR" href={`https://${domain}/`} />
  <link slot="head" rel="alternate" hreflang="en-US" href={`https://${domain}/en/`} />
  <link slot="head" rel="alternate" hreflang="x-default" href={`https://${domain}/`} />
  <div class="vira-shell">
    <header class="vira-nav">
      <a class="vira-logo" href={en ? '/en' : '/'} aria-label="Vira">vira<span>.</span></a>
      <nav class="flex gap-5 items-center">
        <a href="#como-funciona" class="hidden sm:inline">{en ? 'How it works' : 'Como funciona'}</a>
        <a href="#planos" class="hidden sm:inline">{en ? 'Plans' : 'Planos'}</a>
        <a href={en ? '/' : '/en'} aria-label={en ? 'Português' : 'English'}>{en ? 'PT' : 'EN'}</a>
        <a href="/login" class="vira-button">{t.nav}</a>
      </nav>
    </header>
    <main class="marketing-main">
      <section class="marketing-hero">
        <div>
          <span class="eyebrow">{t.eyebrow}</span>
          <h1>{t.titleA} <em>{t.titleB}</em></h1>
          <p>{t.intro}</p>
          <div class="marketing-actions"><a class="vira-button coral" href="/login">{t.cta} <span aria-hidden="true">↗</span></a><a class="vira-button secondary" href="#como-funciona">{t.demo}</a></div>
          <p class="text-sm mt-5">{en ? 'No card required · SMS or WhatsApp access' : 'Sem cartão · Acesso por SMS ou WhatsApp'}</p>
        </div>
        <div class="hero-art" aria-label={en ? 'Page preview' : 'Prévia de uma página'}>
          <div class="mock-browser"><div class="mock-browser-bar"><i></i><i></i><i></i></div><div class="mock-content"><span class="badge-purple">{en ? 'Your space' : 'Seu espaço'}</span><div class="line big"></div><div class="line" style="width:90%"></div><div class="line" style="width:65%"></div><div class="mock-image"></div><div class="flex gap-3 mt-6"><span class="badge-purple">✦ {en ? 'Beautiful' : 'Bonito'}</span><span class="badge-purple">↗ {en ? 'Ready to share' : 'Pronto para compartilhar'}</span></div></div></div>
        </div>
      </section>
      <section id="como-funciona" class="marketing-section">
        <div class="section-heading"><span class="eyebrow">Vira</span><h2>{t.section}</h2><p class="muted">{t.sectionText}</p></div>
        <div class="feature-grid">{t.features.map((feature, i) => <article class="feature-card"><span class="feature-icon" aria-hidden="true">{['◇','✳','↗'][i]}</span><strong>{feature[0]}</strong><p>{feature[1]}</p></article>)}</div>
      </section>
      <section id="planos" class="marketing-section">
        <div class="section-heading"><span class="eyebrow">{en ? 'Simple plans' : 'Planos simples'}</span><h2>{t.plans}</h2><p class="muted">{t.plansText}</p></div>
          <div class="price-grid">{[t.monthly,t.yearly,t.lifetime].map((name, i) => <article class:list={['price-card', i === 1 && 'featured']}><span class="badge-purple">{i === 2 ? (en ? 'One payment' : 'Pagamento único') : (en ? 'Subscription' : 'Assinatura')}</span><h3>{name}</h3><p>{[t.monthlyDesc,t.yearlyDesc,t.lifetimeDesc][i]}</p><div class="price">{displayPrice((['monthly','yearly','lifetime'] as const)[i]) || t.priceLater}</div><ul>{t.included.map(item => <li>{item}</li>)}</ul><a class="vira-button" href="/login">{t.select}</a></article>)}</div>
      </section>
    </main>
    <footer class="vira-footer"><span>© {new Date().getFullYear()} Vira. {t.footer}</span><div class="flex gap-4"><a href={en ? '/en/privacy' : '/privacidade'}>{en ? 'Privacy' : 'Privacidade'}</a><a href={en ? '/' : '/en'}>{en ? 'Português' : 'English'}</a></div></footer>
  </div>
</Base>
