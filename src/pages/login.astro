---
import Base from '@/layouts/Base.astro';
import { getSessionUser } from '@/server/auth';
import { setting } from '@/server/config';

const adminLogin = Astro.url.searchParams.get('next') === 'admin';
if (await getSessionUser(Astro.request)) return Astro.redirect(adminLogin ? '/admin' : '/app');
const en = Astro.url.searchParams.get('lang') === 'en';
const clientId = await setting('GOOGLE_CLIENT_ID');
const [controller, contact] = await Promise.all([setting('PRIVACY_CONTROLLER_NAME'), setting('PRIVACY_CONTACT_EMAIL')]);
const legalReady = Boolean(controller && contact);
const error = Astro.url.searchParams.get('error')?.slice(0, 150);
const loginUri = new URL('/api/auth/google', Astro.url).href;
---
<Base title={en ? 'Sign in · Vira' : 'Entrar · Vira'} lang={en ? 'en' : 'pt'} noindex>
  <div class="vira-shell min-h-screen">
    <header class="vira-nav"><a class="vira-logo" href="/">vira<span>.</span></a><a href={en ? '/login' : '/login?lang=en'}>{en ? 'Português' : 'English'}</a></header>
    <main class="app-panel login-card">
      <span class="badge-purple">{en ? '7 days free' : '7 dias grátis'}</span>
      <h1 class="text-4xl mt-4 mb-3">{en ? 'Your page starts here.' : 'Sua página começa aqui.'}</h1>
      <p class="muted mb-6">{en ? 'Sign in with your Google account. No forms, codes or passwords for Vira.' : 'Entre com sua conta Google. Sem formulário, código ou senha do Vira.'}</p>
      {clientId ? <>
        <div id="g_id_onload" data-client_id={clientId} data-login_uri={loginUri} data-ux_mode="redirect" data-auto_prompt="false"></div>
        <div class="g_id_signin" data-type="standard" data-theme="outline" data-size="large" data-text="continue_with" data-shape="pill" data-logo_alignment="left"></div>
      </> : <p class="status error">{en ? 'Google sign-in is being configured.' : 'O login com Google está sendo configurado.'}</p>}
      {!legalReady && !adminLogin && <p class="status error mt-3">{en ? 'New registrations are temporarily unavailable.' : 'Novos cadastros estão temporariamente indisponíveis.'}</p>}
      {adminLogin && <p class="text-xs muted mt-3">{en ? 'Administrative access is limited to authorized Google accounts.' : 'Acesso administrativo restrito a contas Google autorizadas.'}</p>}
      {error && <p class="status error mt-3" role="alert">{error}</p>}
      <p class="text-xs muted mt-6"><a href={en ? '/en/privacy' : '/privacidade'}>{en ? 'How we use your data' : 'Como usamos seus dados'}</a></p>
    </main>
  </div>
  {clientId && <script src="https://accounts.google.com/gsi/client" async defer></script>}
</Base>
