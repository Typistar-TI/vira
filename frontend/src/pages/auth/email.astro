---
import Base from '@frontend/layouts/Base.astro';

const token = Astro.url.searchParams.get('token') || '';
const valid = /^[a-f0-9]{64}$/.test(token);
const en = Astro.url.searchParams.get('lang') === 'en';
---

<Base
  title={en ? 'Confirm sign-in · Vira' : 'Confirmar acesso · Vira'}
  lang={en ? 'en' : 'pt'}
  noindex
>
  <div class="vira-shell min-h-screen">
    <header class="vira-nav">
      <a class="vira-logo" href="/">
        vira<span>.</span>
      </a>
    </header>
    <main class="app-panel login-card">
      <h1 class="text-4xl mb-3">{en ? 'Confirm your sign-in' : 'Confirme seu acesso'}</h1>
      {valid ? (
        <>
          <p class="muted mb-6">
            {en
              ? 'Continue to your Vira account. This link works once and expires 15 minutes after it was sent.'
              : 'Continue para sua conta no Vira. Este link funciona uma vez e expira 15 minutos após o envio.'}
          </p>
          <input id="login-token" type="hidden" value={token} />
          <button id="confirm-login" class="vira-button" type="button">
            {en ? 'Sign in' : 'Entrar'}
          </button>
          <p id="confirm-status" class="status mt-3" role="status" hidden></p>
        </>
      ) : (
        <>
          <p class="status error">{en ? 'This link is invalid.' : 'Este link é inválido.'}</p>
          <a class="vira-button mt-5" href="/login">
            {en ? 'Request another link' : 'Pedir outro link'}
          </a>
        </>
      )}
    </main>
  </div>
  <script>
    import { apiMutation } from '@frontend/lib/api';
    document
      .querySelector<HTMLButtonElement>('#confirm-login')
      ?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const status = document.querySelector<HTMLElement>('#confirm-status')!;
        button.disabled = true;
        status.hidden = false;
        status.classList.remove('error');
        status.textContent =
          document.documentElement.lang === 'en' ? 'Signing in...' : 'Entrando...';
        try {
          const token = document.querySelector<HTMLInputElement>('#login-token')!.value;
          const data = await apiMutation<{ redirect: string }>('/api/auth/email/verify', {
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token }),
          });
          window.location.assign(data.redirect);
        } catch {
          status.classList.add('error');
          status.textContent =
            document.documentElement.lang === 'en'
              ? 'This link is invalid or expired. Request another link.'
              : 'Este link é inválido ou expirou. Peça outro link.';
          button.disabled = false;
        }
      });
  </script>
</Base>
