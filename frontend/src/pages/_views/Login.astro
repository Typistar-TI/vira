---
import Base from '@frontend/components/Base.astro';
import { getSetting } from '@frontend/api/config/setting';
import { googleLoginUrl } from '@frontend/api/auth/google-url';
import { emailLoginEnabled } from '@frontend/api/config/email-login-enabled';
import { preferredLanguage } from '@frontend/i18n/preferred-language';
const { url } = Astro.props;
const en = preferredLanguage(Astro.request) === 'en';
const [clientId, controller, contact, resendKey, emailFrom, emailEnabled] = await Promise.all([
  getSetting('GOOGLE_CLIENT_ID'),
  getSetting('PRIVACY_CONTROLLER_NAME'),
  getSetting('PRIVACY_CONTACT_EMAIL'),
  getSetting('RESEND_API_KEY'),
  getSetting('AUTH_EMAIL_FROM'),
  emailLoginEnabled(),
]);
const emailReady = Boolean(resendKey && emailFrom && emailEnabled);
const legalReady = Boolean(controller && contact);
const reset = url.searchParams.get('password') === '1';
const error = url.searchParams.get('error')?.slice(0, 150);
const lastLogin =
  /(?:^|;\s*)vira_last_login=(google|code|password)/.exec(
    Astro.request.headers.get('cookie') || '',
  )?.[1] ?? '';
const lastUsed = en ? 'Last used' : 'Último acesso';
---

<Base
  title={en ? 'Sign in · Vira' : 'Entrar · Vira'}
  lang={en ? 'en' : 'pt'}
  noindex
  appearance="light"
>
  <main class="grid min-h-dvh bg-white text-[#17130d] lg:grid-cols-2">
    <section
      aria-label={en ? 'About Vira' : 'Sobre o Vira'}
      class="relative hidden flex-col items-center justify-center gap-2 overflow-hidden bg-[radial-gradient(130%_120%_at_15%_0%,#fff8ec_0%,#fff4df_46%,#f1ddbd_100%)] px-8 py-14 text-center lg:flex lg:min-h-dvh"
    >
      <a
        href={en ? '/en' : '/'}
        aria-label="Vira"
        class="relative inline-flex justify-center no-underline"
      >
        <img
          src="/vira-hero-light.webp"
          alt="Vira"
          width="1586"
          height="992"
          class="w-[80vw] max-w-[460px] animate-float select-none object-contain mix-blend-multiply lg:w-[100%] lg:max-w-[680px]"
        />
      </a>
      <img
        src="/vira-wordmark-amber.png"
        alt=""
        width="122"
        height="50"
        class="relative -mt-2 h-14 w-auto object-contain mix-blend-multiply lg:-mt-4 lg:h-[5.5rem]"
      />
      <span class="absolute bottom-6 left-6 text-sm font-medium tracking-wide text-[#8b5b1e] lg:bottom-8 lg:left-10">
        Vira © {new Date().getFullYear()}
      </span>
    </section>

    <section class="flex flex-col items-center justify-center bg-[#fffdf9] px-5 py-8 sm:px-12 lg:min-h-dvh lg:py-20">
      <div class="mb-5 flex items-center justify-center gap-2.5 lg:hidden">
        <img
          src="/vira-mark-3d.png"
          alt=""
          width="44"
          height="41"
          class="h-11 w-11 object-contain"
        />
        <img
          src="/vira-wordmark-amber.png"
          alt="Vira"
          width="122"
          height="50"
          class="h-9 w-auto object-contain"
        />
      </div>
      <div
        data-login
        data-reset={reset ? 'true' : undefined}
        data-email-ready={emailReady ? 'true' : undefined}
        aria-label={en ? 'Sign in or create account' : 'Entrar ou criar conta'}
        class="w-full max-w-[500px] rounded-[26px] border border-[#ead8bf] bg-white/80 p-7 text-center backdrop-blur-xl sm:p-9 [&_[hidden]]:hidden! [&_form]:text-left [&_label]:mb-2 [&_label]:block [&_label]:text-base [&_label]:font-semibold [&_.input]:w-full [&_.input]:text-base"
        style="box-shadow:0 50px 120px -55px rgba(70,40,5,0.45)"
      >
        <img
          src="/vira-wordmark-amber.png"
          alt="Vira"
          width="122"
          height="50"
          class="mx-auto hidden h-8 w-auto object-contain lg:block"
        />
        <h1 class="mt-6 font-[Outfit] text-3xl leading-tight tracking-tight">
          {en ? 'Welcome to Vira.' : 'Boas-vindas ao Vira.'}
        </h1>
        <p class="mt-2.5 mb-7 text-base text-[#6f5a3a]">
          {en ? 'Sign in, or create your account.' : 'Entre ou crie sua conta.'}
        </p>
        <p
          data-login-description
          hidden
          class="mb-5 text-base text-[#6f5a3a]"
          aria-live="polite"
        ></p>
        <form id="login-start" class="space-y-4">
          <div>
            <label for="login-email">E-mail</label>
            <input
              id="login-email"
              name="email"
              type="email"
              autocomplete="username"
              maxlength="320"
              class="input input-bordered"
              required
            />
          </div>
          <div data-password-login hidden={reset}>
            <label for="login-password">{en ? 'Password' : 'Senha'}</label>
            <input
              id="login-password"
              name="password"
              type="password"
              autocomplete="current-password"
              maxlength="128"
              class="input input-bordered"
              disabled={reset}
              required={!reset}
            />
          </div>
          <div class="relative">
            {lastLogin === 'password' && (
              <span class="absolute -top-2 right-1 z-10 rounded-full border border-white bg-[#b88333] px-2 py-0.5 text-[10px] font-semibold text-white shadow-md">
                {lastUsed}
              </span>
            )}
            <button
              data-start-button
              type="submit"
              class="btn h-11 min-h-11 w-full rounded-full border-[#a66f27] bg-[#b88333] text-white hover:bg-[#9b6823]"
            >
              {reset ? (en ? 'Send code' : 'Enviar código') : en ? 'Sign in' : 'Entrar'}
            </button>
          </div>
        </form>
        <div
          data-terms
          hidden
          class="mt-4 rounded-2xl border border-[#ead8bf] bg-[#fff9ef] p-4 text-left"
        >
          <p class="text-sm leading-relaxed text-[#625a51]">
            {en
              ? 'This account does not exist yet. Accept the terms to create it:'
              : 'Esta conta ainda não existe. Para criá-la, aceite os termos:'}
          </p>
          <label class="mt-3 flex! items-start gap-2">
            <input
              id="accept-terms"
              type="checkbox"
              class="checkbox checkbox-primary mt-0 shrink-0 border border-[#b88333]"
            />
            <span class="text-sm leading-6 text-[#625a51]">
              {en ? 'I accept the ' : 'Aceito os '}
              <a class="font-semibold text-[#8b5b1e] underline" href={en ? '/en/terms' : '/termos'}>
                {en ? 'Terms of Use' : 'Termos de Uso'}
              </a>
              {en ? ' and the ' : ' e a '}
              <a
                class="font-semibold text-[#8b5b1e] underline"
                href={en ? '/en/privacy' : '/privacidade'}
              >
                {en ? 'Privacy Policy' : 'Política de Privacidade'}
              </a>
              .
            </span>
          </label>
        </div>
        {emailReady && (
          <div data-recover class="mt-4 text-center">
            <button
              type="button"
              data-password-reset
              class="text-sm font-semibold text-[#8b5b1e] hover:underline"
            >
              {en ? 'Forgot your password?' : 'Esqueci minha senha'}
            </button>
          </div>
        )}
        <form id="login-code" hidden class="space-y-4">
          <p data-code-recipient class="text-base text-[#625a51]"></p>
          <div>
            <label for="login-code-input">{en ? '6-digit code' : 'Código de 6 dígitos'}</label>
            <input
              id="login-code-input"
              name="code"
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9]{6}"
              minlength="6"
              maxlength="6"
              required
              class="input input-bordered text-center font-mono text-2xl tracking-[0.3em]"
            />
          </div>
          <div data-new-password hidden>
            <label for="new-password">{en ? 'New password' : 'Nova senha'}</label>
            <input
              id="new-password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="12"
              maxlength="128"
              disabled
              class="input input-bordered"
            />
            <label for="confirm-password" class="mt-4">
              {en ? 'Repeat password' : 'Repita a senha'}
            </label>
            <input
              id="confirm-password"
              type="password"
              autocomplete="new-password"
              minlength="12"
              maxlength="128"
              disabled
              class="input input-bordered"
            />
            <p class="mt-2 text-sm text-[#625a51]">
              {en
                ? 'Use 12–128 characters. A passphrase works well.'
                : 'Use de 12 a 128 caracteres. Uma frase longa funciona bem.'}
            </p>
          </div>
          <button
            type="submit"
            class="btn h-11 min-h-11 w-full rounded-full border-[#a66f27] bg-[#b88333] text-white hover:bg-[#9b6823]"
          >
            {en ? 'Continue' : 'Continuar'}
          </button>
          <div class="flex justify-between gap-3 text-base text-[#8b5b1e]">
            <button type="button" data-resend disabled>
              {en ? 'Resend code' : 'Reenviar código'}
            </button>
            <button type="button" data-change-email>
              {en ? 'Change email' : 'Trocar e-mail'}
            </button>
          </div>
        </form>
        <div
          class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2"
          aria-label={en ? 'Other sign-in methods' : 'Outras formas de entrar'}
        >
          <div class="relative">
            {lastLogin === 'google' && (
              <span class="absolute -top-2 right-1 z-10 rounded-full border border-white bg-[#b88333] px-2 py-0.5 text-[10px] font-semibold text-white shadow-md">
                {lastUsed}
              </span>
            )}
            {clientId ? (
              <div class="relative overflow-hidden rounded-full">
                <div
                  data-google-button
                  data-client-id={clientId}
                  data-login-uri={googleLoginUrl(url)}
                  class="flex min-h-10 w-full items-center justify-center"
                ></div>
                <span
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-0 flex items-center justify-center gap-2 rounded-full border border-[#e2cba6] bg-[#fff4df] text-sm font-medium text-[#6f4716]"
                >
                  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 48 48">
                    <path
                      fill="#4285F4"
                      d="M43.61 24.46c0-1.36-.12-2.66-.35-3.92H24v7.42h11c-.47 2.4-1.85 4.44-3.93 5.8v4.82h6.36c3.72-3.43 6.18-8.5 6.18-14.12Z"
                    />
                    <path
                      fill="#34A853"
                      d="M24 44c5.4 0 9.94-1.79 13.25-4.85l-6.36-4.82c-1.77 1.18-4.04 1.9-6.89 1.9-5.22 0-9.65-3.52-11.23-8.25H6.2v4.97C9.5 39.49 16.23 44 24 44Z"
                    />
                    <path
                      fill="#FBBC05"
                      d="M12.77 27.98A12.02 12.02 0 0 1 12.14 24c0-1.39.23-2.73.63-3.98v-4.97H6.2A20 20 0 0 0 4 24c0 3.23.78 6.28 2.2 8.95l6.57-4.97Z"
                    />
                    <path
                      fill="#EA4335"
                      d="M24 11.77c2.94 0 5.57 1.01 7.65 3L37.4 9.1C33.93 5.87 29.4 4 24 4 16.23 4 9.5 8.51 6.2 15.05l6.57 4.97c1.58-4.73 6.01-8.25 11.23-8.25Z"
                    />
                  </svg>
                  {en ? 'Sign in with Google' : 'Entrar com Google'}
                </span>
              </div>
            ) : (
              <button type="button" disabled class="btn btn-ghost w-full rounded-full px-5">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 48 48">
                  <path
                    fill="#4285F4"
                    d="M43.61 24.46c0-1.36-.12-2.66-.35-3.92H24v7.42h11c-.47 2.4-1.85 4.44-3.93 5.8v4.82h6.36c3.72-3.43 6.18-8.5 6.18-14.12Z"
                  />
                  <path
                    fill="#34A853"
                    d="M24 44c5.4 0 9.94-1.79 13.25-4.85l-6.36-4.82c-1.77 1.18-4.04 1.9-6.89 1.9-5.22 0-9.65-3.52-11.23-8.25H6.2v4.97C9.5 39.49 16.23 44 24 44Z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M12.77 27.98A12.02 12.02 0 0 1 12.14 24c0-1.39.23-2.73.63-3.98v-4.97H6.2A20 20 0 0 0 4 24c0 3.23.78 6.28 2.2 8.95l6.57-4.97Z"
                  />
                  <path
                    fill="#EA4335"
                    d="M24 11.77c2.94 0 5.57 1.01 7.65 3L37.4 9.1C33.93 5.87 29.4 4 24 4 16.23 4 9.5 8.51 6.2 15.05l6.57 4.97c1.58-4.73 6.01-8.25 11.23-8.25Z"
                  />
                </svg>
                {en ? 'Sign in with Google' : 'Entrar com Google'}
              </button>
            )}
          </div>
          <div class="relative">
            {lastLogin === 'code' && (
              <span class="absolute -top-2 right-1 z-10 rounded-full border border-white bg-[#b88333] px-2 py-0.5 text-[10px] font-semibold text-white shadow-md">
                {lastUsed}
              </span>
            )}
            <button
              type="button"
              data-login-mode="code"
              aria-pressed="false"
              disabled={!emailReady}
              class="btn btn-ghost w-full rounded-full border border-[#e2cba6] bg-[#fff4df] px-5 font-medium text-[#6f4716] aria-pressed:border-[#b88333] aria-pressed:bg-[#b88333] aria-pressed:text-white"
            >
              <svg
                aria-hidden="true"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              >
                <rect x="3" y="5" width="18" height="14" rx="3" />
                <path d="m4 7 8 6 8-6" />
              </svg>
              {en ? 'Email' : 'E-mail'}
            </button>
          </div>
        </div>
        <button
          type="button"
          data-login-mode="password"
          hidden
          class="btn btn-outline btn-sm mt-3 w-full rounded-full text-[#6f4716]"
        >
          {en ? 'Back to password sign-in' : 'Voltar para entrar com senha'}
        </button>
        {!emailReady && (
          <p class="mt-5 text-base text-[#625a51]">
            {en
              ? 'Email codes are currently unavailable. Use your existing password or Google.'
              : 'Códigos por e-mail indisponíveis no momento. Use sua senha já cadastrada ou Google.'}
          </p>
        )}
        {!legalReady && (
          <p class="alert alert-error mt-5">
            {en
              ? 'New registrations are temporarily unavailable.'
              : 'Novos cadastros estão temporariamente indisponíveis.'}
          </p>
        )}
        {error && <input type="hidden" id="login-error" value={error} />}
      </div>
    </section>
  </main>
  {clientId && <script src="https://accounts.google.com/gsi/client" async defer></script>}

  <script>
    import { startEmail } from '@frontend/api/auth/start-email';
    import { verifyEmail } from '@frontend/api/auth/verify-email';
    import { passwordLogin } from '@frontend/api/auth/password';
    import { reportError, showToast } from '@frontend/components/toast';
    document.addEventListener('astro:page-load', () => {
      const root = document.querySelector<HTMLElement>('[data-login]');
      if (!root) return;
      const en = document.documentElement.lang === 'en';
      const start = root.querySelector<HTMLFormElement>('#login-start')!;
      const codes = root.querySelector<HTMLFormElement>('#login-code')!;
      const emailInput = root.querySelector<HTMLInputElement>('#login-email')!;
      const oldPassword = root.querySelector<HTMLInputElement>('#login-password')!;
      const codeInput = root.querySelector<HTMLInputElement>('#login-code-input')!;
      const newPassword = root.querySelector<HTMLInputElement>('#new-password')!;
      const confirmPassword = root.querySelector<HTMLInputElement>('#confirm-password')!;
      const resend = root.querySelector<HTMLButtonElement>('[data-resend]')!;
      const terms = root.querySelector<HTMLElement>('[data-terms]');
      const startButton = root.querySelector<HTMLButtonElement>('[data-start-button]')!;
      let mode: 'code' | 'password' | 'reset';
      let pendingEmail = '';
      let purpose: 'login' | 'password' = 'login';
      let busy = false;
      let resendAt = 0;
      let needsConsent = false;
      const rememberMethod = (method: 'code' | 'password') => {
        document.cookie = `vira_last_login=${method}; Path=/; Max-Age=31536000; SameSite=Lax`;
      };
      const termsAccepted = () =>
        root.querySelector<HTMLInputElement>('#accept-terms')?.checked ?? false;
      const consentNeeded = (error: unknown) =>
        Boolean((error as { data?: { consent?: boolean } })?.data?.consent);
      const askConsent = () => {
        needsConsent = true;
        if (terms) terms.hidden = false;
        startButton.textContent = en ? 'Create account' : 'Criar conta';
        terms?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      };
      const clearConsent = () => {
        needsConsent = false;
        if (terms) terms.hidden = true;
        const box = root.querySelector<HTMLInputElement>('#accept-terms');
        if (box) box.checked = false;
      };
      type GoogleId = {
        initialize: (options: Record<string, unknown>) => void;
        renderButton: (element: HTMLElement, options: Record<string, unknown>) => void;
      };
      const googleButton = root.querySelector<HTMLElement>('[data-google-button]');
      const renderGoogle = () => {
        const accounts = (window as unknown as { google?: { accounts?: { id?: GoogleId } } }).google
          ?.accounts?.id;
        if (!googleButton || !accounts) return false;
        const width = Math.min(400, Math.max(200, Math.round(googleButton.clientWidth)));
        accounts.initialize({
          client_id: googleButton.dataset.clientId,
          ux_mode: 'redirect',
          login_uri: googleButton.dataset.loginUri,
          auto_select: false,
        });
        accounts.renderButton(googleButton, {
          type: 'standard',
          theme: 'outline',
          size: 'large',
          text: 'signin_with',
          shape: 'pill',
          logo_alignment: 'left',
          width,
        });
        return true;
      };
      if (googleButton && !renderGoogle()) {
        let tries = 0;
        const timer = window.setInterval(() => {
          if (renderGoogle() || ++tries > 60) window.clearInterval(timer);
        }, 100);
      }
      const cooldown = () => {
        const seconds = Math.max(0, Math.ceil((resendAt - Date.now()) / 1000));
        resend.disabled = busy || seconds > 0;
        resend.textContent = seconds
          ? `${en ? 'Resend in' : 'Reenviar em'} ${seconds}s`
          : en
            ? 'Resend code'
            : 'Reenviar código';
      };
      const setBusy = (value: boolean) => {
        busy = value;
        root
          .querySelectorAll<HTMLButtonElement>('button')
          .forEach(
            (button) =>
              (button.disabled =
                value ||
                (button.dataset.loginMode === 'code' && root.dataset.emailReady !== 'true')),
          );
        cooldown();
      };
      const selectMode = (next: typeof mode) => {
        if (busy) return;
        mode = next;
        clearConsent();
        start.hidden = false;
        codes.hidden = true;
        codeInput.value = '';
        oldPassword.value = '';
        newPassword.value = '';
        confirmPassword.value = '';
        root
          .querySelectorAll<HTMLButtonElement>('[data-login-mode]')
          .forEach((button) =>
            button.setAttribute('aria-pressed', String(button.dataset.loginMode === mode)),
          );
        const backToPassword = root.querySelector<HTMLElement>('[data-login-mode="password"]');
        if (backToPassword) backToPassword.hidden = mode === 'password';
        const recover = root.querySelector<HTMLElement>('[data-recover]');
        if (recover) recover.hidden = mode !== 'password';
        root.querySelector<HTMLElement>('[data-login-description]')!.hidden = mode === 'password';
        root.querySelector<HTMLElement>('[data-password-login]')!.hidden = mode !== 'password';
        oldPassword.disabled = mode !== 'password';
        oldPassword.required = mode === 'password';
        root.querySelector<HTMLElement>('[data-new-password]')!.hidden = mode !== 'reset';
        newPassword.disabled = confirmPassword.disabled = mode !== 'reset';
        newPassword.required = confirmPassword.required = mode === 'reset';
        root.querySelector<HTMLElement>('[data-login-description]')!.textContent =
          mode === 'password'
            ? en
              ? 'Sign in with your email and password.'
              : 'Entre com seu e-mail e senha.'
            : mode === 'reset'
              ? en
                ? 'Verify your email with a code to create or reset your password.'
                : 'Confirme seu e-mail com um código para criar ou redefinir sua senha.'
              : en
                ? 'Receive a 6-digit code. No link or password needed.'
                : 'Receba um código de 6 dígitos. Sem link e sem senha.';
        startButton.textContent =
          mode === 'password' ? (en ? 'Sign in' : 'Entrar') : en ? 'Send code' : 'Enviar código';
      };
      root.querySelectorAll<HTMLButtonElement>('[data-login-mode]').forEach((button) =>
        button.addEventListener('click', () => {
          const target = button.dataset.loginMode as typeof mode;
          const wanted = target === 'code' && mode === 'code' ? 'password' : target;
          selectMode(wanted);
          if (!busy) emailInput.focus();
        }),
      );
      root
        .querySelector('[data-password-reset]')
        ?.addEventListener('click', () => selectMode('reset'));
      root.querySelector('[data-change-email]')?.addEventListener('click', () => selectMode(mode));
      const needTerms = () => {
        if (needsConsent && !termsAccepted()) {
          showToast(
            en
              ? 'Accept the Terms of Use and the Privacy Policy to continue.'
              : 'Aceite os Termos de Uso e a Política de Privacidade para continuar.',
            'error',
          );
          return true;
        }
        return false;
      };
      start.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (busy || needTerms()) return;
        setBusy(true);
        try {
          const email = emailInput.value.trim();
          if (mode === 'password') {
            const result = await passwordLogin(email, oldPassword.value, termsAccepted());
            rememberMethod('password');
            location.assign(result.redirect);
            return;
          }
          purpose = mode === 'reset' ? 'password' : 'login';
          await startEmail(email, purpose);
          pendingEmail = email;
          root.querySelector<HTMLElement>('[data-code-recipient]')!.textContent =
            `${en ? 'Code sent to' : 'Código enviado para'} ${pendingEmail}. ${en ? 'Valid for 10 minutes.' : 'Válido por 10 minutos.'}`;
          start.hidden = true;
          codes.hidden = false;
          resendAt = Date.now() + 60_000;
          codeInput.focus();
        } catch (error) {
          if (consentNeeded(error)) askConsent();
          else reportError(error, en ? 'Unable to sign in' : 'Falha no acesso');
        } finally {
          setBusy(false);
        }
      });
      codes.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (busy || needTerms()) return;
        if (purpose === 'password' && newPassword.value !== confirmPassword.value) {
          showToast(en ? 'Passwords do not match.' : 'As senhas não coincidem.', 'error');
          return;
        }
        setBusy(true);
        try {
          const result = await verifyEmail(
            pendingEmail,
            codeInput.value.trim(),
            purpose,
            purpose === 'password' ? newPassword.value : undefined,
            termsAccepted(),
          );
          rememberMethod('code');
          location.assign(result.redirect);
        } catch (error) {
          if (consentNeeded(error)) askConsent();
          else reportError(error, en ? 'Unable to verify code' : 'Falha ao validar código');
        } finally {
          setBusy(false);
        }
      });
      resend.addEventListener('click', async () => {
        if (busy || Date.now() < resendAt) return;
        setBusy(true);
        try {
          await startEmail(pendingEmail, purpose);
          resendAt = Date.now() + 60_000;
        } catch (error) {
          reportError(error, en ? 'Unable to resend' : 'Falha ao reenviar');
        } finally {
          setBusy(false);
        }
      });
      setInterval(cooldown, 1000);
      selectMode(
        root.dataset.reset === 'true' && root.dataset.emailReady === 'true' ? 'reset' : 'password',
      );
      const loginError = root.querySelector<HTMLInputElement>('#login-error')?.value;
      if (loginError) showToast(loginError, 'error');
    });
  </script>
</Base>
