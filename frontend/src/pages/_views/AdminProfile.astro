---
import Base from '@frontend/components/Base.astro';
import AdminHeader from '@frontend/components/AdminHeader.astro';
import ImageUpload from '@frontend/components/ImageUpload.astro';

const { admin } = Astro.props;
const label = admin.displayName || admin.email.split('@')[0] || 'V';
const initials = label
  .split(/[^\p{L}\p{N}]+/u)
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part[0].toLocaleUpperCase('pt-BR'))
  .join('');
---

<Base title="Meus dados · Vira" noindex appearance="light" manifest="/admin/manifest.webmanifest">
  <div class="min-h-screen bg-white text-[#17130d]">
    <AdminHeader section="conta" admin={admin} />
    <main class="panel mx-auto max-w-[1380px] px-5 pt-8 pb-24 sm:px-8">
      <nav class="mb-1 text-xs text-[#9b6823]" aria-label="Trilha de navegação">
        <a href="/admin" class="hover:underline">
          Administração
        </a>
        <span aria-hidden="true"> / </span>
        <span class="font-semibold">Meus dados</span>
      </nav>
      <h1 class="mb-6 font-[Outfit] text-2xl font-medium tracking-[-0.02em] text-[#17130d]">
        Meus dados
      </h1>

      <div class="rounded-2xl border border-[#ead8bd] bg-white p-6">
        <form id="profile-form" class="space-y-6">
          <div>
            <span class="mb-2 block text-sm font-semibold">Foto</span>
            <div data-avatar-picker class="flex flex-wrap items-center gap-4">
              <span class="relative mx-auto h-16 w-16 shrink-0 sm:mx-0">
                <img
                  data-avatar-preview
                  src={admin.avatar ?? ''}
                  alt=""
                  class:list={[
                    'h-16 w-16 rounded-full border border-[#d8ae73] object-cover',
                    !admin.avatar && 'hidden',
                  ]}
                />
                <span
                  data-avatar-placeholder
                  class:list={[
                    'grid h-16 w-16 place-items-center rounded-full border border-[#d8ae73] bg-[#fff4df] font-semibold text-[#6f4716]',
                    admin.avatar && 'hidden',
                  ]}
                >
                  {initials || 'V'}
                </span>
              </span>
              <ImageUpload
                accept="image/png,image/jpeg,image/webp"
                preview={false}
                compact
                class="sm:max-w-xs"
              />
              <button
                data-avatar-remove
                type="button"
                class="btn btn-ghost btn-sm w-full sm:w-auto"
              >
                Remover foto
              </button>
              <input data-avatar-value type="hidden" name="avatar" value={admin.avatar ?? ''} />
            </div>
          </div>
          <div>
            <label class="mb-2 block text-sm font-semibold" for="display-name">
              Nome de exibição
            </label>
            <input
              id="display-name"
              class="input input-bordered w-full"
              name="displayName"
              value={admin.displayName}
              maxlength="80"
              autocomplete="name"
              required
            />
          </div>
          <div>
            <label class="mb-2 block text-sm font-semibold" for="profile-email">
              E-mail de acesso
            </label>
            <input
              id="profile-email"
              class="input input-bordered w-full bg-[#fff9ef]"
              type="email"
              value={admin.email}
              readonly
            />
            <p class="mt-2 text-xs text-[#625a51]">
              O e-mail de acesso permanece vinculado à sua identidade verificada.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <button class="btn btn-primary" type="submit">
              Salvar
            </button>
          </div>
        </form>

        <div id="documentos" class="mt-8 border-t border-[#ead8bd] pt-6">
          <h2 class="font-[Outfit] text-lg">Documentos</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            <a class="btn btn-outline" href="/privacidade">
              Política de Privacidade
            </a>
            <a class="btn btn-outline" href="/termos">
              Termos de Uso
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
  <script>
    import '@frontend/pages/_scripts/account-menu';
    import { initAvatarPicker, applyAvatarToMenu } from '@frontend/pages/_scripts/avatar-picker';
    import { updateProfile } from '@frontend/api/admin/update-profile';
    import { reportError } from '@frontend/components/toast';
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLElement>('[data-avatar-picker]').forEach(initAvatarPicker);
      const form = document.querySelector<HTMLFormElement>('#profile-form');
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
        if (button) button.disabled = true;
        try {
          const name = (form.elements.namedItem('displayName') as HTMLInputElement).value;
          const avatar = (form.elements.namedItem('avatar') as HTMLInputElement).value || null;
          await updateProfile(name, avatar);
          const normalized = name.trim().replace(/\s+/g, ' ');
          document.querySelectorAll<HTMLElement>('[data-account-label]').forEach((node) => {
            node.textContent = normalized;
          });
          const initials = normalized
            .split(/[^\p{L}\p{N}]+/u)
            .filter(Boolean)
            .slice(0, 2)
            .map((part: string) => part[0].toLocaleUpperCase('pt-BR'))
            .join('');
          applyAvatarToMenu(avatar ?? '', initials);
        } catch (error) {
          reportError(error, 'Falha ao salvar o perfil.');
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  </script>
</Base>
