---
import Base from '@frontend/components/Base.astro';
import Walkthrough from '@frontend/components/Walkthrough.astro';
import ProjectShowcase from '@frontend/components/ProjectShowcase.astro';
import AssistantChat from '@frontend/components/AssistantChat.astro';
import CookieNotice from '@frontend/components/CookieNotice.astro';
import SiteHeader from '@frontend/components/SiteHeader.astro';
import SiteFooter from '@frontend/components/SiteFooter.astro';
import { getPublicPrices, type Plan } from '@frontend/api/billing/public-prices';
import { getPublicShowcase } from '@frontend/api/showcase/public-showcase';
import { getRootDomain } from '@frontend/api/config/root-domain';
import { sessionAdmin } from '@frontend/api/auth/session-admin';
import { sessionUser } from '@frontend/api/auth/session-user';
interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;
const en = lang === 'en';
const domain = await getRootDomain();
const [adminSession, userSession] = await Promise.all([
  sessionAdmin(Astro.request),
  sessionUser(Astro.request),
]);
const hasAdmin = Boolean(adminSession);
const hasUser = Boolean(userSession);
const signedIn = hasAdmin || hasUser;
const dashboardHref = hasUser ? '/app' : hasAdmin ? '/admin' : '/login';
const prices = await getPublicPrices();
const { createdCount, projects } = await getPublicShowcase();
const count = new Intl.NumberFormat(en ? 'en-US' : 'pt-BR').format(createdCount);
const createdLabel = en
  ? createdCount === 0
    ? 'Be the first to create a page here'
    : createdCount === 1
      ? '1 person has created a page here'
      : `${count} people have created their pages here`
  : createdCount === 0
    ? 'Seja a primeira pessoa a criar sua página'
    : createdCount === 1
      ? '1 pessoa já criou sua página aqui'
      : `${count} pessoas já criaram suas páginas aqui`;
const currency = en ? 'usd' : 'brl';
const displayPrice = (plan: Plan) => {
  const row = prices.find((item) => item.plan === plan && item.currency === currency);
  return row?.amount_minor
    ? new Intl.NumberFormat(en ? 'en-US' : 'pt-BR', {
        style: 'currency',
        currency: currency.toUpperCase(),
      }).format(row.amount_minor / 100)
    : null;
};
const planPrices = { monthly: displayPrice('monthly'), yearly: displayPrice('yearly') };
const planReady = {
  monthly: prices.some(
    (item) =>
      item.plan === 'monthly' &&
      item.currency === currency &&
      item.active === 1 &&
      item.stripe_price_id?.startsWith('price_'),
  ),
  yearly: prices.some(
    (item) =>
      item.plan === 'yearly' &&
      item.currency === currency &&
      item.active === 1 &&
      item.stripe_price_id?.startsWith('price_'),
  ),
};
const planHref =
  dashboardHref === '/admin' ? '/admin' : dashboardHref === '/app' ? '/app/plano' : '/login';
const t = en
  ? {
      nav: 'Start free',
      titleA: 'Put your idea',
      titleB: 'out there.',
      intro:
        'A page that looks like your business — plus an AI assistant that answers your visitors. Choose a layout, edit every detail, and publish in minutes.',
      cta: 'Try 1 day free',
      demo: 'See how it works',
      assistantName: 'Vira assistant',
      assistantGreeting:
        "Hi! I'm the Vira assistant. Ask me about plans, custom domains, or how to publish your page.",
      assistantSuggestions: ['How much does it cost?', 'Do I need to code?', 'How do I publish?'],
      publishAnswer:
        'It is simple: open your panel, pick the layout, edit your text and images and press Publish.',
      domainQuestion: 'And where does my page live?',
      domainAnswer:
        'Your page goes live at a Vira address, like your-page.vira.ia.br. If you want, you can connect your own domain later.',
      featuresEyebrow: 'Two main features',
      featuresTitle: 'Your page and your assistant.',
      featuresText: 'Everything Vira does, summed up in two ideas.',
      features: [
        {
          title: 'Your page, live',
          text: 'Editable blocks, live editing, and publishing on a free Vira subdomain or your own domain.',
          items: ['Editable blocks', 'Own domain', 'Installable PWA'],
        },
        {
          title: 'Your AI assistant',
          text: 'Every page gets an assistant that answers visitors using the content you filled in.',
          items: [
            'Answers about your business',
            'Speaks Portuguese and English',
            'Included in every access',
          ],
        },
      ],
      section: 'How it works.',
      sectionText: 'Three steps, using our own example page.',
      steps: [
        {
          title: 'Open your space',
          text: 'Sign in with your email and password, a code or Google, then open your dashboard.',
        },
        {
          title: 'Add your information',
          text: 'Choose a layout and edit your text and images directly in the interactive preview.',
        },
        {
          title: 'Check and publish',
          text: 'Review the page on desktop or mobile, then press Publish. Share your Vira address right away; connect your own domain when you choose a plan.',
        },
      ],
      plans: 'Choose your plan',
      plansText: 'Start without a card. Pick a plan when you are ready.',
      monthly: 'Monthly',
      yearly: 'Yearly',
      monthlyDesc: 'Keep your page live with a flexible monthly subscription.',
      yearlyDesc: 'One annual payment for a full year.',
      comingSoon: 'Coming soon',
      included: [
        'One published page',
        'Editable blocks',
        'Your own www domain',
        'Images and basic analytics',
        'AI assistant on your site',
      ],
      select: 'Select plan',
      footer: 'A clear place for what you do.',
    }
  : {
      nav: 'Começar grátis',
      titleA: 'Coloque sua ideia',
      titleB: 'no mundo.',
      intro:
        'Uma página com a cara do seu negócio — e uma assistente de IA que responde seus visitantes. Escolha um layout, edite cada detalhe e publique em minutos.',
      cta: 'Testar 1 dia grátis',
      demo: 'Ver como funciona',
      assistantName: 'Assistente do Vira',
      assistantGreeting:
        'Oi! Sou a assistente do Vira. Pergunte sobre planos, domínio próprio ou como publicar sua página.',
      assistantSuggestions: [
        'Quanto custa?',
        'Preciso saber programar?',
        'Como publico minha página?',
      ],
      publishAnswer:
        'É simples: entre no painel, escolha o layout, edite seus textos e imagens e clique em Publicar.',
      domainQuestion: 'E onde fica o endereço da minha página?',
      domainAnswer:
        'Sua página fica no ar num endereço Vira, como sua-pagina.vira.ia.br. Se quiser, você conecta seu domínio próprio depois.',
      featuresEyebrow: 'Duas features principais',
      featuresTitle: 'Sua página e sua assistente.',
      featuresText: 'Tudo o que o Vira faz, resumido em duas ideias.',
      features: [
        {
          title: 'Sua página no ar',
          text: 'Blocos editáveis, edição ao vivo e publicação no subdomínio Vira ou no seu domínio próprio.',
          items: ['Blocos editáveis', 'Domínio próprio', 'PWA instalável'],
        },
        {
          title: 'Sua assistente de IA',
          text: 'Cada página ganha uma assistente que responde visitantes com base no conteúdo que você cadastrou.',
          items: [
            'Responde sobre o seu negócio',
            'Fala português e inglês',
            'Incluída em todos os acessos',
          ],
        },
      ],
      section: 'Como funciona.',
      sectionText: 'Três passos, usando a nossa própria página de exemplo.',
      steps: [
        {
          title: 'Entre no seu espaço',
          text: 'Entre com e-mail e senha, código ou Google e acesse seu painel para começar.',
        },
        {
          title: 'Coloque suas informações',
          text: 'Escolha um visual e edite seus textos e imagens diretamente na prévia interativa.',
        },
        {
          title: 'Confira e publique',
          text: 'Veja como fica no computador ou no celular e clique em Publicar. Compartilhe seu endereço Vira; seu domínio próprio pode ser conectado após escolher um plano.',
        },
      ],
      plans: 'Escolha seu plano',
      plansText: 'Comece sem cartão. Escolha um plano quando estiver pronto.',
      monthly: 'Mensal',
      yearly: 'Anual',
      monthlyDesc: 'Mantenha sua página no ar com uma assinatura flexível.',
      yearlyDesc: 'Um pagamento para o ano inteiro.',
      comingSoon: 'Em breve',
      included: [
        'Uma página publicada',
        'Blocos editáveis',
        'Domínio www próprio',
        'Imagens e estatísticas básicas',
        'Assistente de IA no site',
      ],
      select: 'Escolher plano',
      footer: 'Um lugar claro para mostrar o que você faz.',
    };
const iconPage =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--a-accent)]" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/></svg>';
const iconSpark =
  '<svg viewBox="0 0 24 24" fill="currentColor" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--a-accent)]" aria-hidden="true"><path d="M12 2.5l1.9 4.7 4.7 1.9-4.7 1.9L12 15.7l-1.9-4.7L5.4 9.1l4.7-1.9z"/><path d="M18.6 15.2l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>';
const iconPublish =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[var(--a-accent)]" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 16V8M8.5 11.5L12 8l3.5 3.5"/></svg>';
const introHtml = en
  ? `<span class="flex items-start gap-2">${iconPage}<span><strong class="font-semibold">Your own page</strong>, made to look like your business</span></span><span class="mt-2 flex items-start gap-2">${iconSpark}<span>An <strong class="font-semibold">AI assistant</strong> that answers your visitors</span></span><span class="mt-2 flex items-start gap-2">${iconPublish}<span>Choose, edit and <strong class="font-semibold">publish in minutes</strong></span></span>`
  : `<span class="flex items-start gap-2">${iconPage}<span><strong class="font-semibold">Sua página</strong> com a cara do seu negócio</span></span><span class="mt-2 flex items-start gap-2">${iconSpark}<span>Uma <strong class="font-semibold">assistente de IA</strong> que responde seus visitantes</span></span><span class="mt-2 flex items-start gap-2">${iconPublish}<span>Escolha, edite e <strong class="font-semibold">publique em minutos</strong></span></span>`;
const heroScript = [
  { role: 'assistant' as const, text: t.intro, html: introHtml },
  { role: 'user' as const, text: t.assistantSuggestions[2] },
  { role: 'assistant' as const, text: t.publishAnswer },
  { role: 'user' as const, text: t.domainQuestion },
  { role: 'assistant' as const, text: t.domainAnswer },
];
---

<Base
  title={en ? 'Vira — Put your idea out there' : 'Vira — Coloque sua ideia no mundo'}
  description={t.intro}
  lang={lang}
  appearance="light"
>
  <link slot="head" rel="alternate" hreflang="pt-BR" href={'https://' + domain + '/'} />
  <link slot="head" rel="alternate" hreflang="en-US" href={'https://' + domain + '/en/'} />
  <link slot="head" rel="alternate" hreflang="x-default" href={'https://' + domain + '/'} />
  <div class="min-h-screen overflow-x-clip bg-white text-[#17130d]">
    <main>
      <div class="marketing-first-screen flex h-[100svh] box-border flex-col border-b border-[#d8ae73]">
        <SiteHeader
          lang={lang}
          signedIn={signedIn}
          dashboardHref={dashboardHref}
          hasAdmin={hasAdmin}
          hasUser={hasUser}
        />
        <section
          data-marketing-hero
          class="relative isolate mx-auto flex min-h-0 w-full max-w-[1380px] flex-1 flex-col overflow-hidden px-5 pb-20 pt-5 sm:px-8 lg:pt-8 [@media(max-height:640px)]:pb-16 [@media(max-height:640px)]:pt-2"
          aria-labelledby="hero-title"
        >
          <img
            src="/vira-hero-light.webp"
            width="1586"
            height="992"
            alt=""
            fetchpriority="high"
            class="pointer-events-none absolute inset-0 -z-20 h-full w-full select-none object-cover object-center opacity-[0.07]"
          />
          <h1 id="hero-title" class="sr-only">
            {t.titleA} {t.titleB}
          </h1>
          <div class="hero-conversation relative z-10 flex min-h-0 w-full flex-1 items-stretch [&_.assistant-demo]:h-full [&_.assistant-demo]:w-full">
            <AssistantChat
              endpoint="/api/assistant/chat"
              lang={lang}
              name={t.assistantName}
              greeting={
                en
                  ? 'You can create your site, customize its look and content, and have an AI assistant answer visitors using your published information.'
                  : 'Você cria seu site, personaliza o visual e o conteúdo e conta com uma assistente de IA que responde aos visitantes usando as informações publicadas.'
              }
              suggestions={t.assistantSuggestions}
              script={heroScript}
              meta={createdLabel}
            >
              <div
                slot="footer"
                data-hero-footer
                class="flex flex-col items-center gap-2 px-6 pb-1 pt-2"
              >
                <p class="text-xs text-[#766e63]">
                  {en ? '1-day free trial · No card required' : '1 dia grátis · Sem cartão'}
                </p>
              </div>
            </AssistantChat>
          </div>
          <a
            href="#como-funciona"
            class="absolute bottom-5 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-3 whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.2em] text-[#8b5b1e] transition-colors hover:text-[#17130d] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b88333]"
            aria-label={en ? 'Scroll to discover' : 'Role para descobrir'}
          >
            Explore
            <span
              aria-hidden="true"
              class="h-7 w-px bg-gradient-to-b from-[#b88333] to-transparent"
            ></span>
          </a>
        </section>
      </div>
      <Walkthrough lang={lang} heading={t.section} intro={t.sectionText} steps={t.steps} />
      <ProjectShowcase lang={lang} projects={projects} />
      <section
        id="planos"
        class="mx-auto max-w-[1380px] scroll-mt-12 bg-white px-5 pt-12 pb-14 sm:px-8 sm:pt-14 sm:pb-20"
      >
        <div class="mb-8 text-center sm:mb-10" data-reveal>
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#9b6823]">
            {en ? 'Plans' : 'Planos'}
          </p>
          <h2 class="mt-2.5 font-['Outfit',sans-serif] text-[clamp(2.2rem,4.6vw,3.6rem)] font-medium leading-none tracking-[-0.06em]">
            {t.plans}
          </h2>
          <p class="mt-2.5 text-sm text-[#625a51]">{t.plansText}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <article
            data-reveal
            class="flex flex-col rounded-[22px] border border-[#d8ae73] bg-white px-6 py-8 sm:px-8"
          >
            <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[#9b6823]">
              {en ? 'Subscription' : 'Assinatura'}
            </span>
            <h3 class="mt-5 font-['Outfit',sans-serif] text-2xl font-medium tracking-[-0.04em]">
              {t.monthly}
            </h3>
            <p class="mt-6 flex flex-wrap items-end gap-x-2 border-b border-[#ead8bf] pb-6">
              <span class="font-['Outfit',sans-serif] text-[clamp(2rem,3.2vw,2.8rem)] font-medium leading-none tracking-[-0.05em] tabular-nums">
                {planPrices.monthly ?? t.comingSoon}
              </span>
              <span class="mb-1 text-sm text-[#625a51]">{en ? '/ month' : '/mês'}</span>
            </p>
            <p class="mt-5 text-sm leading-relaxed text-[#625a51]">{t.monthlyDesc}</p>
            {planReady.monthly ? (
              <a
                href={planHref}
                class="btn mt-7 h-12 w-full rounded-full border border-[#b88333] bg-white font-semibold text-[#6f4716] shadow-none hover:border-[#9b6823] hover:bg-[#fff9ef]"
              >
                {t.select}
                <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="mt-7 grid h-12 w-full cursor-not-allowed place-items-center rounded-full border border-[#e5ded2] bg-[#f5f2eb] text-sm font-semibold text-[#8b8174]">
                {t.comingSoon}
              </span>
            )}
          </article>

          <article
            data-reveal
            class="relative flex flex-col rounded-[22px] border-2 border-[#b88333] bg-[#fffdf9] px-6 py-8 shadow-[0_30px_70px_-55px_#80531888] sm:px-8"
          >
            <span class="absolute -top-3 right-6 rounded-full bg-[#b88333] px-3 py-1 text-[11px] font-semibold text-white">
              {en ? '2 months free' : '2 meses grátis'}
            </span>
            <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[#9b6823]">
              {en ? 'Subscription' : 'Assinatura'}
            </span>
            <h3 class="mt-5 font-['Outfit',sans-serif] text-2xl font-medium tracking-[-0.04em]">
              {t.yearly}
            </h3>
            <p class="mt-6 flex flex-wrap items-end gap-x-2 border-b border-[#ead8bf] pb-6">
              <span class="font-['Outfit',sans-serif] text-[clamp(2rem,3.2vw,2.8rem)] font-medium leading-none tracking-[-0.05em] tabular-nums">
                {planPrices.yearly ?? t.comingSoon}
              </span>
              <span class="mb-1 text-sm text-[#625a51]">{en ? '/ year' : '/ano'}</span>
            </p>
            <p class="mt-5 text-sm leading-relaxed text-[#625a51]">{t.yearlyDesc}</p>
            {planReady.yearly ? (
              <a
                href={planHref}
                class="btn mt-7 h-12 w-full rounded-full border border-[#a66f27] bg-[#b88333] font-semibold text-white shadow-none hover:bg-[#9b6823]"
              >
                {t.select}
                <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="mt-7 grid h-12 w-full cursor-not-allowed place-items-center rounded-full border border-[#e5ded2] bg-[#f5f2eb] text-sm font-semibold text-[#8b8174]">
                {t.comingSoon}
              </span>
            )}
          </article>
        </div>

        <div
          data-reveal
          class="mt-6 rounded-[22px] border border-[#ead8bf] bg-[#fcfaf6] px-6 py-8 sm:px-8"
        >
          <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#9b6823]">
            {en ? 'Included in both plans' : 'Incluído nos dois planos'}
          </p>
          <ul class="mt-5 grid gap-3 text-sm text-[#4f473e] sm:grid-cols-2">
            {t.included.map((item) => (
              <li class="flex gap-3">
                <span class="text-[#9b6823]" aria-hidden="true">
                  ↗
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>
    <SiteFooter lang={lang} />
  </div>
  <CookieNotice lang={lang} />
</Base>

<script>
  import '@frontend/pages/_scripts/assistant-chat';
</script>
