---
import Base from '@frontend/components/Base.astro';
import Brand from '@frontend/components/Brand.astro';
import Walkthrough from '@frontend/components/Walkthrough.astro';
import MobileNavigation from '@frontend/components/MobileNavigation.astro';
import ProjectShowcase from '@frontend/components/ProjectShowcase.astro';
import AssistantChat from '@frontend/components/AssistantChat.astro';
import { getPublicPrices, type Plan } from '@frontend/api/billing/public-prices';
import { getPublicShowcase } from '@frontend/api/showcase/public-showcase';
import { getRootDomain } from '@frontend/api/config/root-domain';
import { sessionAdmin } from '@frontend/api/auth/session-admin';
import { sessionUser } from '@frontend/api/auth/session-user';
interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;
const en = lang === 'en';
const domain = await getRootDomain();
const dashboardHref = (await sessionAdmin(Astro.request))
  ? '/admin'
  : (await sessionUser(Astro.request))
    ? '/app'
    : '/login';
const signedIn = dashboardHref !== '/login';
const prices = await getPublicPrices();
const { createdCount, projects } = await getPublicShowcase();
const count = new Intl.NumberFormat(en ? 'en-US' : 'pt-BR').format(createdCount);
const createdLabel = en
  ? createdCount === 0
    ? 'Be the first to create a page here'
    : createdCount === 1
      ? '1 person has created a page here'
      : `${count} people have created their pages here`
  : createdCount === 0
    ? 'Seja a primeira pessoa a criar sua página'
    : createdCount === 1
      ? '1 pessoa já criou sua página aqui'
      : `${count} pessoas já criaram suas páginas aqui`;
const currency = en ? 'usd' : 'brl';
const displayPrice = (plan: Plan) => {
  const row = prices.find((item) => item.plan === plan && item.currency === currency);
  return row?.amount_minor
    ? new Intl.NumberFormat(en ? 'en-US' : 'pt-BR', {
        style: 'currency',
        currency: currency.toUpperCase(),
      }).format(row.amount_minor / 100)
    : null;
};
const planPrices = (['monthly', 'yearly', 'lifetime'] as const).map(displayPrice);
const planReady = (['monthly', 'yearly', 'lifetime'] as const).map((plan) =>
  prices.some(
    (item) =>
      item.plan === plan &&
      item.currency === currency &&
      item.active === 1 &&
      item.stripe_price_id?.startsWith('price_'),
  ),
);
const t = en
  ? {
      nav: 'Start free',
      titleA: 'Put your idea',
      titleB: 'out there.',
      intro:
        'A page that looks like your business — plus an AI assistant that answers your visitors. Choose a layout, edit every detail, and publish in minutes.',
      cta: 'Try 1 day free',
      demo: 'See how it works',
      assistantName: 'Vira assistant',
      assistantGreeting:
        "Hi! I'm the Vira assistant. Ask me about plans, custom domains, or how to publish your page.",
      assistantSuggestions: ['How much does it cost?', 'Do I need to code?', 'How do I publish?'],
      featuresEyebrow: 'Two main features',
      featuresTitle: 'Your page and your assistant.',
      featuresText: 'Everything Vira does, summed up in two ideas.',
      features: [
        {
          title: 'Your page, live',
          text: 'Ready-made layouts, live editing, and publishing on a free Vira subdomain or your own domain.',
          items: ['Five layouts', 'Own domain', 'Installable PWA'],
        },
        {
          title: 'Your AI assistant',
          text: 'Every page gets an assistant that answers visitors using the content you filled in.',
          items: [
            'Answers about your business',
            'Speaks Portuguese and English',
            'Included in every access',
          ],
        },
      ],
      section: 'Your page, your way.',
      sectionText: 'Choose a template, customize your content and publish your page.',
      steps: [
        {
          title: 'Open your space',
          text: 'Sign in with your email and password, a code or Google, then open your dashboard.',
        },
        {
          title: 'Add your information',
          text: 'Choose a layout and edit your text and images directly in the interactive preview.',
        },
        {
          title: 'Check and publish',
          text: 'Review the page on desktop or mobile, then press Publish. Share your Vira address right away; connect your own domain when you choose a plan.',
        },
      ],
      plans: 'Choose your plan',
      plansText: 'Start without a card. Pick a plan when you are ready.',
      monthly: 'Monthly',
      yearly: 'Yearly',
      lifetime: 'Lifetime',
      monthlyDesc: 'Keep your page live with a flexible monthly subscription.',
      yearlyDesc: 'One annual payment for a full year.',
      lifetimeDesc: 'Pay once and keep access to your page.',
      comingSoon: 'Coming soon',
      included: [
        'One published page',
        'Five layouts',
        'Your own www domain',
        'Images and basic analytics',
        'AI assistant on your site',
      ],
      select: 'Select plan',
      footer: 'A clear place for what you do.',
    }
  : {
      nav: 'Começar grátis',
      titleA: 'Coloque sua ideia',
      titleB: 'no mundo.',
      intro:
        'Uma página com a cara do seu negócio — e uma assistente de IA que responde seus visitantes. Escolha um layout, edite cada detalhe e publique em minutos.',
      cta: 'Testar 1 dia grátis',
      demo: 'Ver como funciona',
      assistantName: 'Assistente do Vira',
      assistantGreeting:
        'Oi! Sou a assistente do Vira. Pergunte sobre planos, domínio próprio ou como publicar sua página.',
      assistantSuggestions: [
        'Quanto custa?',
        'Preciso saber programar?',
        'Como publico minha página?',
      ],
      featuresEyebrow: 'Duas features principais',
      featuresTitle: 'Sua página e sua assistente.',
      featuresText: 'Tudo o que o Vira faz, resumido em duas ideias.',
      features: [
        {
          title: 'Sua página no ar',
          text: 'Layouts prontos, edição ao vivo e publicação no subdomínio Vira ou no seu domínio próprio.',
          items: ['Cinco layouts', 'Domínio próprio', 'PWA instalável'],
        },
        {
          title: 'Sua assistente de IA',
          text: 'Cada página ganha uma assistente que responde visitantes com base no conteúdo que você cadastrou.',
          items: [
            'Responde sobre o seu negócio',
            'Fala português e inglês',
            'Incluída em todos os acessos',
          ],
        },
      ],
      section: 'Sua página, do seu jeito.',
      sectionText: 'Escolha um template, personalize o conteúdo e publique sua página.',
      steps: [
        {
          title: 'Entre no seu espaço',
          text: 'Entre com e-mail e senha, código ou Google e acesse seu painel para começar.',
        },
        {
          title: 'Coloque suas informações',
          text: 'Escolha um visual e edite seus textos e imagens diretamente na prévia interativa.',
        },
        {
          title: 'Confira e publique',
          text: 'Veja como fica no computador ou no celular e clique em Publicar. Compartilhe seu endereço Vira; seu domínio próprio pode ser conectado após escolher um plano.',
        },
      ],
      plans: 'Escolha seu plano',
      plansText: 'Comece sem cartão. Escolha um plano quando estiver pronto.',
      monthly: 'Mensal',
      yearly: 'Anual',
      lifetime: 'Vitalício',
      monthlyDesc: 'Mantenha sua página no ar com uma assinatura flexível.',
      yearlyDesc: 'Um pagamento para o ano inteiro.',
      lifetimeDesc: 'Pague uma vez e mantenha o acesso à sua página.',
      comingSoon: 'Em breve',
      included: [
        'Uma página publicada',
        'Cinco layouts',
        'Domínio www próprio',
        'Imagens e estatísticas básicas',
        'Assistente de IA no site',
      ],
      select: 'Escolher plano',
      footer: 'Um lugar claro para mostrar o que você faz.',
    };
---

<Base
  title={en ? 'Vira — Put your idea out there' : 'Vira — Coloque sua ideia no mundo'}
  description={t.intro}
  lang={lang}
  appearance="light"
>
  <link slot="head" rel="alternate" hreflang="pt-BR" href={'https://' + domain + '/'} />
  <link slot="head" rel="alternate" hreflang="en-US" href={'https://' + domain + '/en/'} />
  <link slot="head" rel="alternate" hreflang="x-default" href={'https://' + domain + '/'} />
  <div class="marketing-page min-h-screen overflow-x-clip bg-white text-[#17130d]">
    <main>
      <div class="marketing-first-screen">
        <header class="relative z-20 mx-auto flex w-full max-w-[1380px] shrink-0 items-center justify-between gap-4 px-5 pt-5 sm:px-8 sm:pt-7">
          <Brand href={signedIn ? dashboardHref : en ? '/en' : '/'} tone="light" />
          <nav
            class="hidden items-center gap-7 rounded-full border border-[#d8ae73] bg-white/95 px-7 py-3 text-sm text-[#605448] shadow-[0_8px_30px_-22px_rgba(131,85,21,0.35)] backdrop-blur-md md:flex"
            aria-label={en ? 'Main navigation' : 'Navegação principal'}
          >
            <a class="transition-colors hover:text-[#9b6823]" href="#como-funciona">
              {en ? 'How it works' : 'Como funciona'}
            </a>
            <a class="transition-colors hover:text-[#9b6823]" href="#vitrine">
              {en ? 'Projects' : 'Projetos'}
            </a>
            <a class="transition-colors hover:text-[#9b6823]" href="#planos">
              {en ? 'Plans' : 'Planos'}
            </a>
          </nav>
          <div class="ml-auto md:hidden">
            <MobileNavigation
              label={en ? 'Navigation' : 'Navegação'}
              lang={en ? 'en' : 'pt'}
              iconOnly
              links={[
                { href: '#como-funciona', label: en ? 'How it works' : 'Como funciona' },
                { href: '#vitrine', label: en ? 'Projects' : 'Projetos' },
                { href: '#planos', label: en ? 'Plans' : 'Planos' },
              ]}
            />
          </div>
          <div class="flex items-center gap-2 sm:gap-4">
            <a
              href={dashboardHref}
              class="btn btn-sm rounded-full border border-[#b88333] bg-white px-3 font-semibold text-[#6f4716] shadow-none transition-colors hover:border-[#9b6823] hover:bg-[#fff9ef] sm:btn-md sm:px-5"
            >
              <span class="sm:hidden">
                {signedIn ? (en ? 'Dashboard' : 'Painel') : en ? 'Start' : 'Começar'}
              </span>
              <span class="hidden sm:inline">
                {signedIn ? (en ? 'Open dashboard' : 'Abrir painel') : t.nav}
              </span>
              <span class="hidden sm:inline" aria-hidden="true">
                ↗
              </span>
            </a>
          </div>
        </header>
        <section
          data-marketing-hero
          class="relative isolate mx-auto flex min-h-0 w-full max-w-[1380px] flex-1 flex-col overflow-hidden px-5 pb-20 pt-5 sm:px-8 lg:pt-8"
          aria-labelledby="hero-title"
        >
          <img
            src="/vira-hero-light.webp"
            width="1586"
            height="992"
            alt=""
            fetchpriority="high"
            class="pointer-events-none absolute inset-0 -z-20 h-full w-full select-none object-cover object-center opacity-[0.07]"
          />
          <div class="hero-conversation relative z-10 min-h-0 w-full flex-1">
            <AssistantChat
              endpoint="/api/assistant/chat"
              lang={lang}
              name={t.assistantName}
              greeting={
                en
                  ? 'You can create your site, customize its look and content, and have an AI assistant answer visitors using your published information.'
                  : 'Você cria seu site, personaliza o visual e o conteúdo e conta com uma assistente de IA que responde aos visitantes usando as informações publicadas.'
              }
              suggestions={t.assistantSuggestions}
            >
              <div slot="intro" data-hero-intro class="py-3 text-left lg:pr-12">
                <p class="font-mono text-[9px] uppercase tracking-[0.12em] text-[#8b5b1e]">
                  {createdLabel}
                </p>
                <h1
                  id="hero-title"
                  class="mt-4 max-w-[18ch] font-['Outfit',sans-serif] text-[clamp(2rem,3.5vw,3.4rem)] font-medium leading-[1.1] tracking-[-0.05em]"
                >
                  {en ? 'Your page ready.' : 'Sua página pronta.'}
                  <span class="text-[#a66f27]">
                    {en ? ' Your AI assisting.' : ' Sua IA atendendo.'}
                  </span>
                </h1>
                <p class="mt-4 max-w-[44ch] text-sm leading-relaxed text-[#625a51]">
                  {en
                    ? 'Create your site with an AI assistant. Try a conversation below.'
                    : 'Crie seu site com uma assistente de IA. Experimente uma conversa abaixo.'}
                </p>
              </div>
              <div
                slot="footer"
                data-hero-footer
                class="flex flex-col items-center gap-2 px-6 pb-1 pt-2"
              >
                <p class="text-xs text-[#766e63]">
                  {en ? '1-day free trial · No card required' : '1 dia grátis · Sem cartão'}
                </p>
              </div>
            </AssistantChat>
          </div>
          <a
            href="#como-funciona"
            class="absolute bottom-5 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-3 whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.2em] text-[#8b5b1e] transition-colors hover:text-[#17130d] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b88333]"
            aria-label={en ? 'Scroll to discover' : 'Role para descobrir'}
          >
            Explore
            <span
              aria-hidden="true"
              class="h-7 w-px bg-gradient-to-b from-[#b88333] to-transparent"
            ></span>
          </a>
        </section>
      </div>
      <Walkthrough lang={lang} heading={t.section} intro={t.sectionText} steps={t.steps} />
      <ProjectShowcase lang={lang} projects={projects} />
      <section
        id="planos"
        class="mx-auto max-w-[1380px] scroll-mt-12 bg-white px-5 py-24 sm:px-8 md:py-32"
      >
        <div class="mb-14 text-center" data-reveal>
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#9b6823]">
            {en ? 'Plans' : 'Planos'}
          </p>
          <h2 class="mt-5 font-['Outfit',sans-serif] text-[clamp(3.3rem,6.2vw,6.4rem)] font-medium leading-none tracking-[-0.06em]">
            {t.plans}
          </h2>
          <p class="mt-5 text-[#625a51]">{t.plansText}</p>
        </div>
        <div class="grid auto-rows-fr gap-4 lg:grid-cols-3">
          {[t.monthly, t.yearly, t.lifetime].map((name, i) => (
            <article
              data-reveal
              class="flex h-full min-w-0 flex-col rounded-[1.5rem] border border-[#d8ae73] bg-white px-6 py-8 sm:px-8 lg:py-10"
            >
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-[#9b6823]">
                  {i === 2
                    ? en
                      ? 'One payment'
                      : 'Pagamento único'
                    : en
                      ? 'Subscription'
                      : 'Assinatura'}
                </span>
                {i === 1 && <span class="h-1.5 w-1.5 rounded-full bg-[#b88333]"></span>}
              </div>
              <h3 class="mt-8 font-['Outfit',sans-serif] text-[clamp(1.7rem,3vw,2.2rem)] font-medium tracking-[-0.04em]">
                {name}
              </h3>
              <p class="mt-4 min-h-16 max-w-[34ch] leading-relaxed text-[#625a51]">
                {[t.monthlyDesc, t.yearlyDesc, t.lifetimeDesc][i]}
              </p>
              <p class="mt-10 border-b border-[#d8ae73] pb-7 font-['Outfit',sans-serif] text-[clamp(2rem,3.5vw,3.4rem)] font-medium leading-none tracking-[-0.05em] tabular-nums">
                {planPrices[i] ?? t.comingSoon}
              </p>
              <ul class="my-8 space-y-3 text-sm text-[#4f473e]">
                {t.included.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-[#9b6823]" aria-hidden="true">
                      ↗
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
              {planPrices[i] && planReady[i] && (
                <a
                  href={
                    dashboardHref === '/admin'
                      ? '/admin'
                      : dashboardHref === '/app'
                        ? '/app/plano'
                        : '/login'
                  }
                  class:list={[
                    'btn mt-auto h-12 w-full rounded-full font-semibold shadow-none',
                    i === 1
                      ? 'border border-[#a66f27] bg-[#b88333] text-white hover:bg-[#9b6823]'
                      : 'border border-[#b88333] bg-white text-[#6f4716] hover:border-[#9b6823] hover:bg-[#fff9ef]',
                  ]}
                >
                  {t.select}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </article>
          ))}
        </div>
      </section>
    </main>
    <footer class="border-t border-[#d8ae73] bg-white">
      <div class="mx-auto flex max-w-[1380px] flex-col items-center gap-8 px-5 py-12 text-center sm:px-8 md:flex-row md:items-end md:justify-between md:text-left">
        <div class="flex flex-col items-center md:items-start">
          <Brand href={signedIn ? dashboardHref : en ? '/en' : '/'} tone="light" />
          <p class="mt-5 max-w-[30ch] text-sm leading-relaxed text-[#625a51]">{t.footer}</p>
        </div>
        <div class="flex flex-wrap justify-center gap-6 text-sm text-[#625a51] md:justify-start">
          <a class="hover:text-[#9b6823]" href={en ? '/en/privacy' : '/privacidade'}>
            {en ? 'Privacy' : 'Privacidade'}
          </a>
        </div>
      </div>
      <div class="mx-auto flex max-w-[1380px] flex-col items-center justify-between gap-2 border-t border-[#d8ae73] px-5 py-5 text-center font-mono text-[10px] uppercase tracking-[0.14em] text-[#766e63] sm:px-8 md:flex-row md:text-left">
        <span>© {new Date().getFullYear()} Vira</span>
        <span>vira.ia.br</span>
      </div>
    </footer>
  </div>
</Base>
<style>
  .marketing-first-screen {
    display: flex;
    flex-direction: column;
    height: 100svh;
  }
  .hero-conversation {
    display: flex;
    align-items: stretch;
  }
  .hero-conversation :global(.assistant-demo) {
    width: 100%;
    height: 100%;
  }
  .marketing-first-screen,
  .marketing-page main > :global(section) {
    height: 100svh;
    box-sizing: border-box;
    border-bottom: 1px solid #d8ae73;
  }
  .marketing-page main > :global(section) {
    overflow: auto;
  }
  #planos {
    max-width: none;
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 4svh, 40px) max(20px, calc((100% - 1316px) / 2));
  }
  #planos > div:first-child {
    flex-shrink: 0;
    margin-bottom: 24px;
  }
  #planos h2 {
    font-size: clamp(1.9rem, 4svh, 3rem);
    margin-top: 12px;
  }
  #planos > div:first-child > p:last-child {
    margin-top: 12px;
    font-size: 14px;
  }
  #planos > div:last-child {
    flex: 1;
    min-height: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  #planos article {
    overflow: auto;
    padding: clamp(16px, 3svh, 28px);
    border-radius: 20px;
  }
  #planos article h3 {
    margin-top: 20px;
    font-size: clamp(1.5rem, 3svh, 2rem);
  }
  #planos article > p:first-of-type {
    min-height: 0;
    font-size: 14px;
    line-height: 1.6;
    margin-top: 12px;
  }
  #planos article > p:nth-of-type(2) {
    margin-top: 20px;
    padding-bottom: 16px;
    font-size: clamp(1.6rem, 3.5svh, 2.5rem);
  }
  #planos article ul {
    margin-block: 20px;
    font-size: 13px;
  }
  #planos article .btn {
    min-height: 44px;
    flex-shrink: 0;
  }
  @media (max-width: 767px) {
    #planos > div:last-child {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 12px;
      padding-bottom: 8px;
    }
    #planos article {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }
  }
  @media (max-height: 640px) {
    [data-marketing-hero] {
      padding-top: 0.5rem;
      padding-bottom: 4rem;
    }
    [data-hero-intro] h1 {
      font-size: 1.65rem;
      margin-top: 0.5rem;
    }
    [data-hero-intro] > p:last-of-type {
      display: none;
    }
  }
</style>
<script>
  import '@frontend/pages/_scripts/assistant-chat';
</script>
