---
import Base from '@frontend/components/Base.astro';
import AdminHeader from '@frontend/components/AdminHeader.astro';
import ResponsiveTables from '@frontend/components/ResponsiveTables.astro';
import Pager from '@frontend/components/Pager.astro';
import { adminDashboard } from '@frontend/api/admin/dashboard';

const { url, admin, section = 'visao' } = Astro.props;
const search = (url.searchParams.get('q') || '').trim().slice(0, 80);
const navigation = [
  { key: 'visao', href: '/admin', label: 'Visão geral' },
  { key: 'configuracoes', href: '/admin/configuracoes', label: 'Configurações' },
  { key: 'emails', href: '/admin/emails', label: 'E-mails' },
  { key: 'usuarios', href: '/admin/usuarios', label: 'Usuários' },
  { key: 'logs', href: '/admin/logs', label: 'Logs' },
];

const roleFilter = ['admin', 'customer'].includes(url.searchParams.get('role') || '')
  ? (url.searchParams.get('role') as string)
  : '';
const sizeParam = Number(url.searchParams.get('size'));
const logFilters = {
  kind: (url.searchParams.get('kind') || '').trim().slice(0, 20),
  level: (url.searchParams.get('level') || '').trim().slice(0, 20),
  q: search,
  role: roleFilter,
  page: Math.max(1, Math.floor(Number(url.searchParams.get('page')) || 1)),
  size: [10, 25, 50, 100].includes(sizeParam) ? sizeParam : 10,
};

const {
  settings,
  prices,
  logs,
  emailTemplates,
  emailOutbox,
  counts,
  signups,
  clients,
  people,
  page,
  pages,
  total,
  size,
  clientDetail,
} = await adminDashboard(search, section, logFilters);
const dateInput = (time: number | null) =>
  time ? new Date(time * 1000).toISOString().slice(0, 10) : '';
const consentLabels: Record<string, string> = {
  cookies: 'Cookies',
  terms: 'Termos de Uso',
  privacy: 'Privacidade',
};
const clientEmailCounts: Record<string, number> = {};
if (clientDetail?.found) {
  for (const row of clientDetail.emailCounts) clientEmailCounts[row.status] = row.total;
}
const pagantes = counts.monthly_active + counts.yearly_active;
const siteTotal = counts.published + counts.drafts;
const publishedPct = siteTotal ? counts.published / siteTotal : 0;
const publicationRate = siteTotal ? Math.round((counts.published / siteTotal) * 100) : 0;
const conversionRate = counts.users ? Math.round((pagantes / counts.users) * 100) : 0;
const activePrice = (plan: string, currency: string) =>
  prices.find(
    (row) => row.plan === plan && row.currency === currency && row.active && row.amount_minor,
  )?.amount_minor ?? 0;
const mrr = (currency: string) =>
  counts.monthly_active * activePrice('monthly', currency) +
  Math.round((counts.yearly_active * activePrice('yearly', currency)) / 12);
const money = (minor: number, currency: string) =>
  new Intl.NumberFormat(currency === 'brl' ? 'pt-BR' : 'en-US', {
    style: 'currency',
    currency: currency.toUpperCase(),
  }).format(minor / 100);
const mrrBrl = mrr('brl');
const mrrUsd = mrr('usd');
const stats = [
  {
    value: counts.users,
    label: 'Clientes',
    href: '/admin/usuarios',
    icon: '<path d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/>',
  },
  {
    value: counts.new_users_7d,
    label: 'Novos (7 dias)',
    href: '/admin/usuarios',
    icon: '<path d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z"/>',
  },
  {
    value: pagantes,
    label: 'Pagantes',
    href: '/admin/usuarios',
    icon: '<path d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"/>',
  },
  {
    value: counts.trials_active,
    label: 'Testes ativos',
    href: '/admin/usuarios',
    icon: '<path d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>',
  },
  {
    value: counts.access_ended,
    label: 'Expirados',
    href: '/admin/usuarios',
    icon: '<path d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>',
  },
  {
    value: counts.domains_active,
    label: 'Domínios ativos',
    href: '/admin/usuarios',
    icon: '<path d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582"/>',
  },
  {
    value: counts.emails_sent_30d,
    label: 'E-mails (30 dias)',
    href: '/admin/emails',
    icon: '<path d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>',
  },
  {
    value: counts.emails_queued,
    label: 'E-mails na fila',
    href: '/admin/emails',
    icon: '<path d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z"/>',
  },
];
const days = Array.from({ length: 14 }, (_, i) => {
  const key = new Date(Date.now() - (13 - i) * 86400000).toISOString().slice(0, 10);
  return { day: key, total: signups.find((row) => row.day === key)?.total ?? 0 };
});
const maxSignups = Math.max(1, ...days.map((row) => row.total));
const groups = [
  { title: 'Identidade e acesso', keys: ['GOOGLE_CLIENT_ID', 'RESEND_API_KEY', 'AUTH_EMAIL_FROM'] },
  { title: 'Cobrança', keys: ['STRIPE_SECRET_KEY', 'STRIPE_WEBHOOK_SECRET'] },
  { title: 'Domínios e métricas', keys: ['CLOUDFLARE_API_TOKEN', 'CLOUDFLARE_ANALYTICS_TOKEN'] },
  { title: 'Inteligência artificial', keys: ['AI_MODEL'] },
  { title: 'Privacidade', keys: ['PRIVACY_CONTROLLER_NAME', 'PRIVACY_CONTACT_EMAIL'] },
  {
    title: 'Legal, contato e redes',
    keys: [
      'PRIVACY_POLICY',
      'PRIVACY_POLICY_EN',
      'TERMS_OF_USE',
      'TERMS_OF_USE_EN',
      'CONTACT_EMAIL',
      'SOCIAL_INSTAGRAM',
      'SOCIAL_X',
      'SOCIAL_FACEBOOK',
      'SOCIAL_YOUTUBE',
      'SOCIAL_LINKEDIN',
      'SOCIAL_TIKTOK',
      'SOCIAL_WHATSAPP',
      'FOOTER_CREATOR',
      'FOOTER_COPYRIGHT',
    ],
  },
];
const labels: Record<string, string> = {
  GOOGLE_CLIENT_ID: 'Client ID do Google',
  RESEND_API_KEY: 'Chave de envio Resend',
  AUTH_EMAIL_FROM: 'E-mail remetente de acesso',
  STRIPE_SECRET_KEY: 'Chave secreta Stripe',
  STRIPE_WEBHOOK_SECRET: 'Segredo do webhook Stripe',
  CLOUDFLARE_API_TOKEN: 'Token Cloudflare para domínios',
  CLOUDFLARE_ANALYTICS_TOKEN: 'Token Cloudflare para métricas',
  AI_MODEL: 'Modelo do Workers AI',
  PRIVACY_CONTROLLER_NAME: 'Responsável pelo Vira',
  PRIVACY_CONTACT_EMAIL: 'E-mail de privacidade',
  PRIVACY_POLICY: 'Política de Privacidade (PT)',
  PRIVACY_POLICY_EN: 'Privacy Policy (EN)',
  TERMS_OF_USE: 'Termos de Uso (PT)',
  TERMS_OF_USE_EN: 'Terms of Use (EN)',
  CONTACT_EMAIL: 'E-mail de contato',
  SOCIAL_INSTAGRAM: 'Instagram (link ou @usuario)',
  SOCIAL_X: 'X / Twitter (link ou @usuario)',
  SOCIAL_FACEBOOK: 'Facebook (link ou página)',
  SOCIAL_YOUTUBE: 'YouTube (link ou @canal)',
  SOCIAL_LINKEDIN: 'LinkedIn (link ou empresa)',
  SOCIAL_TIKTOK: 'TikTok (link ou @usuario)',
  SOCIAL_WHATSAPP: 'WhatsApp (link ou número)',
  FOOTER_CREATOR: 'Criador (aparece abaixo da logo)',
  FOOTER_COPYRIGHT: 'Copyright (abaixo da logo; use {year} para o ano)',
};
const longTextKeys = new Set([
  'PRIVACY_POLICY',
  'PRIVACY_POLICY_EN',
  'TERMS_OF_USE',
  'TERMS_OF_USE_EN',
]);
const planName: Record<string, string> = {
  monthly: 'Mensal',
  yearly: 'Anual',
};
const planLabels: Record<string, string> = {
  trial: 'Teste',
  monthly: 'Mensal',
  yearly: 'Anual',
  expired: 'Expirado',
};
const sectionMeta: Record<string, { crumb: string; title: string }> = {
  visao: { crumb: 'Visão geral', title: 'Painel do Vira' },
  configuracoes: { crumb: 'Configurações', title: 'Configurações' },
  emails: { crumb: 'E-mails', title: 'E-mails automáticos' },
  usuarios: { crumb: 'Usuários', title: 'Usuários' },
  logs: { crumb: 'Logs', title: 'Logs' },
};
const meta = sectionMeta[section] ?? { crumb: section, title: section };
const date = (time: number | null) =>
  time ? new Date(time * 1000).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : '—';
const dateTime = (time: number | null) =>
  time ? new Date(time * 1000).toLocaleString('pt-BR', { timeZone: 'UTC', hour12: false }) : '—';
const logKindLabels: Record<string, string> = {
  auth: 'Acesso',
  admin: 'Admin',
  billing: 'Cobrança',
  site: 'Site',
  domain: 'Domínio',
  security: 'Segurança',
  system: 'Sistema',
};
const logKindOptions = Object.entries(logKindLabels).map(([key, label]) => ({ key, label }));
const severityLabel: Record<string, string> = {
  info: 'Info',
  warning: 'Atenção',
  critical: 'Crítico',
};
const severityClass: Record<string, string> = {
  info: 'badge-outline border-[#d8ae73] text-[#6f4716]',
  warning: 'badge-outline border-[#d9a13b] text-[#8a5a12]',
  critical: 'badge-outline border-[#c98b8b] text-[#a13a3a]',
};
const actionLabels: Record<string, string> = {
  login: 'Entrou',
  signup: 'Criou a conta',
  logout: 'Saiu',
  login_failed: 'Falha de acesso',
  login_denied: 'Acesso negado',
  password_set: 'Definiu a senha',
  update_setting: 'Configuração alterada',
  clear_setting: 'Configuração limpa',
  update_price: 'Preço alterado',
  update_email_template: 'Modelo de e-mail alterado',
  update_profile: 'Perfil alterado',
  checkout_started: 'Compra iniciada',
  checkout_completed: 'Compra concluída',
  subscription_updated: 'Assinatura atualizada',
  subscription_expired: 'Assinatura encerrada',
  webhook_rejected: 'Webhook rejeitado',
  domain_connected: 'Domínio conectado',
  domain_updated: 'Domínio atualizado',
  user_update: 'Usuário alterado',
  user_create: 'Usuário criado',
  error: 'Erro',
};
const actionLabel = (action: string) => actionLabels[action] ?? action;
const emailLabels: Record<string, string> = {
  login: 'Código de acesso',
  site_created: 'Site criado',
  subscription_created: 'Assinatura confirmada',
  subscription_ending: 'Término próximo',
  security_alert: 'Alerta de segurança',
};
const emailDescriptions: Record<string, string> = {
  login:
    'Enviado quando o cliente pede um código para entrar ou criar uma senha. Sem ele, o acesso por código fica indisponível.',
  site_created: 'Enviado uma vez, assim que a conta é criada e o site inicial entra no ar.',
  subscription_created: 'Enviado após a Stripe confirmar o plano mensal ou anual.',
  subscription_ending:
    'Enviado cerca de 12 horas antes do fim do teste ou até 7 dias antes de uma assinatura com cancelamento agendado.',
  security_alert:
    'Enviado aos administradores quando ocorre um evento crítico de segurança (acesso administrativo negado, webhook rejeitado, falhas críticas).',
};
const emailVariables: Record<string, string[]> = {
  login: ['login_code', 'email'],
  site_created: ['dashboard_url', 'site_url', 'end_date_pt', 'end_date_en', 'email'],
  subscription_created: ['dashboard_url', 'site_url', 'plan_pt', 'plan_en', 'email'],
  security_alert: ['when', 'action', 'kind', 'severity', 'actor', 'target', 'ip', 'logs_url'],
  subscription_ending: [
    'dashboard_url',
    'site_url',
    'plan_pt',
    'plan_en',
    'end_date_pt',
    'end_date_en',
    'email',
  ],
};
const deliveryStatus: Record<string, string> = {
  pending: 'Aguardando',
  sending: 'Enviando',
  sent: 'Enviado',
  failed: 'Falhou',
  suppressed: 'Desativado',
};
---

<Base
  title={`${section === 'visao' ? 'Administração' : navigation.find((item) => item.key === section)?.label} · Vira`}
  noindex
  appearance="light"
  manifest="/admin/manifest.webmanifest"
>
  <div class="min-h-screen bg-white text-[#17130d]">
    <AdminHeader section={section} admin={admin} />
    <main
      data-mobile-stack
      class="panel mx-auto min-w-0 max-w-[1380px] px-5 pt-8 pb-24 sm:px-8 [&_code]:break-all [&_table]:text-sm [&_thead]:bg-[#fff9ef] [&_th]:font-semibold [&_th]:text-[#6f4716] [&_tbody_tr:hover]:bg-[#fffaf2]"
    >
      <nav class="mb-1 text-xs text-[#9b6823]" aria-label="Trilha de navegação">
        <a href="/admin" class="hover:underline">
          Administração
        </a>
        <span aria-hidden="true"> / </span>
        <span class="font-semibold">{meta.crumb}</span>
      </nav>
      <h1 class="mb-6 font-[Outfit] text-2xl font-medium tracking-[-0.02em] text-[#17130d]">
        {meta.title}
      </h1>

      {section === 'visao' && (
        <section id="visao" class="scroll-mt-24">
          <form method="get" data-filter-form class="mb-8">
            <label class="flex w-full max-w-[440px] flex-col gap-1 text-sm">
              <span class="text-[#625a51]">Cliente</span>
              <select name="q" class="select select-bordered w-full rounded-lg">
                <option value="">Todos os clientes</option>
                {clients.map((client) => (
                  <option value={client.slug} selected={client.slug === search}>
                    {client.slug}
                    {client.email ? ` — ${client.email}` : ''}
                  </option>
                ))}
              </select>
            </label>
          </form>

          {clientDetail?.found && (
            <div class="mb-8 rounded-2xl border border-[#ead8bd] bg-white p-6">
              <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h2 class="font-[Outfit] text-2xl">{clientDetail.account.slug}</h2>
                  <p class="text-sm text-[#625a51]">
                    {clientDetail.account.email ?? 'Conta antiga'}
                  </p>
                </div>
                <span class="badge badge-outline border-[#d8ae73] text-[#6f4716]">
                  {planLabels[clientDetail.account.plan] ?? clientDetail.account.plan}
                </span>
              </div>

              <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
                {[
                  { value: clientDetail.account.active_sessions, label: 'Sessões ativas' },
                  { value: clientDetail.account.media, label: 'Arquivos' },
                  { value: clientDetail.domains.length, label: 'Domínios' },
                  { value: clientDetail.assistant.conversations, label: 'Conversas (IA)' },
                  { value: clientDetail.assistant.messages, label: 'Mensagens (IA)' },
                  { value: clientEmailCounts.sent ?? 0, label: 'E-mails enviados' },
                  { value: clientEmailCounts.failed ?? 0, label: 'Falhas de e-mail' },
                  { value: clientDetail.consents.length, label: 'Consentimentos' },
                ].map((item) => (
                  <div class="rounded-xl border border-[#ead8bd] bg-[#fcfaf6] p-4">
                    <strong class="block font-[Outfit] text-2xl font-medium tabular-nums text-[#b88333]">
                      {item.value}
                    </strong>
                    <span class="text-xs text-[#625a51]">{item.label}</span>
                  </div>
                ))}
              </div>

              <div class="mb-6">
                <h3 class="mb-3 font-[Outfit] text-lg">Métricas do site</h3>
                <div
                  data-site-metrics
                  data-site={clientDetail.account.slug}
                  data-variant="admin"
                  data-days="30"
                ></div>
              </div>

              <dl class="grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2 [&_dd]:font-medium [&_dt]:text-[#625a51]">
                <dt>Cadastro</dt>
                <dd>{dateTime(clientDetail.account.created_at)}</dd>
                <dt>Página publicada</dt>
                <dd>
                  {clientDetail.account.published_at
                    ? `Sim · ${date(clientDetail.account.published_at)}`
                    : 'Rascunho'}
                </dd>
                <dt>Teste até</dt>
                <dd>{date(clientDetail.account.trial_ends_at)}</dd>
                <dt>Acesso até</dt>
                <dd>{date(clientDetail.account.access_until)}</dd>
                <dt>Encerrado em</dt>
                <dd>{date(clientDetail.account.expired_at)}</dd>
                <dt>Google vinculado</dt>
                <dd>{clientDetail.account.google_sub ? 'Sim' : 'Não'}</dd>
                <dt>Cliente Stripe</dt>
                <dd>
                  <code>{clientDetail.account.stripe_customer_id ?? '—'}</code>
                </dd>
                <dt>Assinatura Stripe</dt>
                <dd>
                  <code>{clientDetail.account.stripe_subscription_id ?? '—'}</code>
                </dd>
              </dl>

              {clientDetail.domains.length > 0 && (
                <div class="mt-6">
                  <h3 class="mb-2 font-[Outfit] text-lg">Domínios</h3>
                  <div class="overflow-x-auto rounded-xl border border-[#ead8bd] [&_td]:whitespace-nowrap">
                    <table class="table min-w-[560px]">
                      <thead>
                        <tr>
                          <th>Domínio</th>
                          <th>Status</th>
                          <th>TLS</th>
                          <th>Adicionado</th>
                        </tr>
                      </thead>
                      <tbody>
                        {clientDetail.domains.map((row) => (
                          <tr>
                            <td>{row.hostname}</td>
                            <td>{row.status}</td>
                            <td>{row.ssl_status}</td>
                            <td>{date(row.created_at)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              <div class="mt-6 grid gap-6 lg:grid-cols-2">
                <div>
                  <h3 class="mb-2 font-[Outfit] text-lg">E-mails recentes</h3>
                  {clientDetail.emails.length > 0 ? (
                    <ul class="space-y-1 text-sm text-[#625a51]">
                      {clientDetail.emails.map((row) => (
                        <li class="flex items-center justify-between gap-3">
                          <span>{emailLabels[row.template_key] ?? row.template_key}</span>
                          <span>
                            {deliveryStatus[row.status] ?? row.status} · {date(row.created_at)}
                          </span>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="text-sm text-[#625a51]">Nenhum e-mail registrado.</p>
                  )}
                </div>
                <div>
                  <h3 class="mb-2 font-[Outfit] text-lg">Consentimentos</h3>
                  {clientDetail.consents.length > 0 ? (
                    <ul class="space-y-1 text-sm text-[#625a51]">
                      {clientDetail.consents.map((row) => (
                        <li class="flex items-center justify-between gap-3">
                          <span>{consentLabels[row.kind] ?? row.kind}</span>
                          <span>{dateTime(row.created_at)}</span>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="text-sm text-[#625a51]">Nenhum consentimento.</p>
                  )}
                </div>
              </div>

              <div class="mt-6">
                <h3 class="mb-2 font-[Outfit] text-lg">Logs do cliente</h3>
                <div class="overflow-x-auto rounded-xl border border-[#ead8bd] [&_td]:whitespace-nowrap">
                  <table class="table min-w-[560px]">
                    <thead>
                      <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Ação</th>
                        <th>Alvo</th>
                        <th>IP</th>
                      </tr>
                    </thead>
                    <tbody>
                      {clientDetail.logs.map((row) => (
                        <tr>
                          <td>{dateTime(row.created_at)}</td>
                          <td>{logKindLabels[row.kind] ?? row.kind}</td>
                          <td>{actionLabel(row.action)}</td>
                          <td>
                            <code>{row.target ?? '—'}</code>
                          </td>
                          <td>
                            <code>{row.ip ?? '—'}</code>
                          </td>
                        </tr>
