                    data-user-form
                    data-type="user"
                    data-id={person.id}
                    class="mt-4 grid gap-4 sm:grid-cols-2"
                  >
                    <label class="flex flex-col gap-1 text-sm sm:col-span-2">
                      <span class="font-semibold text-[#17130d]">E-mail</span>
                      <input
                        class="input input-bordered w-full"
                        name="email"
                        type="email"
                        value={person.email}
                      />
                    </label>
                    <label class="flex flex-col gap-1 text-sm">
                      <span class="font-semibold text-[#17130d]">Plano</span>
                      <select class="select select-bordered w-full" name="plan">
                        {['trial', 'monthly', 'yearly', 'expired'].map((plan) => (
                          <option value={plan} selected={person.plan === plan}>
                            {planLabels[plan] ?? plan}
                          </option>
                        ))}
                      </select>
                    </label>
                    <label class="flex flex-col gap-1 text-sm">
                      <span class="font-semibold text-[#17130d]">Teste até</span>
                      <input
                        class="input input-bordered w-full"
                        name="trial_ends_at"
                        type="date"
                        value={dateInput(person.trial_ends_at)}
                      />
                    </label>
                    <label class="flex flex-col gap-1 text-sm">
                      <span class="font-semibold text-[#17130d]">Acesso até</span>
                      <input
                        class="input input-bordered w-full"
                        name="access_until"
                        type="date"
                        value={dateInput(person.access_until)}
                      />
                    </label>
                    <label class="flex flex-col gap-1 text-sm">
                      <span class="font-semibold text-[#17130d]">Encerrado em</span>
                      <input
                        class="input input-bordered w-full"
                        name="expired_at"
                        type="date"
                        value={dateInput(person.expired_at)}
                      />
                    </label>
                    <div class="modal-action sm:col-span-2">
                      <button class="btn btn-primary" type="submit">
                        Salvar
                      </button>
                    </div>
                  </form>
                )}
              </div>
              <form method="dialog" class="modal-backdrop">
                <button>fechar</button>
              </form>
            </dialog>
          ))}

          <dialog id="user-create-modal" class="modal">
            <div class="relative modal-box max-w-lg">
              <button
                class="btn btn-ghost btn-circle btn-sm absolute top-4 right-4 text-[#625a51] transition-colors hover:text-[#9b6823]"
                type="button"
                data-user-create-close
                aria-label="Fechar"
              >
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 6l12 12M18 6 6 18"></path>
                </svg>
              </button>
              <h3 class="pr-10 font-[Outfit] text-xl">Novo usuário</h3>
              <p class="mt-1 text-sm text-[#625a51]">
                Crie um cliente ou um administrador. O acesso é feito por e-mail (código ou Google).
              </p>
              <form data-user-create-form class="mt-4 grid gap-4 sm:grid-cols-2">
                <label class="flex flex-col gap-1 text-sm sm:col-span-2">
                  <span class="font-semibold text-[#17130d]">Tipo</span>
                  <select class="select select-bordered w-full" name="type" data-user-create-type>
                    <option value="user" selected>
                      Cliente
                    </option>
                    <option value="admin">Administrador</option>
                  </select>
                </label>
                <label class="flex flex-col gap-1 text-sm sm:col-span-2">
                  <span class="font-semibold text-[#17130d]">E-mail</span>
                  <input
                    class="input input-bordered w-full"
                    name="email"
                    type="email"
                    maxlength="320"
                    required
                  />
                </label>
                <label class="flex flex-col gap-1 text-sm sm:col-span-2">
                  <span class="font-semibold text-[#17130d]">
                    Nome de exibição
                    <span class="font-normal text-[#8b8174]">(opcional)</span>
                  </span>
                  <input
                    class="input input-bordered w-full"
                    name="displayName"
                    type="text"
                    maxlength="80"
                  />
                </label>
                <div class="grid gap-4 sm:col-span-2 sm:grid-cols-2" data-user-create-customer>
                  <label class="flex flex-col gap-1 text-sm">
                    <span class="font-semibold text-[#17130d]">Plano</span>
                    <select class="select select-bordered w-full" name="plan">
                      {['trial', 'monthly', 'yearly', 'expired'].map((plan) => (
                        <option value={plan}>{planLabels[plan] ?? plan}</option>
                      ))}
                    </select>
                  </label>
                  <label class="flex flex-col gap-1 text-sm">
                    <span class="font-semibold text-[#17130d]">Teste até</span>
                    <input class="input input-bordered w-full" name="trial_ends_at" type="date" />
                  </label>
                  <label class="flex flex-col gap-1 text-sm">
                    <span class="font-semibold text-[#17130d]">Acesso até</span>
                    <input class="input input-bordered w-full" name="access_until" type="date" />
                  </label>
                  <label class="flex flex-col gap-1 text-sm">
                    <span class="font-semibold text-[#17130d]">Encerrado em</span>
                    <input class="input input-bordered w-full" name="expired_at" type="date" />
                  </label>
                </div>
                <div class="modal-action sm:col-span-2">
                  <button class="btn btn-primary" type="submit">
                    Criar usuário
                  </button>
                </div>
              </form>
            </div>
            <form method="dialog" class="modal-backdrop">
              <button>fechar</button>
            </form>
          </dialog>

          <Pager
            page={page}
            pages={pages}
            total={total}
            size={size}
            base="/admin/usuarios"
            query={{ q: search, role: roleFilter }}
          />
        </section>
      )}
      {section === 'logs' && (
        <section id="logs" class="scroll-mt-24">
          <form
            method="get"
            data-filter-form
            class="mb-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-end"
          >
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[#625a51]">Tipo</span>
              <select name="kind" class="select select-bordered w-full rounded-lg sm:w-auto">
                <option value="" selected={!logFilters.kind}>
                  Todos
                </option>
                {logKindOptions.map((option) => (
                  <option value={option.key} selected={logFilters.kind === option.key}>
                    {option.label}
                  </option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[#625a51]">Nível</span>
              <select name="level" class="select select-bordered w-full rounded-lg sm:w-auto">
                <option value="" selected={!logFilters.level}>
                  Todos
                </option>
                {['info', 'warning', 'critical'].map((level) => (
                  <option value={level} selected={logFilters.level === level}>
                    {severityLabel[level]}
                  </option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[#625a51]">Buscar</span>
              <input
                class="input input-bordered w-full rounded-lg sm:w-72"
                name="q"
                type="search"
                value={search}
                placeholder="Ator, alvo, ação, IP..."
                maxlength="80"
              />
            </label>
            {(logFilters.kind || logFilters.level || search) && (
              <a href="/admin/logs" class="btn btn-ghost rounded-lg">
                Limpar
              </a>
            )}
            <a
              href={`/api/admin/logs/export?kind=${encodeURIComponent(logFilters.kind)}&level=${encodeURIComponent(logFilters.level)}&q=${encodeURIComponent(search)}`}
              class="btn btn-outline rounded-lg"
            >
              Exportar CSV
            </a>
          </form>
          <div class="overflow-x-auto rounded-xl border border-[#ead8bd] [&_td]:whitespace-nowrap">
            <table class="table w-full min-w-[920px]">
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Nível</th>
                  <th>Tipo</th>
                  <th>Ator</th>
                  <th>Ação</th>
                  <th>Alvo</th>
                  <th>IP</th>
                </tr>
              </thead>
              <tbody>
                {logs.map((item) => (
                  <tr>
                    <td>{dateTime(item.created_at)}</td>
                    <td>
                      <span class:list={['badge badge-sm', severityClass[item.severity]]}>
                        {severityLabel[item.severity] ?? item.severity}
                      </span>
                    </td>
                    <td>{logKindLabels[item.kind] ?? item.kind}</td>
                    <td>{item.actor_id ?? item.actor_type ?? '—'}</td>
                    <td>{actionLabel(item.action)}</td>
                    <td>
                      <code>{item.target ?? '—'}</code>
                    </td>
                    <td>
                      <code>{item.ip ?? '—'}</code>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {logs.length === 0 && (
              <p class="py-4 text-sm text-[#625a51]">Nenhum registro para este filtro.</p>
            )}
          </div>
          <Pager
            page={page}
            pages={pages}
            total={total}
            size={size}
            base="/admin/logs"
            query={{
              kind: logFilters.kind,
              level: logFilters.level,
              q: search,
            }}
          />
        </section>
      )}
    </main>
  </div>
  <ResponsiveTables />
  <script>
    import '@frontend/pages/_scripts/account-menu';
    import { updateSetting } from '@frontend/api/admin/update-setting';
    import { updatePrice } from '@frontend/api/admin/update-price';
    import { updateEmailTemplate } from '@frontend/api/admin/update-email-template';
    import { updateUser } from '@frontend/api/admin/update-user';
    import { initSiteMetrics } from '@frontend/pages/_scripts/site-metrics';
    import { reportError } from '@frontend/components/toast';
    document.addEventListener('astro:page-load', () => {
      initSiteMetrics();
      const debounce = (fn: () => void, ms: number) => {
        let timer = 0;
        return () => {
          window.clearTimeout(timer);
          timer = window.setTimeout(fn, ms);
        };
      };
      document.querySelectorAll<HTMLFormElement>('[data-filter-form]').forEach((form) => {
        form
          .querySelectorAll<HTMLSelectElement>('select')
          .forEach((select) => select.addEventListener('change', () => form.requestSubmit()));
        form.querySelectorAll<HTMLInputElement>('input').forEach((input) =>
          input.addEventListener(
            'input',
            debounce(() => form.requestSubmit(), 450),
          ),
        );
      });
      const settingsForm = document.getElementById('settings-form') as HTMLFormElement | null;
      settingsForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = settingsForm.querySelector<HTMLButtonElement>('button[type=submit]');
        const status = settingsForm.querySelector<HTMLElement>('[data-save-status]');
        if (button) button.disabled = true;
        let saved = 0;
        const failed: string[] = [];
        for (const input of settingsForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          '[data-setting-input]',
        )) {
          const key = input.dataset.key || '';
          const secret = input.dataset.secret === 'true';
          const initial = input.dataset.initial ?? '';
          const value = input.value;
          if (secret ? !value.trim() : value === initial) continue;
          try {
            await updateSetting(key, value);
            input.dataset.initial = secret ? '' : value;
            if (secret) input.value = '';
            saved += 1;
            const badge = input
              .closest('label')
              ?.querySelector<HTMLElement>('[data-api-config-state]');
            if (badge && value.trim()) {
              badge.className = 'badge badge-sm badge-outline border-[#d8ae73] text-[#6f4716]';
              badge.textContent = 'Configurado';
            }
          } catch (error) {
            failed.push(key);
            reportError(error, 'Falha ao salvar');
          }
        }
        if (status) {
          status.textContent = failed.length
            ? `Não foi possível salvar: ${failed.join(', ')}`
            : saved
              ? 'Alterações salvas.'
              : 'Nada para salvar.';
        }
        if (button) button.disabled = false;
      });
      document.querySelectorAll<HTMLButtonElement>('[data-user-open]').forEach((button) =>
        button.addEventListener('click', () => {
          const dialog = document.getElementById(
            `user-modal-${button.dataset.userOpen}`,
          ) as HTMLDialogElement | null;
          dialog?.showModal();
        }),
      );
      document
        .querySelectorAll<HTMLButtonElement>('[data-user-close]')
        .forEach((button) =>
          button.addEventListener('click', () =>
            (button.closest('dialog') as HTMLDialogElement | null)?.close(),
          ),
        );
      document.querySelectorAll<HTMLFormElement>('[data-user-form]').forEach((form) =>
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
          const status = form.querySelector<HTMLElement>('[data-user-status]');
          if (button) button.disabled = true;
          const field = (name: string) =>
            (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value ??
            '';
          try {
            await updateUser(
              form.dataset.type === 'admin'
                ? {
                    type: 'admin',
                    email: form.dataset.email,
                    displayName: field('displayName'),
                  }
                : {
                    type: 'user',
                    id: form.dataset.id,
                    email: field('email'),
                    plan: field('plan'),
                    trial_ends_at: field('trial_ends_at'),
                    access_until: field('access_until'),
                    expired_at: field('expired_at'),
                  },
            );
            if (status) status.textContent = 'Salvo.';
            window.location.reload();
          } catch (error) {
            reportError(error, 'Falha ao salvar');
            if (button) button.disabled = false;
          }
        }),
      );
      const createDialog = document.getElementById('user-create-modal') as HTMLDialogElement | null;
      const createForm = document.querySelector<HTMLFormElement>('[data-user-create-form]');
      if (createDialog && createForm) {
        const customerFields = createForm.querySelector<HTMLElement>('[data-user-create-customer]');
        const typeSelect = createForm.querySelector<HTMLSelectElement>('[data-user-create-type]');
        const iso = (date: Date) => date.toISOString().slice(0, 10);
        const setDate = (name: string, value: string) => {
          const hidden = createForm.elements.namedItem(name) as HTMLInputElement | null;
          if (!hidden || hidden.value) return;
          hidden.value = value;
          const visible = hidden.previousElementSibling as HTMLInputElement | null;
          if (visible?.dataset.datePicker === 'ready') {
            const [year, month, day] = value.split('-');
            visible.value = `${day}/${month}/${year}`;
          }
        };
        const syncType = () =>
          customerFields?.classList.toggle('hidden', typeSelect?.value === 'admin');
        typeSelect?.addEventListener('change', syncType);
        document.querySelectorAll<HTMLButtonElement>('[data-user-create-open]').forEach((button) =>
          button.addEventListener('click', () => {
            const now = new Date();
            const plus = (days: number) => {
              const date = new Date(now);
              date.setDate(date.getDate() + days);
              return iso(date);
            };
            setDate('trial_ends_at', plus(1));
            setDate('access_until', plus(30));
            syncType();
            createDialog.showModal();
          }),
        );
        document
          .querySelectorAll<HTMLButtonElement>('[data-user-create-close]')
          .forEach((button) => button.addEventListener('click', () => createDialog.close()));
        createForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          const button = createForm.querySelector<HTMLButtonElement>('button[type=submit]');
          if (button) button.disabled = true;
          const field = (name: string) =>
            (createForm.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)
              ?.value ?? '';
          const type = field('type') === 'admin' ? 'admin' : 'user';
          try {
            await updateUser(
              type === 'admin'
                ? {
                    mode: 'create',
                    type: 'admin',
                    email: field('email'),
                    displayName: field('displayName'),
                  }
                : {
                    mode: 'create',
                    type: 'user',
                    email: field('email'),
                    displayName: field('displayName'),
                    plan: field('plan'),
                    trial_ends_at: field('trial_ends_at'),
                    access_until: field('access_until'),
                    expired_at: field('expired_at'),
                  },
            );
            window.location.reload();
          } catch (error) {
            reportError(error, 'Falha ao criar');
            if (button) button.disabled = false;
          }
        });
      }
      const pricesForm = document.getElementById('prices-form') as HTMLFormElement | null;
      pricesForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = pricesForm.querySelector<HTMLButtonElement>('button[type=submit]');
        const status = pricesForm.querySelector<HTMLElement>('[data-price-status]');
        if (button) button.disabled = true;
        let saved = 0;
        const failed: string[] = [];
        for (const row of pricesForm.querySelectorAll<HTMLElement>('[data-price-row]')) {
          const amountRaw = (
            row.querySelector<HTMLInputElement>('[data-price-amount]')?.value ?? ''
          ).trim();
          const priceId = (
            row.querySelector<HTMLInputElement>('[data-price-id]')?.value ?? ''
          ).trim();
          const active = Boolean(
            row.querySelector<HTMLInputElement>('[data-price-active]')?.checked,
          );
          if (
            amountRaw === (row.dataset.initialAmount ?? '') &&
            priceId === (row.dataset.initialPrice ?? '') &&
            String(active ? '1' : '0') === (row.dataset.initialActive ?? '0')
          )
            continue;
          const amount = Number(amountRaw);
          if (amountRaw !== '' && (!Number.isFinite(amount) || !Number.isInteger(amount * 100))) {
            failed.push(`${row.dataset.plan}:${row.dataset.currency}`);
            reportError(
              new Error('Informe um valor com até duas casas decimais.'),
              'Falha ao salvar',
            );
            continue;
          }
          try {
            await updatePrice({
              plan: row.dataset.plan,
              currency: row.dataset.currency,
              amount_minor: amountRaw === '' ? 0 : Math.round(amount * 100),
              stripe_price_id: priceId,
              active,
            });
            row.dataset.initialAmount = amountRaw;
            row.dataset.initialPrice = priceId;
            row.dataset.initialActive = active ? '1' : '0';
            saved += 1;
          } catch (error) {
            failed.push(`${row.dataset.plan}:${row.dataset.currency}`);
            reportError(error, 'Falha ao salvar');
          }
        }
        if (status) {
          status.textContent = failed.length
            ? `Não foi possível salvar: ${failed.join(', ')}`
            : saved
              ? 'Alterações salvas.'
              : 'Nada para salvar.';
        }
        if (button) button.disabled = false;
      });
      const emailSamples: Record<string, string> = {
        login_code: '123456',
        dashboard_url: 'https://vira.ia.br/app',
        site_url: 'https://meu-site.vira.ia.br',
        end_date: '27 de setembro de 2026',
        end_date_pt: '27 de setembro de 2026',
        end_date_en: 'September 27, 2026',
        plan: 'mensal',
        plan_pt: 'mensal',
        plan_en: 'monthly',
        email: 'cliente@exemplo.com',
        when: new Date().toISOString(),
        action: 'login_denied',
        kind: 'security',
        severity: 'warning',
        actor: 'intruso@exemplo.com',
        target: 'admin@vira.ia.br',
        ip: '203.0.113.4',
        logs_url: 'https://vira.ia.br/admin/logs',
      };
      const renderEmailPreview = (form: HTMLFormElement) => {
        const frame = form.querySelector<HTMLIFrameElement>('[data-email-preview]');
        const textarea = form.querySelector<HTMLTextAreaElement>('[data-email-html]');
        if (!frame || !textarea) return;
        frame.srcdoc = textarea.value.replace(
          /{{\s*([a-z_]+)\s*}}/g,
          (_, name: string) => emailSamples[name] ?? '',
        );
      };
      document.querySelectorAll<HTMLButtonElement>('[data-email-open]').forEach((button) =>
        button.addEventListener('click', () => {
          const dialog = document.getElementById(
            `email-modal-${button.dataset.emailOpen}`,
          ) as HTMLDialogElement | null;
          const form = dialog?.querySelector<HTMLFormElement>('[data-api-email-template-form]');
          if (form) renderEmailPreview(form);
          dialog?.showModal();
        }),
      );
      document
        .querySelectorAll<HTMLButtonElement>('[data-email-close]')
        .forEach((button) =>
          button.addEventListener('click', () =>
            (button.closest('dialog') as HTMLDialogElement | null)?.close(),
          ),
        );
      document
        .querySelectorAll<HTMLFormElement>('[data-api-email-template-form]')
        .forEach((form) => {
          const textarea = form.querySelector<HTMLTextAreaElement>('[data-email-html]');
          let previewTimer: ReturnType<typeof setTimeout>;
          textarea?.addEventListener('input', () => {
            clearTimeout(previewTimer);
            previewTimer = setTimeout(() => renderEmailPreview(form), 200);
          });
          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
            if (button) button.disabled = true;
            try {
              const enabled = form.querySelector<HTMLInputElement>('[name=enabled]')!.checked;
              const subject = form.querySelector<HTMLInputElement>('[name=subject]')!.value;
              await updateEmailTemplate({
                key: form.dataset.key || '',
                enabled,
                subject,
                html: form.querySelector<HTMLTextAreaElement>('[name=html]')!.value,
              });
              const row = document.querySelector<HTMLElement>(
                `[data-email-row="${form.dataset.key}"]`,
              );
              const badge = row?.querySelector<HTMLElement>('[data-email-state]');
              if (badge) {
                badge.className = `badge badge-sm badge-outline ${enabled ? 'border-[#d8ae73] text-[#6f4716]' : 'border-[#c8c4bd] text-[#625a51]'}`;
                badge.textContent = enabled ? 'Ativo' : 'Desativado';
              }
              const subjectCell = row?.querySelector<HTMLElement>('[data-email-subject]');
              if (subjectCell) {
                subjectCell.textContent = subject;
                subjectCell.title = subject;
              }
              (form.closest('dialog') as HTMLDialogElement | null)?.close();
            } catch (error) {
              reportError(error, 'Falha ao salvar');
            } finally {
              if (button) button.disabled = false;
            }
          });
        });
    });
  </script>
</Base>
