                              <input
                                class="input input-bordered"
                                name="expired_at"
                                type="date"
                                value={dateInput(person.expiredAt)}
                              />
                            </label>
                            <button class="btn btn-primary" type="submit">
                              Salvar
                            </button>
                            <span class="text-sm text-[#625a51]" data-user-status></span>
                          </form>
                        )}
                      </td>
                    </tr>
                  </>
                ))}
              </tbody>
            </table>
            {peopleFiltered.length === 0 && (
              <p class="my-2 text-[#625a51]">
                {search || roleFilter
                  ? 'Nenhuma conta corresponde ao filtro.'
                  : 'Nenhuma conta ainda.'}
              </p>
            )}
          </div>
        </section>
      )}
      {section === 'dominios' && (
        <section id="dominios" class="mb-16 scroll-mt-24">
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Publicação
            </span>
            <h2>Domínios dos clientes</h2>
            <p>Acompanhe a ativação do hostname e do certificado TLS.</p>
          </div>
          <div class="overflow-x-auto border-y border-[#d8ae73] [&_td]:whitespace-nowrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Domínio</th>
                  <th>Cliente</th>
                  <th>Hostname</th>
                  <th>TLS</th>
                  <th>Adicionado</th>
                </tr>
              </thead>
              <tbody>
                {domains.map((row) => (
                  <tr>
                    <td>{row.hostname}</td>
                    <td>{row.email ?? 'Conta antiga'}</td>
                    <td>{row.status}</td>
                    <td>{row.ssl_status}</td>
                    <td>{date(row.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {domains.length === 0 && (
              <p class="my-2 text-[#625a51]">Nenhum domínio de cliente conectado ainda.</p>
            )}
          </div>
        </section>
      )}
      {section === 'logs' && (
        <section id="logs" class="mb-16 scroll-mt-24">
          <div class="mb-6 [&_h1]:my-1 [&_h1]:text-3xl [&_h1]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Segurança
            </span>
            <h1>Logs</h1>
            <p>Acessos, ações administrativas, cobrança, domínios e eventos de segurança.</p>
          </div>
          <form method="get" class="mb-5 flex flex-wrap items-end gap-3">
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[#625a51]">Tipo</span>
              <select name="kind" class="select select-bordered h-10 rounded-lg">
                <option value="" selected={!logFilters.kind}>
                  Todos
                </option>
                {logKindOptions.map((option) => (
                  <option value={option.key} selected={logFilters.kind === option.key}>
                    {option.label}
                  </option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[#625a51]">Nível</span>
              <select name="level" class="select select-bordered h-10 rounded-lg">
                <option value="" selected={!logFilters.level}>
                  Todos
                </option>
                {['info', 'warning', 'critical'].map((level) => (
                  <option value={level} selected={logFilters.level === level}>
                    {severityLabel[level]}
                  </option>
                ))}
              </select>
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[#625a51]">Ator ou alvo</span>
              <input
                class="input input-bordered h-10 w-56 rounded-lg"
                name="actor"
                type="search"
                value={logFilters.actor}
                placeholder="E-mail, chave..."
                maxlength="80"
              />
            </label>
            <label class="flex flex-col gap-1 text-sm">
              <span class="text-[#625a51]">IP</span>
              <input
                class="input input-bordered h-10 w-44 rounded-lg"
                name="ip"
                type="search"
                value={logFilters.ip}
                placeholder="203.0.113.4"
                maxlength="45"
              />
            </label>
            <button class="btn h-10 rounded-lg border-0 bg-[#17130d] text-white hover:bg-[#2a241b]">
              Filtrar
            </button>
            {(logFilters.kind || logFilters.level || logFilters.actor || logFilters.ip) && (
              <a href="/admin/logs" class="btn btn-ghost h-10 rounded-lg">
                Limpar
              </a>
            )}
            <a
              href={`/api/admin/logs/export?kind=${encodeURIComponent(logFilters.kind)}&level=${encodeURIComponent(logFilters.level)}&actor=${encodeURIComponent(logFilters.actor)}&ip=${encodeURIComponent(logFilters.ip)}`}
              class="btn btn-outline h-10 rounded-lg"
            >
              Exportar CSV
            </a>
          </form>
          <div class="overflow-x-auto border-y border-[#d8ae73] [&_td]:whitespace-nowrap">
            <table class="table w-full min-w-[920px]">
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Nível</th>
                  <th>Tipo</th>
                  <th>Ator</th>
                  <th>Ação</th>
                  <th>Alvo</th>
                  <th>IP</th>
                </tr>
              </thead>
              <tbody>
                {logs.map((item) => (
                  <tr>
                    <td>{dateTime(item.created_at)}</td>
                    <td>
                      <span class:list={['badge badge-sm', severityClass[item.severity]]}>
                        {severityLabel[item.severity] ?? item.severity}
                      </span>
                    </td>
                    <td>{logKindLabels[item.kind] ?? item.kind}</td>
                    <td>{item.actor_id ?? item.actor_type ?? '—'}</td>
                    <td>{actionLabel(item.action)}</td>
                    <td>
                      <code>{item.target ?? '—'}</code>
                    </td>
                    <td>
                      <code>{item.ip ?? '—'}</code>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {logs.length === 0 && (
              <p class="py-4 text-sm text-[#625a51]">Nenhum registro para este filtro.</p>
            )}
          </div>
        </section>
      )}
    </main>
  </div>
  <ResponsiveTables />
  <PreviewStudio id="email-studio" title="Editor interativo de e-mails" />
  <script>
    import '@frontend/pages/_scripts/account-menu';
    import { previewStudio } from '@frontend/pages/_scripts/preview-studio';
    import { updateSetting } from '@frontend/api/admin/update-setting';
    import { updatePrice } from '@frontend/api/admin/update-price';
    import { updateEmailTemplate } from '@frontend/api/admin/update-email-template';
    import { updateUser } from '@frontend/api/admin/update-user';
    import { reportError } from '@frontend/components/toast';
    document
      .querySelectorAll<HTMLSelectElement>('[data-client-filter]')
      .forEach((select) => select.addEventListener('change', () => select.form?.requestSubmit()));
    const settingsForm = document.getElementById('settings-form') as HTMLFormElement | null;
    settingsForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = settingsForm.querySelector<HTMLButtonElement>('button[type=submit]');
      const status = settingsForm.querySelector<HTMLElement>('[data-save-status]');
      if (button) button.disabled = true;
      let saved = 0;
      const failed: string[] = [];
      for (const input of settingsForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        '[data-setting-input]',
      )) {
        const key = input.dataset.key || '';
        const secret = input.dataset.secret === 'true';
        const initial = input.dataset.initial ?? '';
        const value = input.value;
        if (secret ? !value.trim() : value === initial) continue;
        try {
          await updateSetting(key, value);
          input.dataset.initial = secret ? '' : value;
          if (secret) input.value = '';
          saved += 1;
          const badge = input
            .closest('label')
            ?.querySelector<HTMLElement>('[data-api-config-state]');
          if (badge && value.trim()) {
            badge.className = 'badge badge-sm badge-outline border-[#d8ae73] text-[#6f4716]';
            badge.textContent = 'Configurado';
          }
        } catch (error) {
          failed.push(key);
          reportError(error, 'Falha ao salvar');
        }
      }
      if (status) {
        status.textContent = failed.length
          ? `Não foi possível salvar: ${failed.join(', ')}`
          : saved
            ? 'Alterações salvas.'
            : 'Nada para salvar.';
      }
      if (button) button.disabled = false;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-user-toggle]').forEach((button) =>
      button.addEventListener('click', () => {
        const row = document.getElementById(button.getAttribute('aria-controls') || '');
        if (!row) return;
        const opening = row.classList.contains('hidden');
        document
          .querySelectorAll<HTMLElement>('[data-user-editor-row]')
          .forEach((item) => item.classList.add('hidden'));
        document.querySelectorAll<HTMLButtonElement>('[data-user-toggle]').forEach((item) => {
          item.setAttribute('aria-expanded', 'false');
          item.textContent = 'Editar';
        });
        if (opening) {
          row.classList.remove('hidden');
          button.setAttribute('aria-expanded', 'true');
          button.textContent = 'Fechar';
        }
      }),
    );
    document.querySelectorAll<HTMLFormElement>('[data-user-form]').forEach((form) =>
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
        const status = form.querySelector<HTMLElement>('[data-user-status]');
        if (button) button.disabled = true;
        const field = (name: string) =>
          (form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null)?.value ??
          '';
        try {
          await updateUser(
            form.dataset.type === 'admin'
              ? {
                  type: 'admin',
                  email: form.dataset.email,
                  displayName: field('displayName'),
                }
              : {
                  type: 'user',
                  id: form.dataset.id,
                  email: field('email'),
                  plan: field('plan'),
                  trial_ends_at: field('trial_ends_at'),
                  access_until: field('access_until'),
                  expired_at: field('expired_at'),
                },
          );
          if (status) status.textContent = 'Salvo.';
          window.location.reload();
        } catch (error) {
          reportError(error, 'Falha ao salvar');
          if (button) button.disabled = false;
        }
      }),
    );
    const pricesForm = document.getElementById('prices-form') as HTMLFormElement | null;
    pricesForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = pricesForm.querySelector<HTMLButtonElement>('button[type=submit]');
      const status = pricesForm.querySelector<HTMLElement>('[data-price-status]');
      if (button) button.disabled = true;
      let saved = 0;
      const failed: string[] = [];
      for (const row of pricesForm.querySelectorAll<HTMLElement>('[data-price-row]')) {
        const amountRaw = (
          row.querySelector<HTMLInputElement>('[data-price-amount]')?.value ?? ''
        ).trim();
        const priceId = (
          row.querySelector<HTMLInputElement>('[data-price-id]')?.value ?? ''
        ).trim();
        const active = Boolean(row.querySelector<HTMLInputElement>('[data-price-active]')?.checked);
        if (
          amountRaw === (row.dataset.initialAmount ?? '') &&
          priceId === (row.dataset.initialPrice ?? '') &&
          String(active ? '1' : '0') === (row.dataset.initialActive ?? '0')
        )
          continue;
        const amount = Number(amountRaw);
        if (amountRaw !== '' && (!Number.isFinite(amount) || !Number.isInteger(amount * 100))) {
          failed.push(`${row.dataset.plan}:${row.dataset.currency}`);
          reportError(
            new Error('Informe um valor com até duas casas decimais.'),
            'Falha ao salvar',
          );
          continue;
        }
        try {
          await updatePrice({
            plan: row.dataset.plan,
            currency: row.dataset.currency,
            amount_minor: amountRaw === '' ? 0 : Math.round(amount * 100),
            stripe_price_id: priceId,
            active,
          });
          row.dataset.initialAmount = amountRaw;
          row.dataset.initialPrice = priceId;
          row.dataset.initialActive = active ? '1' : '0';
          saved += 1;
        } catch (error) {
          failed.push(`${row.dataset.plan}:${row.dataset.currency}`);
          reportError(error, 'Falha ao salvar');
        }
      }
      if (status) {
        status.textContent = failed.length
          ? `Não foi possível salvar: ${failed.join(', ')}`
          : saved
            ? 'Alterações salvas.'
            : 'Nada para salvar.';
      }
      if (button) button.disabled = false;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-email-toggle]').forEach((button) =>
      button.addEventListener('click', () => {
        const row = document.getElementById(button.getAttribute('aria-controls') || '');
        if (!row) return;
        const opening = row.classList.contains('hidden');
        document
          .querySelectorAll<HTMLElement>('[data-email-editor-row]')
          .forEach((item) => item.classList.add('hidden'));
        document.querySelectorAll<HTMLButtonElement>('[data-email-toggle]').forEach((item) => {
          item.setAttribute('aria-expanded', 'false');
          item.textContent = 'Editar';
        });
        if (opening) {
          row.classList.remove('hidden');
          button.setAttribute('aria-expanded', 'true');
          button.textContent = 'Fechar';
        }
      }),
    );
    const emailStudio = previewStudio('email-studio');
    document.querySelectorAll<HTMLFormElement>('[data-api-email-template-form]').forEach((form) => {
      const frame = form.querySelector<HTMLIFrameElement>('[data-email-preview]')!;
      const originalRow = form.closest('tr');
      const renderPreview = () => {
        const html = form.querySelector<HTMLTextAreaElement>('[name=html]')!.value;
        const samples: Record<string, string> = {
          login_code: '123456',
          dashboard_url: 'https://vira.ia.br/app',
          site_url: 'https://meu-site.vira.ia.br',
          end_date: '27 de setembro de 2026',
          end_date_pt: '27 de setembro de 2026',
          end_date_en: 'September 27, 2026',
          plan: 'mensal',
          plan_pt: 'mensal',
          plan_en: 'monthly',
          email: 'cliente@exemplo.com',
        };
        const preview = html.replace(
          /{{\s*([a-z_]+)\s*}}/g,
          (_, name: string) => samples[name] ?? '',
        );
        frame.srcdoc = preview;
      };
      form.querySelector('[data-email-preview-button]')?.addEventListener('click', () => {
        renderPreview();
        emailStudio.open(frame, form);
      });
      let previewTimer: ReturnType<typeof setTimeout>;
      form.addEventListener('input', () => {
        clearTimeout(previewTimer);
        previewTimer = setTimeout(renderPreview, 250);
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          await updateEmailTemplate({
            key: form.dataset.key || '',
            enabled: form.querySelector<HTMLInputElement>('[name=enabled]')!.checked,
            subject: form.querySelector<HTMLInputElement>('[name=subject]')!.value,
            html: form.querySelector<HTMLTextAreaElement>('[name=html]')!.value,
          });
          const badge = originalRow?.previousElementSibling?.querySelector<HTMLElement>('.badge');
          if (badge) {
            const enabled = form.querySelector<HTMLInputElement>('[name=enabled]')!.checked;
            badge.className = `badge badge-sm badge-outline ${enabled ? 'border-[#d8ae73] text-[#6f4716]' : 'border-[#c8c4bd] text-[#625a51]'}`;
            badge.textContent = enabled ? 'Ativo' : 'Desativado';
          }
          const subject =
            originalRow?.previousElementSibling?.querySelector<HTMLElement>('[data-email-subject]');
          if (subject) {
            subject.textContent = form.querySelector<HTMLInputElement>('[name=subject]')!.value;
            subject.title = subject.textContent;
          }
        } catch (error) {
          reportError(error, 'Falha ao salvar');
        } finally {
          button.disabled = false;
        }
      });
    });
  </script>
</Base>
