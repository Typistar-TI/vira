---
import Base from '@frontend/components/Base.astro';
import SiteHeader from '@frontend/components/SiteHeader.astro';
import CookieNotice from '@frontend/components/CookieNotice.astro';
import SiteFooter from '@frontend/components/SiteFooter.astro';
import { getSetting } from '@frontend/api/config/setting';
import { sessionAdmin } from '@frontend/api/auth/session-admin';
import { sessionUser } from '@frontend/api/auth/session-user';
interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;
const en = lang === 'en';
const [adminSession, userSession] = await Promise.all([
  sessionAdmin(Astro.request),
  sessionUser(Astro.request),
]);
const hasAdmin = Boolean(adminSession);
const hasUser = Boolean(userSession);
const signedIn = hasAdmin || hasUser;
const dashboardHref = hasUser ? '/app' : hasAdmin ? '/admin' : '/login';
const [controller, email, contact, policyPt, policyEn] = await Promise.all([
  getSetting('PRIVACY_CONTROLLER_NAME'),
  getSetting('PRIVACY_CONTACT_EMAIL'),
  getSetting('CONTACT_EMAIL'),
  getSetting('PRIVACY_POLICY'),
  getSetting('PRIVACY_POLICY_EN'),
]);
const policy = en ? policyEn || policyPt : policyPt;
const mail = contact || email;
const ready = Boolean(controller && email);
const custom = policy.trim();
---

<Base
  title={en ? 'Privacy · Vira' : 'Privacidade · Vira'}
  lang={lang}
  noindex={!ready}
  appearance="light"
>
  <div class="min-h-screen bg-white text-[#17130d]">
    <SiteHeader
      lang={lang}
      signedIn={signedIn}
      dashboardHref={dashboardHref}
      hasAdmin={hasAdmin}
      hasUser={hasUser}
    />
    <main class="mx-auto max-w-[1380px] px-5 pb-16 pt-10 sm:px-8">
      <article class="w-full break-words">
        <span class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#17130d]">Vira</span>
        <h1 class="text-4xl mt-2 mb-6">
          {en ? 'Privacy and your data' : 'Privacidade e seus dados'}
        </h1>
        {!ready && (
          <p class="alert alert-error my-3 [hidden]:hidden">
            {en
              ? 'The service owner and privacy contact are not registered yet. This notice is a draft and the service is not ready for public launch.'
              : 'O responsável pelo serviço e o contato de privacidade ainda não foram cadastrados. Este aviso é um rascunho e o serviço não está pronto para lançamento público.'}
          </p>
        )}
        {ready && (
          <p>
            {en ? 'Data controller' : 'Responsável pelo tratamento'}: <strong>{controller}</strong>.{' '}
            {en ? 'Privacy requests' : 'Solicitações de privacidade'}:{' '}
            <a href={`mailto:${mail}`}>{mail}</a>.
          </p>
        )}
        {custom && (
          <div class="mt-6">
            {custom.split(/\n{2,}/).map((paragraph) => (
              <p class="mt-4 whitespace-pre-line leading-relaxed text-[#4f473e]">{paragraph}</p>
            ))}
          </div>
        )}
      </article>
    </main>
    <SiteFooter lang={lang} />
  </div>
  <CookieNotice lang={lang} />
</Base>
