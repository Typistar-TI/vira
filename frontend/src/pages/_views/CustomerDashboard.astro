---
import Base from '@frontend/components/Base.astro';
import CustomerHeader from '@frontend/components/CustomerHeader.astro';
import ImageUpload from '@frontend/components/ImageUpload.astro';
import SectionFields from '@frontend/components/sections/SectionFields.astro';
import { getPublicPrices } from '@frontend/api/billing/public-prices';
import { getRootDomain } from '@frontend/api/config/root-domain';
import { userHasAccess } from '@frontend/api/sites/has-access';
import {
  parseSiteContent,
  blankSection,
  sectionTypes,
  type SectionType,
} from '@frontend/api/sites/parse-site';
import { preferredLanguage } from '@frontend/i18n/preferred-language';
const { user, site, section = 'conteudo' } = Astro.props;
const content = parseSiteContent(JSON.parse(site.draft_json));
const active = userHasAccess(user);
const en = preferredLanguage(Astro.request) === 'en';
const sectionTitles: Record<string, [string, string]> = {
  aparencia: ['Appearance', 'Aparência'],
  identidade: ['Identity and app', 'Identidade e aplicativo'],
  assistente: ['Assistant', 'Assistente'],
  plano: ['Plan and billing', 'Plano e cobrança'],
  dominio: ['Domain', 'Domínio'],
  conta: ['Account and data', 'Conta e dados'],
};
const sectionTitle = sectionTitles[section]?.[en ? 0 : 1] ?? '';
const domain = await getRootDomain();
const accountName = user.display_name || (user.email ?? '').split('@')[0] || 'V';
const accountInitials = accountName
  .split(/[^\p{L}\p{N}]+/u)
  .filter(Boolean)
  .slice(0, 2)
  .map((part: string) => part[0].toLocaleUpperCase('pt-BR'))
  .join('');
const priceRows = section === 'plano' ? await getPublicPrices() : [];
const priceMap = Object.fromEntries(
  priceRows.map((row) => [`${row.plan}_${row.currency}`, row.amount_minor]),
);
const priceReady = Object.fromEntries(
  priceRows.map((row) => [
    `${row.plan}_${row.currency}`,
    row.active === 1 && Boolean(row.stripe_price_id?.startsWith('price_')),
  ]),
);
const priceText = (plan: string) => {
  const amount = priceMap[`${plan}_brl`];
  return amount
    ? new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(amount / 100)
    : en
      ? 'Coming soon'
      : 'Em breve';
};
const t = en
  ? {
      dashboard: 'Your space',
      trial: 'Free trial',
      active: 'Active',
      expired: 'Access expired',
      yourPage: 'Your page',
      publicLink: 'Public address',
      preview: 'Preview',
      desktop: 'Desktop',
      mobile: 'Mobile',
      content: 'Your page',
      style: 'Typography and colors',
      blocks: 'Page blocks',
      addBlock: 'Add block',
      blockTypes: {
        hero: 'Hero',
        about: 'About',
        services: 'Services',
        gallery: 'Gallery',
        stats: 'Numbers',
        steps: 'Steps',
        experience: 'Experience',
        testimonials: 'Testimonials',
        faq: 'FAQ',
        video: 'Video',
        map: 'Map',
        contact: 'Contact',
        footer: 'Footer',
      } as Record<SectionType, string>,
      assistantToggle: 'AI assistant on the published page',
      assistantToggleHint:
        'On by default. It answers visitors using the content you write here. Publish to update what it knows.',
      font: 'Typography',
      language: 'Page language',
      eyebrow: 'Small label',
      snippet: 'Command or code',
      steps: 'How it works',
      faq: 'Frequently asked questions',
      experience: 'Experience',
      links: 'Links and contact',
      gallery: 'Gallery',
      question: 'Question',
      answer: 'Answer',
      role: 'Role',
      company: 'Company',
      period: 'Period',
      location: 'Location',
      summary: 'Summary',
      title: 'Headline',
      subtitle: 'Introduction',
      hero: 'Cover image',
      upload: 'Upload image',
      buttonText: 'Main button text',
      buttonUrl: 'Main button link',
      about: 'About',
      aboutTitle: 'Section heading',
      aboutBody: 'Description',
      benefits: 'Benefits',
      stats: 'Highlight numbers',
      testimonials: 'Testimonials',
      products: 'Catalog',
      footer: 'Footer text',
      add: 'Add',
      remove: 'Remove',
      label: 'Label',
      value: 'Value',
      description: 'Description',
      name: 'Name',
      quote: 'Quote',
      image: 'Image',
      link: 'Link',
      save: 'Save draft',
      publish: 'Publish',
      plans: 'Plan and billing',
      monthly: 'Monthly',
      yearly: 'Yearly',
      portal: 'Manage subscription',
      domain: 'Custom domain',
      domainHint: 'Available after payment. Use an address such as www.example.com.',
      connect: 'Connect domain',
      address: 'Vira subdomain',
      change: 'Change address',
      metrics: 'Last 30 days',
      views: 'Views',
      clicks: 'Button clicks',
      aiAssistant: 'AI assistant',
      aiHint:
        'A chat assistant is included on your published page. It answers visitors using the content you write here. Publish to update what it knows.',
      account: 'Account and data',
      exportData: 'Download my data',
      deleteAccount: 'Delete account',
      confirmEmail: 'Type your email to confirm',
      privacy: 'Privacy',
      terms: 'Terms of Use',
      identity: 'Site identity and app',
      identityHint:
        'These changes appear on your public site after you publish. Visitors can install it on their phones.',
      favicon: 'Browser icon (favicon)',
      logo: 'Project logo',
      logoHint: 'Your logo appears on your page. Allow it in the Vira showcase below if you wish.',
      showcaseConsent: 'Show my published page and logo in the Vira showcase',
      appIcon: 'App icon (PWA)',
      appName: 'Name shown when installed',
      iconHint: 'Choose a square PNG, JPG or WebP image. Vira prepares the sizes for phones.',
      browserColor: 'Browser bar color',
      pageColor: 'Page background',
      textColor: 'Text color',
      accentColor: 'Accent color',
    }
  : {
      dashboard: 'Seu espaço',
      trial: 'Teste grátis',
      active: 'Ativo',
      expired: 'Acesso expirado',
      yourPage: 'Sua página',
      publicLink: 'Endereço público',
      preview: 'Prévia',
      desktop: 'Computador',
      mobile: 'Celular',
      content: 'Sua página',
      style: 'Tipografia e cores',
      blocks: 'Blocos da página',
      addBlock: 'Adicionar bloco',
      blockTypes: {
        hero: 'Herói',
        about: 'Sobre',
        services: 'Serviços',
        gallery: 'Galeria',
        stats: 'Números',
        steps: 'Passos',
        experience: 'Experiência',
        testimonials: 'Depoimentos',
        faq: 'Perguntas frequentes',
        video: 'Vídeo',
        map: 'Mapa',
        contact: 'Contato',
        footer: 'Rodapé',
      } as Record<SectionType, string>,
      assistantToggle: 'Assistente de IA na página publicada',
      assistantToggleHint:
        'Ligada por padrão. Responde aos visitantes com base no conteúdo que você escreve aqui. Publique para atualizar o que ela sabe.',
      font: 'Tipografia',
      language: 'Idioma da página',
      eyebrow: 'Etiqueta curta',
      snippet: 'Comando ou código',
      steps: 'Como funciona',
      faq: 'Perguntas frequentes',
      experience: 'Experiência',
      links: 'Links e contato',
      gallery: 'Galeria',
      question: 'Pergunta',
      answer: 'Resposta',
      role: 'Cargo',
      company: 'Empresa',
      period: 'Período',
      location: 'Local',
      summary: 'Resumo',
      title: 'Título principal',
      subtitle: 'Apresentação',
      hero: 'Imagem de capa',
      upload: 'Enviar imagem',
      buttonText: 'Texto do botão principal',
      buttonUrl: 'Link do botão principal',
      about: 'Sobre',
      aboutTitle: 'Título da seção',
      aboutBody: 'Descrição',
      benefits: 'Benefícios',
      stats: 'Números em destaque',
      testimonials: 'Depoimentos',
      products: 'Catálogo',
      footer: 'Texto do rodapé',
      add: 'Adicionar',
      remove: 'Remover',
      label: 'Legenda',
      value: 'Valor',
      description: 'Descrição',
      name: 'Nome',
      quote: 'Depoimento',
      image: 'Imagem',
      link: 'Link',
      save: 'Salvar rascunho',
      publish: 'Publicar',
      plans: 'Plano e cobrança',
      monthly: 'Mensal',
      yearly: 'Anual',
      portal: 'Gerenciar assinatura',
      domain: 'Domínio próprio',
      domainHint: 'Disponível após o pagamento. Use um endereço como www.exemplo.com.br.',
      connect: 'Conectar domínio',
      address: 'Subdomínio Vira',
      change: 'Alterar endereço',
      metrics: 'Últimos 30 dias',
      views: 'Visualizações',
      clicks: 'Cliques nos botões',
      aiAssistant: 'Assistente de IA',
      aiHint:
        'Um assistente de chat acompanha sua página publicada. Ele responde aos visitantes com base no conteúdo que você escreve aqui. Publique para atualizar o que ele sabe.',
      account: 'Conta e dados',
      exportData: 'Baixar meus dados',
      deleteAccount: 'Excluir conta',
      confirmEmail: 'Digite seu e-mail para confirmar',
      privacy: 'Privacidade',
      terms: 'Termos de Uso',
      identity: 'Identidade do site e aplicativo',
      identityHint:
        'As alterações aparecem no site público depois de publicar. Os visitantes poderão instalá-lo no celular.',
      favicon: 'Ícone do navegador (favicon)',
      logo: 'Logo do projeto',
      logoHint:
        'A logo aparece na sua página. Você pode autorizar a exibição na vitrine do Vira abaixo.',
      showcaseConsent: 'Mostrar minha página publicada e logo na vitrine do Vira',
      appIcon: 'Ícone do aplicativo (PWA)',
      appName: 'Nome mostrado após instalar',
      iconHint:
        'Escolha uma imagem quadrada PNG, JPG ou WebP. O Vira prepara os tamanhos para celular.',
      browserColor: 'Cor da barra do navegador',
      pageColor: 'Fundo da página',
      textColor: 'Cor do texto',
      accentColor: 'Cor de destaque',
    };
const trialDays = Math.max(0, Math.ceil((user.trial_ends_at * 1000 - Date.now()) / 86400000));
const trialLeft = en
  ? `${trialDays} ${trialDays === 1 ? 'day left in your trial' : 'days left in your trial'}`
  : `${trialDays} ${trialDays === 1 ? 'dia restante de teste' : 'dias restantes de teste'}`;
---

<Base
  title={`${t.dashboard} · Vira`}
  lang={en ? 'en' : 'pt'}
  noindex
  appearance="light"
  manifest="/app/manifest.webmanifest"
>
  <div class="min-h-screen bg-white text-[#17130d]">
    <CustomerHeader
      email={user.email ?? (en ? 'Legacy account' : 'Conta antiga')}
      displayName={user.display_name ?? ''}
      avatar={user.avatar}
      en={en}
      section={section}
    />
    <main
      class:list={[
        'customer-dashboard panel mx-auto min-w-0',
        section === 'conteudo'
          ? 'w-full px-3 pb-5 pt-3 sm:px-5'
          : 'max-w-[1380px] px-5 pb-24 pt-8 sm:px-8',
      ]}
    >
      {section === 'conteudo' ? (
        <h1 class="sr-only">{t.dashboard}</h1>
      ) : (
        <>
          <nav
            class="mb-1 text-xs text-[#9b6823]"
            aria-label={en ? 'Breadcrumb' : 'Trilha de navegação'}
          >
            <a href="/app" class="hover:underline">
              {en ? 'Dashboard' : 'Painel'}
            </a>
            <span aria-hidden="true"> / </span>
            <span class="font-semibold">{sectionTitle}</span>
          </nav>
          <h1 class="mb-6 font-[Outfit] text-2xl font-medium tracking-[-0.02em] text-[#17130d]">
            {sectionTitle}
          </h1>
        </>
      )}
      {!active && (
        <div class="alert alert-error my-3 [hidden]:hidden mb-5">
          {en
            ? 'Your page is suspended. Choose a plan to publish it again.'
            : 'Sua página está suspensa. Escolha um plano para publicá-la novamente.'}
        </div>
      )}
      <div>
        {section === 'assistente' && (
          <form
            id="editor"
            class="rounded-2xl border border-[#ead8bd] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-6 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5"
            data-initial={JSON.stringify(content)}
          >
            <label class="flex items-start gap-3 text-sm font-medium text-[#17130d]">
              <input
                class="checkbox checkbox-primary mt-0.5 shrink-0 border border-[#b88333]"
                name="assistant"
                type="checkbox"
                checked={content.assistant}
              />
              <span>{t.assistantToggle}</span>
            </label>
            <small>{t.assistantToggleHint}</small>

            <div class="mt-5">
              <button class="btn btn-primary" type="submit">
                {t.save}
              </button>
            </div>
          </form>
        )}
        {section === 'aparencia' && (
          <form
            id="editor"
            class="rounded-2xl border border-[#ead8bd] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-6 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5"
            data-initial={JSON.stringify(content)}
          >
            <h3>{t.style}</h3>
            <label for="font">{t.font}</label>
            <select class="select select-bordered" name="font" id="font">
              <option value="outfit" selected={content.font === 'outfit'}>
                Outfit
              </option>
              <option value="bricolage" selected={content.font === 'bricolage'}>
                Bricolage Grotesque + Manrope
              </option>
              <option value="inter" selected={content.font === 'inter'}>
                Inter
              </option>
              <option value="instrument" selected={content.font === 'instrument'}>
                Instrument Serif + Manrope
              </option>
              <option value="gilda" selected={content.font === 'gilda'}>
                Gilda Display
              </option>
            </select>
            <label for="language">{t.language}</label>
            <select class="select select-bordered" name="language" id="language">
              <option value="pt" selected={content.language === 'pt'}>
                Português
              </option>
              <option value="en" selected={content.language === 'en'}>
                English
              </option>
            </select>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="themeColor">{t.browserColor}</label>
                <input
                  class="input input-bordered p-1"
                  id="themeColor"
                  name="themeColor"
                  type="color"
                  value={content.themeColor}
                />
              </div>
              <div>
                <label for="backgroundColor">{t.pageColor}</label>
                <input
                  class="input input-bordered p-1"
                  id="backgroundColor"
                  name="backgroundColor"
                  type="color"
                  value={content.backgroundColor}
                />
              </div>
              <div>
                <label for="textColor">{t.textColor}</label>
                <input
                  class="input input-bordered p-1"
                  id="textColor"
                  name="textColor"
                  type="color"
                  value={content.textColor}
                />
              </div>
              <div>
                <label for="accentColor">{t.accentColor}</label>
                <input
                  class="input input-bordered p-1"
                  id="accentColor"
                  name="accentColor"
                  type="color"
                  value={content.accentColor}
                />
              </div>
            </div>

            <div class="mt-5">
              <button class="btn btn-primary" type="submit">
                {t.save}
              </button>
            </div>
          </form>
        )}
        {section === 'identidade' && (
          <form
            id="editor"
            class="rounded-2xl border border-[#ead8bd] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-6 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5"
            data-initial={JSON.stringify(content)}
          >
            <h3>{t.identity}</h3>
            <p class="text-sm text-[#625a51]">{t.identityHint}</p>
            <label for="logo-file">{t.logo}</label>
            <ImageUpload id="logo-file" name="" lang={en ? 'en' : 'pt'} src={content.logo} />
            <input type="hidden" name="logo" value={content.logo} />
            <small>{t.logoHint}</small>
            <label class="mt-4 flex items-start gap-3 text-sm font-medium text-[#17130d]">
              <input
                class="checkbox checkbox-primary mt-0.5 shrink-0 border border-[#b88333]"
                name="showInShowcase"
                type="checkbox"
                checked={content.showInShowcase}
              />
              <span>{t.showcaseConsent}</span>
            </label>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="favicon-file">{t.favicon}</label>
                <ImageUpload
                  id="favicon-file"
                  name=""
                  lang={en ? 'en' : 'pt'}
                  src={content.favicon}
                  compact
                />
                <input type="hidden" name="favicon" value={content.favicon} />
              </div>
              <div>
                <label for="pwa-icon-file">{t.appIcon}</label>
                <ImageUpload
                  id="pwa-icon-file"
                  name=""
                  lang={en ? 'en' : 'pt'}
                  src={content.pwaIcon192}
                  compact
                />
                <input type="hidden" name="pwaIcon192" value={content.pwaIcon192} />
                <input type="hidden" name="pwaIcon512" value={content.pwaIcon512} />
              </div>
            </div>
            <small>{t.iconHint}</small>
            <label for="appName">{t.appName}</label>
            <input
              class="input input-bordered"
              id="appName"
              name="appName"
              maxlength="50"
              value={content.appName}
              placeholder={content.title}
            />

            <div class="mt-5">
              <button class="btn btn-primary" type="submit">
                {t.save}
              </button>
            </div>
          </form>
        )}
        {section === 'dominio' && (
          <section class="rounded-2xl border border-[#ead8bd] bg-white p-6 shadow-none [&_h2]:font-['Outfit',sans-serif] [&_h2]:font-medium [&_h2]:tracking-[-0.03em] [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2>{t.address}</h2>
            <p class="text-sm text-[#625a51]">
              {t.publicLink}:{' '}
              <a
                id="public-url"
                href={`https://${site.slug}.${domain}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {site.slug}.{domain}
              </a>
            </p>
            <form id="slug-form" class="mt-4 flex flex-col gap-2 sm:flex-row">
              <input
                class="input input-bordered flex-1"
                name="slug"
                value={site.slug}
                aria-label={t.address}
                required
              />
              <button class="btn btn-outline" type="submit">
                {t.change}
              </button>
            </form>
          </section>
        )}
        {section === 'conteudo' && (
          <section
            class="site-editor relative isolate min-h-[640px] overflow-hidden rounded-2xl border border-[#d8ae73] bg-[#f8f7f4]"
            aria-label={t.content}
          >
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#d8ae73] bg-white p-3">
              <h2 class="text-lg">{t.content}</h2>
              <div class="flex flex-wrap gap-2">
                <button
                  class="btn btn-sm btn-outline"
                  id="toggle-site-controls"
                  type="button"
                  aria-controls="site-controls"
                  aria-expanded="false"
                >
                  {en ? 'Edit content' : 'Editar conteúdo'}
                </button>
                <button
                  class="btn btn-sm btn-ghost"
                  id="desktop-preview"
                  type="button"
                  aria-pressed="true"
                >
                  {t.desktop}
                </button>
                <button
                  class="btn btn-sm btn-ghost"
                  id="mobile-preview"
                  type="button"
                  aria-pressed="false"
                >
                  {t.mobile}
                </button>
                <button class="btn btn-sm btn-outline" type="submit" form="editor">
                  {t.save}
                </button>
                <button
                  class="btn btn-sm btn-primary"
                  id="publish"
                  type="button"
                  disabled={!active}
                >
                  {t.publish}
                </button>
              </div>
            </div>
            <div class="relative flex justify-center">
              <iframe
                id="preview-frame"
                src="/app/preview"
                title={t.preview}
                class="block h-[calc(100dvh-180px)] min-h-[560px] w-full border-0 bg-white"
              ></iframe>
              <aside
                id="site-controls"
                aria-label={en ? 'Content controls' : 'Controles de conteúdo'}
                hidden
                class="absolute bottom-3 left-3 top-3 z-10 w-[min(460px,calc(100%_-_1.5rem))] overflow-y-auto overscroll-contain rounded-2xl border border-[#d8ae73] bg-white/95 p-5 shadow-2xl backdrop-blur-sm"
              >
                <div class="sticky -top-5 z-10 -mx-5 -mt-5 mb-4 flex items-center justify-between gap-3 border-b border-[#d8ae73] bg-white px-5 py-3">
                  <strong>{en ? 'Edit your page' : 'Edite sua página'}</strong>
                  <button class="btn btn-sm btn-ghost" id="close-site-controls" type="button">
                    {en ? 'Close' : 'Fechar'} ×
                  </button>
                </div>
                <form
                  id="editor"
                  class="rounded-2xl border border-[#ead8bd] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-6 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5"
                  data-initial={JSON.stringify(content)}
                >
                  <h3>{t.blocks}</h3>
                  <div id="sections">
                    {content.sections.map((item) => (
                      <SectionFields section={item} en={en} />
                    ))}
                  </div>
                  <div class="mt-3 flex flex-col gap-2 sm:flex-row">
                    <select class="select select-bordered flex-1" id="add-section-type">
                      {sectionTypes.map((type) => (
                        <option value={type}>{t.blockTypes[type]}</option>
                      ))}
                    </select>
                    <button
                      class="btn btn-outline btn-sm w-full sm:w-auto"
                      type="button"
                      id="add-section"
                    >
                      + {t.addBlock}
                    </button>
                  </div>
                  <div hidden data-section-templates>
                    {sectionTypes.map((type) => (
                      <SectionFields section={blankSection(type)} en={en} template />
                    ))}
                  </div>
                </form>
                <details class="border-t border-[#d8ae73] py-4 text-sm text-[#625a51]">
                  <summary class="cursor-pointer font-semibold">{t.metrics}</summary>
                  <div class="mt-3 grid grid-cols-2 gap-3">
                    <p>
                      <strong id="metric-views">
                        <span class="inline-block h-4 w-10 animate-pulse rounded bg-[#efe8dc] align-middle"></span>
                      </strong>{' '}
                      · {t.views}
                    </p>
                    <p>
                      <strong id="metric-clicks">
                        <span class="inline-block h-4 w-10 animate-pulse rounded bg-[#efe8dc] align-middle"></span>
                      </strong>{' '}
                      · {t.clicks}
                    </p>
                  </div>
                </details>
              </aside>
            </div>
          </section>
        )}
        {section === 'plano' && (
          <section class="rounded-2xl border border-[#ead8bd] bg-white p-6 shadow-none [&_h2]:font-['Outfit',sans-serif] [&_h2]:font-medium [&_h2]:tracking-[-0.03em] [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2>{t.plans}</h2>
            <p class="text-[#625a51]">{user.plan === 'trial' ? trialLeft : user.plan}</p>
            <div class="mt-5 flex flex-wrap gap-2.5">
              <button
                class="btn btn-outline"
                data-plan="monthly"
                data-label={t.monthly}
                disabled={!priceReady.monthly_brl}
              >
                {t.monthly} · <span data-amount>{priceText('monthly')}</span>
              </button>
              <button
                class="btn btn-outline"
                data-plan="yearly"
                data-label={t.yearly}
                disabled={!priceReady.yearly_brl}
              >
                {t.yearly} · <span data-amount>{priceText('yearly')}</span>
              </button>
            </div>
            <label for="currency">{en ? 'Checkout currency' : 'Moeda da compra'}</label>
            <select
              class="select select-bordered"
              id="currency"
              data-prices={JSON.stringify(priceMap)}
              data-ready={JSON.stringify(priceReady)}
            >
              <option value="brl">BRL · R$</option>
              <option value="usd">USD · $</option>
            </select>
            {user.stripe_customer_id && (
              <button class="btn btn-ghost mt-3" id="portal">
                {t.portal}
              </button>
            )}
          </section>
        )}
        {section === 'dominio' && (
          <section class="rounded-2xl border border-[#ead8bd] bg-white p-6 shadow-none [&_h2]:font-['Outfit',sans-serif] [&_h2]:font-medium [&_h2]:tracking-[-0.03em] [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2>{t.domain}</h2>
            <p class="text-[#625a51] text-sm">{t.domainHint}</p>
            <form id="domain-form" class="mt-4 flex flex-col gap-2 sm:flex-row">
              <input
                class="input input-bordered flex-1"
                name="hostname"
                placeholder="www.exemplo.com.br"
                required
              />
              <button class="btn btn-outline" disabled={user.plan === 'trial' || !active}>
                {t.connect}
              </button>
            </form>
            <p class="text-sm text-[#625a51] mt-3">
              CNAME: <code>connect.{domain}</code>
            </p>
            <p id="domain-status" class="alert alert-info my-3">
              <span class="inline-block h-4 w-40 animate-pulse rounded bg-[#efe8dc] align-middle"></span>
            </p>
          </section>
        )}
        {section === 'conta' && (
          <section
            id="account"
            class="rounded-2xl border border-[#ead8bd] bg-white p-6 shadow-none [&_h2]:font-['Outfit',sans-serif] [&_h2]:font-medium [&_h2]:tracking-[-0.03em] [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5"
          >
            <h2>{t.account}</h2>
            <form id="account-profile-form">
              <label>Foto</label>
              <div data-avatar-picker class="flex flex-wrap items-center gap-4">
                <span class="relative mx-auto h-16 w-16 shrink-0 sm:mx-0">
                  <img
                    data-avatar-preview
                    src={user.avatar ?? ''}
                    alt=""
                    class:list={[
                      'h-16 w-16 rounded-full border border-[#d8ae73] object-cover',
                      !user.avatar && 'hidden',
                    ]}
                  />
                  <span
                    data-avatar-placeholder
                    class:list={[
                      'grid h-16 w-16 place-items-center rounded-full border border-[#d8ae73] bg-[#fff4df] font-semibold text-[#6f4716]',
                      user.avatar && 'hidden',
                    ]}
                  >
                    {accountInitials || 'V'}
                  </span>
                </span>
                <ImageUpload
                  accept="image/png,image/jpeg,image/webp"
                  preview={false}
                  compact
                  lang={en ? 'en' : 'pt'}
                  class="sm:max-w-xs"
                />
                <button
                  data-avatar-remove
                  type="button"
                  class="btn btn-ghost btn-sm w-full sm:w-auto"
                >
                  Remover foto
                </button>
                <input data-avatar-value type="hidden" name="avatar" value={user.avatar ?? ''} />
              </div>
              <label for="account-name">Nome</label>
              <input
                id="account-name"
                class="input input-bordered w-full"
                name="displayName"
                maxlength="80"
                autocomplete="name"
                value={user.display_name ?? ''}
              />
              <div class="mt-5 flex flex-wrap items-center gap-3">
                <button class="btn btn-primary" type="submit">
                  Salvar
                </button>
                <a href="/login?password=1" class="btn btn-outline">
                  {en ? 'Create or change password' : 'Criar ou alterar senha'}
                </a>
              </div>
            </form>

            <div id="documentos" class="mt-8 border-t border-[#ead8bd] pt-6">
              <h3>Documentos</h3>
              <div class="mt-1 flex flex-wrap gap-2.5">
                <a class="btn btn-outline" href={en ? '/en/privacy' : '/privacidade'}>
                  {t.privacy}
                </a>
                <a class="btn btn-outline" href={en ? '/en/terms' : '/termos'}>
                  {t.terms}
                </a>
                <a id="export-data" class="btn btn-ghost" href="#export">
                  {t.exportData}
                </a>
              </div>
            </div>

            <form id="delete-account-form" class="mt-8 border-t border-[#ead8bd] pt-6">
              <label for="delete-email">
                {user.email
                  ? t.confirmEmail
                  : en
                    ? 'Type DELETE to confirm'
                    : 'Digite EXCLUIR para confirmar'}
              </label>
              <input
                class="input input-bordered w-full"
                id="delete-email"
                name="email"
                type={user.email ? 'email' : 'text'}
                placeholder={user.email ?? 'EXCLUIR'}
                required
              />
              <button class="btn btn-error mt-3" type="submit">
                {t.deleteAccount}
              </button>
            </form>
          </section>
        )}
      </div>
    </main>
  </div>

  <script>
    import '@frontend/pages/_scripts/account-menu';
    import { initImageUploads } from '@frontend/pages/_scripts/image-upload';
    import { uploadMedia } from '@frontend/api/media/upload';
    import { saveSite } from '@frontend/api/sites/save';
    import { publishSite } from '@frontend/api/sites/publish';
    import { changeSlug } from '@frontend/api/sites/change-slug';
    import { connectDomain } from '@frontend/api/domains/connect';
    import { domainStatus } from '@frontend/api/domains/status';
    import { checkout } from '@frontend/api/billing/checkout';
    import { billingPortal } from '@frontend/api/billing/portal';
    import { deleteAccount } from '@frontend/api/accounts/delete';
    import { exportAccount } from '@frontend/api/accounts/export';
    import { updateAccountProfile } from '@frontend/api/accounts/profile';
    import { initAvatarPicker, applyAvatarToMenu } from '@frontend/pages/_scripts/avatar-picker';
    import { getMetrics } from '@frontend/api/analytics/metrics';
    import { reportError } from '@frontend/components/toast';
    document.addEventListener('astro:page-load', () => {
      const input = (scope: ParentNode, name: string) =>
        (
          scope.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
            `[name="${name}"]`,
          )?.value || ''
        ).trim();
      const setField = (scope: ParentNode, name: string, value: string) => {
        const field = scope.querySelector<
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >(`[name="${name}"]`);
        if (field && typeof value === 'string') field.value = value;
      };
      const MAX_SECTIONS = 20;
      const ITEM_LIMITS: Record<string, number> = {
        services: 12,
        gallery: 12,
        stats: 4,
        steps: 6,
        experience: 10,
        testimonials: 6,
        faq: 10,
        contact: 8,
        footer: 8,
      };
      const TEXT_KEYS = [
        'eyebrow',
        'title',
        'subtitle',
        'body',
        'primaryLabel',
        'primaryUrl',
        'url',
        'caption',
        'address',
        'text',
      ];

      function initEditor(form: HTMLFormElement) {
        let changeVersion = 0;
        let savedVersion = 0;
        const markChanged = () => {
          changeVersion += 1;
        };
        form.addEventListener('input', markChanged);
        form.addEventListener('change', markChanged);
        window.addEventListener('beforeunload', (event) => {
          if (changeVersion === savedVersion) return;
          event.preventDefault();
          event.returnValue = '';
        });
        const panel =
          document.querySelector<HTMLElement>('#site-controls') ?? document.createElement('div');
        const toggle =
          document.querySelector<HTMLButtonElement>('#toggle-site-controls') ??
          document.createElement('button');
        const setControls = (open: boolean) => {
          panel.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
          if (open) panel.querySelector<HTMLButtonElement>('#close-site-controls')?.focus();
          else toggle.focus();
        };
        toggle.addEventListener('click', () => setControls(Boolean(panel.hidden)));
        form.addEventListener('invalid', () => setControls(true), true);
        document
          .querySelector('#close-site-controls')
          ?.addEventListener('click', () => setControls(false));
        panel.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setControls(false);
        });

        const sectionsRoot =
          form.querySelector<HTMLElement>('#sections') ?? document.createElement('div');
        const templatesRoot =
          form.querySelector<HTMLElement>('[data-section-templates]') ??
          document.createElement('div');
        const sectionNodes = () => [
          ...sectionsRoot.querySelectorAll<HTMLElement>('[data-section]'),
        ];

        const makeSection = (type: string) => {
          const tpl = templatesRoot.querySelector<HTMLElement>(
            `[data-section][data-type="${type}"]`,
          )!;
          const node = tpl.cloneNode(true) as HTMLElement;
          node.removeAttribute('data-template');
          node.classList.remove('hidden');
          setField(node, 'field-id', crypto.randomUUID().slice(0, 12));
          return node;
        };

        // Clones copy the "ready" flag but not the listeners, so clear it before re-initializing.
        const reinitUploads = (root: HTMLElement) => {
          root.querySelectorAll<HTMLElement>('[data-image-upload]').forEach((node) => {
            delete node.dataset.imageUploadReady;
          });
          initImageUploads(root);
        };

        form.querySelector('#add-section')?.addEventListener('click', () => {
          const type = form.querySelector<HTMLSelectElement>('#add-section-type')?.value || 'hero';
          if (sectionNodes().length >= MAX_SECTIONS) return;
          const node = makeSection(type);
          sectionsRoot.append(node);
          reinitUploads(node);
          markChanged();
          updatePreview();
        });

        form.addEventListener('click', (event) => {
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
          if (!button) return;
          const section = button.closest<HTMLElement>('[data-section]');
          if (!section) return;
          if (button.matches('[data-remove-section]')) {
            section.remove();
          } else if (button.matches('[data-move]')) {
            const direction = button.dataset.move;
            if (direction === 'up' && section.previousElementSibling)
              section.parentElement!.insertBefore(section, section.previousElementSibling);
            else if (direction === 'down' && section.nextElementSibling)
              section.parentElement!.insertBefore(section.nextElementSibling, section);
            else return;
          } else if (button.matches('[data-add-item]')) {
            const type = section.dataset.type || '';
            const items = section.querySelector('[data-items]');
            const template = section.querySelector<HTMLTemplateElement>('[data-item-template]');
            if (!items || !template) return;
            if (items.children.length >= (ITEM_LIMITS[type] ?? 0)) return;
            const item = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
            items.append(item);
            reinitUploads(item);
          } else if (button.matches('[data-remove]')) {
            button.closest('[data-item]')?.remove();
          } else {
            return;
          }
          markChanged();
          updatePreview();
        });

        async function upload(file: File) {
          const body = new FormData();
          body.set('file', file);
          const data = await uploadMedia(body);
          return data.url as string;
        }
        async function iconFile(file: File, size: number): Promise<File> {
          if (
            file.size > 5 * 1024 * 1024 ||
            !['image/png', 'image/jpeg', 'image/webp'].includes(file.type)
          )
            throw new Error(
              document.documentElement.lang === 'en'
                ? 'Use a PNG, JPG or WebP image up to 5 MB.'
                : 'Use uma imagem PNG, JPG ou WebP de até 5 MB.',
            );
          const bitmap = await createImageBitmap(file);
          try {
            const canvas = document.createElement('canvas');
            canvas.width = canvas.height = size;
            const context = canvas.getContext('2d');
            if (!context) throw new Error('Canvas indisponível');
            context.fillStyle = field('backgroundColor', snapshot().backgroundColor);
            context.fillRect(0, 0, size, size);
            const scale = Math.min((size * 0.82) / bitmap.width, (size * 0.82) / bitmap.height);
            const width = bitmap.width * scale;
            const height = bitmap.height * scale;
            context.drawImage(bitmap, (size - width) / 2, (size - height) / 2, width, height);
            const blob = await new Promise<Blob>((resolve, reject) =>
              canvas.toBlob(
                (result) =>
                  result ? resolve(result) : reject(new Error('Falha ao preparar ícone')),
                'image/png',
              ),
            );
            return new File([blob], `icon-${size}.png`, { type: 'image/png' });
          } finally {
            bitmap.close();
          }
        }
        async function uploadInto(scope: ParentNode, name: string) {
          const file = scope.querySelector<HTMLInputElement>(
            '[name="field-file"], [name="item-file"]',
          )?.files?.[0];
          let image = input(scope, name);
          if (file) {
            image = await upload(file);
            setField(scope, name, image);
            scope.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach((field) => {
              field.value = '';
            });
          }
          return image;
        }
        function itemValues(row: ParentNode) {
          const value: Record<string, string> = {};
          row
            .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[name^="item-"]')
            .forEach((field) => {
              if (field.name !== 'item-image' && field.type !== 'file')
                value[field.name.replace('item-', '')] = field.value.trim();
            });
          return value;
        }
        const snapshot = (): Record<string, any> => JSON.parse(form.dataset.initial || '{}');
        const field = (name: string, fallback: unknown) =>
          form.querySelector(`[name="${name}"]`) ? input(form, name) : String(fallback ?? '');
        const flag = (name: string, fallback: unknown) => {
          const el = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
          return el ? el.checked : Boolean(fallback);
        };
        async function collect(uploadFiles = true) {
          const logoFile = form.querySelector<HTMLInputElement>('#logo-file')?.files?.[0];
          let logo = field('logo', snapshot().logo);
          if (logoFile && uploadFiles) {
            logo = await upload(logoFile);
            setField(form, 'logo', logo);
            form.querySelector<HTMLInputElement>('#logo-file')!.value = '';
          }
          const faviconFile = form.querySelector<HTMLInputElement>('#favicon-file')?.files?.[0];
          let favicon = field('favicon', snapshot().favicon);
          if (faviconFile && uploadFiles) {
            favicon = await upload(await iconFile(faviconFile, 64));
            setField(form, 'favicon', favicon);
            form.querySelector<HTMLInputElement>('#favicon-file')!.value = '';
          }
          const pwaFile = form.querySelector<HTMLInputElement>('#pwa-icon-file')?.files?.[0];
          let pwaIcon192 = field('pwaIcon192', snapshot().pwaIcon192);
          let pwaIcon512 = field('pwaIcon512', snapshot().pwaIcon512);
          if (pwaFile && uploadFiles) {
            pwaIcon192 = await upload(await iconFile(pwaFile, 192));
            pwaIcon512 = await upload(await iconFile(pwaFile, 512));
            setField(form, 'pwaIcon192', pwaIcon192);
            setField(form, 'pwaIcon512', pwaIcon512);
            form.querySelector<HTMLInputElement>('#pwa-icon-file')!.value = '';
          }

          const sections: Record<string, unknown>[] = [];
          const hasBlocks = Boolean(form.querySelector('#sections'));
          for (const node of hasBlocks ? sectionNodes() : []) {
            const type = node.dataset.type || 'about';
            const variant = input(node, 'field-variant');
            const base: Record<string, unknown> = {
              id: input(node, 'field-id') || crypto.randomUUID().slice(0, 12),
              type,
            };
            if (variant) base.variant = variant;
            base.layout = {
              background: input(node, 'field-layout-background') || 'default',
              spacing: input(node, 'field-layout-spacing') || 'md',
              width: input(node, 'field-layout-width') || 'normal',
              align: input(node, 'field-layout-align') || 'left',
            };
            for (const key of TEXT_KEYS) {
              const field = node.querySelector(`[name="field-${key}"]`);
              if (field) base[key] = input(node, `field-${key}`);
            }
            const imageField = node.querySelector('[name="field-image"]');
            if (imageField) base.image = await uploadInto(node, 'field-image');
            const rows = [...node.querySelectorAll<HTMLElement>('[data-item]')];
            if (type === 'services' || type === 'gallery') {
              const items = [];
              for (const row of rows) {
                const image = await uploadInto(row, 'item-image');
                const values = itemValues(row);
                items.push(
                  type === 'gallery'
                    ? { image }
                    : {
                        title: values.title || '',
                        description: values.description || '',
                        url: values.url || '',
                        image,
                      },
                );
              }
              if (type === 'services') base.items = items;
              else base.images = items;
            } else if (type === 'contact' || type === 'footer') {
              base.links = rows.map((row) => itemValues(row));
            } else {
              base.items = rows.map((row) => itemValues(row));
            }
            sections.push(base);
          }
          const finalSections: Record<string, any>[] = hasBlocks
            ? sections
            : (snapshot().sections ?? []);
          const hero = finalSections.find((item) => item.type === 'hero') as
            { title?: string } | undefined;
          return {
            font: field('font', snapshot().font),
            language: field('language', snapshot().language),
            title: hero?.title || field('appName', snapshot().appName) || 'Vira',
            appName: field('appName', snapshot().appName),
            logo,
            showInShowcase: flag('showInShowcase', snapshot().showInShowcase),
            favicon,
            pwaIcon192,
            pwaIcon512,
            themeColor: field('themeColor', snapshot().themeColor),
            backgroundColor: field('backgroundColor', snapshot().backgroundColor),
            textColor: field('textColor', snapshot().textColor),
            accentColor: field('accentColor', snapshot().accentColor),
            assistant: flag('assistant', snapshot().assistant),
            sections: finalSections,
          };
        }

        async function save() {
          clearTimeout(previewTimer);
          previewRequest?.abort();
          const content = await collect();
          const savingVersion = changeVersion;
          const result = await saveSite(content);
          savedVersion = savingVersion;
          form.dataset.initial = JSON.stringify(content);
          const frame = document.querySelector<HTMLIFrameElement>('#preview-frame');
          if (frame) {
            frame.removeAttribute('srcdoc');
            frame.src = `/app/preview?t=${Date.now()}`;
          }
          return result;
        }
        let previewTimer: ReturnType<typeof setTimeout>;
        let previewRequest: AbortController | undefined;
        const updatePreview = () => {
          if (!document.querySelector('#preview-frame')) return;
          clearTimeout(previewTimer);
          previewRequest?.abort();
          previewTimer = setTimeout(async () => {
            const current = new AbortController();
            previewRequest = current;
            try {
              const content = await collect(false);
              if (current.signal.aborted) return;
              const response = await fetch('/app/preview', {
                method: 'POST',
                credentials: 'same-origin',
                signal: current.signal,
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(content),
              });
              if (!response.ok) return;
              const html = await response.text();
              if (!current.signal.aborted)
                document.querySelector<HTMLIFrameElement>('#preview-frame')!.srcdoc = html;
            } catch (error) {
              if (!(error instanceof DOMException && error.name === 'AbortError'))
                console.warn('Preview unavailable');
            }
          }, 500);
        };
        form.addEventListener('input', updatePreview);
        form.addEventListener('change', updatePreview);
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          try {
            await save();
          } catch (error) {
            reportError(error, 'Falha ao salvar');
          }
        });
        document.querySelector('#publish')?.addEventListener('click', async () => {
          try {
            await save();
            await publishSite();
          } catch (error) {
            reportError(error, 'Falha ao publicar');
          }
        });
        document.querySelector('#desktop-preview')?.addEventListener('click', () => {
          document.querySelector('#desktop-preview')?.setAttribute('aria-pressed', 'true');
          document.querySelector('#mobile-preview')?.setAttribute('aria-pressed', 'false');
          document
            .querySelector<HTMLIFrameElement>('#preview-frame')!
            .classList.remove('max-w-[390px]');
        });
        document.querySelector('#mobile-preview')?.addEventListener('click', () => {
          document.querySelector('#desktop-preview')?.setAttribute('aria-pressed', 'false');
          document.querySelector('#mobile-preview')?.setAttribute('aria-pressed', 'true');
          document
            .querySelector<HTMLIFrameElement>('#preview-frame')!
            .classList.add('max-w-[390px]');
        });
      }
      const editorForm = document.querySelector<HTMLFormElement>('#editor');
      if (editorForm) initEditor(editorForm);
      document
        .querySelector<HTMLFormElement>('#slug-form')
        ?.addEventListener('submit', async (event) => {
          event.preventDefault();
          const form = event.currentTarget as HTMLFormElement;
          try {
            const result = await changeSlug(input(form, 'slug'));
            document.querySelector<HTMLAnchorElement>('#public-url')!.href = result.url;
            document.querySelector<HTMLAnchorElement>('#public-url')!.textContent = new URL(
              result.url,
            ).host;
          } catch (error) {
            reportError(error, 'Falha ao alterar endereço');
          }
        });
      document
        .querySelector<HTMLFormElement>('#domain-form')
        ?.addEventListener('submit', async (event) => {
          event.preventDefault();
          const form = event.currentTarget as HTMLFormElement;
          const target = document.querySelector<HTMLElement>('#domain-status')!;
          target.hidden = false;
          try {
            const result = await connectDomain(input(form, 'hostname'));
            target.textContent = `CNAME: ${result.hostname} → ${result.target}`;
            target.classList.remove('alert-error');
            target.classList.add('alert-success');
          } catch (error) {
            reportError(error, 'Falha ao conectar domínio');
          }
        });
      const currencySelect = document.querySelector<HTMLSelectElement>('#currency');
      if (currencySelect) {
        const priceMap = JSON.parse(currencySelect.dataset.prices || '{}') as Record<
          string,
          number
        >;
        const priceReady = JSON.parse(currencySelect.dataset.ready || '{}') as Record<
          string,
          boolean
        >;
        currencySelect.addEventListener('change', () => {
          document.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((button) => {
            const amount = priceMap[`${button.dataset.plan}_${currencySelect.value}`];
            const label = button.querySelector<HTMLElement>('[data-amount]')!;
            label.textContent = amount
              ? new Intl.NumberFormat(currencySelect.value === 'brl' ? 'pt-BR' : 'en-US', {
                  style: 'currency',
                  currency: currencySelect.value.toUpperCase(),
                }).format(amount / 100)
              : document.documentElement.lang === 'en'
                ? 'Coming soon'
                : 'Em breve';
            button.disabled = !priceReady[`${button.dataset.plan}_${currencySelect.value}`];
          });
        });
        document.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((button) =>
          button.addEventListener('click', async () => {
            try {
              const result = await checkout(
                button.dataset.plan,
                document.querySelector<HTMLSelectElement>('#currency')!.value,
              );
              location.href = result.url;
            } catch (error) {
              reportError(error, 'Falha ao iniciar compra');
            }
          }),
        );
        document.querySelector('#portal')?.addEventListener('click', async () => {
          try {
            const result = await billingPortal();
            location.href = result.url;
          } catch (error) {
            reportError(error, 'Falha ao abrir cobrança');
          }
        });
      }
      document.querySelectorAll<HTMLElement>('[data-avatar-picker]').forEach(initAvatarPicker);
      document
        .querySelector<HTMLFormElement>('#account-profile-form')
        ?.addEventListener('submit', async (event) => {
          event.preventDefault();
          const form = event.currentTarget as HTMLFormElement;
          const button = form.querySelector<HTMLButtonElement>('button[type=submit]');
          if (button) button.disabled = true;
          try {
            const name = input(form, 'displayName');
            const avatar = input(form, 'avatar') || null;
            await updateAccountProfile(name, avatar);
            const normalized = name.trim().replace(/\s+/g, ' ');
            document.querySelectorAll<HTMLElement>('[data-account-label]').forEach((node) => {
              node.textContent = normalized;
            });
            const initials = normalized
              .split(/[^\p{L}\p{N}]+/u)
              .filter(Boolean)
              .slice(0, 2)
              .map((part: string) => part[0].toLocaleUpperCase('pt-BR'))
              .join('');
            applyAvatarToMenu(avatar ?? '', initials);
          } catch (error) {
            reportError(error, 'Falha ao salvar o perfil');
          } finally {
            if (button) button.disabled = false;
          }
        });
      document
        .querySelector<HTMLFormElement>('#delete-account-form')
        ?.addEventListener('submit', async (event) => {
          event.preventDefault();
          const deletionForm = event.currentTarget as HTMLFormElement;
          const email = input(deletionForm, 'email');
          const warning =
            document.documentElement.lang === 'en'
              ? 'Delete your account, page and images? Any subscription will be canceled.'
              : 'Excluir sua conta, página e imagens? Sua assinatura será cancelada.';
          if (!confirm(warning)) return;
          try {
            await deleteAccount(email);
            location.href = '/';
          } catch (error) {
            reportError(error, 'Falha ao excluir a conta');
          }
        });
      if (document.querySelector('#metric-views')) {
        getMetrics()
          .then((data) => {
            document.querySelector('#metric-views')!.textContent = String(data.views ?? 0);
            document.querySelector('#metric-clicks')!.textContent = String(data.clicks ?? 0);
          })
          .catch(() => {
            document.querySelector('#metric-views')!.textContent = '—';
            document.querySelector('#metric-clicks')!.textContent = '—';
          });
      }
      if (document.querySelector('#domain-status')) {
        domainStatus()
          .then((data) => {
            const node = document.querySelector<HTMLElement>('#domain-status')!;
            if (!data.domain) {
              node.hidden = true;
              return;
            }
            node.textContent = `${data.domain.hostname}: ${data.domain.status}/${data.domain.sslStatus}`;
          })
          .catch(() => {
            const node = document.querySelector<HTMLElement>('#domain-status');
            if (node) node.hidden = true;
          });
      }
      document
        .querySelector<HTMLAnchorElement>('#export-data')
        ?.addEventListener('click', async (event) => {
          event.preventDefault();
          try {
            const file = await exportAccount();
            const url = URL.createObjectURL(file);
            const link = document.createElement('a');
            link.href = url;
            link.download = 'vira-dados.json';
            link.click();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
          } catch (error) {
            reportError(error, 'Falha ao baixar dados');
          }
        });
    });
  </script>
</Base>
