      content: 'Conteúdo',
      layout: 'Layout',
      layoutGuardiao: 'Guardião',
      layoutCentral: 'Central',
      layoutPerfil: 'Perfil',
      layoutEstudio: 'Estúdio',
      layoutClassico: 'Clássico',
      font: 'Tipografia',
      language: 'Idioma da página',
      eyebrow: 'Etiqueta curta',
