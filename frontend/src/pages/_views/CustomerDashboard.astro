      steps: 'Como funciona',
      faq: 'Perguntas frequentes',
      experience: 'Experiência',
      links: 'Links e contato',
      gallery: 'Galeria',
      question: 'Pergunta',
      answer: 'Resposta',
      role: 'Cargo',
      company: 'Empresa',
      period: 'Período',
      location: 'Local',
      summary: 'Resumo',
      title: 'Título principal',
      subtitle: 'Apresentação',
      hero: 'Imagem de capa',
