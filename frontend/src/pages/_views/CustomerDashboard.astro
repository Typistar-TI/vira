  <style>
    .customer-dashboard :global(.card) {
      border-radius: 0;
      border-width: 1px 0 0;
      padding-inline: 0;
      box-shadow: none;
    }
    .customer-dashboard :global(h2) {
      font-family: 'Outfit', sans-serif;
      font-weight: 500;
      letter-spacing: -0.03em;
    }
  </style>
  <script>
    import '@frontend/pages/_scripts/account-menu';
    import { previewStudio } from '@frontend/pages/_scripts/preview-studio';
    import { uploadMedia } from '@frontend/api/media/upload';
    import { saveSite } from '@frontend/api/sites/save';
    import { publishSite } from '@frontend/api/sites/publish';
    import { changeSlug } from '@frontend/api/sites/change-slug';
    import { connectDomain } from '@frontend/api/domains/connect';
    import { domainStatus } from '@frontend/api/domains/status';
    import { checkout } from '@frontend/api/billing/checkout';
    import { billingPortal } from '@frontend/api/billing/portal';
    import { deleteAccount } from '@frontend/api/accounts/delete';
    import { exportAccount } from '@frontend/api/accounts/export';
    import { getMetrics } from '@frontend/api/analytics/metrics';
    import { reportError } from '@frontend/components/toast';
    const form = document.querySelector<HTMLFormElement>('#editor')!;
    const studio = previewStudio('site-studio');
    document.querySelector('#open-site-studio')?.addEventListener('click', () => {
      studio.open(document.querySelector<HTMLIFrameElement>('#preview-frame')!, form);
    });
    const input = (scope: ParentNode, name: string) =>
      (
        scope.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
          `[name="${name}"]`,
        )?.value || ''
      ).trim();
    const list = (name: string) => [...form.querySelectorAll<HTMLElement>(`[data-item="${name}"]`)];
    const layoutPalettes: Record<string, [string, string, string]> = {
      guardiao: ['#0f1310', '#f1f4ef', '#8ae07d'],
      central: ['#090d0f', '#f4f7f5', '#ff7919'],
      perfil: ['#11120f', '#f3ede4', '#c9a86a'],
      estudio: ['#ffffff', '#552200', '#552200'],
      classico: ['#ffffff', '#17130d', '#b88333'],
    };
    const layoutFonts: Record<string, string> = {
      guardiao: 'bricolage',
      central: 'inter',
      perfil: 'instrument',
      estudio: 'gilda',
      classico: 'outfit',
    };
    form.querySelector<HTMLSelectElement>('#layout')?.addEventListener('change', (event) => {
      const key = (event.target as HTMLSelectElement).value;
      const palette = layoutPalettes[key];
      if (!palette) return;
      const set = (name: string, value: string) => {
        const field = form.querySelector<
          HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
        >(`[name="${name}"]`);
        if (field) field.value = value;
      };
      set('backgroundColor', palette[0]);
      set('textColor', palette[1]);
      set('accentColor', palette[2]);
      set('themeColor', palette[0]);
      set('font', layoutFonts[key]);
    });
    async function upload(file: File) {
      const body = new FormData();
      body.set('file', file);
      const data = await uploadMedia(body);
      return data.url as string;
    }
    async function iconFile(file: File, size: number): Promise<File> {
      if (
        file.size > 5 * 1024 * 1024 ||
        !['image/png', 'image/jpeg', 'image/webp'].includes(file.type)
      )
        throw new Error(
          document.documentElement.lang === 'en'
            ? 'Use a PNG, JPG or WebP image up to 5 MB.'
            : 'Use uma imagem PNG, JPG ou WebP de até 5 MB.',
        );
      const bitmap = await createImageBitmap(file);
      try {
        const canvas = document.createElement('canvas');
        canvas.width = canvas.height = size;
        const context = canvas.getContext('2d');
        if (!context) throw new Error('Canvas indisponível');
        context.fillStyle = input(form, 'backgroundColor');
        context.fillRect(0, 0, size, size);
        const scale = Math.min((size * 0.82) / bitmap.width, (size * 0.82) / bitmap.height);
        const width = bitmap.width * scale;
        const height = bitmap.height * scale;
        context.drawImage(bitmap, (size - width) / 2, (size - height) / 2, width, height);
        const blob = await new Promise<Blob>((resolve, reject) =>
          canvas.toBlob(
            (result) => (result ? resolve(result) : reject(new Error('Falha ao preparar ícone'))),
            'image/png',
          ),
        );
        return new File([blob], `icon-${size}.png`, { type: 'image/png' });
      } finally {
        bitmap.close();
      }
    }
    async function collect(uploadFiles = true) {
      const logoFile = form.querySelector<HTMLInputElement>('#logo-file')?.files?.[0];
      let logo = input(form, 'logo');
      if (logoFile && uploadFiles) {
        logo = await upload(logoFile);
        form.querySelector<HTMLInputElement>('[name="logo"]')!.value = logo;
        form.querySelector<HTMLInputElement>('#logo-file')!.value = '';
      }
      const faviconFile = form.querySelector<HTMLInputElement>('#favicon-file')?.files?.[0];
      let favicon = input(form, 'favicon');
      if (faviconFile && uploadFiles) {
        favicon = await upload(await iconFile(faviconFile, 64));
        form.querySelector<HTMLInputElement>('[name="favicon"]')!.value = favicon;
        form.querySelector<HTMLInputElement>('#favicon-file')!.value = '';
      }
      const pwaFile = form.querySelector<HTMLInputElement>('#pwa-icon-file')?.files?.[0];
      let pwaIcon192 = input(form, 'pwaIcon192');
      let pwaIcon512 = input(form, 'pwaIcon512');
      if (pwaFile && uploadFiles) {
        pwaIcon192 = await upload(await iconFile(pwaFile, 192));
        pwaIcon512 = await upload(await iconFile(pwaFile, 512));
        form.querySelector<HTMLInputElement>('[name="pwaIcon192"]')!.value = pwaIcon192;
        form.querySelector<HTMLInputElement>('[name="pwaIcon512"]')!.value = pwaIcon512;
        form.querySelector<HTMLInputElement>('#pwa-icon-file')!.value = '';
      }
      const heroFile = form.querySelector<HTMLInputElement>('#hero-file')?.files?.[0];
      let heroImage = input(form, 'heroImage');
      if (heroFile && uploadFiles) {
        heroImage = await upload(heroFile);
        form.querySelector<HTMLInputElement>('[name="heroImage"]')!.value = heroImage;
        form.querySelector<HTMLInputElement>('#hero-file')!.value = '';
      }
      const products = [];
      for (const row of list('product')) {
        let image = input(row, 'item-image');
        const file = row.querySelector<HTMLInputElement>('[name="item-file"]')?.files?.[0];
        if (file && uploadFiles) {
          image = await upload(file);
          row.querySelector<HTMLInputElement>('[name="item-image"]')!.value = image;
          row.querySelector<HTMLInputElement>('[name="item-file"]')!.value = '';
        }
        products.push({
          title: input(row, 'item-title'),
          description: input(row, 'item-description'),
          image,
          url: input(row, 'item-url'),
        });
      }
      const gallery = [];
      for (const row of list('gallery')) {
        let image = input(row, 'item-image');
        const file = row.querySelector<HTMLInputElement>('[name="item-file"]')?.files?.[0];
        if (file && uploadFiles) {
          image = await upload(file);
          row.querySelector<HTMLInputElement>('[name="item-image"]')!.value = image;
          row.querySelector<HTMLInputElement>('[name="item-file"]')!.value = '';
        }
        if (image) gallery.push({ image });
      }
      return {
        layout: input(form, 'layout'),
        font: input(form, 'font'),
        language: input(form, 'language'),
        title: input(form, 'title'),
        eyebrow: input(form, 'eyebrow'),
        appName: input(form, 'appName'),
        subtitle: input(form, 'subtitle'),
        heroImage,
        logo,
        showInShowcase: form.querySelector<HTMLInputElement>('[name="showInShowcase"]')!.checked,
        favicon,
        pwaIcon192,
        pwaIcon512,
        themeColor: input(form, 'themeColor'),
        backgroundColor: input(form, 'backgroundColor'),
        textColor: input(form, 'textColor'),
        accentColor: input(form, 'accentColor'),
        primaryLabel: input(form, 'primaryLabel'),
        primaryUrl: input(form, 'primaryUrl'),
        snippet: input(form, 'snippet'),
        aboutTitle: input(form, 'aboutTitle'),
        about: input(form, 'about'),
        footerText: input(form, 'footerText'),
        benefits: list('benefit').map((row) => ({
          title: input(row, 'item-title'),
          description: input(row, 'item-description'),
        })),
        steps: list('step').map((row) => ({
          title: input(row, 'item-title'),
          description: input(row, 'item-description'),
        })),
        stats: list('stat').map((row) => ({
          value: input(row, 'item-value'),
          label: input(row, 'item-label'),
        })),
        experience: list('experience').map((row) => ({
          role: input(row, 'item-role'),
          company: input(row, 'item-company'),
          period: input(row, 'item-period'),
          location: input(row, 'item-location'),
          summary: input(row, 'item-summary'),
        })),
        testimonials: list('testimonial').map((row) => ({
          quote: input(row, 'item-quote'),
          name: input(row, 'item-name'),
        })),
        faq: list('faq').map((row) => ({
          question: input(row, 'item-question'),
          answer: input(row, 'item-answer'),
        })),
        products,
        gallery,
        links: list('link').map((row) => ({
          label: input(row, 'item-label'),
          url: input(row, 'item-url'),
        })),
      };
    }
    async function save() {
      clearTimeout(previewTimer);
      previewRequest?.abort();
      const content = await collect();
      const result = await saveSite(content);
      const frame = document.querySelector<HTMLIFrameElement>('#preview-frame')!;
      frame.removeAttribute('srcdoc');
      frame.src = `/app/preview?t=${Date.now()}`;
      return result;
    }
    let previewTimer: ReturnType<typeof setTimeout>;
    let previewRequest: AbortController | undefined;
    const updatePreview = () => {
      clearTimeout(previewTimer);
      previewRequest?.abort();
      previewTimer = setTimeout(async () => {
        const current = new AbortController();
        previewRequest = current;
        try {
          const content = await collect(false);
          if (current.signal.aborted) return;
          const response = await fetch('/app/preview', {
            method: 'POST',
            credentials: 'same-origin',
            signal: current.signal,
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(content),
          });
          if (!response.ok) return;
          const html = await response.text();
          if (!current.signal.aborted)
            document.querySelector<HTMLIFrameElement>('#preview-frame')!.srcdoc = html;
        } catch (error) {
          if (!(error instanceof DOMException && error.name === 'AbortError'))
            console.warn('Preview unavailable');
        }
      }, 500);
    };
    form.addEventListener('input', updatePreview);
    form.addEventListener('change', updatePreview);
    form.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('[data-add], [data-remove]')) updatePreview();
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        await save();
      } catch (error) {
        reportError(error, 'Falha ao salvar');
      }
    });
    document.querySelector('#publish')?.addEventListener('click', async () => {
      try {
        await save();
        await publishSite();
      } catch (error) {
        reportError(error, 'Falha ao publicar');
      }
    });
    document.querySelector('#desktop-preview')?.addEventListener('click', () => {
      document
        .querySelector<HTMLIFrameElement>('#preview-frame')!
        .classList.remove('max-w-[390px]');
    });
    document.querySelector('#mobile-preview')?.addEventListener('click', () => {
      document.querySelector<HTMLIFrameElement>('#preview-frame')!.classList.add('max-w-[390px]');
    });
    form.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!button) return;
      if (button.matches('[data-remove]')) button.closest('[data-item]')?.remove();
      const type = button.dataset.add;
      if (!type) return;
      const limits: Record<string, number> = {
        benefit: 6,
        step: 6,
        stat: 4,
        experience: 8,
        testimonial: 3,
        faq: 8,
        product: 12,
        gallery: 12,
        link: 8,
      };
      if (list(type).length >= (limits[type] ?? 0)) return;
      const title = document.documentElement.lang === 'en' ? 'Title' : 'Título';
      const description = document.documentElement.lang === 'en' ? 'Description' : 'Descrição';
      const pair =
        `<input class="input input-bordered mb-2" name="item-title" placeholder="${title}" maxlength="80">` +
        `<textarea class="textarea textarea-bordered" name="item-description" placeholder="${description}" maxlength="240"></textarea>`;
      const markup: Record<string, string> = {
        benefit: pair,
        step: pair,
        stat: '<div class="grid gap-3 sm:grid-cols-2"><input class="input input-bordered" name="item-value" placeholder="Valor" maxlength="20"><input class="input input-bordered" name="item-label" placeholder="Legenda" maxlength="60"></div>',
        experience:
          '<div class="grid gap-3 sm:grid-cols-2"><input class="input input-bordered" name="item-role" placeholder="Cargo" maxlength="80"><input class="input input-bordered" name="item-company" placeholder="Empresa" maxlength="80"><input class="input input-bordered" name="item-period" placeholder="Período" maxlength="60"><input class="input input-bordered" name="item-location" placeholder="Local" maxlength="80"></div><textarea class="textarea textarea-bordered mt-2" name="item-summary" placeholder="Resumo" maxlength="400"></textarea>',
        testimonial:
          '<textarea class="textarea textarea-bordered mb-2" name="item-quote" placeholder="Depoimento" maxlength="300"></textarea><input class="input input-bordered" name="item-name" placeholder="Nome" maxlength="80">',
        faq: '<input class="input input-bordered mb-2" name="item-question" placeholder="Pergunta" maxlength="160"><textarea class="textarea textarea-bordered" name="item-answer" placeholder="Resposta" maxlength="600"></textarea>',
        product:
          '<input class="input input-bordered mb-2" name="item-title" placeholder="Nome" maxlength="80"><textarea class="textarea textarea-bordered mb-2" name="item-description" placeholder="Descrição" maxlength="300"></textarea><input class="input input-bordered mb-2" name="item-url" type="url" placeholder="https://"><input class="file-input file-input-bordered w-full" name="item-file" type="file" accept="image/jpeg,image/png,image/webp"><input type="hidden" name="item-image">',
        gallery:
          '<input class="file-input file-input-bordered w-full" name="item-file" type="file" accept="image/jpeg,image/png,image/webp"><input type="hidden" name="item-image">',
        link: '<div class="grid gap-3 sm:grid-cols-2"><input class="input input-bordered" name="item-label" placeholder="Legenda" maxlength="40"><input class="input input-bordered" name="item-url" type="url" placeholder="https://"></div>',
      };
      const containers: Record<string, string> = {
        benefit: 'benefits-list',
        step: 'steps-list',
        stat: 'stats-list',
        experience: 'experience-list',
        testimonial: 'testimonials-list',
        faq: 'faq-list',
        product: 'products-list',
        gallery: 'gallery-list',
        link: 'links-list',
      };
      const row = document.createElement('fieldset');
      row.dataset.item = type;
      row.className = 'border border-base-300 rounded-xl p-3 mb-2';
      row.innerHTML =
        (markup[type] ?? '') +
        '<button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>Remover</button>';
      document.querySelector(`#${containers[type]}`)?.append(row);
    });
    document
      .querySelector<HTMLFormElement>('#slug-form')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        try {
          const result = await changeSlug(input(form, 'slug'));
          document.querySelector<HTMLAnchorElement>('#public-url')!.href = result.url;
          document.querySelector<HTMLAnchorElement>('#public-url')!.textContent = new URL(
            result.url,
          ).host;
        } catch (error) {
          reportError(error, 'Falha ao alterar endereço');
        }
      });
    document
      .querySelector<HTMLFormElement>('#domain-form')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const target = document.querySelector<HTMLElement>('#domain-status')!;
        target.hidden = false;
        try {
          const result = await connectDomain(input(form, 'hostname'));
          target.textContent = `CNAME: ${result.hostname} → ${result.target}`;
          target.classList.remove('alert-error');
          target.classList.add('alert-success');
        } catch (error) {
          reportError(error, 'Falha ao conectar domínio');
        }
      });
    const currencySelect = document.querySelector<HTMLSelectElement>('#currency')!;
    const priceMap = JSON.parse(currencySelect.dataset.prices || '{}') as Record<string, number>;
    const priceReady = JSON.parse(currencySelect.dataset.ready || '{}') as Record<string, boolean>;
    currencySelect.addEventListener('change', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((button) => {
        const amount = priceMap[`${button.dataset.plan}_${currencySelect.value}`];
        const label = button.querySelector<HTMLElement>('[data-amount]')!;
        label.textContent = amount
          ? new Intl.NumberFormat(currencySelect.value === 'brl' ? 'pt-BR' : 'en-US', {
              style: 'currency',
              currency: currencySelect.value.toUpperCase(),
            }).format(amount / 100)
          : document.documentElement.lang === 'en'
            ? 'Coming soon'
            : 'Em breve';
        button.disabled = !priceReady[`${button.dataset.plan}_${currencySelect.value}`];
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((button) =>
      button.addEventListener('click', async () => {
        try {
          const result = await checkout(
            button.dataset.plan,
            document.querySelector<HTMLSelectElement>('#currency')!.value,
          );
          location.href = result.url;
        } catch (error) {
          reportError(error, 'Falha ao iniciar compra');
        }
      }),
    );
    document.querySelector('#portal')?.addEventListener('click', async () => {
      try {
        const result = await billingPortal();
        location.href = result.url;
      } catch (error) {
        reportError(error, 'Falha ao abrir cobrança');
      }
    });
    document
      .querySelector<HTMLFormElement>('#delete-account-form')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const deletionForm = event.currentTarget as HTMLFormElement;
        const email = input(deletionForm, 'email');
        const warning =
          document.documentElement.lang === 'en'
            ? 'Delete your account, page and images? Any subscription will be canceled.'
            : 'Excluir sua conta, página e imagens? Sua assinatura será cancelada.';
        if (!confirm(warning)) return;
        try {
          await deleteAccount(email);
          location.href = '/';
        } catch (error) {
          reportError(error, 'Falha ao excluir a conta');
        }
      });
    const metrics = getMetrics();
    metrics
      .then((data) => {
        document.querySelector('#metric-views')!.textContent = String(data.views ?? 0);
        document.querySelector('#metric-clicks')!.textContent = String(data.clicks ?? 0);
      })
      .catch(() => {});
    domainStatus()
      .then((data) => {
        if (!data.domain) return;
        const node = document.querySelector<HTMLElement>('#domain-status')!;
        node.hidden = false;
        node.textContent = `${data.domain.hostname}: ${data.domain.status}/${data.domain.sslStatus}`;
      })
      .catch(() => {});
    document
      .querySelector<HTMLAnchorElement>('#export-data')
      ?.addEventListener('click', async (event) => {
        event.preventDefault();
        try {
          const file = await exportAccount();
          const url = URL.createObjectURL(file);
          const link = document.createElement('a');
          link.href = url;
          link.download = 'vira-dados.json';
          link.click();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
        } catch (error) {
          reportError(error, 'Falha ao baixar dados');
        }
      });
  </script>
</Base>
