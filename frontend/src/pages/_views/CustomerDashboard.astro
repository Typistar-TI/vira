      plans: 'Plano e cobrança',
      monthly: 'Mensal',
      yearly: 'Anual',
      lifetime: 'Vitalício',
      portal: 'Gerenciar assinatura',
      domain: 'Domínio próprio',
      domainHint: 'Disponível após o pagamento. Use um endereço como www.exemplo.com.br.',
      connect: 'Conectar domínio',
      address: 'Subdomínio Vira',
      change: 'Alterar endereço',
      metrics: 'Últimos 30 dias',
      views: 'Visualizações',
      clicks: 'Cliques nos botões',
      aiAssistant: 'Assistente de IA',
      aiHint:
        'Um assistente de chat acompanha sua página publicada. Ele responde aos visitantes com base no conteúdo que você escreve aqui. Publique para atualizar o que ele sabe.',
      account: 'Conta e dados',
      exportData: 'Baixar meus dados',
      deleteAccount: 'Excluir conta',
      confirmEmail: 'Digite seu e-mail para confirmar',
      privacy: 'Privacidade',
      identity: 'Identidade do site e aplicativo',
      identityHint:
        'As alterações aparecem no site público depois de publicar. Os visitantes poderão instalá-lo no celular.',
      favicon: 'Ícone do navegador (favicon)',
      logo: 'Logo do projeto',
      logoHint:
        'A logo aparece na sua página. Você pode autorizar a exibição na vitrine do Vira abaixo.',
      showcaseConsent: 'Mostrar minha página publicada e logo na vitrine do Vira',
      appIcon: 'Ícone do aplicativo (PWA)',
      appName: 'Nome mostrado após instalar',
      iconHint:
        'Escolha uma imagem quadrada PNG, JPG ou WebP. O Vira prepara os tamanhos para celular.',
      browserColor: 'Cor da barra do navegador',
      pageColor: 'Fundo da página',
      textColor: 'Cor do texto',
      accentColor: 'Cor de destaque',
    };
const trialDays = Math.max(0, Math.ceil((user.trial_ends_at * 1000 - Date.now()) / 86400000));
const trialLeft = en
  ? `${trialDays} ${trialDays === 1 ? 'day left in your trial' : 'days left in your trial'}`
  : `${trialDays} ${trialDays === 1 ? 'dia restante de teste' : 'dias restantes de teste'}`;
---

<Base
  title={`${t.dashboard} · Vira`}
  lang={en ? 'en' : 'pt'}
  noindex
  appearance="light"
  manifest="/app/manifest.webmanifest"
>
  <div class="min-h-screen bg-white text-[#17130d]">
    <CustomerHeader email={user.email ?? (en ? 'Legacy account' : 'Conta antiga')} en={en} />
    <main class="customer-dashboard mx-auto min-w-0 max-w-[1380px] px-5 pb-24 pt-8 sm:px-8">
      <h1 class="sr-only">{t.dashboard}</h1>
      {!active && (
        <div class="alert alert-error my-3 [hidden]:hidden mb-5">
          {en
            ? 'Your page is suspended. Choose a plan to publish it again.'
            : 'Sua página está suspensa. Escolha um plano para publicá-la novamente.'}
        </div>
      )}
      <div class="grid items-start gap-6 xl:grid-cols-[minmax(360px,520px)_minmax(0,1fr)]">
        <div>
          <section class="card rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2>{t.address}</h2>
            <p class="text-sm text-[#625a51]">
              {t.publicLink}:{' '}
              <a
                id="public-url"
                href={`https://${site.slug}.${domain}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {site.slug}.{domain}
              </a>
            </p>
            <form id="slug-form" class="mt-4 flex flex-col gap-2 sm:flex-row">
              <input
                class="input input-bordered flex-1"
                name="slug"
                value={site.slug}
                aria-label={t.address}
                required
              />
              <button class="btn btn-outline" type="submit">
                {t.change}
              </button>
            </form>
          </section>
          <section class="card rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2>{t.metrics}</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <strong id="metric-views" class="font-[Outfit] text-4xl font-medium text-[#17130d]">
                  —
                </strong>
                <p class="text-[#625a51]">{t.views}</p>
              </div>
              <div>
                <strong
                  id="metric-clicks"
                  class="font-[Outfit] text-4xl font-medium text-[#17130d]"
                >
                  —
                </strong>
                <p class="text-[#625a51]">{t.clicks}</p>
              </div>
            </div>
          </section>
          <section class="card mb-5 rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <h2>{t.aiAssistant}</h2>
            <p>{t.aiHint}</p>
          </section>
          <form
            id="editor"
            class="card rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5"
            data-initial={JSON.stringify(content)}
          >
            <h2>{t.content}</h2>
            <label for="layout">{t.layout}</label>
            <select class="select select-bordered" name="layout" id="layout">
              <option value="guardiao" selected={content.layout === 'guardiao'}>
                {t.layoutGuardiao}
              </option>
              <option value="central" selected={content.layout === 'central'}>
                {t.layoutCentral}
              </option>
              <option value="perfil" selected={content.layout === 'perfil'}>
                {t.layoutPerfil}
              </option>
              <option value="estudio" selected={content.layout === 'estudio'}>
                {t.layoutEstudio}
              </option>
              <option value="classico" selected={content.layout === 'classico'}>
                {t.layoutClassico}
              </option>
            </select>
            <label for="font">{t.font}</label>
            <select class="select select-bordered" name="font" id="font">
              <option value="outfit" selected={content.font === 'outfit'}>
                Outfit
              </option>
              <option value="bricolage" selected={content.font === 'bricolage'}>
                Bricolage Grotesque + Manrope
              </option>
              <option value="inter" selected={content.font === 'inter'}>
                Inter
              </option>
              <option value="instrument" selected={content.font === 'instrument'}>
                Instrument Serif + Manrope
              </option>
              <option value="gilda" selected={content.font === 'gilda'}>
                Gilda Display
              </option>
            </select>
            <label for="language">{t.language}</label>
            <select class="select select-bordered" name="language" id="language">
              <option value="pt" selected={content.language === 'pt'}>
                Português
              </option>
              <option value="en" selected={content.language === 'en'}>
                English
              </option>
            </select>
            <h3>{t.identity}</h3>
            <p class="text-sm text-[#625a51]">{t.identityHint}</p>
            <label for="logo-file">{t.logo}</label>
            <input
              class="file-input file-input-bordered w-full"
              id="logo-file"
              type="file"
              accept="image/jpeg,image/png,image/webp"
            />
            <input type="hidden" name="logo" value={content.logo} />
            {content.logo && (
              <img
                src={content.logo}
                alt=""
                width="120"
                height="80"
                class="mt-2 h-20 w-30 rounded-lg border border-[#d8ae73] object-contain p-2"
              />
            )}
            <small>{t.logoHint}</small>
            <label class="mt-4 flex items-start gap-3 text-sm font-medium text-[#17130d]">
              <input
                class="checkbox checkbox-primary mt-0.5 shrink-0 border border-[#b88333]"
                name="showInShowcase"
                type="checkbox"
                checked={content.showInShowcase}
              />
              <span>{t.showcaseConsent}</span>
            </label>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="favicon-file">{t.favicon}</label>
                <input
                  class="file-input file-input-bordered w-full"
                  id="favicon-file"
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                />
                <input type="hidden" name="favicon" value={content.favicon} />
                {content.favicon && (
                  <img
                    src={content.favicon}
                    alt=""
                    width="48"
                    height="48"
                    class="mt-2 rounded-lg border border-[#d8ae73]"
                  />
                )}
              </div>
              <div>
                <label for="pwa-icon-file">{t.appIcon}</label>
                <input
                  class="file-input file-input-bordered w-full"
                  id="pwa-icon-file"
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                />
                <input type="hidden" name="pwaIcon192" value={content.pwaIcon192} />
                <input type="hidden" name="pwaIcon512" value={content.pwaIcon512} />
                {content.pwaIcon192 && (
                  <img
                    src={content.pwaIcon192}
                    alt=""
                    width="48"
                    height="48"
                    class="mt-2 rounded-lg border border-[#d8ae73]"
                  />
                )}
              </div>
            </div>
            <small>{t.iconHint}</small>
            <label for="appName">{t.appName}</label>
            <input
              class="input input-bordered"
              id="appName"
              name="appName"
              maxlength="50"
              value={content.appName}
              placeholder={content.title}
            />
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="themeColor">{t.browserColor}</label>
                <input
                  class="input input-bordered h-12 p-1"
                  id="themeColor"
                  name="themeColor"
                  type="color"
                  value={content.themeColor}
                />
              </div>
              <div>
                <label for="backgroundColor">{t.pageColor}</label>
                <input
                  class="input input-bordered h-12 p-1"
                  id="backgroundColor"
                  name="backgroundColor"
                  type="color"
                  value={content.backgroundColor}
                />
              </div>
              <div>
                <label for="textColor">{t.textColor}</label>
                <input
                  class="input input-bordered h-12 p-1"
                  id="textColor"
                  name="textColor"
                  type="color"
                  value={content.textColor}
                />
              </div>
              <div>
                <label for="accentColor">{t.accentColor}</label>
                <input
                  class="input input-bordered h-12 p-1"
                  id="accentColor"
                  name="accentColor"
                  type="color"
                  value={content.accentColor}
                />
              </div>
            </div>
            <label for="eyebrow">{t.eyebrow}</label>
            <input
              class="input input-bordered"
              id="eyebrow"
              name="eyebrow"
              maxlength="60"
              value={content.eyebrow}
            />
            <label for="title">{t.title}</label>
            <input
              class="input input-bordered"
              id="title"
              name="title"
              maxlength="100"
              value={content.title}
              required
            />
            <label for="subtitle">{t.subtitle}</label>
            <textarea
              class="textarea textarea-bordered"
              id="subtitle"
              name="subtitle"
              maxlength="300"
            >{content.subtitle}</textarea>
            <label for="hero-file">{t.hero}</label>
            <input
              class="file-input file-input-bordered w-full"
              id="hero-file"
              type="file"
              accept="image/jpeg,image/png,image/webp"
            />
            <input type="hidden" name="heroImage" value={content.heroImage} />
            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <label for="primaryLabel">{t.buttonText}</label>
                <input
                  class="input input-bordered"
                  id="primaryLabel"
                  name="primaryLabel"
                  maxlength="40"
                  value={content.primaryLabel}
                />
              </div>
              <div>
                <label for="primaryUrl">{t.buttonUrl}</label>
                <input
                  class="input input-bordered"
                  id="primaryUrl"
                  name="primaryUrl"
                  type="url"
                  placeholder="https://"
                  value={content.primaryUrl}
                />
              </div>
            </div>
            <label for="snippet">{t.snippet}</label>
            <textarea
              class="textarea textarea-bordered"
              id="snippet"
              name="snippet"
              maxlength="300"
            >{content.snippet}</textarea>
            <h3>{t.about}</h3>
            <label for="aboutTitle">{t.aboutTitle}</label>
            <input
              class="input input-bordered"
              id="aboutTitle"
              name="aboutTitle"
              value={content.aboutTitle}
              maxlength="80"
            />
            <label for="about">{t.aboutBody}</label>
            <textarea
              class="textarea textarea-bordered"
              id="about"
              name="about"
              maxlength="1500"
            >{content.about}</textarea>
            <h3>{t.benefits}</h3>
            <div id="benefits-list">
              {content.benefits.map((item) => (
                <fieldset data-item="benefit" class="border border-base-300 rounded-xl p-3 mb-2">
                  <input
                    class="input input-bordered mb-2"
                    name="item-title"
                    value={item.title}
                    placeholder={t.title}
                    maxlength="80"
                  />
                  <textarea
                    class="textarea textarea-bordered"
                    name="item-description"
                    placeholder={t.description}
                    maxlength="240"
                  >{item.description}</textarea>
                  <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
                    {t.remove}
                  </button>
                </fieldset>
              ))}
            </div>
            <button class="btn btn-outline btn-sm" type="button" data-add="benefit">
              + {t.add}
            </button>
            <h3>{t.stats}</h3>
            <div id="stats-list">
              {content.stats.map((item) => (
                <fieldset data-item="stat" class="border border-base-300 rounded-xl p-3 mb-2">
                  <div class="grid gap-3 sm:grid-cols-2">
                    <input
                      class="input input-bordered"
                      name="item-value"
                      value={item.value}
                      placeholder={t.value}
                      maxlength="20"
                    />
                    <input
                      class="input input-bordered"
                      name="item-label"
                      value={item.label}
                      placeholder={t.label}
                      maxlength="60"
                    />
                  </div>
                  <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
                    {t.remove}
                  </button>
                </fieldset>
              ))}
            </div>
            <button class="btn btn-outline btn-sm" type="button" data-add="stat">
              + {t.add}
            </button>
            <h3>{t.testimonials}</h3>
            <div id="testimonials-list">
              {content.testimonials.map((item) => (
                <fieldset
                  data-item="testimonial"
                  class="border border-base-300 rounded-xl p-3 mb-2"
                >
                  <textarea
                    class="textarea textarea-bordered mb-2"
                    name="item-quote"
                    placeholder={t.quote}
                    maxlength="300"
                  >{item.quote}</textarea>
                  <input
                    class="input input-bordered"
                    name="item-name"
                    value={item.name}
                    placeholder={t.name}
                    maxlength="80"
                  />
                  <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
                    {t.remove}
                  </button>
                </fieldset>
              ))}
            </div>
            <button class="btn btn-outline btn-sm" type="button" data-add="testimonial">
              + {t.add}
            </button>
            <h3>{t.products}</h3>
            <div id="products-list">
              {content.products.map((item) => (
                <fieldset data-item="product" class="border border-base-300 rounded-xl p-3 mb-2">
                  <input
                    class="input input-bordered mb-2"
                    name="item-title"
                    value={item.title}
                    placeholder={t.title}
                    maxlength="80"
                  />
                  <textarea
                    class="textarea textarea-bordered mb-2"
                    name="item-description"
                    placeholder={t.description}
                    maxlength="300"
                  >{item.description}</textarea>
                  <input
                    class="input input-bordered mb-2"
                    name="item-url"
                    type="url"
                    value={item.url}
                    placeholder="https://"
                  />
                  <input
                    class="file-input file-input-bordered w-full"
                    name="item-file"
                    type="file"
                    accept="image/jpeg,image/png,image/webp"
                  />
                  <input type="hidden" name="item-image" value={item.image} />
                  <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
                    {t.remove}
                  </button>
                </fieldset>
              ))}
            </div>
            <button class="btn btn-outline btn-sm" type="button" data-add="product">
              + {t.add}
            </button>
            <h3>{t.steps}</h3>
            <div id="steps-list">
              {content.steps.map((item) => (
                <fieldset data-item="step" class="border border-base-300 rounded-xl p-3 mb-2">
