      lifetime: 'Lifetime',
      portal: 'Manage subscription',
      domain: 'Custom domain',
      domainHint: 'Available after payment. Use an address such as www.example.com.',
      connect: 'Connect domain',
      address: 'Vira subdomain',
      change: 'Change address',
      metrics: 'Last 30 days',
      views: 'Views',
      clicks: 'Button clicks',
      aiAssistant: 'AI assistant',
      aiHint:
        'A chat assistant is included on your published page. It answers visitors using the content you write here. Publish to update what it knows.',
      account: 'Account and data',
      exportData: 'Download my data',
      deleteAccount: 'Delete account',
      confirmEmail: 'Type your email to confirm',
      privacy: 'Privacy',
      identity: 'Site identity and app',
      identityHint:
        'These changes appear on your public site after you publish. Visitors can install it on their phones.',
      favicon: 'Browser icon (favicon)',
      logo: 'Project logo',
      logoHint: 'Your logo appears on your page. Allow it in the Vira showcase below if you wish.',
      showcaseConsent: 'Show my published page and logo in the Vira showcase',
      appIcon: 'App icon (PWA)',
      appName: 'Name shown when installed',
      iconHint: 'Choose a square PNG, JPG or WebP image. Vira prepares the sizes for phones.',
      browserColor: 'Browser bar color',
      pageColor: 'Page background',
