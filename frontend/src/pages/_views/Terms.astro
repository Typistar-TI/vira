---
import Base from '@frontend/components/Base.astro';
import SiteHeader from '@frontend/components/SiteHeader.astro';
import CustomerHeader from '@frontend/components/CustomerHeader.astro';
import AdminHeader from '@frontend/components/AdminHeader.astro';
import CookieNotice from '@frontend/components/CookieNotice.astro';
import SiteFooter from '@frontend/components/SiteFooter.astro';
import { getSetting } from '@frontend/api/config/setting';
import { sessionAdmin } from '@frontend/api/auth/session-admin';
import { sessionUser } from '@frontend/api/auth/session-user';
interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;
const en = lang === 'en';
const [adminSession, userSession] = await Promise.all([
  sessionAdmin(Astro.request),
  sessionUser(Astro.request),
]);
const hasAdmin = Boolean(adminSession);
const hasUser = Boolean(userSession);
const signedIn = hasAdmin || hasUser;
const dashboardHref = hasUser ? '/app' : hasAdmin ? '/admin' : '/login';
const [controller, contact, email, termsPt, termsEn] = await Promise.all([
  getSetting('PRIVACY_CONTROLLER_NAME'),
  getSetting('CONTACT_EMAIL'),
  getSetting('PRIVACY_CONTACT_EMAIL'),
  getSetting('TERMS_OF_USE'),
  getSetting('TERMS_OF_USE_EN'),
]);
const policy = en ? termsEn || termsPt : termsPt;
const mail = contact || email;
const body = policy.trim() ? policy.trim().split(/\n{2,}/) : [];
---

<Base title={en ? 'Terms of Use · Vira' : 'Termos de Uso · Vira'} lang={lang} appearance="light">
  <div class="min-h-screen bg-white text-[#17130d]">
    {hasAdmin && adminSession ? (
      <AdminHeader
        section="conta"
        admin={{
          email: adminSession.email,
          displayName: adminSession.displayName,
          avatar: adminSession.avatar,
        }}
      />
    ) : hasUser && userSession ? (
      <CustomerHeader
        email={userSession.email ?? ''}
        displayName={userSession.display_name ?? ''}
        avatar={userSession.avatar}
        en={en}
        section="conta"
      />
    ) : (
      <SiteHeader
        lang={lang}
        signedIn={signedIn}
        dashboardHref={dashboardHref}
        hasAdmin={hasAdmin}
        hasUser={hasUser}
      />
    )}
    <main
      class:list={['mx-auto max-w-[1380px] px-5 sm:px-8', signedIn ? 'pt-8 pb-24' : 'pt-10 pb-16']}
    >
      <article class="w-full break-words">
        <span class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#17130d]">Vira</span>
        <h1 class="mt-2 mb-6 text-4xl">{en ? 'Terms of Use' : 'Termos de Uso'}</h1>
        {mail && (
          <p>
            {en ? 'Service contact' : 'Contato do serviço'}: <a href={`mailto:${mail}`}>{mail}</a>.
          </p>
        )}
        {body.map((paragraph) => (
          <p class="mt-4 whitespace-pre-line leading-relaxed text-[#4f473e]">{paragraph}</p>
        ))}
        {controller && (
          <p class="mt-6 text-sm text-[#625a51]">
            {en ? 'Provider' : 'Responsável'}: <strong>{controller}</strong>.
          </p>
        )}
      </article>
    </main>
    {!signedIn && <SiteFooter lang={lang} />}
  </div>
  <CookieNotice lang={lang} />
</Base>
