---
import Base from '@frontend/components/Base.astro';
import Brand from '@frontend/components/Brand.astro';
import CookieNotice from '@frontend/components/CookieNotice.astro';
import { getSetting } from '@frontend/api/config/setting';
interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;
const en = lang === 'en';
const [controller, contact, email, policy] = await Promise.all([
  getSetting('PRIVACY_CONTROLLER_NAME'),
  getSetting('CONTACT_EMAIL'),
  getSetting('PRIVACY_CONTACT_EMAIL'),
  getSetting('TERMS_OF_USE'),
]);
const mail = contact || email;
const defaultText = en
  ? [
      'By creating an account you agree to use Vira lawfully and not to publish illegal, harmful or misleading content.',
      'You are responsible for the content you publish and for keeping your access credentials safe. Vira provides the platform as is, may suspend accounts that break these rules, and offers a one-day free trial followed by the plan you choose.',
      'These terms may be updated; continued use after an update means acceptance of the new version.',
    ]
  : [
      'Ao criar uma conta você concorda em usar o Vira de forma legal e em não publicar conteúdo ilegal, nocivo ou enganoso.',
      'Você é responsável pelo conteúdo que publica e por manter suas credenciais de acesso seguras. O Vira fornece a plataforma como está, pode suspender contas que violem estas regras e oferece um dia de teste grátis seguido do plano escolhido.',
      'Estes termos podem ser atualizados; continuar usando após uma atualização significa aceitar a nova versão.',
    ];
const body = policy.trim() ? policy.trim().split(/\n{2,}/) : defaultText;
---

<Base title={en ? 'Terms of Use · Vira' : 'Termos de Uso · Vira'} lang={lang} appearance="light">
  <div class="min-h-screen bg-white text-[#17130d]">
    <header class="mx-auto flex max-w-[1380px] items-center justify-between gap-5 border-b border-[#d8ae73] px-5 py-4 sm:px-8">
      <Brand tone="light" />
      <nav class="flex gap-5 text-sm">
        <a class="hover:text-[#9b6823]" href={en ? '/en/privacy' : '/privacidade'}>
          {en ? 'Privacy' : 'Privacidade'}
        </a>
      </nav>
    </header>
    <main class="mx-auto max-w-[1380px] px-5 py-12 sm:px-8">
      <article class="max-w-3xl break-words">
        <span class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#17130d]">Vira</span>
        <h1 class="mt-2 mb-6 text-4xl">{en ? 'Terms of Use' : 'Termos de Uso'}</h1>
        {mail && (
          <p>
            {en ? 'Service contact' : 'Contato do serviço'}: <a href={`mailto:${mail}`}>{mail}</a>.
          </p>
        )}
        {body.map((paragraph) => (
          <p class="mt-4 whitespace-pre-line leading-relaxed text-[#4f473e]">{paragraph}</p>
        ))}
        {controller && (
          <p class="mt-6 text-sm text-[#625a51]">
            {en ? 'Provider' : 'Responsável'}: <strong>{controller}</strong>.
          </p>
        )}
        <p class="mt-8">
          <a class="btn btn-primary rounded-xl border-0 font-bold shadow-none" href="/app">
            {en ? 'Go to dashboard' : 'Ir ao painel'}
          </a>
        </p>
      </article>
    </main>
  </div>
  <CookieNotice lang={lang} />
</Base>
