---
import CustomerDashboard from '@frontend/pages/_views/CustomerDashboard.astro';
import { sessionUser } from '@frontend/api/auth/session-user';
import { siteForUser } from '@frontend/api/sites/site-for-user';

const section = Astro.params.section;
if (section === 'conteudo') return Astro.redirect('/app');
if (!section || !['plano', 'dominio', 'conta'].includes(section)) return Astro.rewrite('/404');
const user = await sessionUser(Astro.request);
if (!user) return Astro.redirect('/login?next=app');
const site = await siteForUser(user.id);
if (!site) return Astro.rewrite('/404');
---

<CustomerDashboard user={user} site={site} section={section} />
