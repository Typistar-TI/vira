---
import Base from '@frontend/layouts/Base.astro';
import SitePage from '@frontend/components/SitePage.astro';
import { getSessionUser } from '@backend/auth';
import { getSiteForUser } from '@backend/db';
import { parseSite } from '@shared/site';
const user = await getSessionUser(Astro.request);
if (!user) return Astro.redirect('/login');
const site = await getSiteForUser(user.id);
if (!site) return new Response('Página não encontrada', { status: 404 });
const content = parseSite(JSON.parse(site.draft_json));
---
<Base title={`Prévia — ${content.title}`} lang={content.language} noindex><SitePage content={content} preview /></Base>
