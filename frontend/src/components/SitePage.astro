---
import { fontStacks, type SiteContent } from '@frontend/api/sites/parse-site';
import Section from '@frontend/components/sections/Section.astro';

interface Props {
  content: SiteContent;
  preview?: boolean;
}
const { content, preview = false } = Astro.props;

function luminance(hex: string): number {
  const value = hex.replace('#', '');
  const channels = [0, 2, 4].map((offset) => parseInt(value.slice(offset, offset + 2), 16) / 255);
  const [r, g, b] = channels.map((channel) =>
    channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4,
  );
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}
const tone = luminance(content.backgroundColor) < 0.42 ? 'dark' : 'light';
const fonts = fontStacks[content.font];
const brand = (content.appName || content.title).trim();

let productIndex = 0;
const rendered = content.sections.map((section) => {
  const offset = productIndex;
  if (section.type === 'services') productIndex += section.items.length;
  return { section, offset };
});
---

<div
  class="vira-site"
  data-tone={tone}
  style={`--bg:${content.backgroundColor};--fg:${content.textColor};--accent:${content.accentColor};--surface:color-mix(in srgb, var(--bg) 93%, var(--fg));--soft:color-mix(in srgb, var(--bg) 86%, var(--accent));--line:color-mix(in srgb, var(--fg) 16%, transparent);--muted:color-mix(in srgb, var(--fg) 62%, transparent);--font-display:${fonts.display};--font-body:${fonts.body};--font-mono:${fonts.mono};font-family:var(--font-body)`}
>
  {rendered.map(({ section, offset }) => (
    <Section section={section} preview={preview} productOffset={offset} brand={brand} />
  ))}
  {content.sections.length === 0 && (
    <section class="empty">
      <h1>{content.title}</h1>
      <p>Adicione blocos para montar sua página.</p>
    </section>
  )}
</div>
<style>
  .vira-site {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--bg);
    color: var(--fg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .vira-site *,
  .vira-site *::before,
  .vira-site *::after {
    box-sizing: border-box;
  }
  .vira-site a {
    color: inherit;
  }
  .vira-site img {
    max-width: 100%;
  }
  .empty {
    padding: clamp(64px, 12vw, 160px) 24px;
    text-align: center;
  }
</style>
