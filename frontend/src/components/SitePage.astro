---
import { fontStacks, type SiteContent } from '@frontend/api/sites/parse-site';
import Guardiao from '@frontend/components/templates/Guardiao.astro';
import Central from '@frontend/components/templates/Central.astro';
import Perfil from '@frontend/components/templates/Perfil.astro';
import Estudio from '@frontend/components/templates/Estudio.astro';
import Classico from '@frontend/components/templates/Classico.astro';

interface Props {
  content: SiteContent;
  preview?: boolean;
}
const { content, preview = false } = Astro.props;

const templates = {
  guardiao: Guardiao,
  central: Central,
  perfil: Perfil,
  estudio: Estudio,
  classico: Classico,
};
const Template = templates[content.layout];

function luminance(hex: string): number {
  const value = hex.replace('#', '');
  const channels = [0, 2, 4].map((offset) => parseInt(value.slice(offset, offset + 2), 16) / 255);
  const [r, g, b] = channels.map((channel) =>
    channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4,
  );
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}
const tone = luminance(content.backgroundColor) < 0.42 ? 'dark' : 'light';
const fonts = fontStacks[content.font];
---

<div
  class="vira-template"
  data-tone={tone}
  style={`--bg:${content.backgroundColor};--fg:${content.textColor};--accent:${content.accentColor};--surface:color-mix(in srgb, var(--bg) 93%, var(--fg));--soft:color-mix(in srgb, var(--bg) 86%, var(--accent));--line:color-mix(in srgb, var(--fg) 16%, transparent);--muted:color-mix(in srgb, var(--fg) 62%, transparent);--font-display:${fonts.display};--font-body:${fonts.body};--font-mono:${fonts.mono};--sans:var(--font-body);--serif:var(--font-display);--mono:var(--font-mono);font-family:var(--font-body)`}
>
  <Template content={content} preview={preview} />
</div>
<style>
  /* Templates own their grids, not DaisyUI's overlapping .hero cells. */
  .vira-template :global(.hero > *) {
    grid-area: auto;
  }
</style>
