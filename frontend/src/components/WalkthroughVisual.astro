---
interface Props {
  index: number;
  lang: 'pt' | 'en';
}
const { index, lang } = Astro.props;
const en = lang === 'en';
const mockBlocks = [
  en ? 'Hero' : 'Herói',
  en ? 'About' : 'Sobre',
  en ? 'Services' : 'Serviços',
  en ? 'Gallery' : 'Galeria',
  en ? 'Contact' : 'Contato',
];
const label = (pt: string, ingl: string) => (en ? ingl : pt);
---

<div class="overflow-hidden rounded-2xl border border-[#eee7dc] bg-white">
  <div class="flex items-center gap-2 border-b border-[#eee7dc] px-4 py-2.5">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-[#e5ded2]" />
      <span class="h-2.5 w-2.5 rounded-full bg-[#e5ded2]" />
      <span class="h-2.5 w-2.5 rounded-full bg-[#e5ded2]" />
    </span>
    <span class="ml-2 flex-1 truncate rounded-full bg-[#f5f2eb] px-3 py-1 font-mono text-[10px] text-[#8b8174]">
      vira.ia.br
    </span>
  </div>
  <div class="bg-[#fbf9f5] p-5">
    {index === 0 && (
      <>
        <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#9b6823]">
          {label('Adicione blocos', 'Add blocks')}
        </p>
        <div class="flex flex-col gap-2">
          {mockBlocks.map((item) => (
            <div class="flex items-center gap-3 rounded-xl border border-[#e5ded2] bg-white px-3 py-2.5">
              <span class="grid h-7 w-7 place-items-center rounded-lg bg-[#f5f2eb] text-[11px] text-[#8b8174]">
                ≡
              </span>
              <span class="text-sm font-medium">{item}</span>
              <span class="ml-auto text-[#b88333]">＋</span>
            </div>
          ))}
        </div>
      </>
    )}
    {index === 1 && (
      <>
        <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#9b6823]">
          {label('Edite o conteúdo', 'Edit the content')}
        </p>
        <div class="flex flex-col gap-3 rounded-2xl border border-[#e5ded2] bg-white p-4">
          <span class="text-xs font-bold text-[#4a4238]">{label('Título', 'Headline')}</span>
          <span class="rounded-lg border border-[#e5ded2] px-3 py-2 text-sm">
            {label('Sua ideia, no ar.', 'Your idea, online.')}
            <span class="ml-0.5 inline-block h-4 w-px animate-pulse bg-[#b88333] align-middle" />
          </span>
          <span class="text-xs font-bold text-[#4a4238]">{label('Texto', 'Text')}</span>
          <span class="rounded-lg border border-[#e5ded2] px-3 py-2 text-sm text-[#766c60]">
            {label(
              'Apresente seu trabalho em uma página clara e simples.',
              'Present your work in a clear, simple page.',
            )}
          </span>
        </div>
      </>
    )}
    {index === 2 && (
      <>
        <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#9b6823]">
          {label('Publique', 'Publish')}
        </p>
        <div class="flex flex-col gap-3 rounded-2xl border border-[#e5ded2] bg-white p-4">
          <span class="flex items-center gap-2 text-sm font-medium">
            <span class="grid h-5 w-5 place-items-center rounded-full bg-[#17130d] text-[11px] text-white">
              ✓
            </span>
            {label('Publicado!', 'Published!')}
          </span>
          <span class="rounded-lg bg-[#f5f2eb] px-3 py-2 font-mono text-xs text-[#8b8174]">
            {label('sua-pagina', 'your-page')}.vira.ia.br
          </span>
          <div class="mt-1 rounded-xl border border-[#eee7dc] p-3">
            <span class="block text-base font-medium">
              {label('Sua ideia, no ar.', 'Your idea, online.')}
            </span>
            <span class="mt-1 block text-xs text-[#766c60]">
              {label(
                'Seus visitantes podem perguntar qualquer coisa à assistente de IA.',
                'Your visitors can ask the AI assistant anything.',
              )}
            </span>
          </div>
        </div>
      </>
    )}
    {index > 2 && (
      <div class="flex min-h-[220px] items-center justify-center rounded-2xl border border-dashed border-[#e5ded2] text-sm text-[#8b8174]">
        {label('Pronto para publicar.', 'Ready to publish.')}
      </div>
    )}
  </div>
</div>
