---
interface Props {
  lang: 'pt' | 'en';
  heading: string;
  intro: string;
  steps: {
    title: string;
    text: string;
    image?: string;
    alt?: string;
  }[];
}

const { lang, heading, intro, steps } = Astro.props;
const en = lang === 'en';
---

<section id="como-funciona" class="bg-white py-12 sm:py-16" aria-labelledby="walkthrough-heading">
  <div class="mx-auto max-w-[1380px] px-5 sm:px-8">
    <div class="mx-auto mb-8 max-w-[840px] text-center sm:mb-10" data-reveal>
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#9b6823]">
        {en ? 'See it for yourself' : 'Veja como funciona'}
      </p>
      <h2
        id="walkthrough-heading"
        class="mt-3 font-['Outfit',sans-serif] text-[clamp(1.75rem,3vw,2.5rem)] font-medium leading-tight tracking-[-0.04em] text-[#17130d]"
      >
        {heading}
      </h2>
      <p class="mx-auto mt-3 max-w-[60ch] text-sm leading-relaxed text-[#625a51]">{intro}</p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {steps.map((step, i) => (
        <article
          class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-[#ead8bf] bg-[#fffdf9]"
          aria-labelledby={`walkthrough-step-${i + 1}`}
        >
          {step.image && (
            <a
              href={step.image}
              target="_blank"
              rel="noopener"
              class="block bg-white focus-visible:outline-2 focus-visible:outline-[#b88333]"
              aria-label={en ? `Enlarge: ${step.alt}` : `Ampliar: ${step.alt}`}
            >
              <img
                src={step.image}
                width="1200"
                height="800"
                loading="lazy"
                alt={step.alt}
                class="aspect-[3/2] w-full object-contain"
              />
            </a>
          )}
          <div class="flex flex-1 flex-col px-5 py-5">
            <h3
              id={`walkthrough-step-${i + 1}`}
              class="font-['Outfit',sans-serif] text-xl font-medium leading-tight tracking-[-0.03em] text-[#17130d]"
            >
              {step.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-[#625a51]">{step.text}</p>
            {i === 2 && (
              <div class="mt-auto pt-5">
                <a
                  href="/login"
                  class="inline-flex min-h-10 items-center gap-2 rounded-full bg-[#b88333] px-5 text-sm font-semibold text-white transition-colors hover:bg-[#9b6823] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b88333]"
                >
                  {en ? 'Create your page' : 'Criar minha página'}
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
