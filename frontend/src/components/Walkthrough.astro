---
interface Props {
  lang: 'pt' | 'en';
  heading: string;
  intro: string;
  steps: { title: string; text: string; image?: string; alt?: string }[];
}
const { lang, heading, intro, steps } = Astro.props;
const en = lang === 'en';
const templates = [
  {
    key: 'central',
    name: 'Central',
    description: en
      ? 'A clear home for your product.'
      : 'Um lugar claro para apresentar seu produto.',
  },
  {
    key: 'guardiao',
    name: 'Guardião',
    description: en ? 'Show what your service can do.' : 'Mostre o que seu serviço pode fazer.',
  },
  {
    key: 'perfil',
    name: 'Perfil',
    description: en ? 'Your experience, front and center.' : 'Sua experiência em primeiro plano.',
  },
  {
    key: 'estudio',
    name: 'Estúdio',
    description: en
      ? 'A space for your creative identity.'
      : 'Um espaço para sua identidade criativa.',
  },
  {
    key: 'classico',
    name: 'Clássico',
    description: en ? 'Your page and your AI, together.' : 'Sua página e sua IA, juntas.',
  },
];
---

<section
  id="como-funciona"
  class="template-experience"
  aria-labelledby="walkthrough-heading"
  data-template-experience
>
  <div class="experience-wrap">
    <header class="experience-heading" data-reveal>
      <div>
        <p class="eyebrow">
          {en ? 'A starting point. Your own identity.' : 'Um ponto de partida. A sua identidade.'}
        </p>
        <h2 id="walkthrough-heading">{heading}</h2>
      </div>
      <p class="experience-intro">{intro}</p>
    </header>

    <div class="template-toolbar">
      <div
        class="template-tabs"
        role="tablist"
        aria-label={en ? 'Explore templates' : 'Explore os templates'}
      >
        {templates.map((template, index) => (
          <button
            type="button"
            role="tab"
            id={`template-tab-${template.key}`}
            aria-controls={`template-panel-${template.key}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-template-tab={index}
          >
            <span class={`template-dot dot-${template.key}`} aria-hidden="true"></span>
            {template.name}
          </button>
        ))}
      </div>
      <span class="template-count">
        {en ? '5 templates. Endless possibilities.' : '5 templates. Infinitas possibilidades.'}
      </span>
    </div>

    <div class="template-stage">
      {templates.map((template, index) => (
        <div
          role="tabpanel"
          id={`template-panel-${template.key}`}
          aria-labelledby={`template-tab-${template.key}`}
          data-template-panel={index}
          hidden={index !== 0}
          tabindex="0"
        >
          <a
            class="template-capture"
            href={`/template-previews/${template.key}.webp`}
            target="_blank"
            rel="noopener"
            aria-label={
              en ? `Enlarge ${template.name} preview` : `Ampliar prévia do ${template.name}`
            }
          >
            <picture>
              <source
                media="(max-width:767px)"
                srcset={`/template-previews/${template.key}-mobile.webp`}
              />
              <img
                src={`/template-previews/${template.key}.webp`}
                width="1440"
                height="900"
                loading="lazy"
                alt={
                  en
                    ? `${template.name}: actual Vira template with editable sample content`
                    : `${template.name}: template real do Vira com conteúdo genérico editável`
                }
              />
            </picture>
            <span class="enlarge-label">{en ? 'Enlarge preview' : 'Ampliar prévia'} ↗</span>
          </a>
          <div class="template-caption">
            <div>
              <strong>{template.name}</strong>
              <span>{template.description}</span>
            </div>
            <a href="/login">{en ? 'Create my page' : 'Criar minha página'} ↗</a>
          </div>
        </div>
      ))}
    </div>

    <div class="experience-steps">
      {steps.map((step, index) => (
        <article class="experience-step">
          <span class="step-index">0{index + 1}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .template-experience {
    height: 100svh;
    box-sizing: border-box;
    padding: clamp(16px, 3svh, 32px) 0;
    background: #fcfaf6;
    color: #17130d;
  }
  .experience-wrap {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    gap: clamp(12px, 2svh, 20px);
    height: 100%;
    width: 100%;
    max-width: 1240px;
    margin: auto;
    padding: 0 32px;
  }
  .experience-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
    margin-bottom: 0;
  }
  .eyebrow {
    color: #9b6823;
    font:
      10px ui-monospace,
      monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  h2 {
    font:
      500 clamp(1.9rem, 3.8vw, 3.1rem)/1.1 'Outfit',
      sans-serif;
    letter-spacing: -0.045em;
  }
  .experience-intro {
    max-width: 34ch;
    color: #766c60;
    font-size: 14px;
    line-height: 1.7;
  }
  .template-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 0;
  }
  .template-tabs {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .template-tabs button {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 10px 16px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #766c60;
    font:
      500 13px 'Outfit',
      sans-serif;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .template-tabs button[aria-selected='true'] {
    color: #17130d;
    border-color: #e5ded2;
    background: white;
    box-shadow: 0 2px 6px #30251008;
  }
  .template-tabs button:hover {
    background: #f2ede5;
    color: #17130d;
  }
  .template-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff7919;
  }
  .dot-guardiao {
    background: #70b85f;
  }
  .dot-perfil {
    background: #79756d;
  }
  .dot-estudio {
    background: #743d24;
  }
  .dot-classico {
    background: #b88333;
  }
  .template-count {
    font-size: 11px;
    color: #8b8174;
    white-space: nowrap;
  }
  .template-stage {
    min-height: 0;
    overflow: hidden;
    border: 1px solid #e5ded2;
    border-radius: 14px;
    background: white;
    box-shadow: 0 16px 44px -30px #4e392f40;
  }
  [role='tabpanel']:not([hidden]) {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }
  [role='tabpanel'][hidden] {
    display: none;
  }
  .template-capture {
    display: flex;
    flex: 1;
    min-height: 0;
    justify-content: center;
    position: relative;
    background: #f5f2eb;
  }
  .template-capture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .template-capture picture {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  .enlarge-label {
    position: absolute;
    right: 18px;
    bottom: 18px;
    padding: 8px 12px;
    background: #fffefbea;
    border: 1px solid #e5ded2;
    border-radius: 6px;
    font-size: 11px;
    color: #625a51;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .template-capture:hover .enlarge-label,
  .template-capture:focus-visible .enlarge-label {
    opacity: 1;
  }
  .template-caption {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 12px 20px;
    border-top: 1px solid #eee7dc;
  }
  .template-caption > div {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .template-caption strong {
    font-weight: 500;
    font-size: 14px;
  }
  .template-caption span {
    font-size: 12px;
    color: #766c60;
  }
  .template-caption > a {
    font-size: 12px;
    font-weight: 500;
    color: #9b6823;
    white-space: nowrap;
  }
  .experience-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
    padding-top: 0;
  }
  .experience-step {
    display: flex;
    gap: 16px;
    align-items: start;
  }
  .step-index {
    padding-top: 3px;
    color: #b88333;
    font:
      12px ui-monospace,
      monospace;
  }
  h3 {
    font:
      500 18px/1.3 'Outfit',
      sans-serif;
    letter-spacing: -0.025em;
  }
  .experience-step p {
    margin-top: 9px;
    color: #766c60;
    font-size: 12px;
    line-height: 1.8;
  }
  button:focus-visible,
  a:focus-visible,
  [role='tabpanel']:focus-visible {
    outline: 2px solid #b88333;
    outline-offset: 4px;
  }
  @media (max-width: 767px) {
    .template-experience {
      padding: 20px 0;
    }
    .experience-wrap {
      padding: 0 20px;
    }
    .experience-heading {
      display: block;
      margin-bottom: 0;
    }
    .experience-intro {
      margin-top: 14px;
      max-width: 50ch;
    }
    .template-toolbar {
      display: block;
    }
    .template-count {
      display: none;
    }
    .template-tabs {
      gap: 2px;
    }
    .template-tabs button {
      padding: 8px 10px;
      font-size: 12px;
      min-height: 40px;
    }
    .template-caption {
      padding: 14px;
      gap: 12px;
    }
    .template-caption > div {
      align-items: start;
      flex-direction: column;
      gap: 4px;
    }
    .template-caption span {
      font-size: 11px;
    }
    .experience-steps {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 12px;
      padding-top: 0;
      padding-bottom: 8px;
    }
    .experience-step {
      flex: 0 0 90%;
      scroll-snap-align: start;
    }
    .enlarge-label {
      opacity: 1;
      right: 8px;
      bottom: 8px;
      padding: 5px 8px;
      font-size: 9px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button,
    .enlarge-label {
      transition: none;
    }
  }
  @media (max-width: 767px) {
    .template-capture img {
      object-fit: contain;
      object-position: top;
    }
  }
  @media (max-height: 650px) {
    .experience-heading h2 {
      font-size: 1.6rem;
    }
    .eyebrow {
      margin-bottom: 8px;
    }
    .experience-intro {
      font-size: 12px;
      margin-top: 8px;
    }
    .experience-steps {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 20px;
    }
    .experience-step {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }
    .experience-step h3 {
      font-size: 15px;
    }
    .experience-step p {
      margin-top: 4px;
      font-size: 11px;
      line-height: 1.5;
    }
    .template-caption {
      padding: 8px 12px;
    }
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-template-experience]').forEach((section) => {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[data-template-tab]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[data-template-panel]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let animation: Animation | undefined;
    const select = (index: number, focus = false) => {
      if (index === active) {
        if (focus) tabs[index].focus();
        return;
      }
      animation?.cancel();
      active = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (!reduced.matches)
        animation = panels[index].animate(
          [
            { opacity: 0, transform: 'translateY(10px)' },
            { opacity: 1, transform: 'translateY(0)' },
          ],
          { duration: 420, easing: 'cubic-bezier(.22,1,.36,1)' },
        );
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        if (!reduced.matches)
          section.querySelectorAll('.experience-step').forEach((step, index) =>
            step.animate(
              [
                { opacity: 0, transform: 'translateY(18px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              {
                duration: 550,
                delay: index * 90,
                easing: 'cubic-bezier(.22,1,.36,1)',
                fill: 'backwards',
              },
            ),
          );
        observer.disconnect();
      },
      { threshold: 0.2 },
    );
    observer.observe(section.querySelector('.experience-steps')!);
  });
</script>
