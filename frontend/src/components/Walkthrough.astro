---
import WalkthroughVisual from '@frontend/components/WalkthroughVisual.astro';
interface Props {
  lang: 'pt' | 'en';
  heading: string;
  intro: string;
  steps: { title: string; text: string }[];
}
const { lang, heading, intro, steps } = Astro.props;
const en = lang === 'en';
---

<section
  id="como-funciona"
  data-walkthrough
  class="border-b border-[#d8ae73] bg-[#fcfaf6] px-5 py-16 text-[#17130d] sm:px-8 sm:py-24"
  aria-labelledby="walkthrough-heading"
>
  <div class="mx-auto w-full max-w-[1240px]">
    <header class="mb-12 flex items-end justify-between gap-10 max-md:block" data-reveal>
      <div>
        <p class="mb-3.5 font-mono text-[10px] uppercase tracking-[0.14em] text-[#9b6823]">
          {en ? 'How it works' : 'Como funciona'}
        </p>
        <h2
          id="walkthrough-heading"
          class="text-[clamp(1.9rem,3.8vw,3.1rem)] font-medium leading-[1.1] tracking-[-0.045em] font-['Outfit',sans-serif]"
        >
          {heading}
        </h2>
      </div>
      <p class="max-w-[34ch] text-sm leading-relaxed text-[#766c60] max-md:mt-3.5 max-md:max-w-[50ch]">
        {intro}
      </p>
    </header>

    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1fr)] lg:gap-16">
      <div class="hidden lg:block">
        <div class="sticky top-28">
          <div class="relative">
            {steps.map((_, index) => (
              <div data-step-panel={index} class={index === 0 ? '' : 'hidden'}>
                <WalkthroughVisual index={index} lang={lang} />
              </div>
            ))}
          </div>
          <div class="mt-6 flex items-center justify-center gap-2" aria-hidden="true">
            {steps.map((_, index) => (
              <span
                data-step-dot={index}
                class={`h-1.5 rounded-full transition-all duration-300 ${
                  index === 0 ? 'w-8 bg-[#b88333]' : 'w-3 bg-[#e5ded2]'
                }`}
              />
            ))}
          </div>
        </div>
      </div>

      <ol class="flex flex-col gap-12 sm:gap-16 lg:gap-0">
        {steps.map((step, index) => (
          <li data-step-item={index} class="lg:flex lg:min-h-[58svh] lg:flex-col lg:justify-center">
            <span
              data-step-badge={index}
              class={`mb-4 grid h-11 w-11 place-items-center rounded-full border font-mono text-sm font-semibold transition-colors duration-300 ${
                index === 0
                  ? 'border-[#b88333] bg-[#17130d] text-white'
                  : 'border-[#e5ded2] bg-white text-[#b88333]'
              }`}
            >
              0{index + 1}
            </span>
            <h3
              id={`walkthrough-step-${index + 1}`}
              class="text-[clamp(1.6rem,3vw,2.6rem)] font-medium leading-tight tracking-[-0.03em] font-['Outfit',sans-serif]"
            >
              {step.title}
            </h3>
            <p class="mt-3 max-w-[42ch] text-sm leading-relaxed text-[#625a51] sm:text-base">
              {step.text}
            </p>
            <div class="mt-6 lg:hidden">
              <WalkthroughVisual index={index} lang={lang} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<script>
  const root = document.querySelector<HTMLElement>('[data-walkthrough]');
  if (root) {
    const items = [...root.querySelectorAll<HTMLElement>('[data-step-item]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-step-panel]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-step-dot]')];
    const badges = [...root.querySelectorAll<HTMLElement>('[data-step-badge]')];
    const activePanel = (index: number) => {
      panels.forEach((panel, i) => panel.classList.toggle('hidden', i !== index));
      dots.forEach((dot, i) => {
        dot.classList.toggle('w-8', i === index);
        dot.classList.toggle('bg-[#b88333]', i === index);
        dot.classList.toggle('w-3', i !== index);
        dot.classList.toggle('bg-[#e5ded2]', i !== index);
      });
      badges.forEach((badge, i) => {
        badge.classList.toggle('border-[#b88333]', i === index);
        badge.classList.toggle('bg-[#17130d]', i === index);
        badge.classList.toggle('text-white', i === index);
        badge.classList.toggle('border-[#e5ded2]', i !== index);
        badge.classList.toggle('bg-white', i !== index);
        badge.classList.toggle('text-[#b88333]', i !== index);
      });
    };
    activePanel(0);
    if ('IntersectionObserver' in window && items.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              activePanel(Number((entry.target as HTMLElement).dataset.stepItem));
            }
          });
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
      );
      items.forEach((item) => observer.observe(item));
    }
  }
</script>
