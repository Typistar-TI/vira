---
interface Props {
  lang: 'pt' | 'en';
  heading: string;
  intro: string;
  steps: {
    title: string;
    text: string;
    mobile: string;
    alt: string;
  }[];
}

const { lang, heading, intro, steps } = Astro.props;
const en = lang === 'en';
const highlights = en
  ? [
      ['Sign in with email or Google', 'Find your page address', 'See your first preview'],
      ['Choose one of five layouts', 'Edit text and images', 'See the result as you work'],
      [
        'Check desktop and mobile',
        'Publish your Vira address',
        'Connect your own domain with a plan',
      ],
    ]
  : [
      ['Entre por e-mail ou Google', 'Encontre o endereço da página', 'Veja sua primeira prévia'],
      ['Escolha entre cinco layouts', 'Edite textos e imagens', 'Veja o resultado enquanto cria'],
      [
        'Confira no computador e no celular',
        'Publique seu endereço Vira',
        'Conecte seu domínio com um plano',
      ],
    ];
---

<section
  id="como-funciona"
  class="relative border-t border-[#ead8bf] bg-white py-12 sm:py-16"
  aria-labelledby="walkthrough-heading"
>
  <div class="mx-auto max-w-[1380px] px-5 sm:px-8">
    <div class="mx-auto mb-8 max-w-[840px] text-center sm:mb-10" data-reveal>
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#9b6823]">
        {en ? 'See it for yourself' : 'Veja como funciona'}
      </p>
      <h2
        id="walkthrough-heading"
        class="mt-3 font-['Outfit',sans-serif] text-[clamp(2.8rem,5vw,4.8rem)] font-medium leading-[1.02] tracking-[-0.055em] text-[#17130d]"
      >
        {heading}
      </h2>
      <p class="mx-auto mt-3 max-w-[70ch] text-base leading-relaxed text-[#625a51] sm:text-lg">
        {intro}
      </p>
    </div>

    {steps.map((step, i) => (
      <article
        class:list={[
          'relative mb-7 grid min-h-[690px] grid-cols-1 overflow-hidden rounded-[2rem] border border-[#d8ae73] bg-white shadow-[0_30px_75px_-50px_rgba(143,97,36,0.35)] lg:sticky lg:top-24 lg:mb-[22svh] lg:min-h-[610px] lg:grid-cols-2 lg:items-stretch lg:rounded-[2.5rem] last:mb-0',
          ['lg:z-10', 'lg:z-20', 'lg:z-30'][i],
        ]}
        aria-labelledby={`walkthrough-step-${i + 1}`}
      >
        <div
          class:list={[
            'flex flex-col justify-center px-7 pb-8 pt-9 sm:px-12 sm:pb-12 sm:pt-12 lg:px-14 lg:py-16 xl:px-16',
            i === 1 && 'lg:order-2',
          ]}
        >
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.19em] text-[#9b6823]">
            {en ? 'Step' : 'Passo'} 0{i + 1} <span class="mx-2 text-[#c6a573]">/</span> 03
          </p>
          <h3
            id={`walkthrough-step-${i + 1}`}
            class="mt-5 max-w-[14ch] font-['Outfit',sans-serif] text-[clamp(2.2rem,4vw,4.3rem)] font-medium leading-[1.04] tracking-[-0.055em] text-[#17130d]"
          >
            {step.title}
          </h3>
          <p class="mt-5 max-w-[42ch] text-base leading-relaxed text-[#625a51] sm:text-lg">
            {step.text}
          </p>
          <ul class="mt-7 space-y-3 text-sm text-[#4f473e] sm:text-base">
            {highlights[i].map((item) => (
              <li class="flex items-start gap-3">
                <span
                  aria-hidden="true"
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-[#b88333] text-xs text-[#9b6823]"
                >
                  ✓
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          {i === 2 && (
            <div class="mt-7 border-t border-[#d8ae73] pt-6">
              <p class="max-w-[29ch] text-xl font-medium leading-snug text-[#17130d] sm:text-2xl">
                {en
                  ? 'Your corner of the internet, ready to share.'
                  : 'Um lugar seu na internet, pronto para compartilhar.'}
              </p>
              <a
                href="/login"
                class="mt-5 inline-flex min-h-11 items-center gap-3 rounded-full border border-[#b88333] bg-[#b88333] px-6 text-sm font-semibold text-white transition-colors hover:bg-[#9b6823] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b88333]"
              >
                {en ? 'Create your page' : 'Criar minha página'}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          )}
        </div>
        <div
          class:list={[
            'relative flex min-h-[540px] flex-col items-center justify-center overflow-hidden border-t border-[#ead8bf] bg-white px-4 py-8 sm:min-h-[600px] lg:min-h-0 lg:border-t-0 lg:border-l lg:py-10',
            i === 1 && 'lg:order-1 lg:border-r lg:border-l-0',
          ]}
        >
          <div class="h-[460px] w-[250px] overflow-hidden rounded-[2.5rem] border-[5px] border-[#c99b57] bg-white shadow-[0_24px_60px_-30px_rgba(106,69,20,0.45)] sm:h-[530px] sm:w-[287px]">
            <img
              src={step.mobile}
              width="390"
              height="720"
              loading="lazy"
              alt={step.alt}
              class="h-full w-full object-cover object-top"
            />
          </div>
          <span class="mt-4 font-mono text-[10px] uppercase tracking-[0.14em] text-[#8b5b1e]">
            {en ? 'Actual Vira screen' : 'Tela real do Vira'}
          </span>
        </div>
      </article>
    ))}
  </div>
</section>
