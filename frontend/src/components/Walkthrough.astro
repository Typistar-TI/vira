---
import WalkthroughVisual from '@frontend/components/WalkthroughVisual.astro';
interface Props {
  lang: 'pt' | 'en';
  heading: string;
  intro: string;
  steps: { title: string; text: string }[];
}
const { lang, heading, intro, steps } = Astro.props;
const en = lang === 'en';

const details = en
  ? [
      [
        'Email and password, access code or Google',
        'Your workspace is created right away',
        'No credit card to get started',
      ],
      [
        'Text, images and logo in editable blocks',
        'Live preview on desktop and mobile',
        'AI assistant included from the start',
      ],
      [
        'Vira address ready as soon as you publish',
        'Connect your own domain later',
        'Update the content whenever you want',
      ],
    ]
  : [
      [
        'E-mail e senha, código de acesso ou Google',
        'Sua área de trabalho é criada na hora',
        'Sem cartão de crédito para começar',
      ],
      [
        'Textos, imagens e logo em blocos editáveis',
        'Prévia ao vivo no computador e no celular',
        'Assistente de IA incluída desde o início',
      ],
      [
        'Endereço Vira pronto ao publicar',
        'Conecte seu domínio próprio depois',
        'Atualize o conteúdo quando quiser',
      ],
    ];
const captions = en
  ? [
      'Pick the blocks that fit your business and put them in order.',
      'Change the words and images and watch the page update as you type.',
      'One click puts your page online with a shareable address.',
    ]
  : [
      'Escolha os blocos que combinam com o seu negócio e organize a ordem.',
      'Mude textos e imagens e veja a página se atualizar enquanto digita.',
      'Um clique coloca sua página no ar com um endereço para compartilhar.',
    ];
const stepIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>',
];
---

<section
  id="como-funciona"
  data-walkthrough
  data-captions={JSON.stringify(captions)}
  class="border-b border-[#d8ae73] bg-[#fcfaf6] px-5 pt-10 pb-14 text-[#17130d] sm:px-8 sm:pt-14 sm:pb-20"
  aria-labelledby="walkthrough-heading"
>
  <div class="mx-auto w-full max-w-[1240px]">
    <header class="mb-8 flex items-end justify-between gap-10 max-md:block sm:mb-10" data-reveal>
      <div>
        <p class="mb-3.5 font-mono text-[10px] uppercase tracking-[0.14em] text-[#9b6823]">
          {en ? 'How it works' : 'Como funciona'}
        </p>
        <h2
          id="walkthrough-heading"
          class="text-[clamp(1.9rem,3.8vw,3.1rem)] font-medium leading-[1.1] tracking-[-0.045em] font-['Outfit',sans-serif]"
        >
          {heading}
        </h2>
      </div>
      <p class="max-w-[34ch] text-sm leading-relaxed text-[#766c60] max-md:mt-3.5 max-md:max-w-[50ch]">
        {intro}
      </p>
    </header>

    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1fr)] lg:gap-16">
      <div class="hidden lg:block">
        <div class="sticky top-28">
          <div class="mb-4 flex items-center justify-between gap-3">
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-[#9b6823]">
              {en ? 'Inside your panel' : 'Por dentro do painel'}
            </span>
            <span class="rounded-full border border-[#e5ded2] bg-white px-3 py-1 font-mono text-[10px] text-[#8b8174]">
              <span data-step-counter>01</span> / 0{steps.length}
            </span>
          </div>
          <div class="relative rounded-2xl" data-step-stage>
            {steps.map((_, index) => (
              <div data-step-panel={index} class={index === 0 ? '' : 'hidden'}>
                <WalkthroughVisual index={index} lang={lang} />
              </div>
            ))}
          </div>
          <div class="mt-5 flex items-center gap-2" aria-hidden="true">
            {steps.map((_, index) => (
              <span
                data-step-dot={index}
                class={`h-1.5 rounded-full transition-all duration-300 ${
                  index === 0 ? 'w-8 bg-[#b88333]' : 'w-3 bg-[#e5ded2]'
                }`}
              />
            ))}
          </div>
          <p data-step-caption class="mt-3 max-w-[46ch] text-xs leading-relaxed text-[#766c60]">
            {captions[0]}
          </p>
        </div>
      </div>

      <ol class="flex flex-col gap-12 sm:gap-16 lg:gap-0">
        {steps.map((step, index) => (
          <li data-step-item={index} class="lg:flex lg:min-h-[58svh] lg:flex-col lg:justify-center">
            <div class="flex items-center gap-3">
              <span
                data-step-badge={index}
                class={`grid h-12 w-12 place-items-center rounded-full border font-['Outfit',sans-serif] text-lg font-semibold transition-all duration-300 ${
                  index === 0
                    ? 'border-[#17130d] bg-[#17130d] text-white shadow-[0_14px_30px_-14px_#17130d] ring-4 ring-[#b88333]/25'
                    : 'border-[#e5ded2] bg-[#f5f2eb] text-[#8b8174]'
                }`}
              >
                0{index + 1}
              </span>
              <span class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.18em] text-[#9b6823]">
                <span class="text-[#b88333]" aria-hidden="true" set:html={stepIcons[index] ?? ''} />
                {en ? 'Step' : 'Passo'} 0{index + 1}
              </span>
            </div>
            <h3
              id={`walkthrough-step-${index + 1}`}
              class="mt-5 text-[clamp(1.6rem,3vw,2.6rem)] font-medium leading-tight tracking-[-0.03em] font-['Outfit',sans-serif]"
            >
              {step.title}
            </h3>
            <p class="mt-3 max-w-[42ch] text-sm leading-relaxed text-[#625a51] sm:text-base">
              {step.text}
            </p>
            <ul class="mt-5 max-w-[42ch] space-y-2 text-sm text-[#4f473e]">
              {(details[index] ?? []).map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 text-[#b88333]" aria-hidden="true">
                    ✓
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 lg:hidden">
              <WalkthroughVisual index={index} lang={lang} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-walkthrough]');
    if (root) {
      const items = [...root.querySelectorAll<HTMLElement>('[data-step-item]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[data-step-panel]')];
      const dots = [...root.querySelectorAll<HTMLElement>('[data-step-dot]')];
      const badges = [...root.querySelectorAll<HTMLElement>('[data-step-badge]')];
      const counter = root.querySelector<HTMLElement>('[data-step-counter]');
      const caption = root.querySelector<HTMLElement>('[data-step-caption]');
      const stage = root.querySelector<HTMLElement>('[data-step-stage]');
      let captions: string[] = [];
      try {
        captions = JSON.parse(root.dataset.captions || '[]');
      } catch {
        captions = [];
      }
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = 0;
      const replay = (el: HTMLElement, cls: string) => {
        el.classList.remove(cls);
        void el.offsetWidth;
        el.classList.add(cls);
      };
      const activePanel = (index: number, animateChange = true) => {
        const forward = index >= current;
        current = index;
        panels.forEach((panel, i) => {
          panel.classList.remove('animate-panel-forward', 'animate-panel-back');
          if (i === index) {
            panel.classList.remove('hidden');
            if (animateChange && !reduced) {
              replay(panel, forward ? 'animate-panel-forward' : 'animate-panel-back');
            }
          } else {
            panel.classList.add('hidden');
          }
        });
        if (animateChange && !reduced && stage) {
          stage.classList.add('ring-2', 'ring-[#b88333]/50');
          window.setTimeout(() => stage.classList.remove('ring-2', 'ring-[#b88333]/50'), 650);
        }
        dots.forEach((dot, i) => {
          dot.classList.toggle('w-8', i === index);
          dot.classList.toggle('bg-[#b88333]', i === index);
          dot.classList.toggle('w-3', i !== index);
          dot.classList.toggle('bg-[#e5ded2]', i !== index);
        });
        badges.forEach((badge, i) => {
          badge.classList.toggle('border-[#17130d]', i === index);
          badge.classList.toggle('bg-[#17130d]', i === index);
          badge.classList.toggle('text-white', i === index);
          badge.classList.toggle('shadow-[0_14px_30px_-14px_#17130d]', i === index);
          badge.classList.toggle('ring-4', i === index);
          badge.classList.toggle('ring-[#b88333]/25', i === index);
          badge.classList.toggle('border-[#e5ded2]', i !== index);
          badge.classList.toggle('bg-[#f5f2eb]', i !== index);
          badge.classList.toggle('text-[#8b8174]', i !== index);
        });
        if (counter) counter.textContent = String(index + 1).padStart(2, '0');
        if (caption) {
          caption.textContent = captions[index] ?? '';
          if (animateChange && !reduced) replay(caption, 'animate-bubble');
        }
      };
      activePanel(0, false);
      if ('IntersectionObserver' in window && items.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                activePanel(Number((entry.target as HTMLElement).dataset.stepItem));
              }
            });
          },
          { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
        );
        items.forEach((item) => observer.observe(item));
      }
    }
  });
</script>
