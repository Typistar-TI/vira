---
import type { PublicShowcase } from '@frontend/api/showcase/public-showcase';

interface Props {
  lang: 'pt' | 'en';
  projects: PublicShowcase['projects'];
}

const { lang, projects } = Astro.props;
const en = lang === 'en';
const moving = projects.length >= 4;
const rows = moving
  ? [0, 1, 2].map((offset) =>
      Array.from(
        { length: Math.max(8, projects.length) },
        (_, index) => projects[(index + offset * 2) % projects.length],
      ),
    )
  : [];
const cardClass =
  'flex h-32 w-52 shrink-0 flex-col items-center justify-center gap-2 rounded-[1.5rem] border border-[#d8ae73] bg-white px-5 py-3 text-center text-sm font-semibold text-[#4f473e] transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-[#b88333] focus-visible:outline-2 focus-visible:outline-[#b88333] sm:h-40 sm:w-64';
---

<section
  id="vitrine"
  class="border-b border-[#d8ae73] bg-white px-0 py-16 sm:py-24"
  aria-labelledby="showcase-heading"
>
  <div class="mx-auto w-full max-w-[1380px] px-5 sm:px-8" data-reveal>
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#9b6823]">
      {en ? 'Made with Vira' : 'Feito com Vira'}
    </p>
    <h2
      id="showcase-heading"
      class="mt-2.5 text-[clamp(2rem,4vw,3rem)] font-['Outfit',sans-serif] font-medium leading-[1.02] tracking-[-0.06em]"
    >
      {en ? 'Real ideas, already online.' : 'Ideias reais, já no ar.'}
    </h2>
    <p class="mt-2.5 max-w-[55ch] text-sm text-[#625a51]">
      {en
        ? 'Projects shared by people who created and published their pages with Vira.'
        : 'Projetos compartilhados por quem criou e publicou sua página com o Vira.'}
    </p>
  </div>
  {moving ? (
    <div class="mt-10 space-y-3 overflow-hidden sm:mt-14 sm:space-y-4 [mask-image:linear-gradient(to_right,transparent,black_7%,black_93%,transparent)]">
      {rows.map((row, rowIndex) => (
        <div
          class="overflow-hidden"
          aria-hidden={rowIndex > 0 ? 'true' : undefined}
          aria-label={
            rowIndex === 0 ? (en ? 'Published projects' : 'Projetos publicados') : undefined
          }
        >
          <div
            class:list={[
              'flex w-max motion-reduce:animate-none hover:[animation-play-state:paused] focus-within:[animation-play-state:paused]',
              rowIndex === 1 ? 'animate-showcase-right' : 'animate-showcase-left',
            ]}
          >
            {[false, true].map((duplicate) => (
              <div
                class="flex shrink-0 gap-3 pr-3 sm:gap-4 sm:pr-4"
                aria-hidden={duplicate ? 'true' : undefined}
              >
                {row.map((project, itemIndex) => (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-hidden={
                      duplicate || rowIndex > 0 || itemIndex >= projects.length ? 'true' : undefined
                    }
                    tabindex={
                      duplicate || rowIndex > 0 || itemIndex >= projects.length ? -1 : undefined
                    }
                    class={cardClass}
                  >
                    <img
                      src={project.logo}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="max-h-[58%] w-full object-contain"
                    />
                    <span class="max-w-full truncate">{project.name}</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  ) : projects.length > 0 ? (
    <div class="mx-auto mt-10 flex w-full max-w-[1380px] flex-wrap justify-center gap-3 px-5 sm:mt-14 sm:gap-4 sm:px-8">
      {projects.map((project) => (
        <a href={project.url} target="_blank" rel="noopener noreferrer" class={cardClass}>
          <img
            src={project.logo}
            alt=""
            loading="lazy"
            decoding="async"
            class="max-h-[58%] w-full object-contain"
          />
          <span class="max-w-full truncate">{project.name}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="mx-auto mt-10 w-full max-w-[1380px] px-5 sm:mt-14 sm:px-8">
      <p class="rounded-[1.5rem] border border-[#d8ae73] bg-white px-6 py-12 text-center text-[#625a51]">
        {en
          ? 'The first projects will appear here as their owners share them.'
          : 'Os primeiros projetos aparecerão aqui quando seus donos os compartilharem.'}
      </p>
    </div>
  )}
</section>
