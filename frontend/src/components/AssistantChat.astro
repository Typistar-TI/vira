---
interface Colors {
  accent?: string;
  surface?: string;
  text?: string;
  line?: string;
  soft?: string;
}
interface ScriptMessage {
  role: 'user' | 'assistant';
  text: string;
}

interface Props {
  endpoint: string;
  lang?: 'pt' | 'en';
  variant?: 'demo' | 'floating';
  name?: string;
  greeting?: string;
  suggestions?: string[];
  colors?: Colors;
  persist?: boolean;
  script?: ScriptMessage[];
  meta?: string;
}

const {
  endpoint,
  lang = 'pt',
  variant = 'demo',
  name,
  greeting,
  suggestions = [],
  colors = {},
  persist = false,
  script = [],
  meta,
} = Astro.props;
const en = lang === 'en';
const floating = variant === 'floating';
const assistantName = name || (en ? 'Vira assistant' : 'Assistente do Vira');
const hello =
  greeting ||
  (en ? 'Hi! Ask me anything about this page.' : 'Oi! Pergunte o que quiser sobre esta página.');
const hints = suggestions.length
  ? suggestions
  : en
    ? ['What do you offer?', 'How does it work?', 'How much does it cost?']
    : ['O que você oferece?', 'Como funciona?', 'Quanto custa?'];
const palette = {
  accent: colors.accent || '#b88333',
  surface: colors.surface || '#ffffff',
  text: colors.text || '#17130d',
  line: colors.line || '#e8d6b8',
  soft: colors.soft || '#f7efe1',
};
const panelClass = floating
  ? 'hidden fixed bottom-24 right-5 z-50 flex h-[min(560px,calc(100svh-8rem))] w-[min(390px,calc(100vw-2.5rem))] flex-col overflow-hidden rounded-[1.5rem] border bg-[var(--a-surface)] shadow-[0_30px_80px_-40px_rgba(0,0,0,0.55)]'
  : 'assistant-demo-panel flex h-full min-h-0 flex-col rounded-none border-0 shadow-none';
const logClass = floating
  ? 'min-h-0 flex-1 space-y-3 overflow-y-auto px-5 py-4'
  : 'min-h-0 flex-1 space-y-3 overflow-y-auto px-2 py-3 [&>div]:w-fit [&>div]:max-w-[min(85%,48rem)] [&>div]:whitespace-pre-wrap [&>div]:break-words';
const formClass = floating
  ? 'flex items-end gap-2 border-t px-4 py-3'
  : 'mt-3 mb-1 flex items-end gap-2 rounded-3xl border bg-white/95 px-2 py-1.5 shadow-[0_8px_30px_-18px_rgb(70_45_15_/_25%)]';
const textareaClass = floating
  ? 'max-h-28 min-h-11 flex-1 resize-none rounded-2xl border px-4 py-2.5 text-sm outline-none'
  : 'min-h-9 min-w-0 flex-1 resize-none border-0 bg-transparent py-2 text-sm outline-none';
const sendClass = floating
  ? 'flex h-11 w-11 shrink-0 items-center justify-center rounded-full border-0 text-white transition-transform duration-300 hover:-translate-y-0.5 active:scale-95 disabled:opacity-50'
  : 'flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-0 text-white transition-transform duration-300 hover:-translate-y-0.5 active:scale-95 disabled:opacity-50';
const suggestionClass = floating
  ? 'rounded-full border px-3 py-1.5 text-xs transition-colors hover:opacity-80'
  : 'rounded-xl border bg-white/75 px-3.5 py-2.5 text-xs transition-colors hover:opacity-80';
---

<div
  data-assistant
  data-endpoint={endpoint}
  data-lang={lang}
  data-persist={persist ? 'true' : undefined}
  data-script={script.length ? JSON.stringify(script) : undefined}
  class:list={[floating ? 'fixed bottom-5 right-5 z-50' : 'assistant-demo h-full min-h-0']}
>
  {floating && (
    <button
      type="button"
      data-assistant-toggle
      aria-label={en ? 'Open the assistant' : 'Abrir a assistente'}
      aria-expanded="false"
      class="flex h-14 w-14 items-center justify-center rounded-full border-0 text-white shadow-[0_16px_40px_-16px_rgba(0,0,0,0.6)] transition-transform duration-300 hover:-translate-y-0.5 active:scale-95"
      style={`background:${palette.accent}`}
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current" aria-hidden="true">
        <path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-5 4v-4H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
      </svg>
    </button>
  )}
  <div
    data-assistant-panel
    class:list={[panelClass]}
    style={`background:${floating ? palette.surface : 'transparent'};border-color:${palette.line};color:${palette.text};--a-accent:${palette.accent};--a-soft:${palette.soft};--a-line:${palette.line};--a-text:${palette.text}`}
  >
    {floating && (
      <header
        class="flex items-center gap-3 border-b px-5 py-4"
        style={`border-color:${palette.line};background:${palette.soft}`}
      >
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm text-white"
          style={`background:${palette.accent}`}
          aria-hidden="true"
        >
          ✳
        </span>
        <div class="min-w-0">
          <p class="truncate font-['Outfit',sans-serif] text-sm font-semibold">{assistantName}</p>
          <p class="flex items-center gap-1.5 text-[11px] opacity-70">
            <span class="h-1.5 w-1.5 rounded-full bg-[#3fa46a]" />
            {en ? 'Online now' : 'Online agora'}
          </p>
        </div>
        <button
          type="button"
          data-assistant-close
          aria-label={en ? 'Close' : 'Fechar'}
          class="ml-auto flex h-8 w-8 items-center justify-center rounded-full border-0 bg-transparent text-lg opacity-60 transition-opacity hover:opacity-100"
        >
          ×
        </button>
      </header>
    )}
    {!floating && meta && (
      <p class="mb-1 text-center text-[10px] font-semibold uppercase tracking-[0.18em] text-[var(--a-accent)]">
        {meta}
      </p>
    )}
    <div data-assistant-log aria-live="polite" class={logClass}>
      {!floating && script.length === 0 && (
        <div
          class="mr-auto max-w-[85%] rounded-2xl rounded-bl-md px-4 py-2.5 text-sm leading-relaxed"
          style={`background:${palette.soft}`}
        >
          {hello}
        </div>
      )}
    </div>
    <div
      data-assistant-prompts
      class:list={['px-5 pb-2', !floating ? 'px-0 [@media(max-height:640px)]:hidden' : '']}
    >
      <div data-assistant-suggestions class="flex flex-wrap gap-2">
        {hints.map((hint) => (
          <button
            type="button"
            data-assistant-suggestion
            class={suggestionClass}
            style={`border-color:${palette.line};color:${palette.accent}`}
          >
            {hint}
          </button>
        ))}
      </div>
    </div>
    <form data-assistant-form class={formClass} style={`border-color:${palette.line}`}>
      <label class="sr-only" for={`assistant-input-${lang}-${variant}`}>
        {en ? 'Your question' : 'Sua pergunta'}
      </label>
      <textarea
        id={`assistant-input-${lang}-${variant}`}
        data-assistant-input
        rows="1"
        maxlength="500"
        placeholder={en ? 'Type your question…' : 'Escreva sua pergunta…'}
        class={textareaClass}
        style={`border-color:${palette.line};color:${palette.text}`}
      ></textarea>
      <button
        type="submit"
        data-assistant-send
        aria-label={en ? 'Send' : 'Enviar'}
        class={sendClass}
        style={`background:${palette.accent}`}
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
          <path d="M11 20V7.8l-4.6 4.6L5 11l7-7 7 7-1.4 1.4L13 7.8V20z" />
        </svg>
      </button>
    </form>
    <slot name="footer" />
  </div>
</div>
