---
import Sheet from './Sheet.astro';
interface Props {
  label: string;
  links: { href: string; label: string; current?: boolean; icon?: string }[];
  iconOnly?: boolean;
  lang?: 'pt' | 'en';
}

const { label, links, iconOnly = false, lang = 'pt' } = Astro.props;
const closeLabel = lang === 'en' ? 'Close menu' : 'Fechar menu';
---

<div data-mobile-navigation>
  <button
    class:list={[
      'btn h-10 min-h-10 rounded-full border border-[#b88333] bg-white text-[#6f4716] shadow-none transition-colors hover:border-[#9b6823] hover:bg-[#fff9ef]',
      iconOnly ? 'w-10 p-0' : 'px-4 font-semibold',
    ]}
    type="button"
    data-open-navigation
    aria-label={lang === 'en' ? `Open ${label.toLowerCase()}` : `Abrir ${label.toLowerCase()}`}
  >
    <span aria-hidden={iconOnly ? 'true' : undefined}>{iconOnly ? '☰' : label}</span>
  </button>
  <Sheet label={label} closeLabel={closeLabel}>
    <nav aria-label={label}>
      <ul class="flex w-full flex-col gap-1 p-0 text-base">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current ? 'page' : undefined}
              class:list={[
                'flex min-h-12 items-center gap-3 rounded-xl px-4 whitespace-nowrap transition-colors focus-visible:outline-2 focus-visible:outline-[#b88333]',
                link.current
                  ? 'bg-transparent font-semibold text-[#6f4716]'
                  : 'text-[#17130d] hover:text-[#9b6823]',
              ]}
            >
              {link.icon && (
                <svg
                  class="h-5 w-5 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={link.icon}
                />
              )}
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Sheet>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-mobile-navigation]').forEach((root) => {
      const dialog = root.querySelector<HTMLDialogElement>('dialog');
      if (!dialog) return;
      root
        .querySelector('[data-open-navigation]')
        ?.addEventListener('click', () => dialog.showModal());
    });
  });
</script>
