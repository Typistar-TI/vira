---
interface Props {
  email: string;
  displayName?: string;
  profileHref: string;
  profileLabel?: string;
  homeHref: string;
  lang?: 'pt' | 'en';
}

const { email, displayName = '', profileHref, profileLabel, homeHref, lang = 'pt' } = Astro.props;
const en = lang === 'en';
const label = displayName || email.split('@')[0] || 'Conta';
const initials = label
  .split(/[^\p{L}\p{N}]+/u)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0].toLocaleUpperCase('pt-BR'))
  .join('');
const links = [
  { href: profileHref, label: profileLabel ?? (en ? 'My data' : 'Meus dados') },
  { href: homeHref, label: en ? 'Home' : 'Página inicial' },
  { href: en ? '/en/privacy' : '/privacidade', label: en ? 'Privacy' : 'Privacidade' },
];
const avatarClass =
  'btn btn-circle btn-ghost btn-sm border border-[#d8ae73] bg-[#fff4df] font-semibold text-[#6f4716] hover:border-[#b88333] hover:bg-[#ffecd0] sm:btn-md';
---

<div data-account-menu>
  <details class="dropdown dropdown-end hidden sm:block" data-account-dropdown>
    <summary
      class:list={[avatarClass, 'avatar list-none']}
      aria-label={en ? `Open account menu for ${label}` : `Abrir menu da conta de ${label}`}
    >
      <span aria-hidden="true" data-account-initials>
        {initials || 'V'}
      </span>
    </summary>
    <ul class="menu dropdown-content z-50 mt-3 w-64 rounded-2xl border border-[#d8ae73] bg-white p-2 shadow-[0_18px_45px_-20px_rgba(95,59,12,0.28)]">
      <li class="pointer-events-none border-b border-[#ead8bd] px-3 py-2">
        <span class="block truncate p-0 text-sm font-semibold text-[#17130d]" data-account-label>
          {label}
        </span>
        <small class="block truncate text-xs text-[#625a51]">{email}</small>
      </li>
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
      <li class="border-t border-[#ead8bd] pt-1">
        <button type="button" data-account-logout>
          {en ? 'Sign out' : 'Sair da conta'}
        </button>
      </li>
    </ul>
  </details>
  <div class="sm:hidden">
    <button
      class={avatarClass}
      type="button"
      data-open-account
      aria-label={en ? `Open account menu for ${label}` : `Abrir menu da conta de ${label}`}
    >
      <span aria-hidden="true" data-account-initials>
        {initials || 'V'}
      </span>
    </button>
    <dialog
      class="modal modal-bottom"
      data-account-dialog
      aria-label={en ? 'Account options' : 'Opções da conta'}
    >
      <div class="modal-box max-h-[78dvh] w-full max-w-none rounded-t-[2rem] border-t border-[#d8ae73] bg-white px-5 pt-5 pb-[max(1.5rem,env(safe-area-inset-bottom))] text-[#17130d]">
        <div class="mb-5 flex items-center justify-between gap-4">
          <h2 class="font-[Outfit] text-xl font-medium">{en ? 'Your account' : 'Sua conta'}</h2>
          <button
            class="btn btn-ghost btn-circle btn-sm"
            type="button"
            data-close-account
            aria-label={en ? 'Close options' : 'Fechar opções'}
          >
            ×
          </button>
        </div>
        <p class="mb-5 truncate text-sm text-[#625a51]">
          <span data-account-label>{label}</span> · {email}
        </p>
        <ul class="menu w-full gap-1 p-0 text-base">
          {links.map((link) => (
            <li>
              <a class="min-h-12 rounded-xl px-4" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
          <li class="mt-2 border-t border-[#ead8bd] pt-2">
            <button class="min-h-12 rounded-xl px-4" type="button" data-account-logout>
              {en ? 'Sign out' : 'Sair da conta'}
            </button>
          </li>
        </ul>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button aria-label={en ? 'Close options' : 'Fechar opções'}></button>
      </form>
    </dialog>
  </div>
</div>

<script>
  import { logout } from '@frontend/api/auth/logout';
  import { reportError } from '@frontend/components/toast';

  document.querySelectorAll<HTMLElement>('[data-account-menu]').forEach((root) => {
    const dropdown = root.querySelector<HTMLDetailsElement>('[data-account-dropdown]')!;
    const dialog = root.querySelector<HTMLDialogElement>('[data-account-dialog]')!;
    document.addEventListener('click', (event) => {
      if (!dropdown.contains(event.target as Node)) dropdown.open = false;
    });
    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        dropdown.open = false;
        dropdown.querySelector('summary')?.focus();
      }
    });
    root.querySelector('[data-open-account]')?.addEventListener('click', () => dialog.showModal());
    root.querySelector('[data-close-account]')?.addEventListener('click', () => dialog.close());
    root.querySelectorAll<HTMLAnchorElement>('a').forEach((link) =>
      link.addEventListener('click', () => {
        dropdown.open = false;
        dialog.close();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-account-logout]').forEach((button) =>
      button.addEventListener('click', async () => {
        button.disabled = true;
        try {
          await logout();
          window.setTimeout(() => {
            location.href = '/';
          }, 450);
        } catch (error) {
          reportError(error, 'Falha ao sair.');
          button.disabled = false;
        }
      }),
    );
  });
</script>
