---
import Sheet from './Sheet.astro';
interface Props {
  email: string;
  displayName?: string;
  avatar?: string | null;
  profileHref: string;
  profileLabel?: string;
  homeHref: string;
  lang?: 'pt' | 'en';
}

const {
  email,
  displayName = '',
  avatar = null,
  profileHref,
  profileLabel,
  lang = 'pt',
} = Astro.props;
const en = lang === 'en';
const label = displayName || email.split('@')[0] || 'Conta';
const initials = label
  .split(/[^\p{L}\p{N}]+/u)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0].toLocaleUpperCase('pt-BR'))
  .join('');
const icons = {
  account:
    '<path d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>',
  document:
    '<path d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>',
  logout:
    '<path d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-7.5A2.25 2.25 0 0 0 3.75 5.25v13.5A2.25 2.25 0 0 0 6 21h7.5a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"/>',
};
const links = [
  {
    href: profileHref,
    label: profileLabel ?? (en ? 'My data' : 'Meus dados'),
    icon: icons.account,
  },
  {
    href: `${profileHref}#documentos`,
    label: en ? 'Documents' : 'Documentos',
    icon: icons.document,
  },
];
const logoutLabel = en ? 'Sign out' : 'Sair da conta';
const avatarClass =
  'btn btn-circle btn-ghost btn-md overflow-hidden border border-[#e0b878] bg-[linear-gradient(140deg,#fffaf1,#ffd99f)] p-0 font-semibold text-[#6f4716] shadow-[0_6px_16px_-10px_rgba(131,85,21,0.65)] transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-0.5 hover:border-[#b88333] hover:shadow-[0_10px_22px_-10px_rgba(131,85,21,0.85)]';
const itemClass = 'flex min-h-12 items-center gap-3 rounded-xl px-4 whitespace-nowrap';
---

<div data-account-menu data-account-scope={profileHref.startsWith('/admin') ? 'admin' : 'app'}>
  <details class="dropdown dropdown-end hidden sm:block" data-account-dropdown>
    <summary
      class:list={[avatarClass, 'list-none']}
      aria-label={en ? `Open account menu for ${label}` : `Abrir menu da conta de ${label}`}
    >
      <img
        data-account-avatar
        src={avatar ?? ''}
        alt=""
        class:list={['h-full w-full rounded-full object-cover', !avatar && 'hidden']}
      />
      <span
        data-account-initials
        class:list={['grid h-full w-full place-items-center', avatar && 'hidden']}
      >
        {initials || 'V'}
      </span>
    </summary>
    <ul class="menu dropdown-content z-50 mt-3 w-64 rounded-2xl border border-[#d8ae73] bg-white p-2 shadow-[0_18px_45px_-20px_rgba(95,59,12,0.28)]">
      <li class="pointer-events-none border-b border-[#ead8bd] px-3 py-2">
        <span class="block truncate p-0 text-sm font-semibold text-[#17130d]" data-account-label>
          {label}
        </span>
        {email && (
          <span class="mt-0.5 block truncate p-0 text-xs font-normal text-[#8b8174]">{email}</span>
        )}
      </li>
      {links.map((link) => (
        <li>
          <a href={link.href} class="flex items-center gap-3">
            <svg
              class="h-4 w-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={link.icon}
            />
            <span class="truncate">{link.label}</span>
          </a>
        </li>
      ))}
      <li class="mt-1 border-t border-[#ead8bd] pt-1">
        <button class="flex items-center gap-3" type="button" data-account-logout>
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons.logout}
          />
          <span class="truncate">{logoutLabel}</span>
        </button>
      </li>
    </ul>
  </details>
  <div class="sm:hidden">
    <button
      class={avatarClass}
      type="button"
      data-open-account
      aria-label={en ? `Open account menu for ${label}` : `Abrir menu da conta de ${label}`}
    >
      <img
        data-account-avatar
        src={avatar ?? ''}
        alt=""
        class:list={['h-full w-full rounded-full object-cover', !avatar && 'hidden']}
      />
      <span
        data-account-initials
        class:list={['grid h-full w-full place-items-center', avatar && 'hidden']}
      >
        {initials || 'V'}
      </span>
    </button>
    <Sheet
      label={en ? 'Your account' : 'Sua conta'}
      closeLabel={en ? 'Close options' : 'Fechar opções'}
    >
      <div class="mb-3 flex items-center gap-3 border-b border-[#ead8bd] pb-4">
        <span class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-full border border-[#e0b878] bg-[linear-gradient(140deg,#fffaf1,#ffd99f)] text-sm font-semibold text-[#6f4716]">
          <img
            data-account-avatar
            src={avatar ?? ''}
            alt=""
            class:list={['h-full w-full object-cover', !avatar && 'hidden']}
          />
          <span
            data-account-initials
            class:list={['grid h-full w-full place-items-center', avatar && 'hidden']}
          >
            {initials || 'V'}
          </span>
        </span>
        <span class="min-w-0">
          <span class="block truncate text-sm font-semibold text-[#17130d]" data-account-label>
            {label}
          </span>
          {email && <span class="block truncate text-xs text-[#8b8174]">{email}</span>}
        </span>
      </div>
      <ul class="menu w-full gap-1 p-0 text-base">
        {links.map((link) => (
          <li>
            <a class={itemClass} href={link.href}>
              <svg
                class="h-5 w-5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={link.icon}
              />
              <span>{link.label}</span>
            </a>
          </li>
        ))}
        <li class="mt-1 border-t border-[#ead8bd] pt-1">
          <button class={itemClass} type="button" data-account-logout>
            <svg
              class="h-5 w-5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons.logout}
            />
            <span>{logoutLabel}</span>
          </button>
        </li>
      </ul>
    </Sheet>
  </div>
</div>
