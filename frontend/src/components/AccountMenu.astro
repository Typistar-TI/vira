---
import Sheet from './Sheet.astro';
interface Props {
  email: string;
  displayName?: string;
  avatar?: string | null;
  profileHref: string;
  profileLabel?: string;
  homeHref: string;
  lang?: 'pt' | 'en';
}

const {
  email,
  displayName = '',
  avatar = null,
  profileHref,
  profileLabel,
  lang = 'pt',
} = Astro.props;
const en = lang === 'en';
const label = displayName || email.split('@')[0] || 'Conta';
const initials = label
  .split(/[^\p{L}\p{N}]+/u)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0].toLocaleUpperCase('pt-BR'))
  .join('');
const links = [
  { href: profileHref, label: profileLabel ?? (en ? 'My data' : 'Meus dados') },
  { href: `${profileHref}#documentos`, label: en ? 'Documents' : 'Documentos' },
];
const avatarClass =
  'btn btn-circle btn-ghost btn-md overflow-hidden border border-[#e0b878] bg-[linear-gradient(140deg,#fffaf1,#ffd99f)] p-0 font-semibold text-[#6f4716] shadow-[0_6px_16px_-10px_rgba(131,85,21,0.65)] transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-0.5 hover:border-[#b88333] hover:shadow-[0_10px_22px_-10px_rgba(131,85,21,0.85)]';
---

<div data-account-menu data-account-scope={profileHref.startsWith('/admin') ? 'admin' : 'app'}>
  <details class="dropdown dropdown-end hidden sm:block" data-account-dropdown>
    <summary
      class:list={[avatarClass, 'list-none']}
      aria-label={en ? `Open account menu for ${label}` : `Abrir menu da conta de ${label}`}
    >
      <img
        data-account-avatar
        src={avatar ?? ''}
        alt=""
        class:list={['h-full w-full rounded-full object-cover', !avatar && 'hidden']}
      />
      <span
        data-account-initials
        class:list={['grid h-full w-full place-items-center', avatar && 'hidden']}
      >
        {initials || 'V'}
      </span>
    </summary>
    <ul class="menu dropdown-content z-50 mt-3 w-60 rounded-2xl border border-[#d8ae73] bg-white p-2 shadow-[0_18px_45px_-20px_rgba(95,59,12,0.28)]">
      <li class="pointer-events-none border-b border-[#ead8bd] px-3 py-2">
        <span class="block truncate p-0 text-sm font-semibold text-[#17130d]" data-account-label>
          {label}
        </span>
      </li>
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
      <li class="border-t border-[#ead8bd] pt-1">
        <button type="button" data-account-logout>
          {en ? 'Sign out' : 'Sair da conta'}
        </button>
      </li>
    </ul>
  </details>
  <div class="sm:hidden">
    <button
      class={avatarClass}
      type="button"
      data-open-account
      aria-label={en ? `Open account menu for ${label}` : `Abrir menu da conta de ${label}`}
    >
      <img
        data-account-avatar
        src={avatar ?? ''}
        alt=""
        class:list={['h-full w-full rounded-full object-cover', !avatar && 'hidden']}
      />
      <span
        data-account-initials
        class:list={['grid h-full w-full place-items-center', avatar && 'hidden']}
      >
        {initials || 'V'}
      </span>
    </button>
    <Sheet
      label={en ? 'Your account' : 'Sua conta'}
      closeLabel={en ? 'Close options' : 'Fechar opções'}
    >
      <p class="mb-4 truncate text-sm font-semibold text-[#17130d]" data-account-label>
        {label}
      </p>
      <ul class="menu w-full gap-1 p-0 text-base">
        {links.map((link) => (
          <li>
            <a class="min-h-12 rounded-xl px-4" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="mt-2 pt-2">
          <button class="min-h-12 rounded-xl px-4" type="button" data-account-logout>
            {en ? 'Sign out' : 'Sair da conta'}
          </button>
        </li>
      </ul>
    </Sheet>
  </div>
</div>
