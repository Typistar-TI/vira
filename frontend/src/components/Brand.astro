---
interface Props {
  href?: string;
  compact?: boolean;
  tone?: 'light' | 'dark';
}
const { href = '/', compact = false, tone = 'dark' } = Astro.props;
---

<a href={href} class="inline-flex items-center gap-1.5 no-underline" aria-label="Vira">
  <img
    src={tone === 'light' ? '/vira-mark-amber.png' : '/vira-mark.png'}
    width="40"
    height="40"
    alt=""
    class="h-9 w-9 object-contain sm:h-10 sm:w-10"
  />
  {!compact && (
    <img
      src={tone === 'light' ? '/vira-wordmark-amber.png' : '/vira-wordmark.png'}
      width="122"
      height="50"
      alt=""
      class="h-[38px] w-[93px] object-contain sm:h-[45px] sm:w-[110px]"
    />
  )}
</a>
