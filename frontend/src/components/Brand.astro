---
interface Props {
  href?: string;
  compact?: boolean;
  tone?: 'light' | 'dark';
}
const { href, compact = false, tone = 'dark' } = Astro.props;
const homeHref = href ?? '/';
---

<a href={homeHref} class="inline-flex min-w-0 items-center gap-1.5 no-underline" aria-label="Vira">
  <img
    src={tone === 'light' ? '/vira-mark-amber.png' : '/vira-mark.png'}
    width="40"
    height="40"
    alt=""
    class="h-9 w-9 shrink-0 object-contain sm:h-10 sm:w-10"
  />
  {!compact && (
    <img
      src={tone === 'light' ? '/vira-wordmark-amber.png' : '/vira-wordmark.png'}
      width="122"
      height="50"
      alt=""
      class="h-9 w-auto max-w-full object-contain sm:h-[45px]"
    />
  )}
</a>
