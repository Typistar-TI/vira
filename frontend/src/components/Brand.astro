---
interface Props {
  href?: string;
  compact?: boolean;
}
const { href = '/', compact = false } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center gap-1.5 rounded-full bg-[#1b1916] px-2.5 py-1 no-underline shadow-sm"
  aria-label="Vira"
>
  <img
    src="/vira-mark.png"
    width="40"
    height="40"
    alt=""
    class="h-9 w-9 object-contain sm:h-10 sm:w-10"
  />
  {!compact && (
    <img
      src="/vira-wordmark.png"
      width="122"
      height="50"
      alt=""
      class="h-[38px] w-[93px] object-contain sm:h-[45px] sm:w-[110px]"
    />
  )}
</a>
