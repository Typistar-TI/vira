---
interface Props {
  href?: string;
  compact?: boolean;
}
const { href = '/', compact = false } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center gap-1.5 text-[#f3f6fc] no-underline"
  aria-label="Vira"
>
  <img src="/vira-symbol.png" width="44" height="44" alt="" class="-m-1 h-11 w-11 object-contain" />
  {!compact && (
    <span class="font-[Outfit] text-[1.65rem] font-semibold tracking-[-0.06em]">vira</span>
  )}
</a>
