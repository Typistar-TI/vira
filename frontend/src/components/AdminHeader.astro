---
import Brand from '@frontend/components/Brand.astro';
import AccountMenu from '@frontend/components/AccountMenu.astro';
import MobileNavigation from '@frontend/components/MobileNavigation.astro';

interface Props {
  section: string;
  admin: { email: string; displayName: string; avatar?: string | null };
}

const { section, admin } = Astro.props;
const navigation = [
  {
    key: 'visao',
    href: '/admin',
    label: 'Visão geral',
    icon: '<path d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75"/>',
  },
  {
    key: 'configuracoes',
    href: '/admin/configuracoes',
    label: 'Configurações',
    icon: '<path d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>',
  },
  {
    key: 'emails',
    href: '/admin/emails',
    label: 'E-mails',
    icon: '<path d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>',
  },
  {
    key: 'usuarios',
    href: '/admin/usuarios',
    label: 'Usuários',
    icon: '<path d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/>',
  },
  {
    key: 'logs',
    href: '/admin/logs',
    label: 'Logs',
    icon: '<path d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.008v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.008v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.008v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>',
  },
];
---

<header class="bg-white">
  <div class="mx-auto flex max-w-[1380px] flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-8">
    <Brand href="/admin" tone="light" />
    <nav
      class="hidden h-10 items-center gap-1 overflow-x-auto rounded-full border border-[#d8ae73] bg-white/95 px-4 text-sm text-[#605448] shadow-[0_8px_30px_-22px_rgba(131,85,21,0.35)] xl:flex"
      aria-label="Navegação administrativa"
    >
      {navigation.map((item) => (
        <a
          href={item.href}
          aria-current={section === item.key ? 'page' : undefined}
          class:list={[
            'flex items-center gap-1.5 rounded-full px-3 py-1.5 whitespace-nowrap transition-colors focus-visible:outline-2 focus-visible:outline-[#b88333]',
            section === item.key ? 'font-semibold text-[#6f4716]' : 'hover:text-[#9b6823]',
          ]}
        >
          <svg
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={item.icon}
          />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2 xl:ml-0">
      <div class="xl:hidden">
        <MobileNavigation
          label="Navegação"
          lang="pt"
          iconOnly
          links={navigation.map((item) => ({
            href: item.href,
            label: item.label,
            current: section === item.key,
          }))}
        />
      </div>
      <AccountMenu
        email={admin.email}
        displayName={admin.displayName}
        avatar={admin.avatar ?? null}
        profileHref="/admin/conta"
        homeHref="/"
      />
    </div>
  </div>
</header>
