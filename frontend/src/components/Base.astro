---
import '@frontend/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Motion from '@frontend/components/Motion.astro';
import Toast from '@frontend/components/Toast.astro';
interface Props {
  title: string;
  description?: string;
  lang?: 'pt' | 'en';
  noindex?: boolean;
  appearance?: 'dark' | 'light';
  manifest?: string;
  favicon?: string;
  touchIcon?: string;
  themeColor?: string;
  pageBackground?: string;
  fontHref?: string;
}
const {
  title,
  description = '',
  lang = 'pt',
  noindex = false,
  appearance = 'dark',
  manifest = '/manifest.webmanifest',
  favicon = '/favicon.png',
  touchIcon = '/pwa-icon-192.png',
  themeColor = appearance === 'light' ? '#ffffff' : '#050505',
  pageBackground,
  fontHref,
} = Astro.props;
const motionClasses =
  "font-['Outfit',sans-serif] antialiased selection:bg-[#d6a85f] selection:text-black [&_.btn]:transition-[transform,background-color,border-color,box-shadow,opacity] [&_.btn]:duration-300 [&_.btn]:ease-out [&_.btn:active]:scale-[0.97] [&_a]:transition-colors [&_a]:duration-300 [&_button]:transition-[transform,background-color,border-color,box-shadow,opacity] [&_button]:duration-300 [&_button:active]:scale-[0.97] [&_.input]:transition-[border-color,box-shadow] [&_.input]:duration-300 [&_.textarea]:transition-[border-color,box-shadow] [&_.textarea]:duration-300 [&_.select]:transition-[border-color,box-shadow] [&_.select]:duration-300 motion-reduce:[&_*]:!transition-none";
const darkFields =
  '[&_.input]:border-[#45413a] [&_.input]:bg-[#0b0b0b] [&_.textarea]:border-[#45413a] [&_.textarea]:bg-[#0b0b0b] [&_.select]:border-[#45413a] [&_.select]:bg-[#0b0b0b] [&_.file-input]:border-[#45413a] [&_.file-input]:bg-[#0b0b0b]';
const lightFields =
  '[&_.input]:border [&_.input]:border-[#d8ae73] [&_.input]:bg-white [&_.textarea]:border [&_.textarea]:border-[#d8ae73] [&_.textarea]:bg-white [&_.select]:border [&_.select]:border-[#d8ae73] [&_.select]:bg-white [&_.file-input]:border [&_.file-input]:border-[#d8ae73] [&_.file-input]:bg-white [&_.input:focus-within]:!outline-2 [&_.input:focus-within]:!outline-[#b88333] [&_.input:focus-within]:!outline-offset-[-2px] [&_.textarea:focus-within]:!outline-2 [&_.textarea:focus-within]:!outline-[#b88333] [&_.textarea:focus-within]:!outline-offset-[-2px] [&_.select:focus-within]:!outline-2 [&_.select:focus-within]:!outline-[#b88333] [&_.select:focus-within]:!outline-offset-[-2px] [&_.file-input:focus-within]:!outline-2 [&_.file-input:focus-within]:!outline-[#b88333] [&_.file-input:focus-within]:!outline-offset-[-2px] [&_button:focus-visible]:outline-2 [&_button:focus-visible]:outline-offset-2 [&_button:focus-visible]:outline-[#b88333] [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2 [&_a:focus-visible]:outline-[#b88333] [&_.btn]:border [&_.btn]:border-[#b88333] [&_.btn-outline]:text-[#6f4716] [&_.alert]:border [&_.alert]:border-[#d8ae73] [&_.alert]:bg-white [&_.alert-error]:text-[#a13535] [&_.alert-info]:text-[#5b4428]';
---

<!doctype html>
<html
  lang={lang}
  class:list={[
    'scroll-smooth motion-reduce:scroll-auto',
    appearance === 'light' && '[scrollbar-color:#b88333_#ffffff]',
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {fontHref && <link href={fontHref} rel="stylesheet" />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="icon" href={favicon} type="image/png" />
    <link rel="apple-touch-icon" href={touchIcon} />
    <link rel="manifest" href={manifest} />
    <ClientRouter />
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>
    <slot name="head" />
  </head>
  <body
    style={pageBackground ? `background-color:${pageBackground}` : undefined}
    data-theme={appearance === 'light' ? 'vira-light' : 'vira'}
    class:list={[
      appearance === 'light' ? 'bg-white text-[#17130d]' : 'bg-black text-[#f5f2ec]',
      motionClasses,
      appearance === 'dark' && darkFields,
      appearance === 'light' && lightFields,
    ]}
  >
    <slot />
    <Toast />
    <Motion />
    <script>
      import { enhanceDatePickers } from '@frontend/pages/_scripts/date-picker';
      window.scrollTo(0, 0);
      window.addEventListener('pageshow', () => window.scrollTo(0, 0));
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
      document.addEventListener('astro:page-load', enhanceDatePickers);
    </script>
  </body>
</html>
