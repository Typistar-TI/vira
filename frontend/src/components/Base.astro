---
import '@frontend/styles/global.css';
interface Props {
  title: string;
  description?: string;
  lang?: 'pt' | 'en';
  noindex?: boolean;
}
const { title, description = '', lang = 'pt', noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <slot name="head" />
  </head>
  <body class="bg-black font-['DM_Sans',sans-serif] text-[#f5f2ec] antialiased selection:bg-[#d6a85f] selection:text-black [&_.input]:border-[#45413a] [&_.input]:bg-[#0b0b0b] [&_.textarea]:border-[#45413a] [&_.textarea]:bg-[#0b0b0b] [&_.select]:border-[#45413a] [&_.select]:bg-[#0b0b0b] [&_.file-input]:border-[#45413a] [&_.file-input]:bg-[#0b0b0b]">
    <slot />
  </body>
</html>
