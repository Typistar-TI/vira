---
import '@frontend/styles/global.css';
import Motion from '@frontend/components/Motion.astro';
interface Props {
  title: string;
  description?: string;
  lang?: 'pt' | 'en';
  noindex?: boolean;
}
const { title, description = '', lang = 'pt', noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <slot name="head" />
  </head>
  <body class="bg-black font-['Outfit',sans-serif] text-[#f5f2ec] antialiased selection:bg-[#d6a85f] selection:text-black [&_.btn]:transition-[transform,background-color,border-color,box-shadow,opacity] [&_.btn]:duration-300 [&_.btn]:ease-out [&_.btn:active]:scale-[0.97] [&_a]:transition-colors [&_a]:duration-300 [&_button]:transition-[transform,background-color,border-color,box-shadow,opacity] [&_button]:duration-300 [&_button:active]:scale-[0.97] [&_.input]:border-[#45413a] [&_.input]:bg-[#0b0b0b] [&_.input]:transition-[border-color,box-shadow] [&_.input]:duration-300 [&_.textarea]:border-[#45413a] [&_.textarea]:bg-[#0b0b0b] [&_.textarea]:transition-[border-color,box-shadow] [&_.textarea]:duration-300 [&_.select]:border-[#45413a] [&_.select]:bg-[#0b0b0b] [&_.select]:transition-[border-color,box-shadow] [&_.select]:duration-300 [&_.file-input]:border-[#45413a] [&_.file-input]:bg-[#0b0b0b] motion-reduce:[&_*]:!transition-none">
    <slot />
    <Motion />
  </body>
</html>
