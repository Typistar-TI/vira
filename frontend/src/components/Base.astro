---
import '@frontend/styles/global.css';
interface Props {
  title: string;
  description?: string;
  lang?: 'pt' | 'en';
  noindex?: boolean;
}
const { title, description = '', lang = 'pt', noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#513B70" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body class="font-['DM_Sans',sans-serif]">
    <slot />
  </body>
</html>
