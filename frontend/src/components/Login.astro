---
import Base from '@frontend/components/Base.astro';
import Brand from '@frontend/components/Brand.astro';
import { getSetting } from '@frontend/api/config/setting';
import { googleLoginUrl } from '@frontend/api/auth/google-url';
import { emailLoginEnabled } from '@frontend/api/config/email-login-enabled';
import { preferredLanguage } from '@frontend/i18n/preferred-language';

const { url } = Astro.props;
const adminLogin = url.searchParams.get('next') === 'admin';
const en = preferredLanguage(Astro.request) === 'en';
const clientId = await getSetting('GOOGLE_CLIENT_ID');
const [controller, contact, resendKey, emailFrom, emailEnabled] = await Promise.all([
  getSetting('PRIVACY_CONTROLLER_NAME'),
  getSetting('PRIVACY_CONTACT_EMAIL'),
  getSetting('RESEND_API_KEY'),
  getSetting('AUTH_EMAIL_FROM'),
  emailLoginEnabled(),
]);
const legalReady = Boolean(controller && contact);
const emailReady = Boolean(resendKey && emailFrom && emailEnabled);
const error = url.searchParams.get('error')?.slice(0, 150);
const loginUri = googleLoginUrl(url);
---

<Base
  title={en ? 'Sign in · Vira' : 'Entrar · Vira'}
  lang={en ? 'en' : 'pt'}
  noindex
  appearance="light"
>
  <div class="min-h-screen bg-white text-[#17130d]">
    <header class="mx-auto flex max-w-[1380px] items-center justify-between gap-5 border-b border-[#d8ae73] px-5 py-4 sm:px-8">
      <Brand tone="light" />
    </header>
    <main class="card mx-5 my-8 max-w-[480px] rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] sm:mx-auto sm:my-24 sm:p-7">
      <span class="badge badge-outline h-auto rounded-full border-[#d8ae73] px-3 py-2 text-xs font-bold text-[#8b5b1e]">
        {en ? '7 days free' : '7 dias grátis'}
      </span>
      <h1 class="mt-6 mb-4 font-[Outfit] text-[clamp(2.6rem,5vw,3.6rem)] leading-none tracking-[-0.055em]">
        {en ? 'Your page starts here.' : 'Sua página começa aqui.'}
      </h1>
      <p class="text-[#625a51] mb-6">
        {!emailReady && clientId
          ? en
            ? 'Continue with your Google account.'
            : 'Continue com sua conta Google.'
          : clientId
            ? en
              ? 'Use your email to receive a sign-in link, or continue with Google.'
              : 'Receba um link no seu e-mail ou continue com Google.'
            : en
              ? 'Enter your email to receive a sign-in link.'
              : 'Digite seu e-mail para receber um link de acesso.'}
      </p>
      {emailReady && (
        <form id="email-login-form" class="mb-6">
          <label for="login-email">{en ? 'Email' : 'E-mail'}</label>
          <input
            class="input input-bordered w-full mt-2 mb-3"
            id="login-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="voce@exemplo.com"
            required
          />
          <button
            class="btn btn-primary rounded-xl border-0 font-bold shadow-none w-full"
            type="submit"
          >
            {en ? 'Send sign-in link' : 'Enviar link de acesso'}
          </button>
        </form>
      )}
      {!emailReady && !clientId && (
        <p class="alert alert-error my-3 [hidden]:hidden mb-5">
          {en
            ? 'Email sign-in is being configured.'
            : 'A entrada por e-mail está sendo configurada.'}
        </p>
      )}
      {clientId && (
        <>
          {emailReady && <p class="text-[#625a51] mb-4">{en ? 'Or' : 'Ou'}</p>}
          <div
            id="g_id_onload"
            data-client_id={clientId}
            data-login_uri={loginUri}
            data-ux_mode="redirect"
            data-auto_prompt="false"
          ></div>
          <div
            class="g_id_signin"
            data-type="standard"
            data-theme="outline"
            data-size="large"
            data-text="continue_with"
            data-shape="pill"
            data-logo_alignment="left"
          ></div>
        </>
      )}
      {!legalReady && !adminLogin && (
        <p class="alert alert-error my-3 [hidden]:hidden mt-3">
          {en
            ? 'New registrations are temporarily unavailable.'
            : 'Novos cadastros estão temporariamente indisponíveis.'}
        </p>
      )}
      {adminLogin && (
        <p class="text-xs text-[#625a51] mt-3">
          {en
            ? 'Administrative access is limited to authorized email addresses.'
            : 'Acesso administrativo restrito a e-mails autorizados.'}
        </p>
      )}
      {error && <input type="hidden" id="login-error" value={error} />}
      <p class="text-xs text-[#625a51] mt-6">
        <a href={en ? '/en/privacy' : '/privacidade'}>
          {en ? 'How we use your data' : 'Como usamos seus dados'}
        </a>
      </p>
    </main>
  </div>
  {clientId && <script src="https://accounts.google.com/gsi/client" async defer></script>}
  <script>
    import { startEmail } from '@frontend/api/auth/start-email';
    import { reportError, showToast } from '@frontend/components/toast';
    const loginError = document.querySelector<HTMLInputElement>('#login-error')?.value;
    if (loginError)
      document.addEventListener('DOMContentLoaded', () => showToast(loginError, 'error'));
    document
      .querySelector<HTMLFormElement>('#email-login-form')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          const email = form.querySelector<HTMLInputElement>('[name=email]')!.value.trim();
          await startEmail(email);
        } catch (error) {
          reportError(error, 'Falha ao enviar');
        } finally {
          button.disabled = false;
        }
      });
  </script>
</Base>
