---
import Base from '@frontend/components/Base.astro';
import { getSetting } from '@frontend/api/config/setting';
import { googleLoginUrl } from '@frontend/api/auth/google-url';

const { url } = Astro.props;
const adminLogin = url.searchParams.get('next') === 'admin';
const en = url.searchParams.get('lang') === 'en';
const clientId = await getSetting('GOOGLE_CLIENT_ID');
const [controller, contact, resendKey, emailFrom] = await Promise.all([
  getSetting('PRIVACY_CONTROLLER_NAME'),
  getSetting('PRIVACY_CONTACT_EMAIL'),
  getSetting('RESEND_API_KEY'),
  getSetting('AUTH_EMAIL_FROM'),
]);
const legalReady = Boolean(controller && contact);
const emailReady = Boolean(resendKey && emailFrom);
const error = url.searchParams.get('error')?.slice(0, 150);
const loginUri = googleLoginUrl(url);
---

<Base title={en ? 'Sign in · Vira' : 'Entrar · Vira'} lang={en ? 'en' : 'pt'} noindex>
  <div class="min-h-screen bg-[#f3eefa] text-[#292534] font-['DM_Sans',sans-serif] min-h-screen">
    <header class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-5 px-6 py-5">
      <a
        class="inline-flex items-center gap-1.5 font-[Outfit] text-[31px] leading-none font-extrabold tracking-[-0.08em] text-[#513b70] no-underline [&_span]:text-[#f27668]"
        href="/"
      >
        vira<span>.</span>
      </a>
      <a href={en ? '/login' : '/login?lang=en'}>{en ? 'Português' : 'English'}</a>
    </header>
    <main class="card rounded-[22px] border border-[#e4dcec] bg-white p-6 shadow-[0_10px_30px_#513b700c] [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#513b70] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#6f647d] mx-auto my-[50px] max-w-[450px]">
      <span class="badge badge-secondary h-auto rounded-full px-3 py-2 text-xs font-bold">
        {en ? '7 days free' : '7 dias grátis'}
      </span>
      <h1 class="text-4xl mt-4 mb-3">
        {en ? 'Your page starts here.' : 'Sua página começa aqui.'}
      </h1>
      <p class="text-[#6f647d] mb-6">
        {clientId
          ? en
            ? 'Use your email to receive a sign-in link, or continue with Google.'
            : 'Receba um link no seu e-mail ou continue com Google.'
          : en
            ? 'Enter your email to receive a sign-in link.'
            : 'Digite seu e-mail para receber um link de acesso.'}
      </p>
      <form id="email-login-form" class="mb-6">
        <label for="login-email">{en ? 'Email' : 'E-mail'}</label>
        <input
          class="input input-bordered w-full mt-2 mb-3"
          id="login-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="voce@exemplo.com"
          required
        />
        <button
          class="btn btn-primary rounded-xl border-0 font-bold shadow-none w-full"
          type="submit"
          disabled={!emailReady}
        >
          {en ? 'Send sign-in link' : 'Enviar link de acesso'}
        </button>
        <p
          id="email-login-status"
          class="alert alert-info my-3 [hidden]:hidden mt-3"
          role="status"
          hidden
        ></p>
      </form>
      {!emailReady && (
        <p class="alert alert-error my-3 [hidden]:hidden mb-5">
          {en
            ? 'Email sign-in is being configured.'
            : 'A entrada por e-mail está sendo configurada.'}
        </p>
      )}
      {clientId && (
        <>
          <p class="text-[#6f647d] mb-4">{en ? 'Or' : 'Ou'}</p>
          <div
            id="g_id_onload"
            data-client_id={clientId}
            data-login_uri={loginUri}
            data-ux_mode="redirect"
            data-auto_prompt="false"
          ></div>
          <div
            class="g_id_signin"
            data-type="standard"
            data-theme="outline"
            data-size="large"
            data-text="continue_with"
            data-shape="pill"
            data-logo_alignment="left"
          ></div>
        </>
      )}
      {!legalReady && !adminLogin && (
        <p class="alert alert-error my-3 [hidden]:hidden mt-3">
          {en
            ? 'New registrations are temporarily unavailable.'
            : 'Novos cadastros estão temporariamente indisponíveis.'}
        </p>
      )}
      {adminLogin && (
        <p class="text-xs text-[#6f647d] mt-3">
          {en
            ? 'Administrative access is limited to authorized email addresses.'
            : 'Acesso administrativo restrito a e-mails autorizados.'}
        </p>
      )}
      {error && (
        <p class="alert alert-error my-3 [hidden]:hidden mt-3" role="alert">
          {error}
        </p>
      )}
      <p class="text-xs text-[#6f647d] mt-6">
        <a href={en ? '/en/privacy' : '/privacidade'}>
          {en ? 'How we use your data' : 'Como usamos seus dados'}
        </a>
      </p>
    </main>
  </div>
  {clientId && <script src="https://accounts.google.com/gsi/client" async defer></script>}
  <script>
    import { startEmail } from '@frontend/api/auth/start-email';
    document
      .querySelector<HTMLFormElement>('#email-login-form')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        const status = document.querySelector<HTMLElement>('#email-login-status')!;
        button.disabled = true;
        status.hidden = false;
        status.classList.remove('alert-error');
        status.classList.add('alert-info');
        status.textContent = document.documentElement.lang === 'en' ? 'Sending...' : 'Enviando...';
        try {
          const email = form.querySelector<HTMLInputElement>('[name=email]')!.value.trim();
          const data = await startEmail(email);
          status.textContent =
            document.documentElement.lang === 'en'
              ? 'If eligible, a sign-in link is on its way. Check your inbox.'
              : data.message;
        } catch (error) {
          status.classList.remove('alert-info');
          status.classList.add('alert-error');
          status.textContent = error instanceof Error ? error.message : 'Falha ao enviar';
        } finally {
          button.disabled = false;
        }
      });
  </script>
</Base>
