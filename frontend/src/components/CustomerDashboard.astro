---
import Base from '@frontend/components/Base.astro';
import Brand from '@frontend/components/Brand.astro';
import { getPublicPrices } from '@frontend/api/billing/public-prices';
import { getRootDomain } from '@frontend/api/config/root-domain';
import { userHasAccess } from '@frontend/api/sites/has-access';
import { parseSiteContent } from '@frontend/api/sites/parse-site';
import { preferredLanguage } from '@frontend/i18n/preferred-language';
const { user, site } = Astro.props;
const content = parseSiteContent(JSON.parse(site.draft_json));
const active = userHasAccess(user);
const en = preferredLanguage(Astro.request) === 'en';
const domain = await getRootDomain();
const priceRows = await getPublicPrices();
const priceMap = Object.fromEntries(
  priceRows.map((row) => [`${row.plan}_${row.currency}`, row.amount_minor]),
);
const priceText = (plan: string) => {
  const amount = priceMap[`${plan}_brl`];
  return amount
    ? new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(amount / 100)
    : '—';
};
const t = en
  ? {
      dashboard: 'Your space',
      signout: 'End session',
      backToSite: 'Back to site',
      trial: 'Free trial',
      active: 'Active',
      expired: 'Access expired',
      yourPage: 'Your page',
      publicLink: 'Public address',
      preview: 'Preview',
      desktop: 'Desktop',
      mobile: 'Mobile',
      content: 'Content',
      layout: 'Layout',
      language: 'Page language',
      title: 'Headline',
      subtitle: 'Introduction',
      hero: 'Cover image',
      upload: 'Upload image',
      buttonText: 'Main button text',
      buttonUrl: 'Main button link',
      about: 'About',
      aboutTitle: 'Section heading',
      aboutBody: 'Description',
      benefits: 'Benefits',
      stats: 'Highlight numbers',
      testimonials: 'Testimonials',
      products: 'Catalog',
      footer: 'Footer text',
      add: 'Add',
      remove: 'Remove',
      label: 'Label',
      value: 'Value',
      description: 'Description',
      name: 'Name',
      quote: 'Quote',
      image: 'Image',
      link: 'Link',
      save: 'Save draft',
      publish: 'Publish',
      plans: 'Plan and billing',
      monthly: 'Monthly',
      yearly: 'Yearly',
      lifetime: 'Lifetime',
      portal: 'Manage subscription',
      domain: 'Custom domain',
      domainHint: 'Available after payment. Use an address such as www.example.com.',
      connect: 'Connect domain',
      address: 'Vira subdomain',
      change: 'Change address',
      metrics: 'Last 30 days',
      views: 'Views',
      clicks: 'Button clicks',
      account: 'Account and data',
      exportData: 'Download my data',
      deleteAccount: 'Delete account',
      confirmEmail: 'Type your email to confirm',
      privacy: 'Privacy',
      identity: 'Site identity and app',
      identityHint:
        'These changes appear on your public site after you publish. Visitors can install it on their phones.',
      favicon: 'Browser icon (favicon)',
      appIcon: 'App icon (PWA)',
      appName: 'Name shown when installed',
      iconHint: 'Choose a square PNG, JPG or WebP image. Vira prepares the sizes for phones.',
      browserColor: 'Browser bar color',
      pageColor: 'Page background',
      textColor: 'Text color',
      accentColor: 'Accent color',
    }
  : {
      dashboard: 'Seu espaço',
      signout: 'Encerrar sessão',
      backToSite: 'Voltar ao site',
      trial: 'Teste grátis',
      active: 'Ativo',
      expired: 'Acesso expirado',
      yourPage: 'Sua página',
      publicLink: 'Endereço público',
      preview: 'Prévia',
      desktop: 'Computador',
      mobile: 'Celular',
      content: 'Conteúdo',
      layout: 'Layout',
      language: 'Idioma da página',
      title: 'Título principal',
      subtitle: 'Apresentação',
      hero: 'Imagem de capa',
      upload: 'Enviar imagem',
      buttonText: 'Texto do botão principal',
      buttonUrl: 'Link do botão principal',
      about: 'Sobre',
      aboutTitle: 'Título da seção',
      aboutBody: 'Descrição',
      benefits: 'Benefícios',
      stats: 'Números em destaque',
      testimonials: 'Depoimentos',
      products: 'Catálogo',
      footer: 'Texto do rodapé',
      add: 'Adicionar',
      remove: 'Remover',
      label: 'Legenda',
      value: 'Valor',
      description: 'Descrição',
      name: 'Nome',
      quote: 'Depoimento',
      image: 'Imagem',
      link: 'Link',
      save: 'Salvar rascunho',
      publish: 'Publicar',
      plans: 'Plano e cobrança',
      monthly: 'Mensal',
      yearly: 'Anual',
      lifetime: 'Vitalício',
      portal: 'Gerenciar assinatura',
      domain: 'Domínio próprio',
      domainHint: 'Disponível após o pagamento. Use um endereço como www.exemplo.com.br.',
      connect: 'Conectar domínio',
      address: 'Subdomínio Vira',
      change: 'Alterar endereço',
      metrics: 'Últimos 30 dias',
      views: 'Visualizações',
      clicks: 'Cliques nos botões',
      account: 'Conta e dados',
      exportData: 'Baixar meus dados',
      deleteAccount: 'Excluir conta',
      confirmEmail: 'Digite seu e-mail para confirmar',
      privacy: 'Privacidade',
      identity: 'Identidade do site e aplicativo',
      identityHint:
        'As alterações aparecem no site público depois de publicar. Os visitantes poderão instalá-lo no celular.',
      favicon: 'Ícone do navegador (favicon)',
      appIcon: 'Ícone do aplicativo (PWA)',
      appName: 'Nome mostrado após instalar',
      iconHint:
        'Escolha uma imagem quadrada PNG, JPG ou WebP. O Vira prepara os tamanhos para celular.',
      browserColor: 'Cor da barra do navegador',
      pageColor: 'Fundo da página',
      textColor: 'Cor do texto',
      accentColor: 'Cor de destaque',
    };
const trialDays = Math.max(0, Math.ceil((user.trial_ends_at * 1000 - Date.now()) / 86400000));
---

<Base
  title={`${t.dashboard} · Vira`}
  lang={en ? 'en' : 'pt'}
  noindex
  appearance="light"
  manifest="/app/manifest.webmanifest"
>
  <div class="min-h-screen bg-white text-[#17130d]">
    <header class="border-b border-[#d8ae73] bg-white">
      <div class="mx-auto flex max-w-[1380px] items-center justify-between gap-5 px-5 py-4 sm:px-8">
        <Brand href="/app" tone="light" />
        <div class="flex items-center gap-1 sm:gap-3">
          <a href="/" class="btn btn-ghost btn-xs sm:btn-sm" aria-label={t.backToSite}>
            <span class="sm:hidden">{en ? 'Back' : 'Voltar'}</span>
            <span class="hidden sm:inline">{t.backToSite}</span>
          </a>
          <button id="logout" class="btn btn-ghost btn-xs sm:btn-sm" aria-label={t.signout}>
            <span class="sm:hidden">{en ? 'Sign out' : 'Sair'}</span>
            <span class="hidden sm:inline">{t.signout}</span>
          </button>
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-[1380px] px-5 pb-24 pt-9 sm:px-8">
      <div class="relative mb-8 min-h-[240px] overflow-hidden rounded-xl border border-[#d8ae73] bg-white p-7 sm:p-9">
        <img
          src="/vira-process-light.webp"
          width="1586"
          height="992"
          alt=""
          class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-[52%] object-cover object-right opacity-65 md:block"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-white via-white to-transparent"></div>
        <div class="relative z-10 max-w-[800px]">
          <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
            {t.dashboard}
          </span>
          <h1 class="mt-3 font-[Outfit] text-[clamp(2.6rem,5vw,4.6rem)] leading-none tracking-[-0.055em]">
            {t.yourPage}
          </h1>
          <p class="mt-3 text-[#625a51]">
            {user.plan === 'trial'
              ? `${t.trial} · ${trialDays} ${en ? 'days left' : 'dias restantes'}`
              : active
                ? t.active
                : t.expired}
          </p>
          <span class="badge badge-outline mt-7 h-auto max-w-full border-[#d8ae73] px-3 py-3 text-xs text-[#625a51]">
            {user.email ?? 'Conta antiga'}
          </span>
        </div>
      </div>
      {!active && (
        <div class="alert alert-error my-3 [hidden]:hidden mb-5">
          {en
            ? 'Your page is suspended. Choose a plan to publish it again.'
            : 'Sua página está suspensa. Escolha um plano para publicá-la novamente.'}
        </div>
      )}
      <nav
        class="mb-8 flex gap-2 overflow-x-auto border-b border-[#d8ae73] pb-3 text-sm whitespace-nowrap"
        aria-label={en ? 'Dashboard sections' : 'Seções do painel'}
      >
        <a
          class="rounded-lg border-b-2 border-[#b88333] bg-white px-4 py-2 text-[#17130d]"
          href="#editor"
        >
          {t.content}
        </a>
        <a
          class="rounded-lg px-4 py-2 text-[#625a51] transition-colors hover:bg-[#fff9ef] hover:text-[#9b6823]"
          href="#plan-and-billing"
        >
          {t.plans}
        </a>
        <a
          class="rounded-lg px-4 py-2 text-[#625a51] transition-colors hover:bg-[#fff9ef] hover:text-[#9b6823]"
          href="#domain-form"
        >
          {t.domain}
        </a>
        <a
          class="rounded-lg px-4 py-2 text-[#625a51] transition-colors hover:bg-[#fff9ef] hover:text-[#9b6823]"
          href="#delete-account-form"
        >
          {t.account}
        </a>
      </nav>
      <div class="grid items-start gap-6 xl:grid-cols-[minmax(360px,520px)_minmax(0,1fr)]">
        <div>
          <section class="card rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2>{t.address}</h2>
            <p class="text-sm text-[#625a51]">
              {t.publicLink}:{' '}
              <a
                id="public-url"
                href={`https://${site.slug}.${domain}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {site.slug}.{domain}
              </a>
            </p>
            <form id="slug-form" class="flex gap-2 mt-4">
              <input
                class="input input-bordered flex-1"
                name="slug"
                value={site.slug}
                aria-label={t.address}
                required
              />
              <button class="btn btn-outline" type="submit">
                {t.change}
              </button>
            </form>
          </section>
          <section class="card rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2>{t.metrics}</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <strong id="metric-views" class="font-[Outfit] text-4xl font-medium text-[#17130d]">
                  —
                </strong>
                <p class="text-[#625a51]">{t.views}</p>
              </div>
              <div>
                <strong
                  id="metric-clicks"
                  class="font-[Outfit] text-4xl font-medium text-[#17130d]"
                >
                  —
                </strong>
                <p class="text-[#625a51]">{t.clicks}</p>
              </div>
            </div>
          </section>
          <form
            id="editor"
            class="card rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5"
            data-initial={JSON.stringify(content)}
          >
            <h2>{t.content}</h2>
            <label for="layout">{t.layout}</label>
            <select class="select select-bordered" name="layout" id="layout">
              <option value="pulse" selected={content.layout === 'pulse'}>
                Pulse
              </option>
              <option value="editorial" selected={content.layout === 'editorial'}>
                Editorial
              </option>
              <option value="showcase" selected={content.layout === 'showcase'}>
                Showcase
              </option>
            </select>
            <label for="language">{t.language}</label>
            <select class="select select-bordered" name="language" id="language">
              <option value="pt" selected={content.language === 'pt'}>
                Português
              </option>
              <option value="en" selected={content.language === 'en'}>
                English
              </option>
            </select>
            <h3>{t.identity}</h3>
            <p class="text-sm text-[#625a51]">{t.identityHint}</p>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="favicon-file">{t.favicon}</label>
                <input
                  class="file-input file-input-bordered w-full"
                  id="favicon-file"
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                />
                <input type="hidden" name="favicon" value={content.favicon} />
                {content.favicon && (
                  <img
                    src={content.favicon}
                    alt=""
                    width="48"
                    height="48"
                    class="mt-2 rounded-lg border border-[#d8ae73]"
                  />
                )}
              </div>
              <div>
                <label for="pwa-icon-file">{t.appIcon}</label>
                <input
                  class="file-input file-input-bordered w-full"
                  id="pwa-icon-file"
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                />
                <input type="hidden" name="pwaIcon192" value={content.pwaIcon192} />
                <input type="hidden" name="pwaIcon512" value={content.pwaIcon512} />
                {content.pwaIcon192 && (
                  <img
                    src={content.pwaIcon192}
                    alt=""
                    width="48"
                    height="48"
                    class="mt-2 rounded-lg border border-[#d8ae73]"
                  />
                )}
              </div>
            </div>
            <small>{t.iconHint}</small>
            <label for="appName">{t.appName}</label>
            <input
              class="input input-bordered"
              id="appName"
              name="appName"
              maxlength="50"
              value={content.appName}
              placeholder={content.title}
            />
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="themeColor">{t.browserColor}</label>
                <input
                  class="input input-bordered h-12 p-1"
                  id="themeColor"
                  name="themeColor"
                  type="color"
                  value={content.themeColor}
                />
              </div>
              <div>
                <label for="backgroundColor">{t.pageColor}</label>
                <input
                  class="input input-bordered h-12 p-1"
                  id="backgroundColor"
                  name="backgroundColor"
                  type="color"
                  value={content.backgroundColor}
                />
              </div>
              <div>
                <label for="textColor">{t.textColor}</label>
                <input
                  class="input input-bordered h-12 p-1"
                  id="textColor"
                  name="textColor"
                  type="color"
                  value={content.textColor}
                />
              </div>
              <div>
                <label for="accentColor">{t.accentColor}</label>
                <input
                  class="input input-bordered h-12 p-1"
                  id="accentColor"
                  name="accentColor"
                  type="color"
                  value={content.accentColor}
                />
              </div>
            </div>
            <label for="title">{t.title}</label>
            <input
              class="input input-bordered"
              id="title"
              name="title"
              maxlength="100"
              value={content.title}
              required
            />
            <label for="subtitle">{t.subtitle}</label>
            <textarea
              class="textarea textarea-bordered"
              id="subtitle"
              name="subtitle"
              maxlength="300"
            >{content.subtitle}</textarea>
            <label for="hero-file">{t.hero}</label>
            <input
              class="file-input file-input-bordered w-full"
              id="hero-file"
              type="file"
              accept="image/jpeg,image/png,image/webp"
            />
            <input type="hidden" name="heroImage" value={content.heroImage} />
            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <label for="primaryLabel">{t.buttonText}</label>
                <input
                  class="input input-bordered"
                  id="primaryLabel"
                  name="primaryLabel"
                  maxlength="40"
                  value={content.primaryLabel}
                />
              </div>
              <div>
                <label for="primaryUrl">{t.buttonUrl}</label>
                <input
                  class="input input-bordered"
                  id="primaryUrl"
                  name="primaryUrl"
                  type="url"
                  placeholder="https://"
                  value={content.primaryUrl}
                />
              </div>
            </div>
            <h3>{t.about}</h3>
            <label for="aboutTitle">{t.aboutTitle}</label>
            <input
              class="input input-bordered"
              id="aboutTitle"
              name="aboutTitle"
              value={content.aboutTitle}
              maxlength="80"
            />
            <label for="about">{t.aboutBody}</label>
            <textarea
              class="textarea textarea-bordered"
              id="about"
              name="about"
              maxlength="1500"
            >{content.about}</textarea>
            <h3>{t.benefits}</h3>
            <div id="benefits-list">
              {content.benefits.map((item) => (
                <fieldset data-item="benefit" class="border border-base-300 rounded-xl p-3 mb-2">
                  <input
                    class="input input-bordered mb-2"
                    name="item-title"
                    value={item.title}
                    placeholder={t.title}
                    maxlength="80"
                  />
                  <textarea
                    class="textarea textarea-bordered"
                    name="item-description"
                    placeholder={t.description}
                    maxlength="240"
                  >{item.description}</textarea>
                  <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
                    {t.remove}
                  </button>
                </fieldset>
              ))}
            </div>
            <button class="btn btn-outline btn-sm" type="button" data-add="benefit">
              + {t.add}
            </button>
            <h3>{t.stats}</h3>
            <div id="stats-list">
              {content.stats.map((item) => (
                <fieldset data-item="stat" class="border border-base-300 rounded-xl p-3 mb-2">
                  <div class="grid gap-3 sm:grid-cols-2">
                    <input
                      class="input input-bordered"
                      name="item-value"
                      value={item.value}
                      placeholder={t.value}
                      maxlength="20"
                    />
                    <input
                      class="input input-bordered"
                      name="item-label"
                      value={item.label}
                      placeholder={t.label}
                      maxlength="60"
                    />
                  </div>
                  <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
                    {t.remove}
                  </button>
                </fieldset>
              ))}
            </div>
            <button class="btn btn-outline btn-sm" type="button" data-add="stat">
              + {t.add}
            </button>
            <h3>{t.testimonials}</h3>
            <div id="testimonials-list">
              {content.testimonials.map((item) => (
                <fieldset
                  data-item="testimonial"
                  class="border border-base-300 rounded-xl p-3 mb-2"
                >
                  <textarea
                    class="textarea textarea-bordered mb-2"
                    name="item-quote"
                    placeholder={t.quote}
                    maxlength="300"
                  >{item.quote}</textarea>
                  <input
                    class="input input-bordered"
                    name="item-name"
                    value={item.name}
                    placeholder={t.name}
                    maxlength="80"
                  />
                  <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
                    {t.remove}
                  </button>
                </fieldset>
              ))}
            </div>
            <button class="btn btn-outline btn-sm" type="button" data-add="testimonial">
              + {t.add}
            </button>
            <h3>{t.products}</h3>
            <div id="products-list">
              {content.products.map((item) => (
                <fieldset data-item="product" class="border border-base-300 rounded-xl p-3 mb-2">
                  <input
                    class="input input-bordered mb-2"
                    name="item-title"
                    value={item.title}
                    placeholder={t.title}
                    maxlength="80"
                  />
                  <textarea
                    class="textarea textarea-bordered mb-2"
                    name="item-description"
                    placeholder={t.description}
                    maxlength="300"
                  >{item.description}</textarea>
                  <input
                    class="input input-bordered mb-2"
                    name="item-url"
                    type="url"
                    value={item.url}
                    placeholder="https://"
                  />
                  <input
                    class="file-input file-input-bordered w-full"
                    name="item-file"
                    type="file"
                    accept="image/jpeg,image/png,image/webp"
                  />
                  <input type="hidden" name="item-image" value={item.image} />
                  <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
                    {t.remove}
                  </button>
                </fieldset>
              ))}
            </div>
            <button class="btn btn-outline btn-sm" type="button" data-add="product">
              + {t.add}
            </button>
            <label for="footerText">{t.footer}</label>
            <input
              class="input input-bordered"
              id="footerText"
              name="footerText"
              maxlength="160"
              value={content.footerText}
            />
            <div class="mt-5 flex flex-wrap gap-2.5">
              <button
                class="btn btn-outline border-[#d8ae73] font-bold text-[#17130d]"
                type="submit"
              >
                {t.save}
              </button>
              <button
                class="btn btn-primary rounded-xl border-0 font-bold shadow-none"
                id="publish"
                type="button"
                disabled={!active}
              >
                {t.publish}
              </button>
            </div>
            <p
              id="editor-status"
              class="alert alert-info my-3 [hidden]:hidden"
              role="status"
              hidden
            ></p>
          </form>
          <section class="card rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2 id="plan-and-billing">{t.plans}</h2>
            <p class="text-[#625a51]">
              {user.plan === 'trial'
                ? `${trialDays} ${en ? 'days left in your trial' : 'dias restantes de teste'}`
                : user.plan}
            </p>
            <div class="mt-5 flex flex-wrap gap-2.5">
              <button class="btn btn-outline" data-plan="monthly" data-label={t.monthly}>
                {t.monthly} · <span data-amount>{priceText('monthly')}</span>
              </button>
              <button class="btn btn-outline" data-plan="yearly" data-label={t.yearly}>
                {t.yearly} · <span data-amount>{priceText('yearly')}</span>
              </button>
              <button class="btn btn-outline" data-plan="lifetime" data-label={t.lifetime}>
                {t.lifetime} · <span data-amount>{priceText('lifetime')}</span>
              </button>
            </div>
            <label for="currency">{en ? 'Checkout currency' : 'Moeda da compra'}</label>
            <select
              class="select select-bordered"
              id="currency"
              data-prices={JSON.stringify(priceMap)}
            >
              <option value="brl">BRL · R$</option>
              <option value="usd">USD · $</option>
            </select>
            {user.stripe_customer_id && (
              <button class="btn btn-ghost mt-3" id="portal">
                {t.portal}
              </button>
            )}
          </section>
          <section class="card rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2>{t.domain}</h2>
            <p class="text-[#625a51] text-sm">{t.domainHint}</p>
            <form id="domain-form" class="flex gap-2 mt-4">
              <input
                class="input input-bordered flex-1"
                name="hostname"
                placeholder="www.exemplo.com.br"
                required
              />
              <button class="btn btn-outline" disabled={user.plan === 'trial' || !active}>
                {t.connect}
              </button>
            </form>
            <p class="text-sm text-[#625a51] mt-3">
              CNAME: <code>connect.{domain}</code>
            </p>
            <p id="domain-status" class="alert alert-info my-3 [hidden]:hidden" hidden></p>
          </section>
          <section class="card rounded-xl border border-[#d8ae73] bg-white p-6 [&_h2]:mb-4 [&_h2]:text-[1.45rem] [&_h2]:text-[#17130d] [&_h3]:mt-7 [&_h3]:mb-3 [&_h3]:text-lg [&_label]:mt-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&_.input]:w-full [&_.textarea]:w-full [&_.select]:w-full [&_small]:text-[#625a51] mb-5">
            <h2>{t.account}</h2>
            <div class="mt-5 flex flex-wrap gap-2.5">
              <a id="export-data" class="btn btn-outline" href="#export">
                {t.exportData}
              </a>
              <a class="btn btn-ghost" href={en ? '/en/privacy' : '/privacidade'}>
                {t.privacy}
              </a>
            </div>
            <form id="delete-account-form" class="mt-5">
              <label for="delete-email">
                {user.email
                  ? t.confirmEmail
                  : en
                    ? 'Type DELETE to confirm'
                    : 'Digite EXCLUIR para confirmar'}
              </label>
              <input
                class="input input-bordered w-full"
                id="delete-email"
                name="email"
                type={user.email ? 'email' : 'text'}
                placeholder={user.email ?? 'EXCLUIR'}
                required
              />
              <button class="btn btn-error mt-3" type="submit">
                {t.deleteAccount}
              </button>
            </form>
          </section>
        </div>
        <div class="rounded-xl border border-[#d8ae73] bg-white p-3 xl:sticky xl:top-[18px] [&_iframe]:h-[650px] [&_iframe]:w-full [&_iframe]:rounded-[14px] [&_iframe]:border-0 [&_iframe]:bg-white">
          <div class="flex flex-wrap justify-between gap-2 items-center px-3 py-2">
            <strong>{t.preview}</strong>
            <div class="flex gap-2">
              <button class="btn btn-xs" id="desktop-preview" type="button">
                {t.desktop}
              </button>
              <button class="btn btn-xs" id="mobile-preview" type="button">
                {t.mobile}
              </button>
            </div>
          </div>
          <iframe id="preview-frame" src="/app/preview" title={t.preview}></iframe>
          <p class="px-3 pt-2 text-xs text-[#625a51]">
            {en
              ? 'The preview uses the same layout as the published page.'
              : 'A prévia usa o mesmo layout da página publicada.'}
          </p>
        </div>
      </div>
    </main>
  </div>
  <script>
    import { uploadMedia } from '@frontend/api/media/upload';
    import { saveSite } from '@frontend/api/sites/save';
    import { publishSite } from '@frontend/api/sites/publish';
    import { changeSlug } from '@frontend/api/sites/change-slug';
    import { connectDomain } from '@frontend/api/domains/connect';
    import { domainStatus } from '@frontend/api/domains/status';
    import { checkout } from '@frontend/api/billing/checkout';
    import { billingPortal } from '@frontend/api/billing/portal';
    import { deleteAccount } from '@frontend/api/accounts/delete';
    import { exportAccount } from '@frontend/api/accounts/export';
    import { getMetrics } from '@frontend/api/analytics/metrics';
    import { logout } from '@frontend/api/auth/logout';
    const form = document.querySelector<HTMLFormElement>('#editor')!;
    const status = document.querySelector<HTMLElement>('#editor-status')!;
    const input = (scope: ParentNode, name: string) =>
      (
        scope.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
          `[name="${name}"]`,
        )?.value || ''
      ).trim();
    const list = (name: string) => [...form.querySelectorAll<HTMLElement>(`[data-item="${name}"]`)];
    function show(text: string, error = false) {
      status.hidden = false;
      status.textContent = text;
      status.classList.toggle('alert-error', error);
      status.classList.toggle('alert-success', !error);
      status.classList.toggle('alert-info', false);
    }
    async function upload(file: File) {
      const body = new FormData();
      body.set('file', file);
      const data = await uploadMedia(body);
      return data.url as string;
    }
    async function iconFile(file: File, size: number): Promise<File> {
      if (
        file.size > 5 * 1024 * 1024 ||
        !['image/png', 'image/jpeg', 'image/webp'].includes(file.type)
      )
        throw new Error(
          document.documentElement.lang === 'en'
            ? 'Use a PNG, JPG or WebP image up to 5 MB.'
            : 'Use uma imagem PNG, JPG ou WebP de até 5 MB.',
        );
      const bitmap = await createImageBitmap(file);
      try {
        const canvas = document.createElement('canvas');
        canvas.width = canvas.height = size;
        const context = canvas.getContext('2d');
        if (!context) throw new Error('Canvas indisponível');
        context.fillStyle = input(form, 'backgroundColor');
        context.fillRect(0, 0, size, size);
        const scale = Math.min((size * 0.82) / bitmap.width, (size * 0.82) / bitmap.height);
        const width = bitmap.width * scale;
        const height = bitmap.height * scale;
        context.drawImage(bitmap, (size - width) / 2, (size - height) / 2, width, height);
        const blob = await new Promise<Blob>((resolve, reject) =>
          canvas.toBlob(
            (result) => (result ? resolve(result) : reject(new Error('Falha ao preparar ícone'))),
            'image/png',
          ),
        );
        return new File([blob], `icon-${size}.png`, { type: 'image/png' });
      } finally {
        bitmap.close();
      }
    }
    async function collect() {
      const faviconFile = form.querySelector<HTMLInputElement>('#favicon-file')?.files?.[0];
      let favicon = input(form, 'favicon');
      if (faviconFile) {
        favicon = await upload(await iconFile(faviconFile, 64));
        form.querySelector<HTMLInputElement>('[name="favicon"]')!.value = favicon;
        form.querySelector<HTMLInputElement>('#favicon-file')!.value = '';
      }
      const pwaFile = form.querySelector<HTMLInputElement>('#pwa-icon-file')?.files?.[0];
      let pwaIcon192 = input(form, 'pwaIcon192');
      let pwaIcon512 = input(form, 'pwaIcon512');
      if (pwaFile) {
        pwaIcon192 = await upload(await iconFile(pwaFile, 192));
        pwaIcon512 = await upload(await iconFile(pwaFile, 512));
        form.querySelector<HTMLInputElement>('[name="pwaIcon192"]')!.value = pwaIcon192;
        form.querySelector<HTMLInputElement>('[name="pwaIcon512"]')!.value = pwaIcon512;
        form.querySelector<HTMLInputElement>('#pwa-icon-file')!.value = '';
      }
      const heroFile = form.querySelector<HTMLInputElement>('#hero-file')?.files?.[0];
      let heroImage = input(form, 'heroImage');
      if (heroFile) {
        heroImage = await upload(heroFile);
        form.querySelector<HTMLInputElement>('[name="heroImage"]')!.value = heroImage;
        form.querySelector<HTMLInputElement>('#hero-file')!.value = '';
      }
      const products = [];
      for (const row of list('product')) {
        let image = input(row, 'item-image');
        const file = row.querySelector<HTMLInputElement>('[name="item-file"]')?.files?.[0];
        if (file) {
          image = await upload(file);
          row.querySelector<HTMLInputElement>('[name="item-image"]')!.value = image;
          row.querySelector<HTMLInputElement>('[name="item-file"]')!.value = '';
        }
        products.push({
          title: input(row, 'item-title'),
          description: input(row, 'item-description'),
          image,
          url: input(row, 'item-url'),
        });
      }
      return {
        layout: input(form, 'layout'),
        language: input(form, 'language'),
        title: input(form, 'title'),
        appName: input(form, 'appName'),
        subtitle: input(form, 'subtitle'),
        heroImage,
        favicon,
        pwaIcon192,
        pwaIcon512,
        themeColor: input(form, 'themeColor'),
        backgroundColor: input(form, 'backgroundColor'),
        textColor: input(form, 'textColor'),
        accentColor: input(form, 'accentColor'),
        primaryLabel: input(form, 'primaryLabel'),
        primaryUrl: input(form, 'primaryUrl'),
        aboutTitle: input(form, 'aboutTitle'),
        about: input(form, 'about'),
        footerText: input(form, 'footerText'),
        benefits: list('benefit').map((row) => ({
          title: input(row, 'item-title'),
          description: input(row, 'item-description'),
        })),
        stats: list('stat').map((row) => ({
          value: input(row, 'item-value'),
          label: input(row, 'item-label'),
        })),
        testimonials: list('testimonial').map((row) => ({
          quote: input(row, 'item-quote'),
          name: input(row, 'item-name'),
        })),
        products,
      };
    }
    async function save() {
      const content = await collect();
      const result = await saveSite(content);
      const frame = document.querySelector<HTMLIFrameElement>('#preview-frame')!;
      frame.src = `/app/preview?t=${Date.now()}`;
      return result;
    }
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        await save();
        show(document.documentElement.lang === 'en' ? 'Draft saved.' : 'Rascunho salvo.');
      } catch (error) {
        show(error instanceof Error ? error.message : 'Falha ao salvar', true);
      }
    });
    document.querySelector('#publish')?.addEventListener('click', async () => {
      try {
        await save();
        await publishSite();
        show(document.documentElement.lang === 'en' ? 'Published.' : 'Publicado.');
      } catch (error) {
        show(error instanceof Error ? error.message : 'Falha ao publicar', true);
      }
    });
    document.querySelector('#logout')?.addEventListener('click', async () => {
      await logout();
      location.href = '/';
    });
    document.querySelector('#desktop-preview')?.addEventListener('click', () => {
      document
        .querySelector<HTMLIFrameElement>('#preview-frame')!
        .classList.remove('max-w-[390px]');
    });
    document.querySelector('#mobile-preview')?.addEventListener('click', () => {
      document.querySelector<HTMLIFrameElement>('#preview-frame')!.classList.add('max-w-[390px]');
    });
    form.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!button) return;
      if (button.matches('[data-remove]')) button.closest('[data-item]')?.remove();
      const type = button.dataset.add;
      if (!type) return;
      const limits: Record<string, number> = { benefit: 6, stat: 4, testimonial: 3, product: 12 };
      if (list(type).length >= limits[type]) return;
      const markup: Record<string, string> = {
        benefit:
          '<input class="input input-bordered mb-2" name="item-title" placeholder="Título" maxlength="80"><textarea class="textarea textarea-bordered" name="item-description" placeholder="Descrição" maxlength="240"></textarea>',
        stat: '<div class="grid gap-3 sm:grid-cols-2"><input class="input input-bordered" name="item-value" placeholder="Valor" maxlength="20"><input class="input input-bordered" name="item-label" placeholder="Legenda" maxlength="60"></div>',
        testimonial:
          '<textarea class="textarea textarea-bordered mb-2" name="item-quote" placeholder="Depoimento" maxlength="300"></textarea><input class="input input-bordered" name="item-name" placeholder="Nome" maxlength="80">',
        product:
          '<input class="input input-bordered mb-2" name="item-title" placeholder="Nome" maxlength="80"><textarea class="textarea textarea-bordered mb-2" name="item-description" placeholder="Descrição" maxlength="300"></textarea><input class="input input-bordered mb-2" name="item-url" type="url" placeholder="https://"><input class="file-input file-input-bordered w-full" name="item-file" type="file" accept="image/jpeg,image/png,image/webp"><input type="hidden" name="item-image">',
      };
      const row = document.createElement('fieldset');
      row.dataset.item = type;
      row.className = 'border border-base-300 rounded-xl p-3 mb-2';
      row.innerHTML =
        markup[type] +
        '<button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>Remover</button>';
      document
        .querySelector(
          `#${type === 'benefit' ? 'benefits' : type === 'stat' ? 'stats' : type === 'testimonial' ? 'testimonials' : 'products'}-list`,
        )
        ?.append(row);
    });
    document
      .querySelector<HTMLFormElement>('#slug-form')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        try {
          const result = await changeSlug(input(form, 'slug'));
          document.querySelector<HTMLAnchorElement>('#public-url')!.href = result.url;
          document.querySelector<HTMLAnchorElement>('#public-url')!.textContent = new URL(
            result.url,
          ).host;
        } catch (error) {
          show(error instanceof Error ? error.message : 'Falha ao alterar endereço', true);
        }
      });
    document
      .querySelector<HTMLFormElement>('#domain-form')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const target = document.querySelector<HTMLElement>('#domain-status')!;
        target.hidden = false;
        try {
          const result = await connectDomain(input(form, 'hostname'));
          target.textContent = `CNAME: ${result.hostname} → ${result.target}`;
          target.classList.remove('alert-error');
          target.classList.add('alert-success');
        } catch (error) {
          target.textContent = error instanceof Error ? error.message : 'Falha ao conectar domínio';
          target.classList.remove('alert-info', 'alert-success');
          target.classList.add('alert-error');
        }
      });
    const currencySelect = document.querySelector<HTMLSelectElement>('#currency')!;
    const priceMap = JSON.parse(currencySelect.dataset.prices || '{}') as Record<string, number>;
    currencySelect.addEventListener('change', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((button) => {
        const amount = priceMap[`${button.dataset.plan}_${currencySelect.value}`];
        const label = button.querySelector<HTMLElement>('[data-amount]')!;
        label.textContent = amount
          ? new Intl.NumberFormat(currencySelect.value === 'brl' ? 'pt-BR' : 'en-US', {
              style: 'currency',
              currency: currencySelect.value.toUpperCase(),
            }).format(amount / 100)
          : '—';
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((button) =>
      button.addEventListener('click', async () => {
        try {
          const result = await checkout(
            button.dataset.plan,
            document.querySelector<HTMLSelectElement>('#currency')!.value,
          );
          location.href = result.url;
        } catch (error) {
          show(error instanceof Error ? error.message : 'Falha ao iniciar compra', true);
        }
      }),
    );
    document.querySelector('#portal')?.addEventListener('click', async () => {
      try {
        const result = await billingPortal();
        location.href = result.url;
      } catch (error) {
        show(error instanceof Error ? error.message : 'Falha ao abrir cobrança', true);
      }
    });
    document
      .querySelector<HTMLFormElement>('#delete-account-form')
      ?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const deletionForm = event.currentTarget as HTMLFormElement;
        const email = input(deletionForm, 'email');
        const warning =
          document.documentElement.lang === 'en'
            ? 'Delete your account, page and images? Any subscription will be canceled.'
            : 'Excluir sua conta, página e imagens? Sua assinatura será cancelada.';
        if (!confirm(warning)) return;
        try {
          await deleteAccount(email);
          location.href = '/';
        } catch (error) {
          show(error instanceof Error ? error.message : 'Falha ao excluir a conta', true);
        }
      });
    const metrics = getMetrics();
    metrics
      .then((data) => {
        document.querySelector('#metric-views')!.textContent = String(data.views ?? 0);
        document.querySelector('#metric-clicks')!.textContent = String(data.clicks ?? 0);
      })
      .catch(() => {});
    domainStatus()
      .then((data) => {
        if (!data.domain) return;
        const node = document.querySelector<HTMLElement>('#domain-status')!;
        node.hidden = false;
        node.textContent = `${data.domain.hostname}: ${data.domain.status}/${data.domain.sslStatus}`;
      })
      .catch(() => {});
    document
      .querySelector<HTMLAnchorElement>('#export-data')
      ?.addEventListener('click', async (event) => {
        event.preventDefault();
        try {
          const file = await exportAccount();
          const url = URL.createObjectURL(file);
          const link = document.createElement('a');
          link.href = url;
          link.download = 'vira-dados.json';
          link.click();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
        } catch (error) {
          show(error instanceof Error ? error.message : 'Falha ao baixar dados', true);
        }
      });
  </script>
</Base>
