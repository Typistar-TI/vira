---
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'steps' }>;
  preview: boolean;
}
const { section } = Astro.props;
const items = section.items.filter((item) => item.title || item.description);
const cards = section.variant === 'cards';
---

{items.length > 0 && (
  <section class="px-5 py-[var(--sec-py)] text-[var(--fg)] sm:px-10" data-vs-section="steps">
    <div class="mx-auto w-full max-w-[var(--sec-max,1180px)]">
      <SectionHeading title={section.title} />
      <ul
        class:list={[
          cards
            ? 'grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3'
            : 'steps steps-vertical list-none p-0 lg:steps-horizontal',
        ]}
      >
        {items.map((item, index) => (
          <li
            class:list={[
              cards ? 'card border border-[var(--line)] bg-[var(--surface)]' : 'step',
              !cards && index < items.length - 1 ? 'step-primary' : '',
            ]}
            data-content={cards ? undefined : String(index + 1).padStart(2, '0')}
          >
            {cards ? (
              <div class="card-body p-6">
                <span class="font-mono text-sm font-semibold text-[var(--accent)]">
                  {String(index + 1).padStart(2, '0')}
                </span>
                {item.title && (
                  <h3 class="card-title text-lg font-medium [font-family:var(--font-display)]">
                    {item.title}
                  </h3>
                )}
                {item.description && (
                  <p class="text-sm leading-relaxed text-[var(--muted)]">{item.description}</p>
                )}
              </div>
            ) : (
              <div class="text-left">
                {item.title && (
                  <h3 class="text-lg font-medium [font-family:var(--font-display)]">
                    {item.title}
                  </h3>
                )}
                {item.description && (
                  <p class="text-sm leading-relaxed text-[var(--muted)]">{item.description}</p>
                )}
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
