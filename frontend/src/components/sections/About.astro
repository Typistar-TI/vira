---
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'about' }>;
  preview: boolean;
}
const { section } = Astro.props;
const hasImage = section.variant !== 'text' && Boolean(section.image);
const imageLeft = section.variant === 'image-left';
---

<section class="px-5 py-[var(--sec-py)] text-[var(--fg)] sm:px-10" data-vs-section="about">
  <div
    class:list={[
      'mx-auto flex w-full max-w-[1180px] flex-col gap-8 sm:gap-12',
      hasImage ? 'lg:grid lg:grid-cols-2 lg:items-center' : 'max-w-[780px] text-center',
    ]}
  >
    <div class:list={[imageLeft ? 'lg:order-2' : '']}>
      <SectionHeading title={section.title} centered={!hasImage} />
      {section.body && (
        <p
          class:list={[
            'm-0 whitespace-pre-line text-base leading-relaxed text-[var(--muted)] sm:text-lg',
            hasImage ? '' : 'mx-auto',
          ]}
        >
          {section.body}
        </p>
      )}
    </div>
    {hasImage && (
      <figure
        class:list={['m-0 overflow-hidden rounded-3xl shadow-2xl', imageLeft ? 'lg:order-1' : '']}
      >
        <img
          src={section.image}
          alt={section.title}
          class="block aspect-[4/3] w-full object-cover"
          loading="lazy"
        />
      </figure>
    )}
  </div>
</section>
