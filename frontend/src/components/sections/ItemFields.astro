---
import type { SectionType } from '@frontend/api/sites/parse-site';
import ImageUpload from '@frontend/components/ImageUpload.astro';

interface Props {
  kind: SectionType;
  en: boolean;
  item?: Record<string, string>;
}
const { kind, en, item = {} } = Astro.props;
const L = en
  ? {
      title: 'Title',
      description: 'Description',
      url: 'Link',
      value: 'Value',
      label: 'Label',
      image: 'Image',
      role: 'Role',
      company: 'Company',
      period: 'Period',
      location: 'Location',
      summary: 'Summary',
      quote: 'Quote',
      name: 'Name',
      question: 'Question',
      answer: 'Answer',
    }
  : {
      title: 'Título',
      description: 'Descrição',
      url: 'Link',
      value: 'Valor',
      label: 'Legenda',
      image: 'Imagem',
      role: 'Cargo',
      company: 'Empresa',
      period: 'Período',
      location: 'Local',
      summary: 'Resumo',
      quote: 'Depoimento',
      name: 'Nome',
      question: 'Pergunta',
      answer: 'Resposta',
    };
const v = (key: string) => item[key] ?? '';
---

{kind === 'services' && (
  <>
    <input
      class="input input-bordered mb-2"
      name="item-title"
      value={v('title')}
      placeholder={L.title}
      maxlength="80"
    />
    <textarea
      class="textarea textarea-bordered mb-2"
      name="item-description"
      placeholder={L.description}
      maxlength="400"
    >{v('description')}</textarea>
    <input
      class="input input-bordered mb-2"
      name="item-url"
      type="url"
      value={v('url')}
      placeholder="https://"
    />
    <ImageUpload name="item-file" lang={en ? 'en' : 'pt'} src={v('image')} compact class="mb-2" />
    <input type="hidden" name="item-image" value={v('image')} />
  </>
)}
{kind === 'gallery' && (
  <>
    <ImageUpload name="item-file" lang={en ? 'en' : 'pt'} src={v('image')} compact />
    <input type="hidden" name="item-image" value={v('image')} />
  </>
)}
{kind === 'stats' && (
  <div class="grid gap-3 sm:grid-cols-2">
    <input
      class="input input-bordered"
      name="item-value"
      value={v('value')}
      placeholder={L.value}
      maxlength="20"
    />
    <input
      class="input input-bordered"
      name="item-label"
      value={v('label')}
      placeholder={L.label}
      maxlength="60"
    />
  </div>
)}
{kind === 'steps' && (
  <>
    <input
      class="input input-bordered mb-2"
      name="item-title"
      value={v('title')}
      placeholder={L.title}
      maxlength="80"
    />
    <textarea
      class="textarea textarea-bordered"
      name="item-description"
      placeholder={L.description}
      maxlength="400"
    >{v('description')}</textarea>
  </>
)}
{kind === 'experience' && (
  <>
    <div class="grid gap-3 sm:grid-cols-2">
      <input
        class="input input-bordered"
        name="item-role"
        value={v('role')}
        placeholder={L.role}
        maxlength="80"
      />
      <input
        class="input input-bordered"
        name="item-company"
        value={v('company')}
        placeholder={L.company}
        maxlength="80"
      />
      <input
        class="input input-bordered"
        name="item-period"
        value={v('period')}
        placeholder={L.period}
        maxlength="60"
      />
      <input
        class="input input-bordered"
        name="item-location"
        value={v('location')}
        placeholder={L.location}
        maxlength="80"
      />
    </div>
    <textarea
      class="textarea textarea-bordered mt-2"
      name="item-summary"
      placeholder={L.summary}
      maxlength="400"
    >{v('summary')}</textarea>
  </>
)}
{kind === 'testimonials' && (
  <>
    <textarea
      class="textarea textarea-bordered mb-2"
      name="item-quote"
      placeholder={L.quote}
      maxlength="400"
    >{v('quote')}</textarea>
    <input
      class="input input-bordered"
      name="item-name"
      value={v('name')}
      placeholder={L.name}
      maxlength="80"
    />
  </>
)}
{kind === 'faq' && (
  <>
    <input
      class="input input-bordered mb-2"
      name="item-question"
      value={v('question')}
      placeholder={L.question}
      maxlength="200"
    />
    <textarea
      class="textarea textarea-bordered"
      name="item-answer"
      placeholder={L.answer}
      maxlength="800"
    >{v('answer')}</textarea>
  </>
)}
{['contact', 'footer'].includes(kind) && (
  <div class="grid gap-3 sm:grid-cols-2">
    <input
      class="input input-bordered"
      name="item-label"
      value={v('label')}
      placeholder={L.label}
      maxlength="40"
    />
    <input
      class="input input-bordered"
      name="item-url"
      type="url"
      value={v('url')}
      placeholder="https://"
    />
  </div>
)}
