---
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'experience' }>;
  preview: boolean;
}
const { section } = Astro.props;
const items = section.items.filter((item) => item.role || item.company);
const timeline = section.variant === 'timeline';
---

{items.length > 0 && (
  <section class="px-5 py-[var(--sec-py)] text-[var(--fg)] sm:px-10" data-vs-section="experience">
    <div class="mx-auto w-full max-w-[var(--sec-max,900px)]">
      <SectionHeading title={section.title} />
      <ul
        class:list={[
          'm-0 list-none p-0',
          timeline ? 'timeline timeline-vertical timeline-compact' : 'flex flex-col gap-5',
        ]}
      >
        {items.map((item, index) => (
          <li class:list={[timeline && index < items.length - 1 ? '' : '']}>
            {timeline && (
              <>
                <div class="timeline-start text-left text-sm text-[var(--muted)]">
                  {item.period && <span class="font-mono">{item.period}</span>}
                  {item.location && <span class="block">{item.location}</span>}
                </div>
                <div class="timeline-middle">
                  <div class="h-3 w-3 rounded-full bg-[var(--accent)]" />
                </div>
              </>
            )}
            <div
              class:list={[
                timeline
                  ? 'timeline-end timeline-box border-[var(--line)] bg-[var(--surface)] text-left'
                  : 'card border border-[var(--line)] bg-[var(--surface)] p-6',
              ]}
            >
              <h3 class="text-lg font-medium [font-family:var(--font-display)]">
                {item.role}
                {item.company && (
                  <span class="text-[var(--muted)] font-normal"> · {item.company}</span>
                )}
              </h3>
              {!timeline && item.period && (
                <p class="mt-1 font-mono text-xs text-[var(--muted)]">
                  {item.period}
                  {item.location ? ` · ${item.location}` : ''}
                </p>
              )}
              {item.summary && (
                <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">{item.summary}</p>
              )}
            </div>
            {timeline && index < items.length - 1 && <hr class="bg-[var(--accent)]" />}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
