---
import ItemFields from './ItemFields.astro';
import ImageUpload from '@frontend/components/ImageUpload.astro';
import type { Section, SectionType } from '@frontend/api/sites/parse-site';

interface Props {
  section: Section;
  en: boolean;
  template?: boolean;
}
const { section, en, template = false } = Astro.props;

const L = en
  ? {
      moveUp: 'Move up',
      moveDown: 'Move down',
      remove: 'Remove block',
      drag: 'Drag to reorder',
      variant: 'Style',
      background: 'Background',
      spacing: 'Spacing',
      bgDefault: 'Default',
      bgSoft: 'Soft',
      bgAccent: 'Accent',
      bgDark: 'Dark',
      spSm: 'Small',
      spMd: 'Medium',
      spLg: 'Large',
      width: 'Width',
      align: 'Alignment',
      wNormal: 'Default',
      wWide: 'Wide',
      wFull: 'Full width',
      alLeft: 'Left',
      alCenter: 'Center',
      title: 'Heading',
      eyebrow: 'Small label',
      subtitle: 'Introduction',
      body: 'Text',
      buttonText: 'Button text',
      buttonUrl: 'Button link',
      image: 'Image',
      caption: 'Caption',
      videoUrl: 'YouTube or Vimeo link',
      address: 'Address',
      text: 'Footer text',
      addItem: 'Add item',
      item: 'Item',
      types: {
        hero: 'Opening',
        about: 'About you',
        services: 'What you offer',
        gallery: 'Gallery',
        stats: 'Numbers',
        steps: 'How it works',
        experience: 'Experience',
        testimonials: 'Testimonials',
        faq: 'FAQ',
        video: 'Video',
        map: 'Location',
        contact: 'Contact',
        footer: 'Footer',
      } as Record<SectionType, string>,
      hints: {
        hero: 'Headline, introduction and main button.',
        about: 'Tell who you are and what you do.',
        services: 'List your products or services.',
        gallery: 'Show images of your work.',
        stats: 'Highlight important numbers.',
        steps: 'Explain the step by step.',
        experience: 'Career and background.',
        testimonials: 'What clients say.',
        faq: 'Common customer questions.',
        video: 'Embed a video.',
        map: 'Show where you are.',
        contact: 'How to reach you.',
        footer: 'Footer text and links.',
      } as Record<SectionType, string>,
    }
  : {
      moveUp: 'Mover para cima',
      moveDown: 'Mover para baixo',
      remove: 'Remover bloco',
      drag: 'Arraste para reordenar',
      variant: 'Estilo',
      background: 'Fundo',
      spacing: 'Espaçamento',
      bgDefault: 'Padrão',
      bgSoft: 'Suave',
      bgAccent: 'Destaque',
      bgDark: 'Escuro',
      spSm: 'Pequeno',
      spMd: 'Médio',
      spLg: 'Grande',
      width: 'Largura',
      align: 'Alinhamento',
      wNormal: 'Padrão',
      wWide: 'Ampla',
      wFull: 'Total',
      alLeft: 'Esquerda',
      alCenter: 'Centro',
      title: 'Título',
      eyebrow: 'Etiqueta curta',
      subtitle: 'Apresentação',
      body: 'Texto',
      buttonText: 'Texto do botão',
      buttonUrl: 'Link do botão',
      image: 'Imagem',
      caption: 'Legenda',
      videoUrl: 'Link do YouTube ou Vimeo',
      address: 'Endereço',
      text: 'Texto do rodapé',
      addItem: 'Adicionar item',
      item: 'Item',
      types: {
        hero: 'Abertura',
        about: 'Sobre você',
        services: 'O que você oferece',
        gallery: 'Galeria',
        stats: 'Números',
        steps: 'Como funciona',
        experience: 'Experiência',
        testimonials: 'Depoimentos',
        faq: 'Perguntas frequentes',
        video: 'Vídeo',
        map: 'Localização',
        contact: 'Contato',
        footer: 'Rodapé',
      } as Record<SectionType, string>,
      hints: {
        hero: 'Título, apresentação e botão principal.',
        about: 'Conte quem você é e o que faz.',
        services: 'Liste seus produtos ou serviços.',
        gallery: 'Mostre imagens do seu trabalho.',
        stats: 'Destaque números importantes.',
        steps: 'Explique o passo a passo.',
        experience: 'Carreira e histórico.',
        testimonials: 'O que os clientes dizem.',
        faq: 'Dúvidas comuns dos clientes.',
        video: 'Incorpore um vídeo.',
        map: 'Mostre onde você fica.',
        contact: 'Como falar com você.',
        footer: 'Texto e links do rodapé.',
      } as Record<SectionType, string>,
    };

const variantLabels: Record<string, { value: string; pt: string; en: string }[]> = {
  hero: [
    { value: 'left', pt: 'Texto com imagem ao lado', en: 'Text with image beside' },
    { value: 'center', pt: 'Centralizado', en: 'Centered' },
    { value: 'background', pt: 'Imagem de fundo', en: 'Background image' },
  ],
  about: [
    { value: 'text', pt: 'Somente texto', en: 'Text only' },
    { value: 'image-left', pt: 'Imagem à esquerda', en: 'Image on the left' },
    { value: 'image-right', pt: 'Imagem à direita', en: 'Image on the right' },
  ],
  services: [
    { value: 'cards', pt: 'Cartões', en: 'Cards' },
    { value: 'list', pt: 'Lista', en: 'List' },
  ],
  gallery: [
    { value: 'grid', pt: 'Grade', en: 'Grid' },
    { value: 'masonry', pt: 'Mosaico', en: 'Masonry' },
  ],
  stats: [
    { value: 'row', pt: 'Em linha', en: 'In a row' },
    { value: 'grid', pt: 'Grade', en: 'Grid' },
  ],
  steps: [
    { value: 'numbered', pt: 'Numerado', en: 'Numbered' },
    { value: 'cards', pt: 'Cartões', en: 'Cards' },
  ],
  experience: [
    { value: 'timeline', pt: 'Linha do tempo', en: 'Timeline' },
    { value: 'list', pt: 'Lista', en: 'List' },
  ],
  testimonials: [
    { value: 'cards', pt: 'Cartões', en: 'Cards' },
    { value: 'single', pt: 'Destaque único', en: 'Single highlight' },
  ],
  faq: [
    { value: 'accordion', pt: 'Acordeão', en: 'Accordion' },
    { value: 'list', pt: 'Lista', en: 'List' },
  ],
  video: [
    { value: 'wide', pt: 'Largo', en: 'Wide' },
    { value: 'boxed', pt: 'Caixa', en: 'Boxed' },
  ],
  map: [
    { value: 'wide', pt: 'Largo', en: 'Wide' },
    { value: 'boxed', pt: 'Caixa', en: 'Boxed' },
  ],
  contact: [
    { value: 'simple', pt: 'Simples', en: 'Simple' },
    { value: 'cards', pt: 'Cartão', en: 'Card' },
  ],
  footer: [{ value: 'simple', pt: 'Simples', en: 'Simple' }],
};

const itemTypes: SectionType[] = [
  'services',
  'gallery',
  'stats',
  'steps',
  'experience',
  'testimonials',
  'faq',
  'contact',
  'footer',
];
const itemLimits: Record<string, number> = {
  services: 12,
  gallery: 12,
  stats: 4,
  steps: 6,
  experience: 10,
  testimonials: 6,
  faq: 10,
  contact: 8,
  footer: 8,
};
const hasItems = itemTypes.includes(section.type);
const itemList =
  section.type === 'services'
    ? section.items
    : section.type === 'gallery'
      ? section.images
      : section.type === 'stats' || section.type === 'steps' || section.type === 'testimonials'
        ? section.items
        : section.type === 'experience'
          ? section.items
          : section.type === 'faq'
            ? section.items
            : section.type === 'contact' || section.type === 'footer'
              ? section.links
              : [];
const variants = variantLabels[section.type];
const layout = section.layout ?? {
  background: 'default',
  spacing: 'md',
  width: 'normal',
  align: 'left',
};
---

<div
  class:list={[
    'mb-3 overflow-hidden rounded-[14px] border border-[#e2d8c6] bg-white',
    template && 'hidden',
  ]}
  data-section
  data-type={section.type}
  data-template={template ? 'true' : undefined}
>
  <div
    data-section-head
    class="flex items-center justify-between gap-2 border-b border-[#e2d8c6] bg-[#fbf6ec] px-3 py-2.5"
  >
    <span class="flex min-w-0 items-center gap-2">
      <span
        data-drag-handle
        class="shrink-0 cursor-grab text-[#c3b39b] hover:text-[#b88333] active:cursor-grabbing"
        title={L.drag}
        aria-hidden="true"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="9" cy="6" r="1.5"></circle>
          <circle cx="15" cy="6" r="1.5"></circle>
          <circle cx="9" cy="12" r="1.5"></circle>
          <circle cx="15" cy="12" r="1.5"></circle>
          <circle cx="9" cy="18" r="1.5"></circle>
          <circle cx="15" cy="18" r="1.5"></circle>
        </svg>
      </span>
      <span class="min-w-0">
        <strong class="block text-[0.95rem]">{L.types[section.type]}</strong>
        <span class="sec-hint mt-0.5 block text-xs font-normal text-[#8b8174]">
          {L.hints[section.type]}
        </span>
      </span>
    </span>
    <span class="flex shrink-0 gap-1">
      <button
        type="button"
        class="h-[30px] w-[30px] cursor-pointer rounded-lg border border-[#e2d8c6] bg-white leading-none hover:border-[#b88333]"
        data-move="up"
        aria-label={L.moveUp}
        title={L.moveUp}
      >
        ↑
      </button>
      <button
        type="button"
        class="h-[30px] w-[30px] cursor-pointer rounded-lg border border-[#e2d8c6] bg-white leading-none hover:border-[#b88333]"
        data-move="down"
        aria-label={L.moveDown}
        title={L.moveDown}
      >
        ↓
      </button>
      <button
        type="button"
        class="h-[30px] w-[30px] cursor-pointer rounded-lg border border-[#e2d8c6] bg-white leading-none hover:border-[#b88333]"
        data-remove-section
        aria-label={L.remove}
        title={L.remove}
      >
        ✕
      </button>
    </span>
  </div>
  <div data-section-body class="flex flex-col gap-2 p-3">
    <input type="hidden" name="field-id" value={section.id} />
    {variants.length > 0 && (
      <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
        <span>{L.variant}</span>
        <select class="select select-bordered" name="field-variant">
          {variants.map((option) => (
            <option value={option.value} selected={section.variant === option.value}>
              {en ? option.en : option.pt}
            </option>
          ))}
        </select>
      </label>
    )}
    <div class="grid grid-cols-2 gap-2">
      <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
        <span>{L.background}</span>
        <select class="select select-bordered" name="field-layout-background">
          <option value="default" selected={layout.background === 'default'}>
            {L.bgDefault}
          </option>
          <option value="soft" selected={layout.background === 'soft'}>
            {L.bgSoft}
          </option>
          <option value="accent" selected={layout.background === 'accent'}>
            {L.bgAccent}
          </option>
          <option value="dark" selected={layout.background === 'dark'}>
            {L.bgDark}
          </option>
        </select>
      </label>
      <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
        <span>{L.spacing}</span>
        <select class="select select-bordered" name="field-layout-spacing">
          <option value="sm" selected={layout.spacing === 'sm'}>
            {L.spSm}
          </option>
          <option value="md" selected={layout.spacing === 'md'}>
            {L.spMd}
          </option>
          <option value="lg" selected={layout.spacing === 'lg'}>
            {L.spLg}
          </option>
        </select>
      </label>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
        <span>{L.width}</span>
        <select class="select select-bordered" name="field-layout-width">
          <option value="normal" selected={layout.width === 'normal'}>
            {L.wNormal}
          </option>
          <option value="wide" selected={layout.width === 'wide'}>
            {L.wWide}
          </option>
          <option value="full" selected={layout.width === 'full'}>
            {L.wFull}
          </option>
        </select>
      </label>
      <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
        <span>{L.align}</span>
        <select class="select select-bordered" name="field-layout-align">
          <option value="left" selected={layout.align === 'left'}>
            {L.alLeft}
          </option>
          <option value="center" selected={layout.align === 'center'}>
            {L.alCenter}
          </option>
        </select>
      </label>
    </div>

    {section.type === 'hero' && (
      <>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.eyebrow}</span>
          <input
            class="input input-bordered"
            name="field-eyebrow"
            value={section.eyebrow}
            maxlength="60"
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.title}</span>
          <input
            class="input input-bordered"
            name="field-title"
            value={section.title}
            maxlength="120"
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.subtitle}</span>
          <textarea
            class="textarea textarea-bordered"
            name="field-subtitle"
            maxlength="400"
          >{section.subtitle}</textarea>
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.buttonText}</span>
          <input
            class="input input-bordered"
            name="field-primaryLabel"
            value={section.primaryLabel}
            maxlength="40"
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.buttonUrl}</span>
          <input
            class="input input-bordered"
            name="field-primaryUrl"
            type="url"
            value={section.primaryUrl}
            placeholder="https://"
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.image}</span>
          <ImageUpload name="field-file" lang={en ? 'en' : 'pt'} src={section.image} compact />
          <input type="hidden" name="field-image" value={section.image} />
        </label>
      </>
    )}

    {section.type === 'about' && (
      <>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.title}</span>
          <input
            class="input input-bordered"
            name="field-title"
            value={section.title}
            maxlength="120"
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.body}</span>
          <textarea
            class="textarea textarea-bordered"
            name="field-body"
            maxlength="1500"
          >{section.body}</textarea>
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.image}</span>
          <ImageUpload name="field-file" lang={en ? 'en' : 'pt'} src={section.image} compact />
          <input type="hidden" name="field-image" value={section.image} />
        </label>
      </>
    )}

    {(section.type === 'services' ||
      section.type === 'gallery' ||
      section.type === 'stats' ||
      section.type === 'steps' ||
      section.type === 'experience' ||
      section.type === 'testimonials' ||
      section.type === 'faq') && (
      <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
        <span>{L.title}</span>
        <input
          class="input input-bordered"
          name="field-title"
          value={section.title}
          maxlength="120"
        />
      </label>
    )}

    {section.type === 'video' && (
      <>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.title}</span>
          <input
            class="input input-bordered"
            name="field-title"
            value={section.title}
            maxlength="120"
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.videoUrl}</span>
          <input
            class="input input-bordered"
            name="field-url"
            type="url"
            value={section.url}
            placeholder="https://youtu.be/..."
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.caption}</span>
          <input
            class="input input-bordered"
            name="field-caption"
            value={section.caption}
            maxlength="200"
          />
        </label>
      </>
    )}

    {section.type === 'map' && (
      <>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.title}</span>
          <input
            class="input input-bordered"
            name="field-title"
            value={section.title}
            maxlength="120"
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.address}</span>
          <input
            class="input input-bordered"
            name="field-address"
            value={section.address}
            maxlength="200"
          />
        </label>
      </>
    )}

    {section.type === 'contact' && (
      <>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.title}</span>
          <input
            class="input input-bordered"
            name="field-title"
            value={section.title}
            maxlength="120"
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.body}</span>
          <textarea
            class="textarea textarea-bordered"
            name="field-body"
            maxlength="600"
          >{section.body}</textarea>
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.buttonText}</span>
          <input
            class="input input-bordered"
            name="field-primaryLabel"
            value={section.primaryLabel}
            maxlength="40"
          />
        </label>
        <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
          <span>{L.buttonUrl}</span>
          <input
            class="input input-bordered"
            name="field-primaryUrl"
            type="url"
            value={section.primaryUrl}
            placeholder="https://"
          />
        </label>
      </>
    )}

    {section.type === 'footer' && (
      <label class="flex flex-col gap-1 text-[0.8rem] font-bold text-[#4a4238]">
        <span>{L.text}</span>
        <input
          class="input input-bordered"
          name="field-text"
          value={section.text}
          maxlength="200"
        />
      </label>
    )}

    {hasItems && itemLimits[section.type] > 0 && (
      <div class="sec-items" data-items>
        {itemList.map((item: Record<string, unknown>) => (
          <fieldset class="mb-2 rounded-[10px] border border-[#e2d8c6] p-2.5" data-item>
            <ItemFields kind={section.type} en={en} item={item as Record<string, string>} />
            <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
              {en ? 'Remove' : 'Remover'}
            </button>
          </fieldset>
        ))}
      </div>
    )}
    {hasItems && itemLimits[section.type] > 0 && (
      <button type="button" class="btn btn-outline btn-sm" data-add-item>
        + {L.addItem}
      </button>
    )}
  </div>
  {hasItems && (
    <template data-item-template>
      <fieldset class="mb-2 rounded-[10px] border border-[#e2d8c6] p-2.5" data-item>
        <ItemFields kind={section.type} en={en} />
        <button type="button" class="btn btn-ghost btn-sm mt-2" data-remove>
          {en ? 'Remove' : 'Remover'}
        </button>
      </fieldset>
    </template>
  )}
</div>
