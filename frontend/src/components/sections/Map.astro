---
import SectionHeading from './SectionHeading.astro';
import { mapLink, mapSrc } from './shared';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'map' }>;
  preview: boolean;
}
const { section } = Astro.props;
---

{(section.title || section.address) && (
  <section class="px-5 py-[var(--sec-py)] sm:px-10" data-vs-section="map">
    <div
      class:list={[
        'mx-auto w-full',
        section.variant === 'boxed' ? 'max-w-[760px]' : 'max-w-[1000px]',
      ]}
    >
      <SectionHeading title={section.title} />
      {section.address ? (
        <div class="overflow-hidden rounded-3xl border border-[var(--line)]">
          <iframe
            src={mapSrc(section.address)}
            title={section.address}
            class="aspect-video w-full border-0"
            loading="lazy"
          />
          <a
            href={mapLink(section.address)}
            target="_blank"
            rel="noopener"
            class="link inline-block p-4 text-[var(--accent)] no-underline"
          >
            {section.address} ↗
          </a>
        </div>
      ) : (
        <p class="text-[var(--muted)]">Adicione um endereço.</p>
      )}
    </div>
  </section>
)}
