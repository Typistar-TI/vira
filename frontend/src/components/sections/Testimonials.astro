---
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'testimonials' }>;
  preview: boolean;
}
const { section } = Astro.props;
const items = section.items.filter((item) => item.quote || item.name);
const single = section.variant === 'single';
---

{items.length > 0 && (
  <section
    class="px-5 py-16 text-[var(--fg)] sm:px-10 sm:py-24 lg:py-32"
    data-vs-section="testimonials"
  >
    <div class="mx-auto w-full max-w-[1180px]">
      <SectionHeading title={section.title} />
      <div
        class:list={[single ? 'mx-auto max-w-[760px]' : 'grid gap-5 sm:grid-cols-2 lg:grid-cols-3']}
      >
        {items.map((item) => (
          <figure class="card m-0 border border-[var(--line)] bg-[var(--surface)] p-6">
            <blockquote class="text-lg leading-relaxed text-[var(--fg)] [font-family:var(--font-display)]">
              {`“${item.quote}”`}
            </blockquote>
            {item.name && (
              <figcaption class="mt-4 text-xs uppercase tracking-wide text-[var(--muted)]">
                {item.name}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
