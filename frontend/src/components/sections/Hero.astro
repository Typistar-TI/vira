---
import { primaryHref } from './shared';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'hero' }>;
  preview: boolean;
}
const { section, preview } = Astro.props;
const href = primaryHref(section.primaryUrl, preview);
const background = section.variant === 'background';
const centered = section.variant === 'center';
---

<section
  class:list={[
    'relative isolate overflow-hidden px-5 sm:px-10',
    background ? 'py-32 sm:py-44 lg:py-56 text-white' : 'py-16 sm:py-24 lg:py-32 text-[var(--fg)]',
  ]}
  data-vs-section="hero"
>
  {background && section.image && (
    <>
      <img
        src={section.image}
        alt=""
        class="pointer-events-none absolute inset-0 -z-20 h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 -z-10 bg-black/55" />
    </>
  )}
  <div
    class:list={[
      'mx-auto flex w-full max-w-[1180px] flex-col gap-8 sm:gap-12',
      centered ? 'max-w-[820px] items-center text-center' : '',
      !centered && section.image && !background
        ? 'lg:grid lg:grid-cols-[1.05fr_0.95fr] lg:items-center'
        : '',
    ]}
  >
    <div class:list={[centered ? 'flex flex-col items-center' : '']}>
      {section.eyebrow && (
        <p
          class:list={[
            'mb-4 font-mono text-xs font-semibold uppercase tracking-[0.2em]',
            background ? 'text-white/80' : 'text-[var(--accent)]',
          ]}
        >
          {section.eyebrow}
        </p>
      )}
      {section.title && (
        <h1 class="m-0 text-[clamp(2.2rem,5.4vw,4.2rem)] font-medium leading-[1.05] tracking-[-0.03em] [font-family:var(--font-display)]">
          {section.title}
        </h1>
      )}
      {section.subtitle && (
        <p
          class:list={[
            'mt-5 max-w-[52ch] text-base leading-relaxed sm:text-lg',
            background ? 'text-white/85' : 'text-[var(--muted)]',
          ]}
        >
          {section.subtitle}
        </p>
      )}
      {section.primaryLabel && (
        <a
          href={href}
          class="btn mt-8 w-fit rounded-full border-0"
          style="background:var(--accent);color:var(--bg)"
        >
          {section.primaryLabel}
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
    {!background && section.image && (
      <figure class="m-0 overflow-hidden rounded-3xl shadow-2xl">
        <img
          src={section.image}
          alt={section.title}
          class="block aspect-[4/3] w-full object-cover"
          loading="eager"
        />
      </figure>
    )}
  </div>
</section>
