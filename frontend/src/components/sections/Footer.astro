---
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'footer' }>;
  preview: boolean;
  brand: string;
}
const { section, brand } = Astro.props;
const links = section.links.filter((link) => link.label && link.url);
const year = new Date().getFullYear();
---

<footer
  class="mt-auto border-t border-[var(--line)] px-5 pb-8 pt-12 text-center sm:px-10 sm:pt-16"
  data-vs-section="footer"
>
  <div class="footer footer-horizontal mx-auto flex w-full max-w-[1180px] flex-col items-center justify-center gap-3 text-[var(--fg)]">
    {brand && <span class="text-lg font-semibold [font-family:var(--font-display)]">{brand}</span>}
    {section.text && <p class="m-0 max-w-[42ch] text-sm text-[var(--muted)]">{section.text}</p>}
    {links.length > 0 && (
      <nav class="flex flex-wrap justify-center gap-5 text-sm">
        {links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener" class="link link-hover no-underline">
            {link.label}
          </a>
        ))}
      </nav>
    )}
    <span class="font-mono text-xs uppercase tracking-widest text-[var(--muted)]">
      © {year} · Vira
    </span>
  </div>
</footer>
