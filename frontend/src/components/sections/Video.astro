---
import SectionHeading from './SectionHeading.astro';
import { embedUrl } from '@frontend/api/sites/parse-site';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'video' }>;
  preview: boolean;
}
const { section } = Astro.props;
const source = embedUrl(section.url);
---

{(section.title || source) && (
  <section class="px-5 py-16 sm:px-10 sm:py-24 lg:py-32" data-vs-section="video">
    <div
      class:list={[
        'mx-auto w-full',
        section.variant === 'boxed' ? 'max-w-[760px]' : 'max-w-[1000px]',
      ]}
    >
      <SectionHeading title={section.title} />
      {source ? (
        <div class="aspect-video overflow-hidden rounded-3xl shadow-2xl">
          <iframe
            src={source}
            title={section.title || 'Vídeo'}
            class="h-full w-full border-0"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      ) : (
        <p class="text-[var(--muted)]">Adicione um link do YouTube ou Vimeo.</p>
      )}
      {section.caption && (
        <p class="mt-4 text-center text-sm text-[var(--muted)]">{section.caption}</p>
      )}
    </div>
  </section>
)}
