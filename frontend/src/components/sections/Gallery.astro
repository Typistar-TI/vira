---
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'gallery' }>;
  preview: boolean;
}
const { section } = Astro.props;
const images = section.images.filter((item) => item.image);
---

{images.length > 0 && (
  <section class:list={['gallery', `gallery-${section.variant}`]} data-vs-section="gallery">
    <div class="gallery-inner">
      <SectionHeading title={section.title} />
      <div class="gallery-grid">
        {images.map((item) => (
          <figure class="gallery-item">
            <img src={item.image} alt="" loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .gallery {
    padding: clamp(56px, 9vw, 120px) clamp(20px, 5vw, 40px);
  }
  .gallery-inner {
    max-width: 1180px;
    margin-inline: auto;
  }
  .gallery-grid {
    display: grid;
    gap: clamp(10px, 1.6vw, 18px);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }
  .gallery-masonry .gallery-grid {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    grid-auto-rows: 12px;
  }
  .gallery-masonry .gallery-item:nth-child(3n) {
    grid-row: span 22;
  }
  .gallery-masonry .gallery-item:nth-child(3n + 1) {
    grid-row: span 16;
  }
  .gallery-item {
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 1/1;
  }
  .gallery-masonry .gallery-item {
    aspect-ratio: auto;
    height: 100%;
  }
  .gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .gallery-item:hover img {
    transform: scale(1.04);
  }
</style>
