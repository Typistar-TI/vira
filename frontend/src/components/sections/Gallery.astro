---
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'gallery' }>;
  preview: boolean;
}
const { section } = Astro.props;
const images = section.images.filter((item) => item.image);
---

{images.length > 0 && (
  <section class="px-5 py-[var(--sec-py)] sm:px-10" data-vs-section="gallery">
    <div class="mx-auto w-full max-w-[1180px]">
      <SectionHeading title={section.title} />
      <div
        class:list={[
          'grid gap-3',
          section.variant === 'masonry'
            ? 'grid-cols-2 sm:grid-cols-3 auto-rows-[10rem]'
            : 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4',
        ]}
      >
        {images.map((item, index) => (
          <figure
            class:list={[
              'm-0 overflow-hidden rounded-2xl',
              section.variant === 'masonry' && index % 3 === 0 ? 'row-span-2' : '',
            ]}
          >
            <img
              src={item.image}
              alt=""
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
