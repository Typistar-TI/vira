---
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'stats' }>;
  preview: boolean;
}
const { section } = Astro.props;
const items = section.items.filter((item) => item.value || item.label);
---

{items.length > 0 && (
  <section class="px-5 py-[var(--sec-py)] sm:px-10" data-vs-section="stats">
    <div class="mx-auto w-full max-w-[1180px]">
      <SectionHeading title={section.title} />
      <div
        class:list={[
          'stats w-full border border-[var(--line)] bg-[var(--surface)] text-[var(--fg)]',
          section.variant === 'grid' ? 'stats-vertical sm:stats-horizontal' : 'stats-horizontal',
        ]}
      >
        {items.map((item) => (
          <div class="stat">
            <div class="stat-value text-[clamp(1.8rem,4vw,2.8rem)] text-[var(--fg)] [font-family:var(--font-display)]">
              {item.value}
            </div>
            <div class="stat-title uppercase tracking-wide text-[var(--muted)]">{item.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
