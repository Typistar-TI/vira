---
import SectionHeading from './SectionHeading.astro';
import { productHref } from './shared';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'services' }>;
  preview: boolean;
  productOffset?: number;
}
const { section, preview, productOffset = 0 } = Astro.props;
const items = section.items.filter((item) => item.title || item.description || item.image);
const globalIndex = (index: number) => productOffset + index;
---

{items.length > 0 && (
  <section class="px-5 py-[var(--sec-py)] text-[var(--fg)] sm:px-10" data-vs-section="services">
    <div class="mx-auto w-full max-w-[1180px]">
      <SectionHeading title={section.title} />
      <div
        class:list={[
          section.variant === 'list'
            ? 'flex flex-col gap-4'
            : 'grid gap-5 sm:grid-cols-2 lg:grid-cols-3',
        ]}
      >
        {items.map((item, index) => {
          const linked = Boolean(item.url);
          const Tag = linked ? 'a' : 'div';
          return (
            <Tag
              class:list={[
                'card border border-[var(--line)] bg-[var(--surface)] text-[var(--fg)] transition-transform',
                linked ? 'hover:-translate-y-1' : '',
                section.variant === 'list' ? 'card-side items-center overflow-hidden' : '',
              ]}
              href={linked ? productHref(item.url, preview, globalIndex(index)) : undefined}
            >
              {item.image && (
                <figure class:list={[section.variant === 'list' ? 'w-40 shrink-0' : '']}>
                  <img
                    src={item.image}
                    alt={item.title}
                    class="aspect-[4/3] h-full w-full object-cover"
                    loading="lazy"
                  />
                </figure>
              )}
              <div class="card-body p-6">
                {item.title && (
                  <h3 class="card-title text-lg font-medium [font-family:var(--font-display)]">
                    {item.title}
                  </h3>
                )}
                {item.description && (
                  <p class="text-sm leading-relaxed text-[var(--muted)]">{item.description}</p>
                )}
                {linked && (
                  <span class="text-[var(--accent)]" aria-hidden="true">
                    ↗
                  </span>
                )}
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>
)}
