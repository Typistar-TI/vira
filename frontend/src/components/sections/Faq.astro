---
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'faq' }>;
  preview: boolean;
}
const { section } = Astro.props;
const items = section.items.filter((item) => item.question || item.answer);
const accordion = section.variant === 'accordion';
---

{items.length > 0 && (
  <section class="px-5 py-[var(--sec-py)] text-[var(--fg)] sm:px-10" data-vs-section="faq">
    <div class="mx-auto w-full max-w-[var(--sec-max,820px)]">
      <SectionHeading title={section.title} />
      {accordion ? (
        <div class="flex flex-col gap-3">
          {items.map((item) => (
            <div class="collapse-arrow collapse border border-[var(--line)] bg-[var(--surface)]">
              <input type="checkbox" name={`faq-${section.id}`} />
              <div class="collapse-title font-medium [font-family:var(--font-display)]">
                {item.question}
              </div>
              <div class="collapse-content text-[var(--muted)]">
                <p>{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <dl class="m-0 flex flex-col gap-3">
          {items.map((item) => (
            <div class="rounded-box border border-[var(--line)] bg-[var(--surface)] p-4">
              <dt class="font-medium [font-family:var(--font-display)]">{item.question}</dt>
              <dd class="mt-2 text-[var(--muted)]">{item.answer}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </section>
)}
