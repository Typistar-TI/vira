---
import SectionHeading from './SectionHeading.astro';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'faq' }>;
  preview: boolean;
}
const { section } = Astro.props;
const items = section.items.filter((item) => item.question || item.answer);
---

{items.length > 0 && (
  <section class:list={['faq', `faq-${section.variant}`]} data-vs-section="faq">
    <div class="faq-inner">
      <SectionHeading title={section.title} />
      {section.variant === 'accordion' ? (
        <div class="faq-list">
          {items.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">{item.question}</summary>
              <p class="faq-answer">{item.answer}</p>
            </details>
          ))}
        </div>
      ) : (
        <dl class="faq-list">
          {items.map((item) => (
            <div class="faq-item">
              <dt class="faq-question">{item.question}</dt>
              <dd class="faq-answer">{item.answer}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </section>
)}
<style>
  .faq {
    padding: clamp(56px, 9vw, 120px) clamp(20px, 5vw, 40px);
  }
  .faq-inner {
    max-width: 820px;
    margin-inline: auto;
  }
  .faq-list {
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .faq-item {
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
  }
  .faq-question {
    cursor: pointer;
    font: 500 1.05rem/1.4 var(--font-display);
    color: var(--fg);
  }
  .faq-list dt.faq-question {
    cursor: default;
  }
  .faq-answer {
    margin: 0.75rem 0 0;
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.95rem;
  }
</style>
