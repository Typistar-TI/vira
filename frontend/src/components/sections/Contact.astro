---
import SectionHeading from './SectionHeading.astro';
import { primaryHref } from './shared';
import type { Section } from '@frontend/api/sites/parse-site';

interface Props {
  section: Extract<Section, { type: 'contact' }>;
  preview: boolean;
}
const { section, preview } = Astro.props;
const links = section.links.filter((link) => link.label && link.url);
---

{(section.title || section.body || section.primaryLabel || links.length > 0) && (
  <section class="px-5 py-[var(--sec-py)] text-[var(--fg)] sm:px-10" data-vs-section="contact">
    <div
      class:list={[
        'mx-auto w-full max-w-[760px] text-center',
        section.variant === 'cards'
          ? 'card border border-[var(--line)] bg-[var(--surface)] p-8 sm:p-12'
          : '',
      ]}
    >
      <SectionHeading title={section.title} centered />
      {section.body && (
        <p class="mx-auto max-w-[46ch] leading-relaxed text-[var(--muted)]">{section.body}</p>
      )}
      {section.primaryLabel && (
        <a
          href={primaryHref(section.primaryUrl, preview)}
          class="btn mt-6 rounded-full border-0"
          style="background:var(--accent);color:var(--bg)"
        >
          {section.primaryLabel}
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {links.length > 0 && (
        <ul class="mt-6 flex list-none flex-wrap justify-center gap-5 p-0">
          {links.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener" class="link no-underline">
                {link.label} ↗
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
