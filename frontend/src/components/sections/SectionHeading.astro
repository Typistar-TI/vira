---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

{title && (
  <h2 class="vs-heading" data-vs-heading>
    {title}
  </h2>
)}
<style>
  .vs-heading {
    margin: 0 0 1.6rem;
    font: 500 clamp(1.6rem, 3.4vw, 2.7rem) / 1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--fg);
  }
</style>
