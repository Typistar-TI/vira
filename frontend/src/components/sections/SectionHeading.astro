---
interface Props {
  title?: string;
  centered?: boolean;
}
const { title, centered = false } = Astro.props;
---

{title && (
  <h2
    class:list={[
      'mb-6 text-[clamp(1.6rem,3.4vw,2.7rem)] font-medium leading-tight tracking-[-0.02em] text-[var(--fg)] [font-family:var(--font-display)]',
      centered ? 'mx-auto text-center' : '',
    ]}
    data-vs-heading
  >
    {title}
  </h2>
)}
