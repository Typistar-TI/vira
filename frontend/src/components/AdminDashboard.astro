---
import Base from '@frontend/components/Base.astro';
import Brand from '@frontend/components/Brand.astro';
import { adminDashboard } from '@frontend/api/admin/dashboard';

const { admin, url } = Astro.props;
const search = (url.searchParams.get('q') || '').trim().slice(0, 80);

const { settings, prices, customers, domains, audit, emailTemplates, emailOutbox, counts, domain } =
  await adminDashboard(search);
const byKey = Object.fromEntries(settings.map((row) => [row.key, Boolean(row.value)]));
const required = [
  { label: 'Entrar por e-mail', ready: Boolean(byKey.RESEND_API_KEY && byKey.AUTH_EMAIL_FROM) },
  { label: 'Cobrança', ready: Boolean(byKey.STRIPE_SECRET_KEY && byKey.STRIPE_WEBHOOK_SECRET) },
  {
    label: 'Privacidade',
    ready: Boolean(byKey.PRIVACY_CONTROLLER_NAME && byKey.PRIVACY_CONTACT_EMAIL),
  },
  { label: 'Domínios próprios', ready: Boolean(byKey.CLOUDFLARE_API_TOKEN) },
  { label: 'Métricas', ready: Boolean(byKey.CLOUDFLARE_ANALYTICS_TOKEN) },
];
const groups = [
  { title: 'Identidade e acesso', keys: ['GOOGLE_CLIENT_ID', 'RESEND_API_KEY', 'AUTH_EMAIL_FROM'] },
  { title: 'Cobrança', keys: ['STRIPE_SECRET_KEY', 'STRIPE_WEBHOOK_SECRET'] },
  { title: 'Domínios e métricas', keys: ['CLOUDFLARE_API_TOKEN', 'CLOUDFLARE_ANALYTICS_TOKEN'] },
  { title: 'Privacidade', keys: ['PRIVACY_CONTROLLER_NAME', 'PRIVACY_CONTACT_EMAIL'] },
];
const labels: Record<string, string> = {
  GOOGLE_CLIENT_ID: 'Client ID do Google',
  RESEND_API_KEY: 'Chave de envio Resend',
  AUTH_EMAIL_FROM: 'E-mail remetente de acesso',
  STRIPE_SECRET_KEY: 'Chave secreta Stripe',
  STRIPE_WEBHOOK_SECRET: 'Segredo do webhook Stripe',
  CLOUDFLARE_API_TOKEN: 'Token Cloudflare para domínios',
  CLOUDFLARE_ANALYTICS_TOKEN: 'Token Cloudflare para métricas',
  PRIVACY_CONTROLLER_NAME: 'Responsável pelo Vira',
  PRIVACY_CONTACT_EMAIL: 'E-mail de privacidade',
};
const planName: Record<string, string> = {
  monthly: 'Mensal',
  yearly: 'Anual',
  lifetime: 'Vitalício',
};
const date = (time: number | null) =>
  time ? new Date(time * 1000).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : '—';
const emailLabels: Record<string, string> = {
  login: 'Link de acesso',
  site_created: 'Site criado',
  subscription_created: 'Assinatura confirmada',
  subscription_ending: 'Término próximo',
};
const emailDescriptions: Record<string, string> = {
  login:
    'Enviado quando o cliente pede um link para entrar. Sem ele, o acesso por e-mail fica indisponível.',
  site_created: 'Enviado uma vez, assim que a conta é criada e o site inicial entra no ar.',
  subscription_created: 'Enviado após a Stripe confirmar o plano mensal, anual ou vitalício.',
  subscription_ending:
    'Enviado cerca de 1 a 2 dias antes do fim do teste ou até 7 dias antes de uma assinatura com cancelamento agendado.',
};
const emailVariables: Record<string, string[]> = {
  login: ['login_url', 'email'],
  site_created: ['dashboard_url', 'site_url', 'end_date_pt', 'end_date_en', 'email'],
  subscription_created: ['dashboard_url', 'site_url', 'plan_pt', 'plan_en', 'email'],
  subscription_ending: [
    'dashboard_url',
    'site_url',
    'plan_pt',
    'plan_en',
    'end_date_pt',
    'end_date_en',
    'email',
  ],
};
const deliveryStatus: Record<string, string> = {
  pending: 'Aguardando',
  sending: 'Enviando',
  sent: 'Enviado',
  failed: 'Falhou',
  suppressed: 'Desativado',
};
---

<Base title="Administração · Vira" noindex appearance="light">
  <div class="min-h-screen bg-white text-[#17130d]">
    <header class="border-b border-[#d8ae73] bg-white">
      <div class="mx-auto flex max-w-[1380px] items-center justify-between gap-5 px-5 py-4 sm:px-8">
        <Brand tone="light" />
        <div class="flex items-center gap-4 text-sm text-[#625a51]">
          <span>Administração</span>
          <button id="admin-logout" class="btn btn-ghost btn-sm" type="button">
            Sair
          </button>
        </div>
      </div>
    </header>
    <div class="mx-auto grid max-w-[1380px] grid-cols-[minmax(0,1fr)] px-5 sm:px-8 lg:grid-cols-[230px_minmax(0,1fr)]">
      <aside class="min-w-0 border-b border-[#d8ae73] py-6 lg:sticky lg:top-0 lg:h-screen lg:border-r lg:border-b-0 lg:pr-6 lg:py-10">
        <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.18em] text-[#9b6823]">
          Vira / Admin
        </p>
        <nav
          class="flex gap-1 overflow-x-auto whitespace-nowrap lg:flex-col lg:overflow-visible"
          aria-label="Seções do painel"
        >
          <a
            class="rounded-lg border-l-2 border-[#b88333] px-3 py-2.5 text-sm text-[#17130d] transition-colors hover:bg-[#fff9ef]"
            href="#visao"
          >
            ↗ &nbsp;Visão geral
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#625a51] transition-colors hover:bg-[#fff9ef] hover:text-[#9b6823]"
            href="#precos"
          >
            ↗ &nbsp;Preços
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#625a51] transition-colors hover:bg-[#fff9ef] hover:text-[#9b6823]"
            href="#configuracoes"
          >
            ↗ &nbsp;Configurações
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#625a51] transition-colors hover:bg-[#fff9ef] hover:text-[#9b6823]"
            href="#emails"
          >
            ↗ &nbsp;E-mails
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#625a51] transition-colors hover:bg-[#fff9ef] hover:text-[#9b6823]"
            href="#clientes"
          >
            ↗ &nbsp;Clientes
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#625a51] transition-colors hover:bg-[#fff9ef] hover:text-[#9b6823]"
            href="#dominios"
          >
            ↗ &nbsp;Domínios
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#625a51] transition-colors hover:bg-[#fff9ef] hover:text-[#9b6823]"
            href="#atividade"
          >
            ↗ &nbsp;Atividade
          </a>
        </nav>
      </aside>
      <main class="min-w-0 pt-10 pb-24 lg:pl-10">
        <div class="relative mb-10 min-h-[260px] overflow-hidden rounded-xl border border-[#d8ae73] bg-white p-7 sm:p-9 [&_h1]:my-3 [&_h1]:font-[Outfit] [&_h1]:text-[clamp(2.4rem,5vw,4.4rem)] [&_h1]:leading-none [&_h1]:text-[#17130d] [&_p]:max-w-[56ch] [&_p]:text-[#625a51]">
          <img
            src="/vira-hero-light.webp"
            width="1586"
            height="992"
            alt=""
            class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-1/2 object-cover object-center opacity-55 md:block"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-white via-white to-transparent"></div>
          <div class="relative z-10 max-w-[760px]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Operação do Vira
            </span>
            <h1>Seu negócio, em ordem.</h1>
            <p>Configure o lançamento, acompanhe clientes e mantenha os planos atualizados.</p>
            <p class="mt-7 text-sm">
              Acesso autorizado · <strong class="text-[#17130d]">{admin.email}</strong>
            </p>
          </div>
        </div>

        <section
          id="visao"
          class="mb-20 scroll-mt-8 border-t border-[#d8ae73] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Visão geral
            </span>
            <h2>Estado da operação</h2>
          </div>
          <div class="grid gap-3 sm:grid-cols-3 [&_div]:flex [&_div]:min-h-36 [&_div]:flex-col [&_div]:justify-between [&_div]:rounded-xl [&_div]:border [&_div]:border-[#d8ae73] [&_div]:bg-white [&_div]:p-5 [&_strong]:font-[Outfit] [&_strong]:text-5xl [&_strong]:font-medium [&_strong]:tracking-tight [&_strong]:text-[#17130d] [&_span]:font-mono [&_span]:text-xs [&_span]:uppercase [&_span]:tracking-wide [&_span]:text-[#766e63]">
            <div>
              <strong>{counts.users}</strong>
              <span>clientes</span>
            </div>
            <div>
              <strong>{counts.published}</strong>
              <span>páginas publicadas</span>
            </div>
            <div>
              <strong>{counts.domains}</strong>
              <span>domínios conectados</span>
            </div>
          </div>
          <div class="mt-4 grid items-center gap-7 rounded-xl border border-[#d8ae73] bg-white p-7 md:grid-cols-[1fr_1.2fr] [&_h3]:mb-2 [&_h3]:text-xl [&_h3]:text-[#17130d] [&_p]:leading-relaxed [&_p]:text-[#625a51] [&_li]:flex [&_li]:items-center [&_li]:gap-2.5 [&_li]:border-b [&_li]:border-[#d8ae73] [&_li]:py-2 [&_li]:text-sm [&_li_strong]:ml-auto [&_li_strong]:text-xs [&_li_strong]:text-[#625a51]">
            <div>
              <h3>Antes de abrir as vendas</h3>
              <p>
                Estes itens dependem das configurações abaixo. O DNS e o Cloudflare for SaaS também
                devem estar ativos.
              </p>
            </div>
            <ul>
              {required.map((item) => (
                <li>
                  <span
                    class={
                      item.ready
                        ? 'h-2.5 w-2.5 flex-none rounded-full bg-[#7ddcb7]'
                        : 'h-2.5 w-2.5 flex-none rounded-full bg-[#9b6823]'
                    }
                  ></span>
                  {item.label}
                  <strong>{item.ready ? 'Pronto' : 'Pendente'}</strong>
                </li>
              ))}
            </ul>
          </div>
        </section>
        <section
          id="precos"
          class="mb-20 scroll-mt-8 border-t border-[#d8ae73] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Cobrança
            </span>
            <h2>Preços e planos</h2>
            <p>
              Ao ativar um preço, o Vira confere o valor, a moeda e a periodicidade na Stripe. Use
              um Price ID já criado na Stripe.
            </p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {prices.map((row) => (
              <form
                class="card rounded-xl border border-[#d8ae73] bg-white p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#17130d] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold"
                data-api-price-form
                data-plan={row.plan}
                data-currency={row.currency}
              >
                <div class="flex items-start justify-between [&_span]:badge [&_span]:badge-secondary">
                  <h3>{planName[row.plan]}</h3>
                  <span>{row.currency.toUpperCase()}</span>
                </div>
                <label>
                  Valor em {row.currency.toUpperCase()}
                  <input
                    class="input input-bordered w-full"
                    name="amount"
                    type="number"
                    min="0"
                    max="1000000"
                    step="0.01"
                    value={row.amount_minor === null ? '' : (row.amount_minor / 100).toFixed(2)}
                    placeholder="0,00"
                    required
                  />
                </label>
                <label>
                  Price ID da Stripe
                  <input
                    class="input input-bordered w-full"
                    name="stripe_price_id"
                    value={row.stripe_price_id ?? ''}
                    placeholder="price_..."
                    autocomplete="off"
                  />
                </label>
                <label class="my-4 flex! items-center gap-2 [&_input]:checkbox [&_input]:checkbox-primary">
                  <input name="active" type="checkbox" checked={Boolean(row.active)} /> Disponível
                  para compra
                </label>
                <button
                  class="btn btn-primary rounded-xl border-0 font-bold shadow-none"
                  type="submit"
                >
                  Salvar preço
                </button>
                <p
                  class="mt-2 text-sm text-success [hidden]:hidden"
                  data-api-status
                  role="status"
                  hidden
                ></p>
              </form>
            ))}
          </div>
        </section>
        <section
          id="configuracoes"
          class="mb-20 scroll-mt-8 border-t border-[#d8ae73] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Serviços
            </span>
            <h2>Configurações</h2>
            <p>
              Os segredos ficam criptografados no banco. Depois de salvos, apenas o estado
              “configurado” aparece aqui.
            </p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {groups.map((group) => (
              <div class="card rounded-xl border border-[#d8ae73] bg-white p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#17130d] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold">
                <h3>{group.title}</h3>
                {group.keys.map((key) => {
                  const row = settings.find((item) => item.key === key);
                  if (!row) return null;
                  return (
                    <form
                      class="border-t border-[#d8ae73] py-3 [&_label]:flex [&_label]:justify-between [&_label]:gap-2.5"
                      data-key={key}
                      data-secret={Boolean(row.encrypted)}
                      data-api-setting-form
                    >
                      <label for={`setting-${key}`}>
                        {labels[key]}{' '}
                        <span
                          class={row.value ? 'text-xs text-success' : 'text-xs text-error'}
                          data-api-config-state
                        >
                          {row.value ? 'Configurado' : 'Pendente'}
                        </span>
                      </label>
                      <div class="flex gap-2 [&_input]:min-w-0 [&_input]:flex-1">
                        <input
                          class="input input-bordered w-full"
                          id={`setting-${key}`}
                          name="value"
                          type={
                            row.encrypted
                              ? 'password'
                              : key === 'PRIVACY_CONTACT_EMAIL'
                                ? 'email'
                                : 'text'
                          }
                          value={row.encrypted ? '' : row.value}
                          placeholder={
                            row.encrypted && row.value ? 'Novo valor para substituir' : ''
                          }
                          autocomplete="off"
                        />
                        <button class="btn btn-outline" type="submit">
                          Salvar
                        </button>
                      </div>
                      <p
                        class="mt-2 text-sm text-success [hidden]:hidden"
                        data-api-status
                        role="status"
                        hidden
                      ></p>
                    </form>
                  );
                })}
              </div>
            ))}
          </div>
        </section>
        <section
          id="emails"
          class="mb-20 scroll-mt-8 border-t border-[#d8ae73] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Comunicação
            </span>
            <h2>E-mails automáticos</h2>
            <p>
              Edite o assunto e o HTML de cada mensagem. As variáveis entre chaves recebem os dados
              reais antes do envio. Desative um modelo para suspender novos envios desse tipo.
            </p>
          </div>
          <div class="grid gap-5">
            {emailTemplates.map((row) => (
              <form
                class="rounded-xl border border-[#d8ae73] bg-white p-5 sm:p-7"
                data-api-email-template-form
                data-key={row.key}
              >
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 class="font-[Outfit] text-2xl text-[#17130d]">{emailLabels[row.key]}</h3>
                    <p class="mt-1 max-w-[70ch] text-sm leading-relaxed text-[#625a51]">
                      {emailDescriptions[row.key]}
                    </p>
                  </div>
                  <label class="flex items-center gap-2 text-sm font-semibold text-[#17130d]">
                    <input
                      class="checkbox checkbox-primary"
                      name="enabled"
                      type="checkbox"
                      checked={Boolean(row.enabled)}
                    />
                    Ativo
                  </label>
                </div>
                <p class="mt-5 text-xs text-[#625a51]">
                  Variáveis: {emailVariables[row.key].map((name) => `{{${name}}}`).join(' · ')}
                </p>
                <label
                  class="mt-5 block text-sm font-semibold text-[#17130d]"
                  for={`email-subject-${row.key}`}
                >
                  Assunto
                </label>
                <input
                  id={`email-subject-${row.key}`}
                  class="input input-bordered mt-2 w-full"
                  name="subject"
                  type="text"
                  maxlength="180"
                  value={row.subject}
                  required
                />
                <label
                  class="mt-5 block text-sm font-semibold text-[#17130d]"
                  for={`email-html-${row.key}`}
                >
                  HTML do e-mail
                </label>
                <textarea
                  id={`email-html-${row.key}`}
                  class="textarea textarea-bordered mt-2 min-h-52 w-full font-mono text-xs leading-relaxed"
                  name="html"
                  maxlength="32000"
                  spellcheck="false"
                  required
                >{row.html}</textarea>
                <div class="mt-4 flex flex-wrap items-center gap-3">
                  <button
                    class="btn btn-primary rounded-xl border-0 font-bold shadow-none"
                    type="submit"
                  >
                    Salvar modelo
                  </button>
                  <button
                    class="btn btn-outline rounded-xl"
                    type="button"
                    data-email-preview-button
                  >
                    Ver prévia
                  </button>
                  <p
                    class="text-sm text-success [hidden]:hidden"
                    data-api-status
                    role="status"
                    hidden
                  ></p>
                </div>
                <div
                  class="mt-5 hidden rounded-xl border border-[#d8ae73] bg-[#fffdf9] p-3"
                  data-email-preview-container
                >
                  <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-[#9b6823]">
                    Prévia isolada
                  </p>
                  <iframe
                    title={`Prévia: ${emailLabels[row.key]}`}
                    class="h-80 w-full rounded-lg bg-white"
                    sandbox=""
                    data-email-preview
                  ></iframe>
                </div>
              </form>
            ))}
          </div>
          <div class="mt-8 rounded-xl border border-[#d8ae73] bg-white p-5 sm:p-7">
            <h3 class="font-[Outfit] text-xl text-[#17130d]">Últimos envios</h3>
            <p class="mt-1 text-sm text-[#625a51]">Histórico mantido por 30 dias.</p>
            <div class="mt-4 overflow-x-auto">
              <table class="table w-full">
                <thead>
                  <tr>
                    <th>Mensagem</th>
                    <th>Destinatário</th>
                    <th>Estado</th>
                    <th>Criado</th>
                  </tr>
                </thead>
                <tbody>
                  {emailOutbox.map((item) => (
                    <tr>
                      <td>{emailLabels[item.template_key] ?? item.template_key}</td>
                      <td>{item.recipient}</td>
                      <td title={item.last_error ?? ''}>
                        {deliveryStatus[item.status] ?? item.status}
                      </td>
                      <td>{date(item.created_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              {emailOutbox.length === 0 && (
                <p class="py-3 text-sm text-[#625a51]">Nenhum envio registrado.</p>
              )}
            </div>
          </div>
        </section>
        <section
          id="clientes"
          class="mb-20 scroll-mt-8 border-t border-[#d8ae73] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Contas
            </span>
            <h2>Clientes e assinaturas</h2>
            <p>
              Busque por e-mail ou endereço da página. Os planos mudam apenas pelos eventos de
              cobrança da Stripe.
            </p>
          </div>
          <form
            class="mb-3.5 flex gap-2 [&_input]:w-full [&_input]:max-w-[360px]"
            action="/admin#clientes"
            method="get"
          >
            <input
              class="input input-bordered w-full"
              name="q"
              type="search"
              value={search}
              placeholder="E-mail ou endereço da página"
              maxlength="80"
            />
            <button class="btn btn-primary" type="submit">
              Buscar
            </button>
          </form>
          <div class="card rounded-xl border border-[#d8ae73] bg-white p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#17130d] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold overflow-auto [&_table]:table [&_table]:w-full [&_th]:text-xs [&_th]:uppercase [&_th]:text-[#625a51] [&_td]:whitespace-nowrap [&_td_small]:text-[#625a51]">
            <table class="table">
              <thead>
                <tr>
                  <th>E-mail</th>
                  <th>Plano</th>
                  <th>Acesso até</th>
                  <th>Cadastro</th>
                  <th>Página</th>
                  <th>Assinatura</th>
                </tr>
              </thead>
              <tbody>
                {customers.map((row) => (
                  <tr>
                    <td>{row.email ?? 'Conta antiga'}</td>
                    <td>{row.plan}</td>
                    <td>
                      {date(row.access_until ?? (row.plan === 'trial' ? row.trial_ends_at : null))}
                    </td>
                    <td>{date(row.created_at)}</td>
                    <td>
                      <a
                        href={`https://${row.slug}.${domain}/`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {row.slug}
                      </a>
                      <small>{row.published_at ? 'Publicada' : 'Rascunho'}</small>
                    </td>
                    <td>
                      <code>{row.stripe_subscription_id ?? '—'}</code>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {customers.length === 0 && (
              <p class="my-2 text-[#625a51]">
                {search
                  ? 'Nenhuma conta corresponde à busca.'
                  : 'Nenhum cliente ainda. As contas aparecerão aqui após o primeiro cadastro.'}
              </p>
            )}
          </div>
        </section>
        <section
          id="dominios"
          class="mb-20 scroll-mt-8 border-t border-[#d8ae73] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Publicação
            </span>
            <h2>Domínios dos clientes</h2>
            <p>Acompanhe a ativação do hostname e do certificado TLS.</p>
          </div>
          <div class="card rounded-xl border border-[#d8ae73] bg-white p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#17130d] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold overflow-auto [&_table]:table [&_table]:w-full [&_th]:text-xs [&_th]:uppercase [&_th]:text-[#625a51] [&_td]:whitespace-nowrap [&_td_small]:text-[#625a51]">
            <table class="table">
              <thead>
                <tr>
                  <th>Domínio</th>
                  <th>Cliente</th>
                  <th>Hostname</th>
                  <th>TLS</th>
                  <th>Adicionado</th>
                </tr>
              </thead>
              <tbody>
                {domains.map((row) => (
                  <tr>
                    <td>{row.hostname}</td>
                    <td>{row.email ?? 'Conta antiga'}</td>
                    <td>{row.status}</td>
                    <td>{row.ssl_status}</td>
                    <td>{date(row.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {domains.length === 0 && (
              <p class="my-2 text-[#625a51]">Nenhum domínio de cliente conectado ainda.</p>
            )}
          </div>
        </section>
        <section
          id="atividade"
          class="mb-20 scroll-mt-8 border-t border-[#d8ae73] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Segurança
            </span>
            <h2>Atividade administrativa</h2>
          </div>
          <div class="card rounded-xl border border-[#d8ae73] bg-white p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#17130d] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&>div]:flex [&>div]:items-center [&>div]:gap-5 [&>div]:border-b [&>div]:border-[#d8ae73] [&>div]:py-3 [&>div]:text-sm [&_span]:min-w-20 [&_span]:text-[#625a51] [&_code]:ml-auto [&_code]:text-[#17130d]">
            {audit.length ? (
              audit.map((item) => (
                <div>
                  <span>{date(item.created_at)}</span>
                  <strong>
                    {item.action === 'update_price'
                      ? 'Preço alterado'
                      : item.action === 'update_email_template'
                        ? 'Modelo de e-mail alterado'
                        : item.action === 'clear_setting'
                          ? 'Configuração limpa'
                          : 'Configuração alterada'}
                  </strong>
                  <code>{item.target}</code>
                </div>
              ))
            ) : (
              <p class="my-2 text-[#625a51]">Nenhuma alteração registrada ainda.</p>
            )}
          </div>
        </section>
      </main>
    </div>
  </div>
  <script>
    import { updateSetting } from '@frontend/api/admin/update-setting';
    import { updatePrice } from '@frontend/api/admin/update-price';
    import { updateEmailTemplate } from '@frontend/api/admin/update-email-template';
    import { logout } from '@frontend/api/auth/logout';
    const show = (form: HTMLFormElement, message: string, error = false) => {
      const node = form.querySelector<HTMLElement>('[data-api-status]')!;
      node.textContent = message;
      node.hidden = false;
      node.classList.toggle('text-error', error);
      node.classList.toggle('text-success', !error);
    };
    document.querySelectorAll<HTMLFormElement>('[data-api-setting-form]').forEach((form) =>
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          const value = form.querySelector<HTMLInputElement>('[name=value]')!.value;
          if (!value.trim()) throw new Error('Informe um valor.');
          await updateSetting(form.dataset.key || '', value);
          if (form.dataset.secret === 'true')
            form.querySelector<HTMLInputElement>('[name=value]')!.value = '';
          const badge = form.querySelector<HTMLElement>('[data-api-config-state]')!;
          badge.className = 'text-xs text-success';
          badge.textContent = 'Configurado';
          show(form, 'Salvo.');
        } catch (error) {
          show(form, error instanceof Error ? error.message : 'Falha ao salvar', true);
        } finally {
          button.disabled = false;
        }
      }),
    );
    document.querySelectorAll<HTMLFormElement>('[data-api-price-form]').forEach((form) =>
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          const input = form.querySelector<HTMLInputElement>('[name=amount]')!;
          const amount = Number(input.value);
          if (!Number.isFinite(amount) || !Number.isInteger(amount * 100))
            throw new Error('Informe um valor com até duas casas decimais.');
          const body = {
            plan: form.dataset.plan,
            currency: form.dataset.currency,
            amount_minor: Math.round(amount * 100),
            stripe_price_id: form
              .querySelector<HTMLInputElement>('[name=stripe_price_id]')!
              .value.trim(),
            active: form.querySelector<HTMLInputElement>('[name=active]')!.checked,
          };
          await updatePrice(body);
          show(form, 'Preço salvo.');
        } catch (error) {
          show(form, error instanceof Error ? error.message : 'Falha ao salvar', true);
        } finally {
          button.disabled = false;
        }
      }),
    );
    document.querySelectorAll<HTMLFormElement>('[data-api-email-template-form]').forEach((form) => {
      form
        .querySelector<HTMLButtonElement>('[data-email-preview-button]')
        ?.addEventListener('click', () => {
          const html = form.querySelector<HTMLTextAreaElement>('[name=html]')!.value;
          const samples: Record<string, string> = {
            login_url: 'https://vira.ia.br/auth/email?token=exemplo',
            dashboard_url: 'https://vira.ia.br/app',
            site_url: 'https://meu-site.vira.ia.br',
            end_date: '27 de setembro de 2026',
            end_date_pt: '27 de setembro de 2026',
            end_date_en: 'September 27, 2026',
            plan: 'mensal',
            plan_pt: 'mensal',
            plan_en: 'monthly',
            email: 'cliente@exemplo.com',
          };
          const preview = html.replace(
            /{{\s*([a-z_]+)\s*}}/g,
            (_, name: string) => samples[name] ?? '',
          );
          const container = form.querySelector<HTMLElement>('[data-email-preview-container]')!;
          form.querySelector<HTMLIFrameElement>('[data-email-preview]')!.srcdoc = preview;
          container.classList.remove('hidden');
        });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          await updateEmailTemplate({
            key: form.dataset.key || '',
            enabled: form.querySelector<HTMLInputElement>('[name=enabled]')!.checked,
            subject: form.querySelector<HTMLInputElement>('[name=subject]')!.value,
            html: form.querySelector<HTMLTextAreaElement>('[name=html]')!.value,
          });
          show(form, 'Modelo salvo.');
        } catch (error) {
          show(form, error instanceof Error ? error.message : 'Falha ao salvar', true);
        } finally {
          button.disabled = false;
        }
      });
    });
    document.querySelector('#admin-logout')?.addEventListener('click', async () => {
      await logout();
      location.href = '/';
    });
  </script>
</Base>
