---
import Base from '@frontend/components/Base.astro';
import Brand from '@frontend/components/Brand.astro';
import { adminDashboard } from '@frontend/api/admin/dashboard';

const { url, section = 'visao' } = Astro.props;
const search = (url.searchParams.get('q') || '').trim().slice(0, 80);
const navigation = [
  { key: 'visao', href: '/admin', label: 'Visão geral' },
  { key: 'precos', href: '/admin/precos', label: 'Preços' },
  { key: 'configuracoes', href: '/admin/configuracoes', label: 'Configurações' },
  { key: 'emails', href: '/admin/emails', label: 'E-mails' },
  { key: 'clientes', href: '/admin/clientes', label: 'Clientes' },
  { key: 'dominios', href: '/admin/dominios', label: 'Domínios' },
  { key: 'atividade', href: '/admin/atividade', label: 'Atividade' },
];

const { settings, prices, customers, domains, audit, emailTemplates, emailOutbox, counts, domain } =
  await adminDashboard(search, section);
const byKey = Object.fromEntries(settings.map((row) => [row.key, Boolean(row.value)]));
const required = [
  { label: 'Entrar por e-mail', ready: Boolean(byKey.RESEND_API_KEY && byKey.AUTH_EMAIL_FROM) },
  { label: 'Cobrança', ready: Boolean(byKey.STRIPE_SECRET_KEY && byKey.STRIPE_WEBHOOK_SECRET) },
  {
    label: 'Privacidade',
    ready: Boolean(byKey.PRIVACY_CONTROLLER_NAME && byKey.PRIVACY_CONTACT_EMAIL),
  },
  { label: 'Domínios próprios', ready: Boolean(byKey.CLOUDFLARE_API_TOKEN) },
  { label: 'Métricas', ready: Boolean(byKey.CLOUDFLARE_ANALYTICS_TOKEN) },
];
const groups = [
  { title: 'Identidade e acesso', keys: ['GOOGLE_CLIENT_ID', 'RESEND_API_KEY', 'AUTH_EMAIL_FROM'] },
  { title: 'Cobrança', keys: ['STRIPE_SECRET_KEY', 'STRIPE_WEBHOOK_SECRET'] },
  { title: 'Domínios e métricas', keys: ['CLOUDFLARE_API_TOKEN', 'CLOUDFLARE_ANALYTICS_TOKEN'] },
  { title: 'Privacidade', keys: ['PRIVACY_CONTROLLER_NAME', 'PRIVACY_CONTACT_EMAIL'] },
];
const labels: Record<string, string> = {
  GOOGLE_CLIENT_ID: 'Client ID do Google',
  RESEND_API_KEY: 'Chave de envio Resend',
  AUTH_EMAIL_FROM: 'E-mail remetente de acesso',
  STRIPE_SECRET_KEY: 'Chave secreta Stripe',
  STRIPE_WEBHOOK_SECRET: 'Segredo do webhook Stripe',
  CLOUDFLARE_API_TOKEN: 'Token Cloudflare para domínios',
  CLOUDFLARE_ANALYTICS_TOKEN: 'Token Cloudflare para métricas',
  PRIVACY_CONTROLLER_NAME: 'Responsável pelo Vira',
  PRIVACY_CONTACT_EMAIL: 'E-mail de privacidade',
};
const planName: Record<string, string> = {
  monthly: 'Mensal',
  yearly: 'Anual',
  lifetime: 'Vitalício',
};
const date = (time: number | null) =>
  time ? new Date(time * 1000).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : '—';
const emailLabels: Record<string, string> = {
  login: 'Link de acesso',
  site_created: 'Site criado',
  subscription_created: 'Assinatura confirmada',
  subscription_ending: 'Término próximo',
};
const emailDescriptions: Record<string, string> = {
  login:
    'Enviado quando o cliente pede um link para entrar. Sem ele, o acesso por e-mail fica indisponível.',
  site_created: 'Enviado uma vez, assim que a conta é criada e o site inicial entra no ar.',
  subscription_created: 'Enviado após a Stripe confirmar o plano mensal, anual ou vitalício.',
  subscription_ending:
    'Enviado cerca de 1 a 2 dias antes do fim do teste ou até 7 dias antes de uma assinatura com cancelamento agendado.',
};
const emailVariables: Record<string, string[]> = {
  login: ['login_url', 'email'],
  site_created: ['dashboard_url', 'site_url', 'end_date_pt', 'end_date_en', 'email'],
  subscription_created: ['dashboard_url', 'site_url', 'plan_pt', 'plan_en', 'email'],
  subscription_ending: [
    'dashboard_url',
    'site_url',
    'plan_pt',
    'plan_en',
    'end_date_pt',
    'end_date_en',
    'email',
  ],
};
const deliveryStatus: Record<string, string> = {
  pending: 'Aguardando',
  sending: 'Enviando',
  sent: 'Enviado',
  failed: 'Falhou',
  suppressed: 'Desativado',
};
---

<Base
  title={`${section === 'visao' ? 'Administração' : navigation.find((item) => item.key === section)?.label} · Vira`}
  noindex
  appearance="light"
  manifest="/admin/manifest.webmanifest"
>
  <div class="min-h-screen bg-white text-[#17130d]">
    <header class="border-b border-[#d8ae73] bg-white">
      <div class="mx-auto flex max-w-[1380px] flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-8">
        <Brand tone="light" />
        <nav
          class="order-3 flex w-full items-center gap-1 overflow-x-auto rounded-full border border-[#d8ae73] bg-white/95 px-3 py-2 text-sm text-[#605448] shadow-[0_8px_30px_-22px_rgba(131,85,21,0.35)] xl:order-none xl:w-auto"
          aria-label="Navegação administrativa"
        >
          {navigation.map((item) => (
            <a
              href={item.href}
              aria-current={section === item.key ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-1.5 whitespace-nowrap transition-colors focus-visible:outline-2 focus-visible:outline-[#b88333]',
                section === item.key
                  ? 'bg-[#fff4df] font-semibold text-[#6f4716]'
                  : 'hover:bg-[#fff9ef] hover:text-[#9b6823]',
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-1 text-sm text-[#625a51] sm:gap-2">
          <a
            href="/"
            class="btn btn-ghost btn-xs rounded-full sm:btn-sm"
            aria-label="Voltar ao site"
          >
            <span class="sm:hidden">Site</span>
            <span class="hidden sm:inline">Voltar ao site</span>
          </a>
          <button
            id="admin-logout"
            class="btn btn-ghost btn-xs rounded-full sm:btn-sm"
            type="button"
            aria-label="Encerrar sessão"
          >
            <span class="sm:hidden">Sair</span>
            <span class="hidden sm:inline">Encerrar sessão</span>
          </button>
        </div>
      </div>
    </header>
    <main class="mx-auto min-w-0 max-w-[1380px] px-5 pt-8 pb-24 sm:px-8 [&_table]:text-sm [&_thead]:bg-[#fff9ef] [&_th]:font-semibold [&_th]:text-[#6f4716] [&_tbody_tr]:border-[#ead8bd] [&_tbody_tr:hover]:bg-[#fffaf2]">
      {section === 'visao' && (
        <h1 class="mb-8 font-[Outfit] text-[clamp(2rem,4vw,3rem)] font-medium leading-none tracking-[-0.04em] text-[#17130d]">
          Bem-vindo
        </h1>
      )}

      {section === 'visao' && (
        <section id="visao" class="mb-16 scroll-mt-24 border-t border-[#d8ae73] pt-8">
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Visão geral
            </span>
            <h2>Estado da operação</h2>
          </div>
          <div class="grid grid-cols-3 border-y border-[#d8ae73] py-5 [&_div]:flex [&_div]:flex-col [&_div]:gap-1 [&_div]:px-3 [&_div:first-child]:pl-0 [&_div+div]:border-l [&_div+div]:border-[#d8ae73] [&_strong]:font-[Outfit] [&_strong]:text-[clamp(2rem,4vw,3.5rem)] [&_strong]:font-medium [&_strong]:leading-none [&_strong]:tracking-tight [&_strong]:text-[#17130d] [&_span]:text-xs [&_span]:text-[#625a51] sm:[&_div]:px-6">
            <div>
              <strong>{counts.users}</strong>
              <span>clientes</span>
            </div>
            <div>
              <strong>{counts.published}</strong>
              <span>páginas publicadas</span>
            </div>
            <div>
              <strong>{counts.domains}</strong>
              <span>domínios conectados</span>
            </div>
          </div>
          <h3 class="mt-8 mb-2 font-[Outfit] text-xl">Antes de abrir as vendas</h3>
          <p class="mb-3 text-sm text-[#625a51]">
            Confira as integrações abaixo. DNS e Cloudflare for SaaS também precisam estar ativos.
          </p>
          <div class="overflow-x-auto border-y border-[#d8ae73]">
            <table class="table w-full">
              <thead>
                <tr>
                  <th>Item</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                {required.map((item) => (
                  <tr>
                    <td>{item.label}</td>
                    <td>
                      <span
                        class:list={[
                          'badge badge-sm',
                          item.ready
                            ? 'badge-outline border-[#d8ae73] text-[#6f4716]'
                            : 'badge-outline border-[#c8c4bd] text-[#625a51]',
                        ]}
                      >
                        {item.ready ? 'Pronto' : 'Pendente'}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}
      {section === 'precos' && (
        <section id="precos" class="mb-16 scroll-mt-24 border-t border-[#d8ae73] pt-8">
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Cobrança
            </span>
            <h2>Preços e planos</h2>
            <p>
              Ao ativar um preço, o Vira confere o valor, a moeda e a periodicidade na Stripe. Use
              um Price ID já criado na Stripe.
            </p>
          </div>
          <div class="overflow-x-auto border-y border-[#d8ae73]">
            <table class="table w-full min-w-[760px]">
              <thead>
                <tr>
                  <th>Plano</th>
                  <th>Moeda</th>
                  <th>Valor</th>
                  <th>Price ID da Stripe</th>
                  <th>Disponível</th>
                  <th>
                    <span class="sr-only">Ação</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {prices.map((row) => {
                  const formId = `price-${row.plan}-${row.currency}`;
                  return (
                    <tr>
                      <td class="font-semibold">
                        <form
                          id={formId}
                          data-api-price-form
                          data-plan={row.plan}
                          data-currency={row.currency}
                        >
                          {planName[row.plan]}
                          <p
                            class="mt-1 text-xs text-[#6f4716] [hidden]:hidden"
                            data-api-status
                            role="status"
                            hidden
                          ></p>
                        </form>
                      </td>
                      <td>
                        <span class="badge badge-outline border-[#d8ae73]">
                          {row.currency.toUpperCase()}
                        </span>
                      </td>
                      <td>
                        <input
                          class="input input-bordered w-28"
                          form={formId}
                          aria-label={`Valor de ${planName[row.plan]} em ${row.currency.toUpperCase()}`}
                          name="amount"
                          type="number"
                          min="0"
                          max="1000000"
                          step="0.01"
                          value={
                            row.amount_minor === null ? '' : (row.amount_minor / 100).toFixed(2)
                          }
                          placeholder="0,00"
                          required
                        />
                      </td>
                      <td>
                        <input
                          class="input input-bordered w-full min-w-48"
                          form={formId}
                          aria-label={`Price ID de ${planName[row.plan]} em ${row.currency.toUpperCase()}`}
                          name="stripe_price_id"
                          value={row.stripe_price_id ?? ''}
                          placeholder="price_..."
                          autocomplete="off"
                        />
                      </td>
                      <td>
                        <input
                          class="checkbox checkbox-primary"
                          form={formId}
                          aria-label={`Disponibilizar ${planName[row.plan]} em ${row.currency.toUpperCase()}`}
                          name="active"
                          type="checkbox"
                          checked={Boolean(row.active)}
                        />
                      </td>
                      <td>
                        <button class="btn btn-primary btn-sm" form={formId} type="submit">
                          Salvar
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}
      {section === 'configuracoes' && (
        <section id="configuracoes" class="mb-16 scroll-mt-24 border-t border-[#d8ae73] pt-8">
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Serviços
            </span>
            <h2>Configurações</h2>
            <p>
              Os segredos ficam criptografados no banco. Depois de salvos, apenas o estado
              “configurado” aparece aqui.
            </p>
          </div>
          <div class="overflow-x-auto border-y border-[#d8ae73]">
            <table class="table w-full min-w-[780px]">
              <thead>
                <tr>
                  <th>Grupo</th>
                  <th>Configuração</th>
                  <th>Estado</th>
                  <th>Valor</th>
                  <th>
                    <span class="sr-only">Ação</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {groups.map((group) =>
                  group.keys.map((key) => {
                    const row = settings.find((item) => item.key === key);
                    if (!row) return null;
                    const formId = `setting-form-${key}`;
                    return (
                      <tr>
                        <td class="text-xs text-[#625a51]">{group.title}</td>
                        <td class="font-medium">
                          <form
                            id={formId}
                            data-key={key}
                            data-secret={Boolean(row.encrypted)}
                            data-api-setting-form
                          >
                            <label for={`setting-${key}`}>{labels[key]}</label>
                            <p
                              class="mt-1 text-xs text-[#6f4716] [hidden]:hidden"
                              data-api-status
                              role="status"
                              hidden
                            ></p>
                          </form>
                        </td>
                        <td>
                          <span
                            class:list={[
                              'badge badge-sm',
                              row.value
                                ? 'badge-outline border-[#d8ae73] text-[#6f4716]'
                                : 'badge-outline border-[#c8c4bd] text-[#625a51]',
                            ]}
                            data-api-config-state
                          >
                            {row.value ? 'Configurado' : 'Pendente'}
                          </span>
                        </td>
                        <td>
                          <input
                            class="input input-bordered w-full min-w-56"
                            form={formId}
                            id={`setting-${key}`}
                            name="value"
                            type={
                              row.encrypted
                                ? 'password'
                                : key === 'PRIVACY_CONTACT_EMAIL'
                                  ? 'email'
                                  : 'text'
                            }
                            value={row.encrypted ? '' : row.value}
                            placeholder={
                              row.encrypted && row.value ? 'Novo valor para substituir' : ''
                            }
                            autocomplete="off"
                          />
                        </td>
                        <td>
                          <button class="btn btn-outline btn-sm" form={formId} type="submit">
                            Salvar
                          </button>
                        </td>
                      </tr>
                    );
                  }),
                )}
              </tbody>
            </table>
          </div>
        </section>
      )}
      {section === 'emails' && (
        <section id="emails" class="mb-16 scroll-mt-24 border-t border-[#d8ae73] pt-8">
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Comunicação
            </span>
            <h2>E-mails automáticos</h2>
            <p>
              Edite o assunto e o HTML de cada mensagem. As variáveis entre chaves recebem os dados
              reais antes do envio. Desative um modelo para suspender novos envios desse tipo.
            </p>
          </div>
          <div class="overflow-x-auto border-y border-[#d8ae73]">
            <table class="table w-full">
              <thead>
                <tr>
                  <th>Mensagem</th>
                  <th>Estado</th>
                  <th class="hidden md:table-cell">Assunto</th>
                  <th>
                    <span class="sr-only">Ação</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {emailTemplates.map((row) => (
                  <>
                    <tr>
                      <td class="font-medium">{emailLabels[row.key]}</td>
                      <td>
                        <span
                          class:list={[
                            'badge badge-sm',
                            row.enabled
                              ? 'badge-outline border-[#d8ae73] text-[#6f4716]'
                              : 'badge-outline border-[#c8c4bd] text-[#625a51]',
                          ]}
                        >
                          {row.enabled ? 'Ativo' : 'Desativado'}
                        </span>
                      </td>
                      <td
                        class="hidden max-w-80 truncate md:table-cell"
                        title={row.subject}
                        data-email-subject
                      >
                        {row.subject}
                      </td>
                      <td>
                        <button
                          class="btn btn-outline btn-sm"
                          type="button"
                          data-email-toggle
                          aria-controls={`email-editor-${row.key}`}
                          aria-expanded="false"
                        >
                          Editar
                        </button>
                      </td>
                    </tr>
                    <tr id={`email-editor-${row.key}`} class="hidden" data-email-editor-row>
                      <td colspan="4" class="bg-[#fffdf9] p-5 sm:p-7">
                        <form data-api-email-template-form data-key={row.key}>
                          <p class="max-w-[70ch] text-sm leading-relaxed text-[#625a51]">
                            {emailDescriptions[row.key]}
                          </p>
                          <label class="mt-5 flex items-center gap-2 text-sm font-semibold text-[#17130d]">
                            <input
                              class="checkbox checkbox-primary"
                              name="enabled"
                              type="checkbox"
                              checked={Boolean(row.enabled)}
                            />{' '}
                            Ativo
                          </label>
                          <p class="mt-4 text-xs text-[#625a51]">
                            Variáveis:{' '}
                            {emailVariables[row.key].map((name) => `{{${name}}}`).join(' · ')}
                          </p>
                          <label
                            class="mt-5 block text-sm font-semibold text-[#17130d]"
                            for={`email-subject-${row.key}`}
                          >
                            Assunto
                          </label>
                          <input
                            id={`email-subject-${row.key}`}
                            class="input input-bordered mt-2 w-full"
                            name="subject"
                            type="text"
                            maxlength="180"
                            value={row.subject}
                            required
                          />
                          <label
                            class="mt-5 block text-sm font-semibold text-[#17130d]"
                            for={`email-html-${row.key}`}
                          >
                            HTML do e-mail
                          </label>
                          <textarea
                            id={`email-html-${row.key}`}
                            class="textarea textarea-bordered mt-2 min-h-52 w-full font-mono text-xs leading-relaxed"
                            name="html"
                            maxlength="32000"
                            spellcheck="false"
                            required
                          >{row.html}</textarea>
                          <div class="mt-4 flex flex-wrap items-center gap-3">
                            <button class="btn btn-primary" type="submit">
                              Salvar modelo
                            </button>
                            <button class="btn btn-outline" type="button" data-email-preview-button>
                              Ver prévia
                            </button>
                            <p
                              class="text-sm text-[#6f4716] [hidden]:hidden"
                              data-api-status
                              role="status"
                              hidden
                            ></p>
                          </div>
                          <div
                            class="mt-5 hidden border border-[#d8ae73] bg-white p-3"
                            data-email-preview-container
                          >
                            <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-[#9b6823]">
                              Prévia isolada
                            </p>
                            <iframe
                              title={`Prévia: ${emailLabels[row.key]}`}
                              class="h-80 w-full bg-white"
                              sandbox=""
                              data-email-preview
                            ></iframe>
                          </div>
                        </form>
                      </td>
                    </tr>
                  </>
                ))}
              </tbody>
            </table>
          </div>
          <div class="mt-8">
            <h3 class="font-[Outfit] text-xl text-[#17130d]">Últimos envios</h3>
            <p class="mt-1 text-sm text-[#625a51]">Histórico mantido por 30 dias.</p>
            <div class="mt-4 overflow-x-auto">
              <table class="table w-full">
                <thead>
                  <tr>
                    <th>Mensagem</th>
                    <th>Destinatário</th>
                    <th>Estado</th>
                    <th>Criado</th>
                  </tr>
                </thead>
                <tbody>
                  {emailOutbox.map((item) => (
                    <tr>
                      <td>{emailLabels[item.template_key] ?? item.template_key}</td>
                      <td>{item.recipient}</td>
                      <td title={item.last_error ?? ''}>
                        {deliveryStatus[item.status] ?? item.status}
                      </td>
                      <td>{date(item.created_at)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              {emailOutbox.length === 0 && (
                <p class="py-3 text-sm text-[#625a51]">Nenhum envio registrado.</p>
              )}
            </div>
          </div>
        </section>
      )}
      {section === 'clientes' && (
        <section id="clientes" class="mb-16 scroll-mt-24 border-t border-[#d8ae73] pt-8">
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Contas
            </span>
            <h2>Clientes e assinaturas</h2>
            <p>
              Busque por e-mail ou endereço da página. Os planos mudam apenas pelos eventos de
              cobrança da Stripe.
            </p>
          </div>
          <form
            class="mb-3.5 flex gap-2 [&_input]:w-full [&_input]:max-w-[360px]"
            action="/admin/clientes"
            method="get"
          >
            <input
              class="input input-bordered w-full"
              name="q"
              type="search"
              value={search}
              placeholder="E-mail ou endereço da página"
              maxlength="80"
            />
            <button class="btn btn-primary" type="submit">
              Buscar
            </button>
          </form>
          <div class="overflow-x-auto border-y border-[#d8ae73] [&_td]:whitespace-nowrap [&_td_small]:block [&_td_small]:text-[#625a51]">
            <table class="table">
              <thead>
                <tr>
                  <th>E-mail</th>
                  <th>Plano</th>
                  <th>Acesso até</th>
                  <th>Cadastro</th>
                  <th>Página</th>
                  <th>Assinatura</th>
                </tr>
              </thead>
              <tbody>
                {customers.map((row) => (
                  <tr>
                    <td>{row.email ?? 'Conta antiga'}</td>
                    <td>{row.plan}</td>
                    <td>
                      {date(row.access_until ?? (row.plan === 'trial' ? row.trial_ends_at : null))}
                    </td>
                    <td>{date(row.created_at)}</td>
                    <td>
                      <a
                        href={`https://${row.slug}.${domain}/`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {row.slug}
                      </a>
                      <small>{row.published_at ? 'Publicada' : 'Rascunho'}</small>
                    </td>
                    <td>
                      <code>{row.stripe_subscription_id ?? '—'}</code>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {customers.length === 0 && (
              <p class="my-2 text-[#625a51]">
                {search
                  ? 'Nenhuma conta corresponde à busca.'
                  : 'Nenhum cliente ainda. As contas aparecerão aqui após o primeiro cadastro.'}
              </p>
            )}
          </div>
        </section>
      )}
      {section === 'dominios' && (
        <section id="dominios" class="mb-16 scroll-mt-24 border-t border-[#d8ae73] pt-8">
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Publicação
            </span>
            <h2>Domínios dos clientes</h2>
            <p>Acompanhe a ativação do hostname e do certificado TLS.</p>
          </div>
          <div class="overflow-x-auto border-y border-[#d8ae73] [&_td]:whitespace-nowrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Domínio</th>
                  <th>Cliente</th>
                  <th>Hostname</th>
                  <th>TLS</th>
                  <th>Adicionado</th>
                </tr>
              </thead>
              <tbody>
                {domains.map((row) => (
                  <tr>
                    <td>{row.hostname}</td>
                    <td>{row.email ?? 'Conta antiga'}</td>
                    <td>{row.status}</td>
                    <td>{row.ssl_status}</td>
                    <td>{date(row.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {domains.length === 0 && (
              <p class="my-2 text-[#625a51]">Nenhum domínio de cliente conectado ainda.</p>
            )}
          </div>
        </section>
      )}
      {section === 'atividade' && (
        <section id="atividade" class="mb-16 scroll-mt-24 border-t border-[#d8ae73] pt-8">
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#17130d] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#625a51]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#9b6823]">
              Segurança
            </span>
            <h2>Atividade administrativa</h2>
          </div>
          <div class="overflow-x-auto border-y border-[#d8ae73]">
            <table class="table w-full min-w-[540px]">
              <thead>
                <tr>
                  <th>Data</th>
                  <th>Alteração</th>
                  <th>Item</th>
                </tr>
              </thead>
              <tbody>
                {audit.map((item) => (
                  <tr>
                    <td>{date(item.created_at)}</td>
                    <td>
                      {item.action === 'update_price'
                        ? 'Preço alterado'
                        : item.action === 'update_email_template'
                          ? 'Modelo de e-mail alterado'
                          : item.action === 'clear_setting'
                            ? 'Configuração limpa'
                            : 'Configuração alterada'}
                    </td>
                    <td>
                      <code>{item.target}</code>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {audit.length === 0 && (
              <p class="py-4 text-sm text-[#625a51]">Nenhuma alteração registrada ainda.</p>
            )}
          </div>
        </section>
      )}
    </main>
  </div>
  <script>
    import { updateSetting } from '@frontend/api/admin/update-setting';
    import { updatePrice } from '@frontend/api/admin/update-price';
    import { updateEmailTemplate } from '@frontend/api/admin/update-email-template';
    import { logout } from '@frontend/api/auth/logout';
    const show = (form: HTMLFormElement, message: string, error = false) => {
      const node = form.querySelector<HTMLElement>('[data-api-status]')!;
      node.textContent = message;
      node.hidden = false;
      node.classList.toggle('text-error', error);
      node.classList.toggle('text-[#6f4716]', !error);
    };
    document.querySelectorAll<HTMLFormElement>('[data-api-setting-form]').forEach((form) =>
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.closest('tr')!.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          const field = form.elements.namedItem('value') as HTMLInputElement;
          const value = field.value;
          if (!value.trim()) throw new Error('Informe um valor.');
          await updateSetting(form.dataset.key || '', value);
          if (form.dataset.secret === 'true') field.value = '';
          const badge = form.closest('tr')!.querySelector<HTMLElement>('[data-api-config-state]')!;
          badge.className = 'badge badge-sm badge-outline border-[#d8ae73] text-[#6f4716]';
          badge.textContent = 'Configurado';
          show(form, 'Salvo.');
        } catch (error) {
          show(form, error instanceof Error ? error.message : 'Falha ao salvar', true);
        } finally {
          button.disabled = false;
        }
      }),
    );
    document.querySelectorAll<HTMLFormElement>('[data-api-price-form]').forEach((form) =>
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.closest('tr')!.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          const input = form.elements.namedItem('amount') as HTMLInputElement;
          const amount = Number(input.value);
          if (!Number.isFinite(amount) || !Number.isInteger(amount * 100))
            throw new Error('Informe um valor com até duas casas decimais.');
          const body = {
            plan: form.dataset.plan,
            currency: form.dataset.currency,
            amount_minor: Math.round(amount * 100),
            stripe_price_id: (
              form.elements.namedItem('stripe_price_id') as HTMLInputElement
            ).value.trim(),
            active: (form.elements.namedItem('active') as HTMLInputElement).checked,
          };
          await updatePrice(body);
          show(form, 'Preço salvo.');
        } catch (error) {
          show(form, error instanceof Error ? error.message : 'Falha ao salvar', true);
        } finally {
          button.disabled = false;
        }
      }),
    );
    document.querySelectorAll<HTMLButtonElement>('[data-email-toggle]').forEach((button) =>
      button.addEventListener('click', () => {
        const row = document.getElementById(button.getAttribute('aria-controls') || '');
        if (!row) return;
        const opening = row.classList.contains('hidden');
        document
          .querySelectorAll<HTMLElement>('[data-email-editor-row]')
          .forEach((item) => item.classList.add('hidden'));
        document.querySelectorAll<HTMLButtonElement>('[data-email-toggle]').forEach((item) => {
          item.setAttribute('aria-expanded', 'false');
          item.textContent = 'Editar';
        });
        if (opening) {
          row.classList.remove('hidden');
          button.setAttribute('aria-expanded', 'true');
          button.textContent = 'Fechar';
        }
      }),
    );
    document.querySelectorAll<HTMLFormElement>('[data-api-email-template-form]').forEach((form) => {
      form
        .querySelector<HTMLButtonElement>('[data-email-preview-button]')
        ?.addEventListener('click', () => {
          const html = form.querySelector<HTMLTextAreaElement>('[name=html]')!.value;
          const samples: Record<string, string> = {
            login_url: 'https://vira.ia.br/auth/email?token=exemplo',
            dashboard_url: 'https://vira.ia.br/app',
            site_url: 'https://meu-site.vira.ia.br',
            end_date: '27 de setembro de 2026',
            end_date_pt: '27 de setembro de 2026',
            end_date_en: 'September 27, 2026',
            plan: 'mensal',
            plan_pt: 'mensal',
            plan_en: 'monthly',
            email: 'cliente@exemplo.com',
          };
          const preview = html.replace(
            /{{\s*([a-z_]+)\s*}}/g,
            (_, name: string) => samples[name] ?? '',
          );
          const container = form.querySelector<HTMLElement>('[data-email-preview-container]')!;
          form.querySelector<HTMLIFrameElement>('[data-email-preview]')!.srcdoc = preview;
          container.classList.remove('hidden');
        });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          await updateEmailTemplate({
            key: form.dataset.key || '',
            enabled: form.querySelector<HTMLInputElement>('[name=enabled]')!.checked,
            subject: form.querySelector<HTMLInputElement>('[name=subject]')!.value,
            html: form.querySelector<HTMLTextAreaElement>('[name=html]')!.value,
          });
          const badge = form
            .closest('tr')
            ?.previousElementSibling?.querySelector<HTMLElement>('.badge');
          if (badge) {
            const enabled = form.querySelector<HTMLInputElement>('[name=enabled]')!.checked;
            badge.className = `badge badge-sm badge-outline ${enabled ? 'border-[#d8ae73] text-[#6f4716]' : 'border-[#c8c4bd] text-[#625a51]'}`;
            badge.textContent = enabled ? 'Ativo' : 'Desativado';
          }
          const subject = form
            .closest('tr')
            ?.previousElementSibling?.querySelector<HTMLElement>('[data-email-subject]');
          if (subject) {
            subject.textContent = form.querySelector<HTMLInputElement>('[name=subject]')!.value;
            subject.title = subject.textContent;
          }
          show(form, 'Modelo salvo.');
        } catch (error) {
          show(form, error instanceof Error ? error.message : 'Falha ao salvar', true);
        } finally {
          button.disabled = false;
        }
      });
    });
    document.querySelector('#admin-logout')?.addEventListener('click', async () => {
      await logout();
      location.href = '/';
    });
  </script>
</Base>
