---
import Base from '@frontend/components/Base.astro';
import Brand from '@frontend/components/Brand.astro';
import { adminDashboard } from '@frontend/api/admin/dashboard';

const { admin, url } = Astro.props;
const search = (url.searchParams.get('q') || '').trim().slice(0, 80);

const { settings, prices, customers, domains, audit, counts, domain } =
  await adminDashboard(search);
const byKey = Object.fromEntries(settings.map((row) => [row.key, Boolean(row.value)]));
const required = [
  { label: 'Entrar por e-mail', ready: Boolean(byKey.RESEND_API_KEY && byKey.AUTH_EMAIL_FROM) },
  { label: 'Cobrança', ready: Boolean(byKey.STRIPE_SECRET_KEY && byKey.STRIPE_WEBHOOK_SECRET) },
  {
    label: 'Privacidade',
    ready: Boolean(byKey.PRIVACY_CONTROLLER_NAME && byKey.PRIVACY_CONTACT_EMAIL),
  },
  { label: 'Domínios próprios', ready: Boolean(byKey.CLOUDFLARE_API_TOKEN) },
  { label: 'Métricas', ready: Boolean(byKey.CLOUDFLARE_ANALYTICS_TOKEN) },
];
const groups = [
  { title: 'Identidade e acesso', keys: ['GOOGLE_CLIENT_ID', 'RESEND_API_KEY', 'AUTH_EMAIL_FROM'] },
  { title: 'Cobrança', keys: ['STRIPE_SECRET_KEY', 'STRIPE_WEBHOOK_SECRET'] },
  { title: 'Domínios e métricas', keys: ['CLOUDFLARE_API_TOKEN', 'CLOUDFLARE_ANALYTICS_TOKEN'] },
  { title: 'Privacidade', keys: ['PRIVACY_CONTROLLER_NAME', 'PRIVACY_CONTACT_EMAIL'] },
];
const labels: Record<string, string> = {
  GOOGLE_CLIENT_ID: 'Client ID do Google',
  RESEND_API_KEY: 'Chave de envio Resend',
  AUTH_EMAIL_FROM: 'E-mail remetente de acesso',
  STRIPE_SECRET_KEY: 'Chave secreta Stripe',
  STRIPE_WEBHOOK_SECRET: 'Segredo do webhook Stripe',
  CLOUDFLARE_API_TOKEN: 'Token Cloudflare para domínios',
  CLOUDFLARE_ANALYTICS_TOKEN: 'Token Cloudflare para métricas',
  PRIVACY_CONTROLLER_NAME: 'Responsável pelo Vira',
  PRIVACY_CONTACT_EMAIL: 'E-mail de privacidade',
};
const planName: Record<string, string> = {
  monthly: 'Mensal',
  yearly: 'Anual',
  lifetime: 'Vitalício',
};
const date = (time: number | null) =>
  time ? new Date(time * 1000).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : '—';
---

<Base title="Administração · Vira" noindex>
  <div class="min-h-screen bg-[#050505] text-[#f5f2ec]">
    <header class="flex items-center justify-between gap-5 border-b border-[#2d2a25] bg-[#0c0c0b] px-5 py-4 sm:px-8">
      <Brand />
      <div class="flex items-center gap-4 text-sm text-[#aaa69f]">
        <span>Administração</span>
        <button id="admin-logout" class="btn btn-ghost btn-sm" type="button">
          Sair
        </button>
      </div>
    </header>
    <div class="mx-auto grid max-w-[1480px] grid-cols-[minmax(0,1fr)] lg:grid-cols-[230px_minmax(0,1fr)]">
      <aside class="min-w-0 border-b border-[#2d2a25] px-5 py-6 lg:sticky lg:top-0 lg:h-screen lg:border-r lg:border-b-0 lg:px-6 lg:py-10">
        <p class="mb-5 font-mono text-[11px] uppercase tracking-[0.18em] text-[#d6a85f]">
          Vira / Admin
        </p>
        <nav
          class="flex gap-1 overflow-x-auto whitespace-nowrap lg:flex-col lg:overflow-visible"
          aria-label="Seções do painel"
        >
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#eee8dc] transition-colors hover:bg-[#211b14]"
            href="#visao"
          >
            ↗ &nbsp;Visão geral
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#aaa69f] transition-colors hover:bg-[#211b14] hover:text-white"
            href="#precos"
          >
            ↗ &nbsp;Preços
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#aaa69f] transition-colors hover:bg-[#211b14] hover:text-white"
            href="#configuracoes"
          >
            ↗ &nbsp;Configurações
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#aaa69f] transition-colors hover:bg-[#211b14] hover:text-white"
            href="#clientes"
          >
            ↗ &nbsp;Clientes
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#aaa69f] transition-colors hover:bg-[#211b14] hover:text-white"
            href="#dominios"
          >
            ↗ &nbsp;Domínios
          </a>
          <a
            class="rounded-lg px-3 py-2.5 text-sm text-[#aaa69f] transition-colors hover:bg-[#211b14] hover:text-white"
            href="#atividade"
          >
            ↗ &nbsp;Atividade
          </a>
        </nav>
      </aside>
      <main class="min-w-0 px-5 pt-10 pb-24 sm:px-8 lg:px-10">
        <div class="relative mb-10 min-h-[260px] overflow-hidden rounded-xl border border-[#38322a] bg-[#100d09] p-7 sm:p-9 [&_h1]:my-3 [&_h1]:font-[Outfit] [&_h1]:text-[clamp(2.4rem,5vw,4.4rem)] [&_h1]:leading-none [&_h1]:text-[#f5f2ec] [&_p]:max-w-[56ch] [&_p]:text-[#aaa69f]">
          <img
            src="/vira-hero.webp"
            width="1586"
            height="992"
            alt=""
            class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-1/2 object-cover object-center opacity-55 md:block"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#100d09] via-[#100d09] to-transparent"></div>
          <div class="relative z-10 max-w-[760px]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#d6a85f]">
              Operação do Vira
            </span>
            <h1>Seu negócio, em ordem.</h1>
            <p>Configure o lançamento, acompanhe clientes e mantenha os planos atualizados.</p>
            <p class="mt-7 text-sm">
              Acesso autorizado · <strong class="text-[#eee8dc]">{admin.email}</strong>
            </p>
          </div>
        </div>

        <section
          id="visao"
          class="mb-20 scroll-mt-8 border-t border-[#2d2a25] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#f5f2ec] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#aaa69f]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#d6a85f]">
              Visão geral
            </span>
            <h2>Estado da operação</h2>
          </div>
          <div class="grid gap-3 sm:grid-cols-3 [&_div]:flex [&_div]:min-h-36 [&_div]:flex-col [&_div]:justify-between [&_div]:rounded-xl [&_div]:border [&_div]:border-[#3a3630] [&_div]:bg-[#151310] [&_div]:p-5 [&_strong]:font-[Outfit] [&_strong]:text-5xl [&_strong]:font-medium [&_strong]:tracking-tight [&_strong]:text-[#eee8dc] [&_span]:font-mono [&_span]:text-xs [&_span]:uppercase [&_span]:tracking-wide [&_span]:text-[#8f8a83]">
            <div>
              <strong>{counts.users}</strong>
              <span>clientes</span>
            </div>
            <div>
              <strong>{counts.published}</strong>
              <span>páginas publicadas</span>
            </div>
            <div>
              <strong>{counts.domains}</strong>
              <span>domínios conectados</span>
            </div>
          </div>
          <div class="mt-4 grid items-center gap-7 rounded-xl border border-[#2d2a25] bg-[#111110] p-7 md:grid-cols-[1fr_1.2fr] [&_h3]:mb-2 [&_h3]:text-xl [&_h3]:text-[#f5f2ec] [&_p]:leading-relaxed [&_p]:text-[#aaa69f] [&_li]:flex [&_li]:items-center [&_li]:gap-2.5 [&_li]:border-b [&_li]:border-[#2d2a25] [&_li]:py-2 [&_li]:text-sm [&_li_strong]:ml-auto [&_li_strong]:text-xs [&_li_strong]:text-[#aaa69f]">
            <div>
              <h3>Antes de abrir as vendas</h3>
              <p>
                Estes itens dependem das configurações abaixo. O DNS e o Cloudflare for SaaS também
                devem estar ativos.
              </p>
            </div>
            <ul>
              {required.map((item) => (
                <li>
                  <span
                    class={
                      item.ready
                        ? 'h-2.5 w-2.5 flex-none rounded-full bg-[#7ddcb7]'
                        : 'h-2.5 w-2.5 flex-none rounded-full bg-[#d6a85f]'
                    }
                  ></span>
                  {item.label}
                  <strong>{item.ready ? 'Pronto' : 'Pendente'}</strong>
                </li>
              ))}
            </ul>
          </div>
        </section>
        <section
          id="precos"
          class="mb-20 scroll-mt-8 border-t border-[#2d2a25] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#f5f2ec] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#aaa69f]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#d6a85f]">
              Cobrança
            </span>
            <h2>Preços e planos</h2>
            <p>
              Ao ativar um preço, o Vira confere o valor, a moeda e a periodicidade na Stripe. Use
              um Price ID já criado na Stripe.
            </p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {prices.map((row) => (
              <form
                class="card rounded-xl border border-[#34312b] bg-[#111110] p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#f5f2ec] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold"
                data-api-price-form
                data-plan={row.plan}
                data-currency={row.currency}
              >
                <div class="flex items-start justify-between [&_span]:badge [&_span]:badge-secondary">
                  <h3>{planName[row.plan]}</h3>
                  <span>{row.currency.toUpperCase()}</span>
                </div>
                <label>
                  Valor em {row.currency.toUpperCase()}
                  <input
                    class="input input-bordered w-full"
                    name="amount"
                    type="number"
                    min="0"
                    max="1000000"
                    step="0.01"
                    value={row.amount_minor === null ? '' : (row.amount_minor / 100).toFixed(2)}
                    placeholder="0,00"
                    required
                  />
                </label>
                <label>
                  Price ID da Stripe
                  <input
                    class="input input-bordered w-full"
                    name="stripe_price_id"
                    value={row.stripe_price_id ?? ''}
                    placeholder="price_..."
                    autocomplete="off"
                  />
                </label>
                <label class="my-4 flex! items-center gap-2 [&_input]:checkbox [&_input]:checkbox-primary">
                  <input name="active" type="checkbox" checked={Boolean(row.active)} /> Disponível
                  para compra
                </label>
                <button
                  class="btn btn-primary rounded-xl border-0 font-bold shadow-none"
                  type="submit"
                >
                  Salvar preço
                </button>
                <p
                  class="mt-2 text-sm text-success [hidden]:hidden"
                  data-api-status
                  role="status"
                  hidden
                ></p>
              </form>
            ))}
          </div>
        </section>
        <section
          id="configuracoes"
          class="mb-20 scroll-mt-8 border-t border-[#2d2a25] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#f5f2ec] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#aaa69f]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#d6a85f]">
              Serviços
            </span>
            <h2>Configurações</h2>
            <p>
              Os segredos ficam criptografados no banco. Depois de salvos, apenas o estado
              “configurado” aparece aqui.
            </p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {groups.map((group) => (
              <div class="card rounded-xl border border-[#34312b] bg-[#111110] p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#f5f2ec] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold">
                <h3>{group.title}</h3>
                {group.keys.map((key) => {
                  const row = settings.find((item) => item.key === key);
                  if (!row) return null;
                  return (
                    <form
                      class="border-t border-[#2d2a25] py-3 [&_label]:flex [&_label]:justify-between [&_label]:gap-2.5"
                      data-key={key}
                      data-secret={Boolean(row.encrypted)}
                      data-api-setting-form
                    >
                      <label for={`setting-${key}`}>
                        {labels[key]}{' '}
                        <span
                          class={row.value ? 'text-xs text-success' : 'text-xs text-error'}
                          data-api-config-state
                        >
                          {row.value ? 'Configurado' : 'Pendente'}
                        </span>
                      </label>
                      <div class="flex gap-2 [&_input]:min-w-0 [&_input]:flex-1">
                        <input
                          class="input input-bordered w-full"
                          id={`setting-${key}`}
                          name="value"
                          type={
                            row.encrypted
                              ? 'password'
                              : key === 'PRIVACY_CONTACT_EMAIL'
                                ? 'email'
                                : 'text'
                          }
                          value={row.encrypted ? '' : row.value}
                          placeholder={
                            row.encrypted && row.value ? 'Novo valor para substituir' : ''
                          }
                          autocomplete="off"
                        />
                        <button class="btn btn-outline" type="submit">
                          Salvar
                        </button>
                      </div>
                      <p
                        class="mt-2 text-sm text-success [hidden]:hidden"
                        data-api-status
                        role="status"
                        hidden
                      ></p>
                    </form>
                  );
                })}
              </div>
            ))}
          </div>
        </section>
        <section
          id="clientes"
          class="mb-20 scroll-mt-8 border-t border-[#2d2a25] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#f5f2ec] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#aaa69f]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#d6a85f]">
              Contas
            </span>
            <h2>Clientes e assinaturas</h2>
            <p>
              Busque por e-mail ou endereço da página. Os planos mudam apenas pelos eventos de
              cobrança da Stripe.
            </p>
          </div>
          <form
            class="mb-3.5 flex gap-2 [&_input]:w-full [&_input]:max-w-[360px]"
            action="/admin#clientes"
            method="get"
          >
            <input
              class="input input-bordered w-full"
              name="q"
              type="search"
              value={search}
              placeholder="E-mail ou endereço da página"
              maxlength="80"
            />
            <button class="btn btn-primary" type="submit">
              Buscar
            </button>
          </form>
          <div class="card rounded-xl border border-[#34312b] bg-[#111110] p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#f5f2ec] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold overflow-auto [&_table]:table [&_table]:w-full [&_th]:text-xs [&_th]:uppercase [&_th]:text-[#aaa69f] [&_td]:whitespace-nowrap [&_td_small]:text-[#aaa69f]">
            <table class="table">
              <thead>
                <tr>
                  <th>E-mail</th>
                  <th>Plano</th>
                  <th>Acesso até</th>
                  <th>Cadastro</th>
                  <th>Página</th>
                  <th>Assinatura</th>
                </tr>
              </thead>
              <tbody>
                {customers.map((row) => (
                  <tr>
                    <td>{row.email ?? 'Conta antiga'}</td>
                    <td>{row.plan}</td>
                    <td>
                      {date(row.access_until ?? (row.plan === 'trial' ? row.trial_ends_at : null))}
                    </td>
                    <td>{date(row.created_at)}</td>
                    <td>
                      <a
                        href={`https://${row.slug}.${domain}/`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {row.slug}
                      </a>
                      <small>{row.published_at ? 'Publicada' : 'Rascunho'}</small>
                    </td>
                    <td>
                      <code>{row.stripe_subscription_id ?? '—'}</code>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {customers.length === 0 && (
              <p class="my-2 text-[#aaa69f]">
                {search
                  ? 'Nenhuma conta corresponde à busca.'
                  : 'Nenhum cliente ainda. As contas aparecerão aqui após o primeiro cadastro.'}
              </p>
            )}
          </div>
        </section>
        <section
          id="dominios"
          class="mb-20 scroll-mt-8 border-t border-[#2d2a25] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#f5f2ec] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#aaa69f]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#d6a85f]">
              Publicação
            </span>
            <h2>Domínios dos clientes</h2>
            <p>Acompanhe a ativação do hostname e do certificado TLS.</p>
          </div>
          <div class="card rounded-xl border border-[#34312b] bg-[#111110] p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#f5f2ec] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold overflow-auto [&_table]:table [&_table]:w-full [&_th]:text-xs [&_th]:uppercase [&_th]:text-[#aaa69f] [&_td]:whitespace-nowrap [&_td_small]:text-[#aaa69f]">
            <table class="table">
              <thead>
                <tr>
                  <th>Domínio</th>
                  <th>Cliente</th>
                  <th>Hostname</th>
                  <th>TLS</th>
                  <th>Adicionado</th>
                </tr>
              </thead>
              <tbody>
                {domains.map((row) => (
                  <tr>
                    <td>{row.hostname}</td>
                    <td>{row.email ?? 'Conta antiga'}</td>
                    <td>{row.status}</td>
                    <td>{row.ssl_status}</td>
                    <td>{date(row.created_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {domains.length === 0 && (
              <p class="my-2 text-[#aaa69f]">Nenhum domínio de cliente conectado ainda.</p>
            )}
          </div>
        </section>
        <section
          id="atividade"
          class="mb-20 scroll-mt-8 border-t border-[#2d2a25] pt-9 first:border-t-0 first:pt-0"
        >
          <div class="mb-5 [&_h2]:my-1 [&_h2]:text-3xl [&_h2]:text-[#f5f2ec] [&_p]:max-w-[68ch] [&_p]:leading-relaxed [&_p]:text-[#aaa69f]">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.15em] text-[#d6a85f]">
              Segurança
            </span>
            <h2>Atividade administrativa</h2>
          </div>
          <div class="card rounded-xl border border-[#34312b] bg-[#111110] p-4 shadow-none sm:p-6 [&_h3]:mb-4 [&_h3]:text-xl [&_h3]:text-[#f5f2ec] [&_label]:mt-3 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-bold [&>div]:flex [&>div]:items-center [&>div]:gap-5 [&>div]:border-b [&>div]:border-[#2d2a25] [&>div]:py-3 [&>div]:text-sm [&_span]:min-w-20 [&_span]:text-[#aaa69f] [&_code]:ml-auto [&_code]:text-[#f5f2ec]">
            {audit.length ? (
              audit.map((item) => (
                <div>
                  <span>{date(item.created_at)}</span>
                  <strong>
                    {item.action === 'update_price'
                      ? 'Preço alterado'
                      : item.action === 'clear_setting'
                        ? 'Configuração limpa'
                        : 'Configuração alterada'}
                  </strong>
                  <code>{item.target}</code>
                </div>
              ))
            ) : (
              <p class="my-2 text-[#aaa69f]">Nenhuma alteração registrada ainda.</p>
            )}
          </div>
        </section>
      </main>
    </div>
  </div>
  <script>
    import { updateSetting } from '@frontend/api/admin/update-setting';
    import { updatePrice } from '@frontend/api/admin/update-price';
    import { logout } from '@frontend/api/auth/logout';
    const show = (form: HTMLFormElement, message: string, error = false) => {
      const node = form.querySelector<HTMLElement>('[data-api-status]')!;
      node.textContent = message;
      node.hidden = false;
      node.classList.toggle('text-error', error);
      node.classList.toggle('text-success', !error);
    };
    document.querySelectorAll<HTMLFormElement>('[data-api-setting-form]').forEach((form) =>
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          const value = form.querySelector<HTMLInputElement>('[name=value]')!.value;
          if (!value.trim()) throw new Error('Informe um valor.');
          await updateSetting(form.dataset.key || '', value);
          if (form.dataset.secret === 'true')
            form.querySelector<HTMLInputElement>('[name=value]')!.value = '';
          const badge = form.querySelector<HTMLElement>('[data-api-config-state]')!;
          badge.className = 'text-xs text-success';
          badge.textContent = 'Configurado';
          show(form, 'Salvo.');
        } catch (error) {
          show(form, error instanceof Error ? error.message : 'Falha ao salvar', true);
        } finally {
          button.disabled = false;
        }
      }),
    );
    document.querySelectorAll<HTMLFormElement>('[data-api-price-form]').forEach((form) =>
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        try {
          const input = form.querySelector<HTMLInputElement>('[name=amount]')!;
          const amount = Number(input.value);
          if (!Number.isFinite(amount) || !Number.isInteger(amount * 100))
            throw new Error('Informe um valor com até duas casas decimais.');
          const body = {
            plan: form.dataset.plan,
            currency: form.dataset.currency,
            amount_minor: Math.round(amount * 100),
            stripe_price_id: form
              .querySelector<HTMLInputElement>('[name=stripe_price_id]')!
              .value.trim(),
            active: form.querySelector<HTMLInputElement>('[name=active]')!.checked,
          };
          await updatePrice(body);
          show(form, 'Preço salvo.');
        } catch (error) {
          show(form, error instanceof Error ? error.message : 'Falha ao salvar', true);
        } finally {
          button.disabled = false;
        }
      }),
    );
    document.querySelector('#admin-logout')?.addEventListener('click', async () => {
      await logout();
      location.href = '/';
    });
  </script>
</Base>
