---
interface Props {
  appearance?: 'dark' | 'light';
}
const { appearance = 'dark' } = Astro.props;
const bg = appearance === 'light' ? 'bg-white' : 'bg-black';
const bar = appearance === 'light' ? 'bg-[#efe8dc]' : 'bg-[#24211c]';
const card = appearance === 'light' ? 'bg-[#f6f1e8]' : 'bg-[#181613]';
---

<div
  data-route-skeleton
  hidden
  aria-hidden="true"
  class:list={['fixed inset-0 z-[70] overflow-hidden', bg]}
>
  <div class="mx-auto max-w-[1380px] px-5 py-6 sm:px-8">
    <div class="flex items-center justify-between gap-3">
      <div class:list={['h-8 w-28 animate-pulse rounded-lg', bar]}></div>
      <div class="hidden gap-2 md:flex">
        {Array.from({ length: 6 }).map(() => (
          <div class:list={['h-8 w-20 animate-pulse rounded-full', card]} />
        ))}
      </div>
      <div class:list={['h-9 w-9 animate-pulse rounded-full', bar]}></div>
    </div>
    <div class:list={['mt-10 h-9 w-56 animate-pulse rounded-lg', bar]}></div>
    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {Array.from({ length: 8 }).map(() => (
        <div class:list={['h-24 animate-pulse rounded-2xl', card]} />
      ))}
    </div>
    <div class="mt-8 space-y-3">
      {Array.from({ length: 8 }).map(() => (
        <div class:list={['h-11 animate-pulse rounded-xl', card]} />
      ))}
    </div>
  </div>
</div>
