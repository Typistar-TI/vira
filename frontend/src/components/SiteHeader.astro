---
import Brand from '@frontend/components/Brand.astro';
import Sheet from '@frontend/components/Sheet.astro';
import MobileNavigation from '@frontend/components/MobileNavigation.astro';

interface Props {
  lang: 'pt' | 'en';
  signedIn: boolean;
  dashboardHref: string;
  hasAdmin?: boolean;
  hasUser?: boolean;
}
const { lang, signedIn, dashboardHref, hasAdmin = false, hasUser = false } = Astro.props;
const bothSessions = hasAdmin && hasUser;
const en = lang === 'en';
const links = [
  {
    href: '/#como-funciona',
    label: en ? 'How it works' : 'Como funciona',
    icon: '<path d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/>',
  },
  {
    href: '/#vitrine',
    label: en ? 'Projects' : 'Projetos',
    icon: '<path d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z"/>',
  },
  {
    href: '/#planos',
    label: en ? 'Plans' : 'Planos',
    icon: '<path d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/><path d="M6 6h.008v.008H6V6Z"/>',
  },
];
---

<header class="relative z-20 mx-auto flex w-full max-w-[1380px] shrink-0 items-center justify-between gap-4 px-5 pt-5 sm:px-8 sm:pt-7 md:grid md:grid-cols-[1fr_auto_1fr]">
  <div class="flex w-fit min-w-0 flex-col items-center justify-center md:justify-self-start">
    <Brand href={signedIn ? dashboardHref : en ? '/en' : '/'} tone="light" />
    <span class="mt-0.5 text-center text-[11px] leading-tight text-[#8b5b1e] sm:mt-1 sm:text-xs">
      {en ? 'Vira your idea out there.' : 'Vira sua ideia no mundo.'}
    </span>
  </div>
  <nav
    class="hidden h-10 items-center gap-7 justify-self-center rounded-full border border-[#d8ae73] bg-white/95 px-6 text-sm text-[#605448] shadow-[0_8px_30px_-22px_rgba(131,85,21,0.35)] backdrop-blur-md md:flex"
    aria-label={en ? 'Main navigation' : 'Navegação principal'}
  >
    {links.map((link) => (
      <a class="flex items-center gap-1.5 transition-colors hover:text-[#9b6823]" href={link.href}>
        <svg
          class="h-4 w-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={link.icon}
        />
        {link.label}
      </a>
    ))}
  </nav>
  <div class="flex shrink-0 items-center gap-2 sm:gap-4 md:justify-self-end">
    <div class="md:hidden">
      <MobileNavigation
        label={en ? 'Navigation' : 'Navegação'}
        lang={en ? 'en' : 'pt'}
        iconOnly
        links={links}
      />
    </div>
    {signedIn ? (
      bothSessions ? (
        <button
          type="button"
          data-dashboard-open
          aria-haspopup="dialog"
          class="btn rounded-full border border-[#b88333] bg-white px-4 font-semibold text-[#6f4716] shadow-none transition-colors hover:border-[#9b6823] hover:bg-[#fff9ef] sm:px-5"
        >
          Dashboard
        </button>
      ) : (
        <a
          href={dashboardHref}
          class="btn rounded-full border border-[#b88333] bg-white px-4 font-semibold text-[#6f4716] shadow-none transition-colors hover:border-[#9b6823] hover:bg-[#fff9ef] sm:px-5"
        >
          Dashboard
          <span class="hidden sm:inline" aria-hidden="true">
            ↗
          </span>
        </a>
      )
    ) : (
      <a
        href="/login?signup=1"
        class="btn rounded-full border border-[#b88333] bg-white px-4 font-semibold text-[#6f4716] shadow-none transition-colors hover:border-[#9b6823] hover:bg-[#fff9ef] sm:px-5"
      >
        <span class="sm:hidden">{en ? 'Start' : 'Começar'}</span>
        <span class="hidden sm:inline">{en ? 'Start free' : 'Começar grátis'}</span>
        <span class="hidden sm:inline" aria-hidden="true">
          ↗
        </span>
      </a>
    )}
  </div>

  {bothSessions && (
    <Sheet
      id="dashboard-sheet"
      label={en ? 'Where do you want to go?' : 'Para onde você quer ir?'}
      closeLabel={en ? 'Close' : 'Fechar'}
      centered
    >
      <p class="mb-5 text-sm text-[#625a51]">
        {en
          ? 'You are signed in as a customer and as an administrator.'
          : 'Você está logado como cliente e como administrador.'}
      </p>
      <div class="flex flex-col gap-3">
        <a
          href="/app"
          class="btn h-12 w-full rounded-full border border-[#b88333] bg-white font-semibold text-[#6f4716] shadow-none hover:border-[#9b6823] hover:bg-[#fff9ef]"
        >
          {en ? 'Customer dashboard' : 'Painel do cliente'}
        </a>
        <a
          href="/admin"
          class="btn h-12 w-full rounded-full border border-[#a66f27] bg-[#b88333] font-semibold text-white shadow-none hover:bg-[#9b6823]"
        >
          {en ? 'Admin dashboard' : 'Painel admin'}
        </a>
      </div>
    </Sheet>
  )}
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    document
      .querySelectorAll<HTMLElement>('[data-dashboard-open]')
      .forEach((button) =>
        button.addEventListener('click', () =>
          document.querySelector<HTMLDialogElement>('#dashboard-sheet')?.showModal(),
        ),
      );
  });
</script>
