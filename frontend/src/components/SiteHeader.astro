---
import Brand from '@frontend/components/Brand.astro';
import MobileNavigation from '@frontend/components/MobileNavigation.astro';

interface Props {
  lang: 'pt' | 'en';
  signedIn: boolean;
  dashboardHref: string;
  hasAdmin?: boolean;
  hasUser?: boolean;
}
const { lang, signedIn, dashboardHref, hasAdmin = false, hasUser = false } = Astro.props;
const bothSessions = hasAdmin && hasUser;
const en = lang === 'en';
const links = [
  { href: '/#como-funciona', label: en ? 'How it works' : 'Como funciona' },
  { href: '/#vitrine', label: en ? 'Projects' : 'Projetos' },
  { href: '/#planos', label: en ? 'Plans' : 'Planos' },
];
---

<header class="relative z-20 mx-auto flex w-full max-w-[1380px] shrink-0 items-center justify-between gap-4 px-5 pt-5 sm:px-8 sm:pt-7 md:grid md:grid-cols-[1fr_auto_1fr]">
  <div class="flex min-w-0 flex-col justify-center md:justify-self-start">
    <Brand href={signedIn ? dashboardHref : en ? '/en' : '/'} tone="light" />
    <span class="mt-0.5 text-[11px] leading-tight text-[#8b5b1e] sm:mt-1 sm:text-xs">
      {en ? 'Vira your idea out there.' : 'Vira sua ideia no mundo.'}
    </span>
  </div>
  <nav
    class="hidden h-10 items-center gap-7 justify-self-center rounded-full border border-[#d8ae73] bg-white/95 px-6 text-sm text-[#605448] shadow-[0_8px_30px_-22px_rgba(131,85,21,0.35)] backdrop-blur-md md:flex"
    aria-label={en ? 'Main navigation' : 'Navegação principal'}
  >
    {links.map((link) => (
      <a class="transition-colors hover:text-[#9b6823]" href={link.href}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="flex shrink-0 items-center gap-2 sm:gap-4 md:justify-self-end">
    <div class="md:hidden">
      <MobileNavigation
        label={en ? 'Navigation' : 'Navegação'}
        lang={en ? 'en' : 'pt'}
        iconOnly
        links={links}
      />
    </div>
    {signedIn ? (
      bothSessions ? (
        <button
          type="button"
          data-dashboard-open
          aria-haspopup="dialog"
          class="btn h-10 min-h-10 rounded-full border border-[#b88333] bg-white px-4 font-semibold text-[#6f4716] shadow-none transition-colors hover:border-[#9b6823] hover:bg-[#fff9ef] sm:px-5"
        >
          Dashboard
        </button>
      ) : (
        <a
          href={dashboardHref}
          class="btn h-10 min-h-10 rounded-full border border-[#b88333] bg-white px-4 font-semibold text-[#6f4716] shadow-none transition-colors hover:border-[#9b6823] hover:bg-[#fff9ef] sm:px-5"
        >
          Dashboard
          <span class="hidden sm:inline" aria-hidden="true">
            ↗
          </span>
        </a>
      )
    ) : (
      <a
        href="/login?signup=1"
        class="btn h-10 min-h-10 rounded-full border border-[#b88333] bg-white px-4 font-semibold text-[#6f4716] shadow-none transition-colors hover:border-[#9b6823] hover:bg-[#fff9ef] sm:px-5"
      >
        <span class="sm:hidden">{en ? 'Start' : 'Começar'}</span>
        <span class="hidden sm:inline">{en ? 'Start free' : 'Começar grátis'}</span>
        <span class="hidden sm:inline" aria-hidden="true">
          ↗
        </span>
      </a>
    )}
  </div>

  {bothSessions && (
    <dialog
      data-dashboard-dialog
      class="modal modal-bottom sm:modal-middle"
      aria-label={en ? 'Choose dashboard' : 'Escolher painel'}
    >
      <div class="modal-box max-w-md rounded-t-[2rem] border-t border-[#d8ae73] bg-white px-6 pt-6 pb-6 text-[#17130d] sm:rounded-3xl sm:border">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 class="font-['Outfit',sans-serif] text-xl font-medium">
            {en ? 'Where do you want to go?' : 'Para onde você quer ir?'}
          </h2>
          <button
            type="button"
            data-dashboard-close
            class="btn btn-ghost btn-circle btn-sm"
            aria-label={en ? 'Close' : 'Fechar'}
          >
            ×
          </button>
        </div>
        <p class="mb-5 text-sm text-[#625a51]">
          {en
            ? 'You are signed in as a customer and as an administrator.'
            : 'Você está logado como cliente e como administrador.'}
        </p>
        <div class="flex flex-col gap-3">
          <a
            href="/app"
            class="btn h-12 w-full rounded-full border border-[#b88333] bg-white font-semibold text-[#6f4716] shadow-none hover:border-[#9b6823] hover:bg-[#fff9ef]"
          >
            {en ? 'Customer dashboard' : 'Painel do cliente'}
          </a>
          <a
            href="/admin"
            class="btn h-12 w-full rounded-full border border-[#a66f27] bg-[#b88333] font-semibold text-white shadow-none hover:bg-[#9b6823]"
          >
            {en ? 'Admin dashboard' : 'Painel admin'}
          </a>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button aria-label={en ? 'Close' : 'Fechar'}></button>
      </form>
    </dialog>
  )}
</header>

<script>
  const dashboardDialog = document.querySelector<HTMLDialogElement>('[data-dashboard-dialog]');
  document
    .querySelectorAll<HTMLElement>('[data-dashboard-open]')
    .forEach((button) => button.addEventListener('click', () => dashboardDialog?.showModal()));
  dashboardDialog
    ?.querySelector('[data-dashboard-close]')
    ?.addEventListener('click', () => dashboardDialog?.close());
</script>
