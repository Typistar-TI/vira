---
import Brand from '@frontend/components/Brand.astro';
import MobileNavigation from '@frontend/components/MobileNavigation.astro';

interface Props {
  lang: 'pt' | 'en';
  signedIn: boolean;
  dashboardHref: string;
}
const { lang, signedIn, dashboardHref } = Astro.props;
const en = lang === 'en';
const links = [
  { href: '/#como-funciona', label: en ? 'How it works' : 'Como funciona' },
  { href: '/#vitrine', label: en ? 'Projects' : 'Projetos' },
  { href: '/#planos', label: en ? 'Plans' : 'Planos' },
];
---

<header class="relative z-20 mx-auto flex w-full max-w-[1380px] shrink-0 items-center justify-between gap-4 px-5 pt-5 sm:px-8 sm:pt-7 md:grid md:grid-cols-[1fr_auto_1fr]">
  <div class="flex min-w-0 flex-col justify-center md:justify-self-start">
    <Brand href={signedIn ? dashboardHref : en ? '/en' : '/'} tone="light" />
    <span class="mt-0.5 text-[11px] leading-tight text-[#8b5b1e] sm:mt-1 sm:text-xs">
      {en ? 'Vira your idea out there.' : 'Vira sua ideia no mundo.'}
    </span>
  </div>
  <nav
    class="hidden h-10 items-center gap-7 justify-self-center rounded-full border border-[#d8ae73] bg-white/95 px-6 text-sm text-[#605448] shadow-[0_8px_30px_-22px_rgba(131,85,21,0.35)] backdrop-blur-md md:flex"
    aria-label={en ? 'Main navigation' : 'Navegação principal'}
  >
    {links.map((link) => (
      <a class="transition-colors hover:text-[#9b6823]" href={link.href}>
        {link.label}
      </a>
    ))}
  </nav>
  <div class="flex shrink-0 items-center gap-2 sm:gap-4 md:justify-self-end">
    <div class="md:hidden">
      <MobileNavigation
        label={en ? 'Navigation' : 'Navegação'}
        lang={en ? 'en' : 'pt'}
        iconOnly
        links={links}
      />
    </div>
    <a
      href={dashboardHref}
      class="btn h-10 min-h-10 rounded-full border border-[#b88333] bg-white px-4 font-semibold text-[#6f4716] shadow-none transition-colors hover:border-[#9b6823] hover:bg-[#fff9ef] sm:px-5"
    >
      <span class="sm:hidden">
        {signedIn ? (en ? 'Dashboard' : 'Painel') : en ? 'Start' : 'Começar'}
      </span>
      <span class="hidden sm:inline">
        {signedIn ? (en ? 'Open dashboard' : 'Abrir painel') : en ? 'Start free' : 'Começar grátis'}
      </span>
      <span class="hidden sm:inline" aria-hidden="true">
        ↗
      </span>
    </a>
  </div>
</header>
