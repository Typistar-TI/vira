<div
  id="vira-toasts"
  class="pointer-events-none fixed bottom-0 left-1/2 z-[100] flex w-max max-w-[min(34rem,calc(100vw_-_2rem))] -translate-x-1/2 flex-col items-center gap-3 pb-[max(1rem,env(safe-area-inset-bottom))]"
  aria-live="polite"
  aria-atomic="false"
></div>

<script>
  const dismissals = new WeakMap<Element, () => void>();
  document.addEventListener('vira:toast', (event) => {
    const { message, kind } = (event as CustomEvent<{ message: string; kind: string }>).detail;
    if (!message) return;
    const container = document.querySelector<HTMLElement>('#vira-toasts');
    if (!container) return;
    while (container.children.length >= 3) {
      const oldest = container.firstElementChild!;
      const dismiss = dismissals.get(oldest);
      if (dismiss) dismiss();
      else oldest.remove();
    }
    const palette: Record<string, { wrapper: string; badge: string; icon: string }> = {
      success: {
        wrapper: 'border-[#e0b878] bg-[#fff9ef] text-[#6f4716]',
        badge: 'bg-[#f6e6c8] text-[#b88333]',
        icon: '<path d="m4.5 12.75 6 6 9-13.5" />',
      },
      error: {
        wrapper: 'border-[#e8bdba] bg-[#fff4f3] text-[#812929]',
        badge: 'bg-[#f7dcdc] text-[#b73535]',
        icon: '<path d="M12 9v3.75m9.303 3.376c.866 1.5-.217 3.374-1.948 3.374H4.645c-1.73 0-2.813-1.874-1.948-3.374L10.051 3.378c.866-1.5 3.032-1.5 3.898 0L21.303 16.126ZM12 15.75h.007v.008H12v-.008Z" />',
      },
      info: {
        wrapper: 'border-[#d8ae73] bg-white text-[#5b4428]',
        badge: 'bg-[#f3e9d7] text-[#9b6823]',
        icon: '<path d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />',
      },
    };
    const style = palette[kind] ?? palette.info;
    const toast = document.createElement('div');
    toast.className = [
      'pointer-events-auto',
      'flex items-center gap-3',
      'w-fit max-w-full min-w-0 touch-none select-none',
      'rounded-2xl border px-4 py-3 text-sm leading-snug',
      'shadow-[0_18px_45px_-18px_rgba(32,23,10,0.32)]',
      style.wrapper,
    ].join(' ');
    toast.setAttribute('role', kind === 'error' ? 'alert' : 'status');
    const badge = document.createElement('span');
    badge.className = `grid h-6 w-6 shrink-0 place-items-center rounded-full ${style.badge}`;
    badge.setAttribute('aria-hidden', 'true');
    badge.innerHTML = `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${style.icon}</svg>`;
    const text = document.createElement('span');
    text.className = 'min-w-0 flex-1 whitespace-pre-wrap [overflow-wrap:anywhere]';
    text.textContent = message;
    const close = document.createElement('button');
    close.type = 'button';
    close.className =
      'ml-auto -mr-1 shrink-0 rounded-full p-1 text-current opacity-55 transition-opacity duration-300 hover:opacity-100';
    close.setAttribute(
      'aria-label',
      document.documentElement.lang === 'en' ? 'Dismiss notification' : 'Fechar aviso',
    );
    close.innerHTML =
      '<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>';
    const lifetime = kind === 'error' ? 7000 : 4500;
    let timer: number;
    let dismissed = false;
    let drag: { id: number; x: number; y: number } | undefined;
    let dx = 0;
    let dy = 0;
    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dismiss = (animate = false) => {
      if (dismissed) return;
      dismissed = true;
      clearTimeout(timer);
      drag = undefined;
      dismissals.delete(toast);
      if (!animate || reducedMotion()) {
        toast.remove();
        return;
      }
      toast.style.pointerEvents = 'none';
      toast.style.transition = 'transform 160ms ease-out, opacity 160ms ease-out';
      toast.style.opacity = '0';
      const distance = Math.hypot(dx, dy);
      toast.style.transform = distance
        ? `translate(${dx + (dx / distance) * 64}px, ${dy + (dy / distance) * 64}px)`
        : 'translateY(12px)';
      timer = window.setTimeout(() => toast.remove(), 160);
    };
    const schedule = () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => dismiss(true), lifetime);
    };
    const resetDrag = () => {
      if (dismissed) return;
      drag = undefined;
      dx = dy = 0;
      toast.style.transition = reducedMotion()
        ? 'none'
        : 'transform 160ms ease-out, opacity 160ms ease-out';
      toast.style.transform = '';
      toast.style.opacity = '';
      schedule();
    };
    toast.addEventListener('pointerdown', (event) => {
      if (
        dismissed ||
        !event.isPrimary ||
        event.button !== 0 ||
        (event.target as Element).closest('button')
      )
        return;
      clearTimeout(timer);
      dx = dy = 0;
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY };
      toast.style.transition = 'none';
      toast.setPointerCapture(event.pointerId);
    });
    toast.addEventListener('pointermove', (event) => {
      if (!drag || event.pointerId !== drag.id) return;
      dx = event.clientX - drag.x;
      dy = event.clientY - drag.y;
      toast.style.transform = `translate(${dx}px, ${dy}px)`;
      toast.style.opacity = String(Math.max(0.35, 1 - Math.hypot(dx, dy) / 200));
    });
    toast.addEventListener('pointerup', (event) => {
      if (!drag || event.pointerId !== drag.id) return;
      dx = event.clientX - drag.x;
      dy = event.clientY - drag.y;
      drag = undefined;
      if (toast.hasPointerCapture(event.pointerId)) toast.releasePointerCapture(event.pointerId);
      if (Math.hypot(dx, dy) >= 48) dismiss(true);
      else resetDrag();
    });
    toast.addEventListener('pointercancel', resetDrag);
    toast.addEventListener('lostpointercapture', () => {
      if (drag) resetDrag();
    });
    dismissals.set(toast, () => {
      clearTimeout(timer);
      if (dismissed) toast.remove();
      else dismiss();
    });
    close.addEventListener('click', () => dismiss(true));
    toast.append(badge, text, close);
    container.append(toast);
    schedule();
  });
</script>
