---
import type { SiteContent } from '@frontend/api/sites/parse-site';
import { primaryLink, productLink } from './links';
import GenericPortrait from './GenericPortrait.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  content: SiteContent;
  preview?: boolean;
}

const { content, preview = false } = Astro.props;
const en = content.language === 'en';

const stats = content.stats.filter((stat) => stat.value || stat.label);
const testimonials = content.testimonials.filter((item) => item.quote || item.name);
const gallery = content.gallery.filter((item) => item.image);
const links = content.links.filter((link) => link.url);

// Keep the original index so productLink() can resolve the correct href.
const products = content.products
  .map((product, index) => ({ product, index }))
  .filter(({ product }) => product.title || product.description || product.image);

const primaryHref = primaryLink(content, preview);
const year = new Date().getFullYear();
const monogram = (content.title.trim().charAt(0) || 'V').toUpperCase();

const catalog = products.map(({ product, index }) => ({
  title: product.title,
  description: product.description,
  image: product.image,
  href: productLink(content, preview, index),
  linked: Boolean(product.url || !preview),
}));

const navItems = links.length
  ? links.map((link) => ({ label: link.label || link.url, href: link.url }))
  : products
      .filter(({ product }) => product.title && (product.url || !preview))
      .map(({ product, index }) => ({
        label: product.title,
        href: productLink(content, preview, index),
      }));

const hasStats = stats.length > 0;
const hasHighlight = Boolean(content.logo || content.about || content.aboutTitle);
const hasGallery = gallery.length > 0;
const hasProducts = catalog.length > 0;
const hasTestimonials = testimonials.length > 0;
const hasContact = Boolean(content.footerText || links.length || content.title);

function contactIcon(url: string): string {
  const value = url.toLowerCase();
  if (value.startsWith('mailto:') || value.includes('mail') || value.includes('@')) return '✉';
  if (value.includes('wa.me') || value.includes('whatsapp') || value.startsWith('tel:')) return '☎';
  if (value.includes('instagram')) return '◎';
  if (value.includes('tiktok')) return '♪';
  if (value.includes('youtube') || value.includes('youtu.be')) return '▶';
  if (value.includes('facebook')) return 'f';
  if (value.includes('linkedin')) return 'in';
  if (value.includes('twitter') || value.includes('x.com')) return 'X';
  if (value.includes('github')) return '⌥';
  return '↗';
}
---

<main class="estudio">
  <!-- 1. Profile hero -->
  <header class="hero" id="estudio-inicio">
    {content.heroImage ? (
      <span class="avatar">
        <img
          class="avatar-img"
          src={content.heroImage}
          alt={content.title}
          width="150"
          height="150"
          loading="eager"
          decoding="async"
        />
      </span>
    ) : (
      <span class="avatar">
        <GenericPortrait label={en ? 'Sample profile portrait' : 'Retrato genérico do perfil'} />
      </span>
    )}

    {content.title && <h1 class="name">{content.title}</h1>}
    {content.eyebrow && <p class="role">{content.eyebrow}</p>}
    {content.subtitle && <p class="tagline">{content.subtitle}</p>}
  </header>

  <!-- 2. Stats card -->
  {hasStats && (
    <section class="card stats" aria-labelledby="estudio-stats-title">
      <div class="social-header">
        <span class="social-icon">◎</span>
        <div>
          <small>@{content.appName.replace(/\s/g, '').toLowerCase()}</small>
          <h2 id="estudio-stats-title">{en ? 'Instagram in numbers' : 'Instagram em números'}</h2>
        </div>
        <a href={content.links[0]?.url || '#estudio-contato'}>
          {en ? 'View profile' : 'Ver perfil'} ↗
        </a>
      </div>

      <dl class="stats-grid">
        {stats.map((stat) => (
          <div class="stat">
            <dt class="stat-value">{stat.value}</dt>
            <dd class="stat-label">{stat.label}</dd>
          </div>
        ))}
      </dl>

      <p class="note">
        {en
          ? 'Views and interactions refer to recent public content.'
          : 'Visualizações e interações consideram o conteúdo público recente.'}
      </p>
    </section>
  )}

  <!-- 3. Brand highlight card -->
  {hasHighlight && (
    <section
      class="card highlight"
      aria-labelledby={content.aboutTitle ? 'estudio-about-title' : undefined}
    >
      <div class="highlight-media">
        {content.logo ? (
          <img
            src={content.logo}
            alt={content.appName || content.title}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="highlight-symbol" aria-hidden="true">
            {monogram}
          </span>
        )}
      </div>

      <div class="highlight-body">
        {content.aboutTitle && (
          <h2 class="highlight-title" id="estudio-about-title">
            {content.aboutTitle}
          </h2>
        )}
        {content.about && <p class="highlight-text">{content.about}</p>}
        {primaryHref && content.primaryLabel && (
          <a class="btn btn-outline" href={primaryHref}>
            {content.primaryLabel}
          </a>
        )}
      </div>
    </section>
  )}

  <!-- 4. Navigation buttons -->
  {navItems.length > 0 && (
    <nav class="nav" aria-label={en ? 'Useful links' : 'Links úteis'}>
      <a class="nav-btn" href="#estudio-inicio">
        ⌂ {en ? 'Home' : 'Início'}
      </a>
      {navItems.map((item) => (
        <a class="nav-btn" href={item.href}>
          {item.label}
        </a>
      ))}
      <ThemeToggle en={en} />
    </nav>
  )}

  <!-- 5. Gallery -->
  {hasGallery && (
    <section class="gallery" aria-label={en ? 'Gallery' : 'Galeria'}>
      {gallery.map((item) => (
        <figure class="shot">
          <img src={item.image} alt={content.title} loading="lazy" decoding="async" />
        </figure>
      ))}
    </section>
  )}

  <!-- 6. Services / catalog -->
  {hasProducts && (
    <section class="products" aria-labelledby="estudio-products-title">
      <h2 class="section-label" id="estudio-products-title">
        {en ? 'Catalog' : 'Catálogo'}
      </h2>
      <div class="product-grid">
        {catalog.map((item) =>
          item.linked ? (
            <a class="product-card" href={item.href}>
              {item.image && (
                <img
                  src={item.image}
                  alt={item.title || content.title}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="product-body">
                {item.title && <span class="product-title">{item.title}</span>}
                {item.description && <span class="product-desc">{item.description}</span>}
                <span class="product-link">{en ? 'View' : 'Ver'} →</span>
              </span>
            </a>
          ) : (
            <article class="product-card">
              {item.image && (
                <img
                  src={item.image}
                  alt={item.title || content.title}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="product-body">
                {item.title && <span class="product-title">{item.title}</span>}
                {item.description && <span class="product-desc">{item.description}</span>}
              </span>
            </article>
          ),
        )}
      </div>
    </section>
  )}

  <!-- 7. Testimonials -->
  {hasTestimonials && (
    <section class="testimonials" aria-labelledby="estudio-quotes-title">
      <h2 class="section-label" id="estudio-quotes-title">
        {en ? 'What they say' : 'O que dizem'}
      </h2>
      <div class="quote-grid">
        {testimonials.map((item) => (
          <blockquote class="quote">
            {item.quote && <p>{item.quote}</p>}
            {item.name && <cite>{item.name}</cite>}
          </blockquote>
        ))}
      </div>
    </section>
  )}

  <!-- 8. Contact -->
  {hasContact && (
    <footer class="contact" id="contato">
      {content.footerText && <p class="contact-text">{content.footerText}</p>}

      {links.length > 0 && (
        <div class="contact-links">
          {links.map((link) => (
            <a class="contact-btn" href={link.url} aria-label={link.label || link.url}>
              <span aria-hidden="true">{contactIcon(link.url)}</span>
            </a>
          ))}
        </div>
      )}

      {content.title && (
        <p class="copyright">
          © {year} {content.title}
        </p>
      )}
    </footer>
  )}
</main>

<style>
  /* ------------------------------------------------------------------ */
  /* Layout shell                                                       */
  /* ------------------------------------------------------------------ */
  .estudio {
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding: clamp(2.75rem, 8vw, 5.5rem) clamp(1.15rem, 4vw, 2.5rem) clamp(3rem, 9vw, 6rem);
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg) 60%, var(--soft) 100%);
    color: var(--fg);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .estudio > * {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
  }

  .estudio > * + * {
    margin-top: clamp(1.75rem, 4.5vw, 3rem);
  }

  .estudio a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* ------------------------------------------------------------------ */
  /* Entrance animations                                                */
  /* ------------------------------------------------------------------ */
  @keyframes estudio-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes estudio-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .estudio > * {
    animation: estudio-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .estudio > .hero {
    animation: estudio-fade 0.9s ease both;
  }

  .estudio > *:nth-child(2) {
    animation-delay: 0.06s;
  }
  .estudio > *:nth-child(3) {
    animation-delay: 0.12s;
  }
  .estudio > *:nth-child(4) {
    animation-delay: 0.18s;
  }
  .estudio > *:nth-child(5) {
    animation-delay: 0.24s;
  }
  .estudio > *:nth-child(6) {
    animation-delay: 0.3s;
  }
  .estudio > *:nth-child(7) {
    animation-delay: 0.36s;
  }
  .estudio > *:nth-child(8) {
    animation-delay: 0.42s;
  }

  /* ------------------------------------------------------------------ */
  /* 1. Hero                                                            */
  /* ------------------------------------------------------------------ */
  .hero {
    display: block;
    min-height: 0;
    text-align: center;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 150px;
    height: 150px;
    margin: 0 auto clamp(1.5rem, 4vw, 2rem);
    padding: 7px;
    border: 2px solid color-mix(in srgb, var(--accent) 65%, transparent);
    border-radius: 0;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    box-shadow: 0 26px 55px -38px color-mix(in srgb, var(--fg) 55%, transparent);
    overflow: hidden;
  }

  .avatar-img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
  }

  .avatar-mono {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--accent);
    background: var(--soft);
  }

  .name {
    margin: 0 0 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0.08em;
    text-indent: 0.08em;
    text-transform: uppercase;
  }

  .role {
    margin: 0 0 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
  }

  .tagline {
    max-width: 90ch;
    margin: 0 auto;
    font: clamp(1rem, 2.3vw, 1.16rem)/1.75 var(--font-display);
    line-height: 1.75;
    color: color-mix(in srgb, var(--fg) 80%, transparent);
  }

  /* ------------------------------------------------------------------ */
  /* Shared card                                                        */
  /* ------------------------------------------------------------------ */
  .card {
    padding: clamp(1.6rem, 4.5vw, 2.75rem);
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: 0 30px 70px -55px color-mix(in srgb, var(--fg) 60%, transparent);
  }

  .card-eyebrow {
    margin: 0 0 1.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ------------------------------------------------------------------ */
  /* 2. Stats                                                           */
  /* ------------------------------------------------------------------ */
  .stats {
    display: block;
    width: 100%;
    overflow: visible;
    text-align: left;
    border-radius: 0;
    padding: 18px 20px;
    background: var(--bg);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.35rem 1rem;
    margin: 0 0 8px;
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }

  .stat {
    display: block;
    text-align: left;
    border-left: 1px solid var(--line);
    padding-left: 12px;
    padding-block: 0;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--fg);
  }

  .stat-label {
    margin: 0.4rem 0 0;
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    text-transform: none;
    font-family: var(--font-display);
    color: var(--muted);
  }

  .note {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--muted);
  }

  /* ------------------------------------------------------------------ */
  /* Buttons                                                            */
  /* ------------------------------------------------------------------ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.9rem 1.7rem;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      transform 0.3s ease,
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .btn-solid {
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .btn-outline {
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    background: transparent;
    color: var(--fg);
  }

  .btn-solid:hover,
  .btn-outline:hover {
    transform: translateY(-2px);
  }

  .btn-outline:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  /* ------------------------------------------------------------------ */
  /* 3. Highlight                                                       */
  /* ------------------------------------------------------------------ */
  .highlight {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.25rem, 3.5vw, 2.25rem);
    align-items: center;
    background: var(--soft);
  }
  .social-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 14px;
    font-family: var(--font-display);
  }
  .social-header h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.05em;
  }
  .social-header small {
    font-size: 10px;
    letter-spacing: 0.15em;
  }
  .social-header a {
    margin-left: auto;
    font-size: 12px;
    border-bottom: 1px solid;
    padding-bottom: 4px;
  }
  .social-icon {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--bg);
    width: 36px;
    height: 36px;
    border-radius: 9px;
    font-size: 24px;
  }
  .highlight-title {
    margin: 0 0 8px;
    font: 400 clamp(1.6rem, 3.4vw, 3rem)/1.15 var(--font-display);
  }
  .estudio .nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 12px;
    background: var(--bg);
    border-top: 1px solid var(--line);
    overflow-x: auto;
    border-radius: 0;
    max-width: none;
    animation: none;
  }
  .estudio .nav-btn {
    width: auto;
    padding: 8px 12px;
    font-size: 12px;
    white-space: nowrap;
    text-transform: none;
  }
  .estudio .highlight {
    background: color-mix(in srgb, var(--bg) 90%, #efb174);
  }
  @media (min-width: 768px) {
    .estudio {
      padding-top: 40px;
    }
    .estudio .name {
      font-size: 42px;
      margin-top: 24px;
    }
    .estudio .eyebrow {
      font: 14px var(--font-display);
      margin-top: 20px;
    }
    .estudio .tagline {
      margin-top: 12px;
    }
    .estudio > * + * {
      margin-top: 32px;
    }
    .estudio .highlight {
      min-height: 162px;
      padding: 24px;
    }
    .estudio .highlight-media {
      border-radius: 50%;
      width: 112px;
      height: 112px;
    }
  }

  .highlight-media {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    overflow: hidden;
  }

  .highlight-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .highlight-symbol {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--accent);
  }

  .highlight-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .highlight .card-eyebrow {
    margin: 0;
  }

  .highlight-text {
    margin: 0;
    font-size: clamp(0.98rem, 2.2vw, 1.08rem);
    line-height: 1.75;
    color: color-mix(in srgb, var(--fg) 84%, transparent);
  }

  @media (max-width: 560px) {
    .highlight {
      grid-template-columns: minmax(0, 1fr);
      text-align: center;
    }

    .highlight-media {
      margin-inline: auto;
    }

    .highlight-body {
      align-items: center;
    }
  }

  /* ------------------------------------------------------------------ */
  /* 4. Navigation                                                      */
  /* ------------------------------------------------------------------ */
  .nav {
    display: grid;
    gap: 0.8rem;
  }

  .nav-btn {
    display: block;
    width: 100%;
    padding: 1.05rem 1.4rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    color: var(--fg);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      transform 0.3s ease,
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .nav-btn:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: var(--soft);
  }

  /* ------------------------------------------------------------------ */
  /* 5. Gallery                                                         */
  /* ------------------------------------------------------------------ */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  @media (min-width: 720px) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .shot {
    margin: 0;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: 0 20px 45px -40px color-mix(in srgb, var(--fg) 60%, transparent);
    overflow: hidden;
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease,
      border-color 0.4s ease;
  }

  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .shot:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 34px 60px -42px color-mix(in srgb, var(--fg) 70%, transparent);
  }

  .shot:hover img {
    transform: scale(1.05);
  }

  /* ------------------------------------------------------------------ */
  /* 6. Products                                                        */
  /* ------------------------------------------------------------------ */
  .section-label {
    margin: 0 0 1.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-align: center;
    text-transform: uppercase;
    color: var(--muted);
  }

  .product-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .product-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 24px 55px -50px color-mix(in srgb, var(--fg) 60%, transparent);
    overflow: hidden;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: 0 36px 70px -48px color-mix(in srgb, var(--fg) 70%, transparent);
  }

  .product-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .product-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.2rem 1.3rem 1.45rem;
  }

  .product-title {
    font-family: var(--font-display);
    font-size: 1.16rem;
    line-height: 1.3;
    color: var(--fg);
