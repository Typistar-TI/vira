---
import type { SiteContent } from '@frontend/api/sites/parse-site';
import { primaryLink, productLink } from './links';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  content: SiteContent;
  preview?: boolean;
}
const { content, preview = false } = Astro.props;
const en = content.language === 'en';

const brand = (content.appName || content.title || 'Vira').trim();
const monogram = brand.charAt(0).toUpperCase();
const year = new Date().getFullYear();

/* ------------------------------------------------------------------ *
 * Section availability
 * ------------------------------------------------------------------ */
const hasManifesto = Boolean(content.about || content.benefits.length || content.steps.length);
const hasFeatures = content.benefits.length > 0;
const hasArchitecture = content.products.length > 0 || content.steps.length > 0;
const hasInstallation = content.steps.length > 0;

const navItems: { href: string; label: string }[] = [];
if (hasManifesto) navItems.push({ href: '#manifesto', label: en ? 'Manifesto' : 'Manifesto' });
if (hasFeatures) navItems.push({ href: '#recursos', label: en ? 'Features' : 'Recursos' });
if (hasArchitecture)
  navItems.push({ href: '#arquitetura', label: en ? 'Architecture' : 'Arquitetura' });
if (hasInstallation) navItems.push({ href: '#instalacao', label: en ? 'Install' : 'Instalação' });

/* ------------------------------------------------------------------ *
 * Hero
 * ------------------------------------------------------------------ */
const titleBreak = content.title.indexOf(',');
const hasMultiWordTitle = titleBreak >= 0;
const titleLead = hasMultiWordTitle ? content.title.slice(0, titleBreak + 1) : '';
const titleAccent = hasMultiWordTitle ? content.title.slice(titleBreak + 1).trim() : '';

const proof = content.benefits
  .slice(0, 3)
  .map((b) => ({ head: b.title, text: b.description }))
  .filter((item) => item.head);

const metricDefaults = en
  ? [
      { value: '99.98%', label: 'Uptime' },
      { value: '42ms', label: 'Latency' },
      { value: '18', label: 'Services' },
      { value: '24/7', label: 'Monitoring' },
    ]
  : [
      { value: '99,98%', label: 'Uptime' },
      { value: '42ms', label: 'Latência' },
      { value: '18', label: 'Serviços' },
      { value: '24/7', label: 'Monitoramento' },
    ];
const dashMetrics = metricDefaults.map((fallback, index) => {
  const stat = content.stats[index];
  return stat ? { value: stat.value, label: stat.label } : fallback;
});

const serviceDefaults = en
  ? ['Core API', 'Database', 'Backups']
  : ['API principal', 'Banco de dados', 'Backups'];
const services = serviceDefaults.map((fallback, index) => content.links[index]?.label || fallback);

/* ------------------------------------------------------------------ *
 * Manifesto / features / architecture
 * ------------------------------------------------------------------ */
const principles = (content.benefits.length ? content.benefits : content.steps).slice(0, 3);
const featureSymbols = ['◈', '◎', '⬡', '⌘', '◐', '▦'];
const productNodes = content.products.map((product, index) => ({
  title: product.title,
  description: product.description,
  href: productLink(content, preview, index),
}));
const stepNodes = content.steps.map((step) => ({
  title: step.title,
  description: step.description,
  href: '',
}));
const architectureNodes = (
  productNodes.length >= 3 ? productNodes : stepNodes.length ? stepNodes : productNodes
).slice(0, 4);
---

<div class="central">
  <a class="skip-link" href="#inicio">
    {en ? 'Skip to content' : 'Ir para o conteúdo'}
  </a>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="#inicio" aria-label={brand}>
        {content.logo ? (
          <img class="brand-logo" src={content.logo} alt={brand} width="26" height="26" />
        ) : (
          <span class="brand-mark" aria-hidden="true">
            {monogram}
          </span>
        )}
        <span class="brand-name">{brand}</span>
      </a>

      {navItems.length > 0 && (
        <>
          <nav
            id="primary-nav"
            class="site-nav"
            data-menu
            aria-label={en ? 'Primary' : 'Principal'}
          >
            {navItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>
          <button
            class="menu-toggle"
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="primary-nav"
            aria-label={en ? 'Open menu' : 'Abrir menu'}
          >
            <span class="menu-bars" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </span>
          </button>
        </>
      )}

      {content.primaryLabel && (
        <a class="header-cta" href={primaryLink(content, preview)}>
          {content.primaryLabel}
        </a>
      )}
      <ThemeToggle en={en} />
    </div>
  </header>

  <main id="main">
    <section id="inicio" class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy reveal">
          {content.eyebrow && <p class="eyebrow mono">{content.eyebrow}</p>}
          <h1 class="hero-title">
            {hasMultiWordTitle ? (
              <>
                <span class="hero-title-line">{titleLead}</span>
                <span class="hero-title-accent">{titleAccent}</span>
              </>
            ) : (
              content.title
            )}
          </h1>
          {content.subtitle && <p class="hero-sub">{content.subtitle}</p>}

          <div class="hero-actions">
            {content.primaryLabel && (
              <a class="cta cta-primary" href={primaryLink(content, preview)}>
                {content.primaryLabel}
                <span class="cta-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            )}
            {hasInstallation && (
              <a class="cta cta-quiet" href="#instalacao">
                {en ? 'See install' : 'Ver instalação'}
              </a>
            )}
          </div>

          {proof.length > 0 && (
            <dl class="proof">
              {proof.map((item, index) => (
                <div class="proof-item">
                  <dt class="proof-index mono">{String(index + 1).padStart(2, '0')}</dt>
                  <dd class="proof-body">
                    <span class="proof-value">{item.head}</span>
                    {item.text && <span class="proof-text">{item.text}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          )}
        </div>

        <div class="hero-visual reveal">
          <div class="dash" aria-hidden="true">
            <div class="dash-bar">
              <span class="dash-dots">
                <i></i>
                <i></i>
                <i></i>
              </span>
              <span class="dash-title mono">{brand}</span>
            </div>
            <div class="dash-metrics">
              {dashMetrics.slice(0, 2).map((metric) => (
                <div class="metric">
                  <span class="metric-value">{metric.value}</span>
                  <span class="metric-label mono">{metric.label}</span>
                </div>
              ))}
            </div>
            <div class="dash-services">
              {(content.products.length
                ? content.products.slice(0, 4).map((product) => product.title)
                : services
              ).map((label, index) => (
                <div class="service">
                  <span class="service-name">
                    <span class="service-glyph mono">{String(index + 1).padStart(2, '0')}</span>
                    {label}
                  </span>
                  <span class="status mono">
                    <span class="status-dot"></span>
                    {en ? 'online' : 'operacional'}
                  </span>
                </div>
              ))}
            </div>
            <div class="dash-footer mono">
              <span>{en ? 'PERSONAL WORKSPACE' : 'ESPAÇO PESSOAL'}</span>
              <span>● {en ? 'SYSTEM READY' : 'SISTEMA PRONTO'}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {hasManifesto && (
      <section id="manifesto" class="section manifest reveal">
        <div class="shell">
          <p class="section-index mono">01 / {en ? 'PRINCIPLE' : 'PRINCÍPIO'}</p>
          <div class="manifest-grid">
            <div class="manifest-copy">
              <h2 class="section-title">{content.aboutTitle || content.title}</h2>
              {content.about && <p class="section-lead">{content.about}</p>}
            </div>
            {principles.length > 0 && (
              <div class="principles">
                {principles.map((principle, index) => (
                  <article class="principle">
                    <span class="principle-index mono">{String(index + 1).padStart(2, '0')}</span>
                    <h3>{principle.title}</h3>
                    <p>{principle.description}</p>
                  </article>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    {hasFeatures && (
      <section id="recursos" class="section features reveal">
        <div class="shell">
          <div class="section-head">
            <p class="section-index mono">02 / {en ? 'MODULES' : 'MÓDULOS'}</p>
            <h2 class="section-title">{en ? 'Everything in one panel' : 'Tudo em um painel'}</h2>
          </div>
          <ul class="feature-grid">
            {content.benefits.map((benefit, index) => (
              <li class="feature-card">
                <div class="feature-top">
                  <span class="feature-index mono">{String(index + 1).padStart(2, '0')}</span>
                  <span class="feature-symbol" aria-hidden="true">
                    {featureSymbols[index % featureSymbols.length] || '◈'}
                  </span>
                </div>
                <h3>{benefit.title}</h3>
                <p>{benefit.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {hasArchitecture && (
      <section id="arquitetura" class="section architecture reveal">
        <div class="shell">
          <p class="section-index mono">03 / {en ? 'SYSTEM MAP' : 'MAPA DO SISTEMA'}</p>
          <div class="section-head">
            <h2 class="section-title">{en ? 'How it fits together' : 'Como tudo se conecta'}</h2>
          </div>
          <div class="map">
            {architectureNodes.map((node, index) => (
              <div class="map-node">
                <span class="map-index mono">{String(index + 1).padStart(2, '0')}</span>
                <h3>{node.href ? <a href={node.href}>{node.title}</a> : node.title}</h3>
                {node.description && <p>{node.description}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {hasInstallation && (
      <section id="instalacao" class="section install reveal">
        <div class={`shell install-grid${content.snippet ? '' : ' install-grid--solo'}`}>
          <div class="install-copy">
            <p class="section-index mono">04 / {en ? 'INSTALL' : 'INSTALAÇÃO'}</p>
            <h2 class="section-title">{en ? 'Up in a few steps' : 'No ar em poucos passos'}</h2>
            <ol class="steps">
              {content.steps.map((step, index) => (
                <li class="step">
                  <span class="step-index mono">{String(index + 1).padStart(2, '0')}</span>
                  <div class="step-body">
                    <h3>{step.title}</h3>
                    {step.description && <p>{step.description}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>

          {content.snippet && (
            <div class="terminal" data-copy-root>
              <div class="terminal-bar">
                <span class="terminal-dots" aria-hidden="true">
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
                <span class="terminal-title mono">
                  {brand} — {en ? 'shell' : 'terminal'}
                </span>
                <button
                  type="button"
                  class="copy-btn mono"
                  data-copy
                  data-copy-label={en ? 'Copy' : 'Copiar'}
                  data-copied-label={en ? 'Copied' : 'Copiado'}
                >
                  <span data-copy-text>{en ? 'Copy' : 'Copiar'}</span>
                </button>
              </div>
              <pre class="terminal-body"><code data-copy-source>{content.snippet}</code></pre>
            </div>
          )}
        </div>
      </section>
    )}

    {content.primaryLabel && (
      <section class="closing reveal">
        <div class="shell closing-inner">
          <p class="section-index mono">05 / {en ? 'NEXT STEP' : 'PRÓXIMO PASSO'}</p>
          <h2 class="closing-title">
            {en ? 'Bring your infrastructure into focus.' : 'Coloque sua infraestrutura em foco.'}
          </h2>
          {(content.footerText || content.subtitle) && (
            <p class="closing-lead">{content.footerText || content.subtitle}</p>
          )}
          <a class="cta cta-primary" href={primaryLink(content, preview)}>
            {content.primaryLabel}
            <span class="cta-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </section>
    )}
  </main>

  <footer class="site-footer">
    <div class="shell footer-grid">
      <div class="footer-brand">
        {content.logo ? (
          <img class="brand-logo" src={content.logo} alt={brand} width="24" height="24" />
        ) : (
          <span class="brand-mark" aria-hidden="true">
            {monogram}
          </span>
        )}
        <span class="brand-name">{brand}</span>
      </div>

      {content.footerText && <p class="footer-text">{content.footerText}</p>}

      {content.links.length > 0 && (
        <nav class="footer-links" aria-label={en ? 'Footer' : 'Rodapé'}>
          {content.links.map((link) =>
            link.url ? <a href={link.url}>{link.label}</a> : <span>{link.label}</span>,
          )}
        </nav>
      )}

      <p class="footer-copy mono">
        © {year} {brand}
      </p>
    </div>
  </footer>

  <noscript>
    <style>
      .reveal {
        opacity: 1;
        transform: none;
      }
    </style>
  </noscript>
</div>

<script>
  /* Menu toggle */
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  /* Reveal on scroll */
  const reveals = document.querySelectorAll<HTMLElement>('.central .reveal');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced || !('IntersectionObserver' in window)) {
    reveals.forEach((element) => element.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
    );
    reveals.forEach((element) => observer.observe(element));
  }

  /* Copy snippet */
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const root = button.closest('[data-copy-root]');
      const source = root?.querySelector<HTMLElement>('[data-copy-source]');
      if (!source || !navigator.clipboard) return;
      try {
        await navigator.clipboard.writeText(source.textContent?.trim() ?? '');
      } catch {
        return;
      }
      const label = button.querySelector<HTMLElement>('[data-copy-text]') ?? button;
      const original = button.getAttribute('data-copy-label') || label.textContent || '';
      label.textContent = button.getAttribute('data-copied-label') || original;
      button.classList.add('is-copied');
      window.setTimeout(() => {
        label.textContent = original;
        button.classList.remove('is-copied');
      }, 1800);
    });
  });
</script>

<style>
  /* ================================================================ *
   * 1. Tokens
   * ================================================================ */
  .central {
    --c-bg: var(--bg, #090d0f);
    --c-fg: var(--fg, #f4f7f5);
    --c-accent: var(--accent, #ff7919);
    --c-surface: var(--surface, #11171a);
    --c-soft: var(--soft, #1a1f22);
    --c-line: var(--line, rgba(244, 247, 245, 0.16));
    --c-muted: var(--muted, rgba(244, 247, 245, 0.62));
    --mono: var(--font-mono);
    --serif: var(--font-display);
    --nav-h: 64px;

    min-height: 100vh;
    padding-top: var(--nav-h);
    background: var(--c-bg);
    color: var(--c-fg);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  /* ================================================================ *
   * 2. Base / layout
   * ================================================================ */
  .central * {
    box-sizing: border-box;
  }
  .central img {
    display: block;
    max-width: 100%;
  }
  .shell {
    width: min(1180px, 100% - 48px);
    margin-inline: auto;
  }
  .mono {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .section {
    padding: clamp(64px, 9vw, 132px) 0;
    border-top: 1px solid var(--c-line);
    scroll-margin-top: calc(var(--nav-h) + 8px);
  }
  .section-index {
    margin: 0 0 20px;
    color: var(--c-accent);
  }
  .section-title {
    margin: 0;
    font-size: clamp(1.9rem, 4.2vw, 3.4rem);
    font-weight: 500;
    line-height: 1.03;
    letter-spacing: -0.05em;
  }
  .section-lead {
    margin: 22px 0 0;
    max-width: 56ch;
    color: var(--c-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.65;
  }
  .section-head {
    margin-bottom: 44px;
  }

  /* Skip link */
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 16px;
    border: 1px solid var(--c-line);
    border-radius: 2px;
    background: var(--c-surface);
    color: var(--c-fg);
    text-decoration: none;
    transform: translateY(-160%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }

  /* ================================================================ *
   * 3. Header
   * ================================================================ */
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    border-bottom: 1px solid var(--c-line);
    background: color-mix(in srgb, var(--c-bg) 84%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--nav-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--c-fg);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--c-accent);
    border-radius: 2px;
    color: var(--c-accent);
    font-family: var(--mono);
    font-size: 14px;
  }
  .brand-logo {
    width: 26px;
    height: 26px;
    border: 1px solid var(--c-line);
    border-radius: 2px;
    object-fit: cover;
  }
  .brand-name {
    font-size: 1rem;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-left: auto;
  }
  .site-nav a {
    color: var(--c-muted);
    text-decoration: none;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    transition: color 0.2s ease;
  }
  .site-nav a:hover {
    color: var(--c-fg);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border: 1px solid var(--c-accent);
    border-radius: 2px;
    background: var(--c-accent);
    color: var(--c-bg);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .header-cta:hover {
    background: transparent;
    color: var(--c-accent);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--c-line);
    border-radius: 2px;
    background: transparent;
    color: var(--c-fg);
    cursor: pointer;
  }
  .menu-bars {
    display: grid;
    gap: 4px;
  }
  .menu-bars i {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--c-fg);
  }

  /* ================================================================ *
   * 4. Buttons
   * ================================================================ */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 26px;
    border: 1px solid var(--c-line);
    border-radius: 2px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .cta-primary {
    border-color: var(--c-accent);
    background: var(--c-accent);
    color: var(--c-bg);
  }
  .cta-primary:hover {
    background: transparent;
    color: var(--c-accent);
  }
  .cta-arrow {
    transition: transform 0.2s ease;
  }
  .cta-primary:hover .cta-arrow {
    transform: translateX(4px);
  }
  .cta-quiet {
    color: var(--c-muted);
    background: transparent;
  }
  .cta-quiet:hover {
    color: var(--c-fg);
    border-color: var(--c-fg);
  }

  /* ================================================================ *
   * 5. Hero
   * ================================================================ */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 48px 0 56px;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--c-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-line) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0.4;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, #000 0%, transparent 75%);
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, #000 0%, transparent 75%);
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.41fr 0.59fr;
    gap: 42px;
    align-items: center;
  }
  .eyebrow {
    margin: 0 0 22px;
    color: var(--c-accent);
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.6rem, 6.4vw, 5.5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.06em;
  }
  .hero-title-line,
  .hero-title-accent {
    display: block;
  }
  .hero-title-accent {
    color: var(--c-accent);
    font-family: Georgia, serif;
    font-style: italic;
    font-weight: 400;
  }
  .hero-sub {
    margin: 26px 0 0;
    max-width: 48ch;
    color: var(--c-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
