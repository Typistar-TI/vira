---
import type { SiteContent } from '@frontend/api/sites/parse-site';
import { primaryLink, productLink } from './links';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  content: SiteContent;
  preview?: boolean;
}
const { content, preview = false } = Astro.props;
const en = content.language === 'en';

const brand = (content.appName || content.title || 'Vira').trim();
const monogram = brand.charAt(0).toUpperCase();
const ctaHref = primaryLink(content, preview) || '#';
const snippet = content.snippet.trim();
const year = new Date().getFullYear();

const galleryImages = content.gallery
  .map((item) => item.image)
  .filter((src): src is string => Boolean(src));

const heroShots = [content.heroImage, ...galleryImages]
  .filter((src): src is string => Boolean(src))
  .slice(0, 3);

const hasFeatures = content.benefits.length > 0 || content.about.trim() !== '';
const featuresHeading = content.aboutTitle || content.eyebrow;
const hasSteps = content.steps.length > 0;
const hasTerminal = snippet !== '';
const hasGallery = galleryImages.length >= 2;
const hasTestimonials = content.testimonials.length > 0;
const hasFaq = content.faq.length > 0;

// `productLink` is part of the shared template contract even though this
// layout renders products through the gallery/hero imagery.
void productLink;

const t = en
  ? {
      navLabel: 'Main navigation',
      navResources: 'Features',
      navSteps: 'How it works',
      navFaq: 'FAQ',
      ctaSecondary: 'How it works',
      stepsHeading: 'How it works',
      stepsIntro: 'Three simple steps to get from idea to online.',
      faqHeading: 'Frequently asked questions',
      statsLabel: 'Highlights',
      galleryLabel: 'Gallery',
      testimonialsLabel: 'Testimonials',
      footerLinks: 'Footer links',
      copy: 'Copy',
      copied: 'Copied',
      screenshot: 'app screenshot',
      galleryShot: 'gallery image',
    }
  : {
      navLabel: 'Navegação principal',
      navResources: 'Diferenciais',
      navSteps: 'Como funciona',
      navFaq: 'FAQ',
      ctaSecondary: 'Como funciona',
      stepsHeading: 'Como funciona',
      stepsIntro: 'Três passos simples da ideia até o ar.',
      faqHeading: 'Perguntas frequentes',
      statsLabel: 'Destaques',
      galleryLabel: 'Galeria',
      testimonialsLabel: 'Depoimentos',
      footerLinks: 'Links do rodapé',
      copy: 'Copiar',
      copied: 'Copiado',
      screenshot: 'captura de tela',
      galleryShot: 'imagem da galeria',
    };
---

<div class="guardiao">
  <!-- 1. Floating dock -->
  <nav class="guardiao-nav" aria-label={t.navLabel}>
    <a class="dock-brand" href="#top">
      {content.logo ? (
        <img
          class="dock-logo"
          src={content.logo}
          alt={brand}
          width="34"
          height="34"
          loading="eager"
        />
      ) : (
        <span class="dock-monogram" aria-hidden="true">
          {monogram}
        </span>
      )}
      <span class="dock-name">{brand}</span>
    </a>

    {(hasFeatures || hasSteps || hasFaq) && (
      <div class="dock-links">
        <a href="#top">{en ? 'Overview' : 'Visão geral'}</a>
        {hasFeatures && <a href="#recursos">{t.navResources}</a>}
        {hasSteps && <a href="#passos">{t.navSteps}</a>}
        {hasFaq && <a href="#faq">{t.navFaq}</a>}
      </div>
    )}
    <ThemeToggle en={en} />

    {content.primaryLabel && (
      <a class="dock-cta" href={ctaHref}>
        {content.primaryLabel}
      </a>
    )}
  </nav>

  <main class="page">
    <!-- 2. Hero -->
    <header id="top" class="hero">
      <div class="hero-copy" data-rise>
        {content.eyebrow && (
          <p class="eyebrow">
            <span class="eyebrow-rule" aria-hidden="true" />
            {content.eyebrow}
          </p>
        )}

        <h1>{content.title}</h1>

        {content.subtitle && <p class="lede">{content.subtitle}</p>}

        {(content.primaryLabel || hasSteps) && (
          <div class="hero-actions">
            {content.primaryLabel && (
              <a class="btn btn-primary" href={ctaHref}>
                {content.primaryLabel}
              </a>
            )}
            {hasSteps && (
              <a class="btn btn-quiet" href="#passos">
                {t.ctaSecondary}
              </a>
            )}
          </div>
        )}

        {content.stats.length > 0 && (
          <ul class="trust-row" aria-label={t.statsLabel}>
            {content.stats.map((stat) => (
              <li>
                <span class="trust-value">{stat.value}</span>
                <span class="trust-label">{stat.label}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="hero-visual" data-rise>
        {heroShots.length > 0 ? (
          <div class="stack">
            {heroShots.map((src, index) => (
              <figure
                class={`stack-card stack-card-${index + 1}`}
                tabindex="0"
                role="button"
                data-phone
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={
                  en ? `Bring screen ${index + 1} to front` : `Trazer tela ${index + 1} para frente`
                }
              >
                <img
                  src={src}
                  alt={`${brand} — ${t.screenshot} ${index + 1}`}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </figure>
            ))}
          </div>
        ) : (
          <div class="phone-stack">
            {[0, 1].map((index) => (
              <button
                type="button"
                class:list={['sample-phone', `sample-phone-${index}`, { 'is-front': index === 0 }]}
                data-phone
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={
                  en ? `Bring screen ${index + 1} to front` : `Trazer tela ${index + 1} para frente`
                }
              >
                <span class="phone-heading">
                  <span class="phone-logo">◉</span>
                  {index === 0 ? (en ? 'Overview' : 'Visão geral') : en ? 'Events' : 'Eventos'}
                  <span class="phone-alert">♧</span>
                </span>
                {index === 0 && (
                  <span class="phone-stats">
                    {content.stats.slice(0, 2).map((stat) => (
                      <span>
                        <small>◈</small>
                        <strong>{stat.value}</strong>
                        <small>{stat.label}</small>
                      </span>
                    ))}
                  </span>
                )}
                <span class="phone-section">
                  {index === 0
                    ? en
                      ? 'Spaces'
                      : 'Ambientes'
                    : en
                      ? 'Recent activity'
                      : 'Atividade recente'}
                </span>
                {content.products.slice(0, 3).map((product, i) => (
                  <span class="phone-row">
                    <span class="phone-logo">{['⌂', '♧', '◈'][i]}</span>
                    <span>
                      <strong>{product.title}</strong>
                      <small>{product.description}</small>
                    </span>
                    <span class="phone-dot">●</span>
                  </span>
                ))}
                {index === 0 && (
                  <>
                    <span class="phone-section">
                      {en ? 'Recent activity' : 'Atividade recente'}
                    </span>
                    {content.benefits.slice(0, 2).map((benefit) => (
                      <span class="phone-row">
                        <span class="phone-logo">♧</span>
                        <span>
                          <strong>{benefit.title}</strong>
                          <small>{en ? 'Just now' : 'Agora'}</small>
                        </span>
                      </span>
                    ))}
                  </>
                )}
                <span class="phone-bottom">⌂　◉　☷　⚙</span>
              </button>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- 3. Features -->
    {hasFeatures && (
      <section id="recursos" class="section">
        <div class="section-head" data-rise>
          {featuresHeading && <h2>{featuresHeading}</h2>}
          {content.about && <p class="section-intro">{content.about}</p>}
        </div>

        {content.benefits.length > 0 && (
          <ol class="feature-grid">
            {content.benefits.map((benefit, index) => (
              <li class="feature-card" data-rise>
                <span class="feature-index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3>{benefit.title}</h3>
                {benefit.description && <p>{benefit.description}</p>}
              </li>
            ))}
          </ol>
        )}
      </section>
    )}

    <!-- 4. Steps -->
    {hasSteps && (
      <section id="passos" class="section">
        <div class="section-head" data-rise>
          <h2>{t.stepsHeading}</h2>
          <p class="section-intro">{t.stepsIntro}</p>
        </div>

        <ol class="steps-grid">
          {content.steps.map((step, index) => (
            <li class="step-card" data-rise>
              <span class="step-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{step.title}</h3>
              {step.description && <p>{step.description}</p>}
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- 5. Terminal -->
    {hasTerminal && (
      <section class="section terminal-section">
        <div class="terminal" data-rise>
          <div class="terminal-bar">
            <span class="terminal-dots" aria-hidden="true">
              <i />
              <i />
              <i />
            </span>
            <button
              type="button"
              class="terminal-copy"
              data-copy-button
              data-copy-value={snippet}
              data-default-label={t.copy}
              data-copied-label={t.copied}
              aria-label={content.language === 'en' ? 'Copy command' : 'Copiar comando'}
            >
              {t.copy}
            </button>
          </div>
          <pre class="terminal-body"><code>{snippet}</code></pre>
        </div>
      </section>
    )}

    <!-- 6. Gallery -->
    {hasGallery && (
      <section class="section gallery-section" aria-label={t.galleryLabel}>
        <div class="gallery" data-rise>
          {galleryImages.map((src, index) => (
            <figure class="gallery-item">
              <img src={src} alt={`${brand} — ${t.galleryShot} ${index + 1}`} loading="lazy" />
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- 7. Testimonials -->
    {hasTestimonials && (
      <section class="section" aria-label={t.testimonialsLabel}>
        <div class="testimonials">
          {content.testimonials.map((item) => (
            <figure class="testimonial" data-rise>
              <blockquote>
                <p>{item.quote}</p>
              </blockquote>
              {item.name && <figcaption>{item.name}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- 8. FAQ -->
    {hasFaq && (
      <section id="faq" class="section">
        <div class="section-head" data-rise>
          <h2>{t.faqHeading}</h2>
        </div>

        <div class="faq-list">
          {content.faq.map((item) => (
            <details class="faq-item" data-faq data-rise>
              <summary>
                <span>{item.question}</span>
                <span class="faq-chevron" aria-hidden="true" />
              </summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </main>

  <!-- 9. Footer -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-brand">
          {content.logo ? (
            <img
              class="footer-logo"
              src={content.logo}
              alt={brand}
              width="34"
              height="34"
              loading="lazy"
            />
          ) : (
            <span class="footer-monogram" aria-hidden="true">
              {monogram}
            </span>
          )}
          <div>
            <p class="footer-name">{brand}</p>
            {content.footerText && <p class="footer-text">{content.footerText}</p>}
          </div>
        </div>

        {content.links.length > 0 && (
          <nav class="footer-links" aria-label={t.footerLinks}>
            {content.links.map((link) =>
              link.url ? (
                <a
                  class="footer-link"
                  href={link.url}
                  {...(link.url.startsWith('http')
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {link.label}
                </a>
              ) : (
                <span class="footer-link">{link.label}</span>
              ),
            )}
          </nav>
        )}
      </div>

      <p class="footer-copy">
        © {year} {brand} · {content.title}
      </p>
    </div>
  </footer>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.guardiao [data-phone]').forEach((phone) => {
    const bringForward = () => {
      phone
        .closest('.hero-visual')
        ?.querySelectorAll('[data-phone]')
        .forEach((node) => {
          node.classList.toggle('is-front', node === phone);
          node.setAttribute('aria-pressed', String(node === phone));
        });
    };
    phone.addEventListener('click', bringForward);
    if (phone.tagName !== 'BUTTON')
      phone.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          bringForward();
        }
      });
  });
</script>
<style>
  .phone-stack {
    position: relative;
    height: 620px;
    min-width: 0;
  }
  .guardiao .guardiao-nav {
    inset: 20px auto auto 50%;
    transform: translateX(-50%);
    width: max-content;
    height: auto;
    display: flex;
    gap: 16px;
    padding: 10px;
    max-width: calc(100vw - 24px);
    border-radius: 24px;
    background: var(--surface);
  }
  .guardiao .guardiao-nav > * {
    width: auto;
    height: auto;
    display: flex;
    flex-direction: row;
  }
  .guardiao .guardiao-nav .dock-links {
    display: flex;
    gap: 8px;
  }
  .guardiao .dock-name {
    display: block;
  }
  .guardiao .page {
    max-width: 1440px;
    padding-inline: 24px;
  }
  .guardiao .hero {
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
  }
  .sample-phone {
    display: block;
  }
  .guardiao .btn {
    border-radius: 15px;
  }
  .guardiao .btn-primary {
    background: var(--fg);
    color: var(--bg);
    box-shadow: none;
  }
  .guardiao .btn-quiet {
    padding: 13px 20px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg);
  }
  @media (max-width: 900px) {
    .guardiao .hero {
      grid-template-columns: 1fr;
    }
    .guardiao .guardiao-nav .dock-links {
      display: none;
    }
    .guardiao .guardiao-nav .dock-name {
      display: block;
    }
    .guardiao .phone-stack {
      max-width: 480px;
      margin: auto;
    }
  }
  .sample-phone {
    position: absolute;
    top: 10px;
    left: 0;
    width: 270px;
    height: 565px;
    padding: 18px 12px;
    border: 8px solid color-mix(in srgb, var(--bg) 25%, white);
    border-radius: 34px;
    background: var(--bg);
    box-shadow: 0 20px 36px #0002;
    color: var(--fg);
    text-align: left;
    cursor: pointer;
    transform: rotate(-4deg);
    transition:
      transform 0.4s,
      opacity 0.4s;
    opacity: 0.66;
  }
  .sample-phone-1 {
    top: 82px;
    left: 48%;
    transform: rotate(9deg);
  }
  .sample-phone.is-front {
    z-index: 2;
    opacity: 1;
    transform: rotate(-4deg) translateY(-10px);
  }
  .sample-phone-1.is-front {
    transform: rotate(4deg) translateY(-20px);
  }
  .phone-heading {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 700;
  }
  .phone-logo {
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    flex-shrink: 0;
    border-radius: 8px;
    background: var(--fg);
    color: var(--accent);
  }
  .phone-alert {
    margin-left: auto;
  }
  .phone-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .phone-stats > span {
    display: grid;
    gap: 4px;
    padding: 8px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 2px 4px #0002;
  }
  .phone-stats strong {
    font-size: 18px;
  }
  .sample-phone small {
    display: block;
    color: var(--muted);
    font: 8px/1.6 var(--font-mono);
  }
  .phone-section {
    display: block;
    margin: 12px 0 8px;
    font-size: 10px;
    font-weight: 700;
  }
  .phone-row {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 10px 8px;
    margin-bottom: 8px;
    background: var(--surface);
    border-radius: 10px;
    box-shadow: 0 3px 5px #0002;
  }
  .phone-row strong {
    display: block;
    font-size: 10px;
    font-weight: 600;
  }
  .phone-dot {
    color: var(--accent);
    font-size: 10px;
    margin-left: auto;
  }
  .phone-bottom {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 5px 12px;
    border-radius: 24px;
    background: var(--surface);
    box-shadow: 0 3px 5px #0002;
    color: var(--muted);
  }
  .stack-card.is-front {
    z-index: 10;
  }
  @media (max-width: 640px) {
    .phone-stack {
      height: 440px;
      max-width: 400px;
      margin: auto;
    }
    .sample-phone {
      width: 200px;
      height: 415px;
      padding: 12px 8px;
      border-width: 6px;
    }
    .sample-phone-1 {
      left: 43%;
    }
    .phone-row {
      padding: 6px;
    }
    .phone-heading {
      font-size: 11px;
    }
    .phone-stats strong {
      font-size: 13px;
    }
    .phone-section {
      margin: 8px 0 4px;
    }
  }
</style>

<script>
  type CopyButton = HTMLButtonElement;

  async function writeToClipboard(value: string): Promise<boolean> {
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(value);
        return true;
      }
    } catch {
      // Fall through to the legacy clipboard path below.
    }

    try {
      const area = document.createElement('textarea');
      area.value = value;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.top = '-1000px';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    } catch {
      return false;
    }
  }

  document.querySelectorAll<CopyButton>('[data-copy-button]').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.dataset.copyValue ?? '';
      const defaultLabel = button.dataset.defaultLabel ?? 'Copiar';
      const copiedLabel = button.dataset.copiedLabel ?? 'Copiado';
      const ok = await writeToClipboard(value);
      button.textContent = ok ? copiedLabel : defaultLabel;
      window.setTimeout(() => {
        button.textContent = defaultLabel;
      }, 1600);
    });
  });
</script>

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-rise]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (reducedMotion.matches) {
    revealTargets.forEach((element) => element.classList.add('is-visible'));
  } else {
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
    );

    revealTargets.forEach((element) => revealObserver.observe(element));
  }
</script>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details[data-faq]').forEach((details) => {
    const summary = details.querySelector('summary');
    if (!summary) return;
    const sync = () => summary.setAttribute('aria-expanded', String(details.open));
    sync();
    details.addEventListener('toggle', sync);
  });
</script>

<style>
  /* ---------- Base ---------- */
  .guardiao {
    position: relative;
    min-height: 100vh;
    overflow-x: clip;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .guardiao::before {
    content: '';
    position: absolute;
    inset: -10% 0 auto;
    height: 68vh;
    background: radial-gradient(
      55% 60% at 72% 18%,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 72%
    );
    pointer-events: none;
    z-index: 0;
  }

  .page,
  .footer,
  .guardiao-nav {
    position: relative;
    z-index: 1;
  }

  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .guardiao a {
    color: inherit;
    text-decoration: none;
  }

  .guardiao img {
    display: block;
    max-width: 100%;
  }

  /* ---------- Entrance reveal ---------- */
  @media (prefers-reduced-motion: no-preference) {
    [data-rise] {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, transform;
    }

    [data-rise].is-visible {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- 1. Floating dock ---------- */
  .guardiao-nav {
    position: fixed;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: calc(100vw - 24px);
    padding: 8px 10px 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 18px 50px -28px rgba(0, 0, 0, 0.7);
  }

  .dock-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .dock-logo,
  .dock-monogram,
  .footer-logo,
  .footer-monogram {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .dock-logo,
  .footer-logo {
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .dock-monogram,
  .footer-monogram {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 20%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--accent) 38%, var(--line));
