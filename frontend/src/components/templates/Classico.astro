---
import type { SiteContent } from '@frontend/api/sites/parse-site';
import { primaryLink, productLink } from './links';

interface Props {
  content: SiteContent;
  preview?: boolean;
}
const { content, preview = false } = Astro.props;
const en = content.language === 'en';

const brand = content.appName || content.title;
const monogram = (content.appName || content.title).trim().charAt(0).toUpperCase() || '•';

const hasPrimary = Boolean(content.primaryLabel);
const hasAbout = Boolean(content.about || content.benefits.length);
const hasStats = content.stats.length > 0;
const hasSteps = content.steps.length > 0;
const hasCatalog = content.products.length > 0;
const hasTestimonials = content.testimonials.length > 0;
const hasFaq = content.faq.length > 0;

const gallery = content.gallery.filter((item) => item.image);
const footerLinks = content.links.filter((link) => link.url);
const showGallery = hasCatalog && gallery.length > 0 && content.products.length < 3;

const year = new Date().getFullYear();

const t = en
  ? {
      skip: 'Skip to content',
      home: 'Home',
      menu: 'Main navigation',
      navAbout: 'About',
      navSteps: 'How it works',
      navCatalog: 'Catalog',
      navFaq: 'FAQ',
      howItWorks: 'See how it works',
      learnMore: 'Learn more',
      aboutDefault: 'About us',
      benefitsLabel: 'Highlights',
      stepsEyebrow: 'Step by step',
      stepsTitle: 'How it works',
      catalogEyebrow: 'Catalog',
      catalogTitle: 'What we offer',
      testimonialsEyebrow: 'Testimonials',
      testimonialsTitle: 'What people say',
      quoteLabel: 'Testimonial from',
      faqEyebrow: 'Questions',
      faqTitle: 'Frequently asked questions',
      galleryAlt: 'Image gallery',
      finalCta: 'Get started',
      statsLabel: 'Numbers',
      footerLinks: 'Footer links',
    }
  : {
      skip: 'Ir para o conteúdo',
      home: 'Início',
      menu: 'Navegação principal',
      navAbout: 'Sobre',
      navSteps: 'Como funciona',
      navCatalog: 'Catálogo',
      navFaq: 'Perguntas',
      howItWorks: 'Veja como funciona',
      learnMore: 'Saiba mais',
      aboutDefault: 'Sobre nós',
      benefitsLabel: 'Diferenciais',
      stepsEyebrow: 'Passo a passo',
      stepsTitle: 'Como funciona',
      catalogEyebrow: 'Catálogo',
      catalogTitle: 'O que oferecemos',
      testimonialsEyebrow: 'Depoimentos',
      testimonialsTitle: 'O que dizem sobre nós',
      quoteLabel: 'Depoimento de',
      faqEyebrow: 'Dúvidas',
      faqTitle: 'Perguntas frequentes',
      galleryAlt: 'Galeria de imagens',
      finalCta: 'Comece agora',
      statsLabel: 'Números',
      footerLinks: 'Links do rodapé',
    };

const aboutHeading = content.aboutTitle || content.eyebrow || t.aboutDefault;
const aboutKicker = content.aboutTitle && content.eyebrow ? content.eyebrow : '';
---

<div class="classico" data-classico>
  <a class="skip-link" href="#main">
    {t.skip}
  </a>

  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#top" aria-label={`${brand} — ${t.home}`}>
        {content.logo ? (
          <img class="brand-logo" src={content.logo} alt={brand} width="40" height="40" />
        ) : (
          <span class="brand-mark" aria-hidden="true">
            {monogram}
          </span>
        )}
        <span class="brand-name">{brand}</span>
      </a>

      <nav class="site-nav" aria-label={t.menu}>
        {hasAbout && <a href="#sobre">{t.navAbout}</a>}
        {hasSteps && <a href="#passos">{t.navSteps}</a>}
        {hasCatalog && <a href="#catalogo">{t.navCatalog}</a>}
        {hasFaq && <a href="#faq">{t.navFaq}</a>}
        {hasPrimary && (
          <a class="btn btn-sm" href={primaryLink(content, preview)}>
            {content.primaryLabel}
          </a>
        )}
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="wrap hero-grid">
        <div class="hero-copy reveal">
          {content.eyebrow && <p class="eyebrow">{content.eyebrow}</p>}
          <h1>{content.title}</h1>
          {content.subtitle && <p class="lead">{content.subtitle}</p>}
          <div class="hero-actions">
            {hasPrimary && (
              <a class="btn" href={primaryLink(content, preview)}>
                {content.primaryLabel}
              </a>
            )}
            {hasSteps && (
              <a class="quiet-link" href="#passos">
                {t.howItWorks}
              </a>
            )}
          </div>
        </div>

        <div class="hero-media reveal">
          {content.heroImage ? (
            <img src={content.heroImage} alt={content.title} loading="eager" />
          ) : (
            <div class="hero-placeholder">
              <span class="hero-placeholder-mark" aria-hidden="true">
                {monogram}
              </span>
            </div>
          )}
        </div>
      </div>
    </section>

    {hasAbout && (
      <section class="section" id="sobre" aria-labelledby="sobre-title">
        <div class:list={['wrap', 'about-grid', { 'about-grid-solo': !content.benefits.length }]}>
          <div class="about-copy reveal">
            {aboutKicker && <p class="eyebrow">{aboutKicker}</p>}
            <h2 id="sobre-title">{aboutHeading}</h2>
            {content.about && <p class="body-text">{content.about}</p>}
          </div>

          {content.benefits.length > 0 && (
            <ol class="benefits reveal" aria-label={t.benefitsLabel}>
              {content.benefits.map((benefit, index) => (
                <li class="benefit">
                  <span class="benefit-index" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3>{benefit.title}</h3>
                    {benefit.description && <p>{benefit.description}</p>}
                  </div>
                </li>
              ))}
            </ol>
          )}
        </div>
      </section>
    )}

    {hasStats && (
      <section class="stats-band" aria-label={t.statsLabel}>
        <div class="wrap stats-grid">
          {content.stats.map((stat) => (
            <div class="stat reveal">
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {hasSteps && (
      <section class="section" id="passos" aria-labelledby="passos-title">
        <div class="wrap">
          <header class="section-head reveal">
            <p class="eyebrow">{t.stepsEyebrow}</p>
            <h2 id="passos-title">{t.stepsTitle}</h2>
          </header>
          <ol class="steps-grid">
            {content.steps.map((step, index) => (
              <li class="step reveal">
                <span class="step-index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3>{step.title}</h3>
                {step.description && <p>{step.description}</p>}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {hasCatalog && (
      <section class="section" id="catalogo" aria-labelledby="catalogo-title">
        <div class="wrap">
          <header class="section-head reveal">
            <p class="eyebrow">{t.catalogEyebrow}</p>
            <h2 id="catalogo-title">{t.catalogTitle}</h2>
          </header>

          <div class="catalog-grid">
            {content.products.map((product, index) => (
              <article class="catalog-card reveal">
                {product.image && (
                  <div class="catalog-media">
                    <img src={product.image} alt={product.title} loading="lazy" />
                  </div>
                )}
                <div class="catalog-body">
                  <h3>{product.title}</h3>
                  {product.description && <p>{product.description}</p>}
                  <a class="card-link" href={productLink(content, preview, index)}>
                    {t.learnMore}
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>

          {showGallery && (
            <div class="gallery reveal" role="group" aria-label={t.galleryAlt}>
              {gallery.map((item, index) => (
                <div class="gallery-item">
                  <img src={item.image} alt={`${t.galleryAlt} ${index + 1}`} loading="lazy" />
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    {hasTestimonials && (
      <section class="section" aria-labelledby="depoimentos-title">
        <div class="wrap">
          <header class="section-head reveal">
            <p class="eyebrow">{t.testimonialsEyebrow}</p>
            <h2 id="depoimentos-title">{t.testimonialsTitle}</h2>
          </header>
          <div class="quotes-grid">
            {content.testimonials.map((item) => (
              <figure
                class="quote reveal"
                aria-label={item.name ? `${t.quoteLabel} ${item.name}` : undefined}
              >
                <blockquote>
                  <p>“{item.quote}”</p>
                </blockquote>
                {item.name && <figcaption>{item.name}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {hasFaq && (
      <section class="section" id="faq" aria-labelledby="faq-title">
        <div class="wrap faq-wrap">
          <header class="section-head reveal">
            <p class="eyebrow">{t.faqEyebrow}</p>
            <h2 id="faq-title">{t.faqTitle}</h2>
          </header>
          <div class="faq-list reveal">
            {content.faq.map((item) => (
              <details class="faq-item">
                <summary>
                  <span>{item.question}</span>
                  <span class="faq-toggle" aria-hidden="true" />
                </summary>
                {item.answer && <p>{item.answer}</p>}
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {hasPrimary && (
      <section class="section final-cta" aria-label={t.finalCta}>
        <div class="wrap">
          <div class="cta-card reveal">
            {content.eyebrow && <p class="eyebrow">{content.eyebrow}</p>}
            {content.subtitle && <h2>{content.subtitle}</h2>}
            <a class="btn" href={primaryLink(content, preview)}>
              {content.primaryLabel}
            </a>
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <a class="brand" href="#top" aria-label={`${brand} — ${t.home}`}>
          {content.logo ? (
            <img class="brand-logo" src={content.logo} alt={brand} width="40" height="40" />
          ) : (
            <span class="brand-mark" aria-hidden="true">
              {monogram}
            </span>
          )}
          <span class="brand-name">{brand}</span>
        </a>
        {content.footerText && <p class="footer-text">{content.footerText}</p>}
      </div>

      {footerLinks.length > 0 && (
        <nav class="footer-links" aria-label={t.footerLinks}>
          {footerLinks.map((link) => (
            <a href={link.url}>{link.label}</a>
          ))}
        </nav>
      )}

      <p class="footer-copy">
        © {year} {content.title}
      </p>
    </div>
  </footer>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-classico]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  roots.forEach((root) => {
    const items = root.querySelectorAll<HTMLElement>('.reveal');

    if (reduce || typeof IntersectionObserver === 'undefined') {
      items.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    items.forEach((item) => {
      if (item.getBoundingClientRect().top < window.innerHeight * 0.95) {
        item.classList.add('is-visible');
      }
    });

    root.setAttribute('data-animate', '');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );

    items.forEach((item) => {
      if (!item.classList.contains('is-visible')) observer.observe(item);
    });
  });
</script>

<style>
  .classico {
    --radius-lg: 28px;
    --radius-md: 20px;
    --shadow-soft: 0 26px 64px -36px color-mix(in srgb, var(--accent) 60%, transparent);
    --shadow-card: 0 18px 44px -30px color-mix(in srgb, var(--accent) 45%, transparent);
    font-family: var(--font-body);
    color: var(--fg);
    background: var(--bg);
    min-height: 100vh;
    overflow-x: clip;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .classico *,
  .classico *::before,
  .classico *::after {
    box-sizing: border-box;
  }

  .wrap {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }

  .classico :is(a, button, summary):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 8px;
  }

  /* Skip link */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 12px 18px;
    background: var(--accent);
    color: var(--bg);
    border-radius: 0 0 14px 0;
    font-weight: 600;
    text-decoration: none;
  }
  .skip-link:focus {
    left: 0;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 76px;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .brand-logo,
  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 14px;
    flex: none;
  }
  .brand-logo {
    object-fit: cover;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--bg);
    font-size: 1.05rem;
    font-weight: 700;
    box-shadow: var(--shadow-soft);
  }
  .brand-name {
    font-size: 1.05rem;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.6vw, 22px);
  }
  .site-nav > a:not(.btn) {
    text-decoration: none;
    white-space: nowrap;
    font-size: 0.95rem;
    color: var(--muted);
    transition: color 0.25s ease;
  }
  .site-nav > a:not(.btn):hover {
    color: var(--fg);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: var(--accent);
    color: var(--bg);
    font: inherit;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
    transition:
      transform 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .btn:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--accent) 86%, var(--fg));
  }
  .btn:active {
    transform: translateY(0);
  }
  .btn-sm {
    padding: 10px 20px;
    font-size: 0.92rem;
    box-shadow: none;
  }

  /* Hero */
  .hero {
    padding: clamp(44px, 8vw, 104px) 0 clamp(40px, 7vw, 84px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }
  .eyebrow {
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero h1 {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
    font-weight: 600;
  }
  .lead {
    margin: 22px 0 0;
    max-width: 52ch;
    font-size: clamp(1.05rem, 1.5vw, 1.28rem);
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 26px;
    margin-top: 34px;
  }
  .quiet-link {
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 3px;
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }
  .quiet-link:hover {
    color: color-mix(in srgb, var(--accent) 72%, var(--fg));
  }
  .hero-media {
    position: relative;
    aspect-ratio: 1.08;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(
        120% 120% at 15% 12%,
        color-mix(in srgb, var(--accent) 34%, transparent) 0%,
        transparent 55%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--accent) 18%, var(--bg)) 0%,
        color-mix(in srgb, var(--accent) 4%, var(--bg)) 100%
      );
  }
  .hero-placeholder-mark {
    font-size: clamp(3rem, 8vw, 5.4rem);
    font-weight: 700;
    color: color-mix(in srgb, var(--accent) 62%, transparent);
  }

  /* Shared section chrome */
  .section {
    padding: clamp(56px, 8vw, 100px) 0;
  }
  .section-head {
    max-width: 640px;
    margin-bottom: clamp(34px, 4vw, 54px);
  }
  .section-head h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.06;
    letter-spacing: -0.05em;
    font-weight: 600;
  }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: start;
  }
  .about-grid-solo {
    grid-template-columns: minmax(0, 1fr);
  }
  .about-copy h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.05em;
    font-weight: 600;
  }
  .body-text {
    margin: 22px 0 0;
    max-width: 58ch;
    font-size: 1.05rem;
    color: var(--muted);
  }
  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .benefit {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    padding: 20px 22px;
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .benefit-index {
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
  }
  .benefit h3 {
    margin: 0 0 6px;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .benefit p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* Stats band */
  .stats-band {
    background: var(--accent);
    color: var(--bg);
    padding: clamp(38px, 5vw, 64px) 0;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px);
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stat strong {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 700;
  }
  .stat span {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--bg) 76%, transparent);
  }

  /* Steps */
  .steps-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.5vw, 28px);
  }
  .step {
    padding: clamp(24px, 3vw, 34px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }
  .step-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: 20px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 16%, var(--bg));
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .step h3 {
    margin: 0 0 10px;
    font-size: 1.2rem;
    letter-spacing: -0.03em;
  }
  .step p {
    margin: 0;
    font-size: 0.98rem;
    color: var(--muted);
  }

  /* Catalog */
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.5vw, 28px);
  }
  .catalog-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .catalog-card:hover {
    transform: translateY(-4px);
  }
  .catalog-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--soft);
  }
  .catalog-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .catalog-body {
    display: flex;
    flex: 1;
    flex-direction: column;
