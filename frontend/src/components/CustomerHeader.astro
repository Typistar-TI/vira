---
import Brand from './Brand.astro';
import AccountMenu from './AccountMenu.astro';
import MobileNavigation from './MobileNavigation.astro';
interface Props {
  email: string;
  en: boolean;
  section: string;
  displayName?: string;
  avatar?: string | null;
}
const { email, en, section, displayName = '', avatar = null } = Astro.props;
const links = [
  { key: 'conteudo', href: '/app', label: en ? 'Content' : 'Conteúdo' },
  { key: 'plano', href: '/app/plano', label: en ? 'Plan and billing' : 'Plano e cobrança' },
  { key: 'dominio', href: '/app/dominio', label: en ? 'Domain' : 'Domínio' },
  { key: 'conta', href: '/app/conta', label: en ? 'Account' : 'Conta' },
];
---

<header class="bg-white">
  <div class="mx-auto flex max-w-[1380px] flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-8">
    <Brand href="/app" tone="light" />
    <nav
      class="hidden items-center gap-1 overflow-x-auto rounded-full border border-[#d8ae73] bg-white/95 px-3 py-2 text-sm text-[#605448] shadow-[0_8px_30px_-22px_rgba(131,85,21,0.35)] xl:flex"
      aria-label={en ? 'Dashboard sections' : 'Seções do painel'}
    >
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={section === link.key ? 'page' : undefined}
          class:list={[
            'rounded-full px-3 py-1.5 whitespace-nowrap transition-colors focus-visible:outline-2 focus-visible:outline-[#b88333]',
            section === link.key
              ? 'bg-[#fff4df] font-semibold text-[#6f4716]'
              : 'hover:text-[#9b6823]',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2 xl:ml-0">
      <div class="xl:hidden">
        <MobileNavigation
          label={en ? 'Sections' : 'Seções'}
          lang={en ? 'en' : 'pt'}
          links={links.map((link) => ({ ...link, current: section === link.key }))}
        />
      </div>
      <AccountMenu
        email={email}
        displayName={displayName}
        avatar={avatar}
        profileHref="/app/conta"
        profileLabel={en ? 'Account and data' : 'Conta e dados'}
        homeHref="/"
        lang={en ? 'en' : 'pt'}
      />
    </div>
  </div>
</header>
