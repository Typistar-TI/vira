---
import Base from '@frontend/components/Base.astro';
import Brand from '@frontend/components/Brand.astro';
import { getPublicPrices, type Plan } from '@frontend/api/billing/public-prices';
import { getRootDomain } from '@frontend/api/config/root-domain';
interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;
const en = lang === 'en';
const domain = await getRootDomain();
const prices = await getPublicPrices();
const currency = en ? 'usd' : 'brl';
const displayPrice = (plan: Plan) => {
  const row = prices.find((item) => item.plan === plan && item.currency === currency);
  return row?.amount_minor
    ? new Intl.NumberFormat(en ? 'en-US' : 'pt-BR', {
        style: 'currency',
        currency: currency.toUpperCase(),
      }).format(row.amount_minor / 100)
    : null;
};
const t = en
  ? {
      nav: 'Start free',
      eyebrow: 'Your next page starts here',
      titleA: 'Put your idea',
      titleB: 'out there.',
      intro:
        'A page that looks like your business. Choose a layout, edit every detail, and publish in minutes.',
      cta: 'Try 7 days free',
      demo: 'See how it works',
      section: 'Everything in one place',
      sectionText: 'From the first draft to your own domain, Vira keeps the work simple.',
      features: [
        ['Choose a layout', 'Three responsive starting points with room for your content.'],
        ['Make it yours', 'Edit images, benefits, numbers, testimonials and a product catalog.'],
        ['Publish and learn', 'Use your domain and see page views and button clicks.'],
      ],
      plans: 'Choose your plan',
      plansText: 'Start without a card. Pick a plan when you are ready.',
      monthly: 'Monthly',
      yearly: 'Yearly',
      lifetime: 'Lifetime',
      monthlyDesc: 'Keep your page live with a flexible monthly subscription.',
      yearlyDesc: 'One annual payment for a full year.',
      lifetimeDesc: 'Pay once and keep access to your page.',
      priceLater: 'Price at checkout',
      included: [
        'One published page',
        'Three layouts',
        'Your own www domain',
        'Images and basic analytics',
      ],
      select: 'Select plan',
      footer: 'A clear place for what you do.',
    }
  : {
      nav: 'Começar grátis',
      eyebrow: 'Sua próxima página começa aqui',
      titleA: 'Coloque sua ideia',
      titleB: 'no mundo.',
      intro:
        'Uma página com a cara do seu negócio. Escolha um layout, edite cada detalhe e publique em minutos.',
      cta: 'Testar 7 dias grátis',
      demo: 'Ver como funciona',
      section: 'Tudo em um só lugar',
      sectionText: 'Do primeiro rascunho ao seu domínio, o Vira deixa o caminho simples.',
      features: [
        ['Escolha um layout', 'Três pontos de partida responsivos com espaço para seu conteúdo.'],
        ['Deixe com a sua cara', 'Edite imagens, benefícios, números, depoimentos e um catálogo.'],
        ['Publique e acompanhe', 'Use seu domínio e veja visualizações e cliques nos botões.'],
      ],
      plans: 'Escolha seu plano',
      plansText: 'Comece sem cartão. Escolha um plano quando estiver pronto.',
      monthly: 'Mensal',
      yearly: 'Anual',
      lifetime: 'Vitalício',
      monthlyDesc: 'Mantenha sua página no ar com uma assinatura flexível.',
      yearlyDesc: 'Um pagamento para o ano inteiro.',
      lifetimeDesc: 'Pague uma vez e mantenha o acesso à sua página.',
      priceLater: 'Valor no checkout',
      included: [
        'Uma página publicada',
        'Três layouts',
        'Domínio www próprio',
        'Imagens e estatísticas básicas',
      ],
      select: 'Escolher plano',
      footer: 'Um lugar claro para mostrar o que você faz.',
    };
---

<Base
  title={en ? 'Vira — Put your idea out there' : 'Vira — Coloque sua ideia no mundo'}
  description={t.intro}
  lang={lang}
>
  <link slot="head" rel="alternate" hreflang="pt-BR" href={'https://' + domain + '/'} />
  <link slot="head" rel="alternate" hreflang="en-US" href={'https://' + domain + '/en/'} />
  <link slot="head" rel="alternate" hreflang="x-default" href={'https://' + domain + '/'} />
  <div class="min-h-screen overflow-hidden bg-[#090d16] text-[#f3f6fc]">
    <header class="relative z-10 border-b border-[#202839]">
      <div class="mx-auto flex max-w-[1320px] items-center justify-between gap-4 px-5 py-4 sm:px-8">
        <Brand href={en ? '/en' : '/'} />
        <nav
          class="flex items-center gap-3 text-sm sm:gap-7"
          aria-label={en ? 'Main navigation' : 'Navegação principal'}
        >
          <a
            href="#como-funciona"
            class="hidden text-[#a6b2c8] transition-colors hover:text-white sm:inline"
          >
            {en ? 'How it works' : 'Como funciona'}
          </a>
          <a
            href="#planos"
            class="hidden text-[#a6b2c8] transition-colors hover:text-white sm:inline"
          >
            {en ? 'Plans' : 'Planos'}
          </a>
          <a
            href={en ? '/' : '/en'}
            class="text-[#a6b2c8] transition-colors hover:text-white"
            aria-label={en ? 'Português' : 'English'}
          >
            {en ? 'PT' : 'EN'}
          </a>
          <a href="/login" class="btn btn-primary btn-sm border-0 px-4 font-bold sm:btn-md">
            {t.nav}
            <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main>
      <section class="relative isolate border-b border-[#202839]">
        <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_70%_40%,#283e782b,transparent_48%)]"></div>
        <div class="mx-auto grid max-w-[1320px] items-center gap-8 px-5 pb-16 pt-16 sm:px-8 md:grid-cols-[1.05fr_0.95fr] md:pb-24 md:pt-24 lg:min-h-[690px]">
          <div data-reveal>
            <div class="mb-7 inline-flex items-center gap-3 rounded-full border border-[#344263] bg-[#151e31] px-3 py-2 text-xs font-semibold uppercase tracking-[0.17em] text-[#c2d0ff]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#8199ff] shadow-[0_0_15px_#8199ff]"></span>
              {t.eyebrow}
            </div>
            <h1 class="max-w-[13ch] font-[Outfit] text-[clamp(3.8rem,7.4vw,7.3rem)] font-semibold leading-[0.96] tracking-[-0.065em]">
              {t.titleA}
              <br />
              <span class="text-[#8199ff]">{t.titleB}</span>
            </h1>
            <p class="mt-8 max-w-[52ch] text-lg leading-relaxed text-[#acb7ca]">{t.intro}</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="/login" class="btn btn-primary h-12 border-0 px-6 font-bold">
                {t.cta}
                <span aria-hidden="true">↗</span>
              </a>
              <a
                href="#como-funciona"
                class="btn btn-outline h-12 border-[#3a465f] px-6 text-[#ecf1fa] hover:border-[#8199ff] hover:bg-[#151d2e]"
              >
                {t.demo}
              </a>
            </div>
            <p class="mt-5 text-sm text-[#7f8ba0]">
              {en
                ? 'No card required · Email or Google sign-in'
                : 'Sem cartão · Entre por e-mail ou Google'}
            </p>
          </div>
          <div
            class="relative flex min-h-[350px] items-center justify-center md:min-h-[530px]"
            aria-hidden="true"
          >
            <div class="absolute h-[min(82vw,510px)] w-[min(82vw,510px)] rounded-full border border-[#26324c]"></div>
            <div class="absolute h-[min(64vw,390px)] w-[min(64vw,390px)] rounded-full border border-[#34456b]"></div>
            <div class="absolute h-[min(42vw,270px)] w-[min(42vw,270px)] rounded-full border border-[#3f5484]"></div>
            <div class="absolute top-[14%] left-[11%] h-2 w-2 rounded-full bg-[#9bb0ff] shadow-[0_0_25px_#8199ff]"></div>
            <div class="absolute right-[11%] bottom-[22%] h-1.5 w-1.5 rounded-full bg-[#9bb0ff] shadow-[0_0_25px_#8199ff]"></div>
            <div class="absolute left-1/2 top-1/2 h-[230px] w-[230px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#536fca2d] blur-[70px]"></div>
            <img
              id="hero-symbol"
              src="/vira-symbol.png"
              width="560"
              height="560"
              alt=""
              class="relative z-10 w-[min(78vw,560px)] drop-shadow-[0_25px_50px_#3158bd40]"
            />
          </div>
        </div>
        <div class="mx-auto flex max-w-[1320px] flex-wrap items-center justify-between gap-3 border-t border-[#202839] px-5 py-5 text-xs font-semibold uppercase tracking-[0.15em] text-[#8794ab] sm:px-8">
          <span>{en ? 'One place to launch' : 'Um lugar para publicar'}</span>
          <span>{en ? 'Build · Publish · Grow' : 'Crie · Publique · Evolua'}</span>
          <span>01 / 03</span>
        </div>
      </section>
      <section
        id="como-funciona"
        class="mx-auto max-w-[1320px] scroll-mt-10 px-5 py-24 sm:px-8 md:py-32"
      >
        <div class="mb-12 max-w-[780px]" data-reveal>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#8199ff]">
            01 / {en ? 'The process' : 'O processo'}
          </span>
          <h2 class="mt-5 font-[Outfit] text-[clamp(2.8rem,5vw,5rem)] leading-[1.04] tracking-[-0.05em]">
            {t.section}
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-[#acb7ca]">{t.sectionText}</p>
        </div>
        <div class="grid border-t border-[#344055] md:grid-cols-3">
          {t.features.map((feature, i) => (
            <article
              data-reveal
              class="group border-b border-[#344055] py-8 md:border-r md:px-8 md:py-10 md:first:pl-0 md:last:border-r-0"
            >
              <span class="font-mono text-xs text-[#8199ff]">0{i + 1} / 03</span>
              <div class="mt-10 mb-6 flex items-start justify-between">
                <span class="font-[Outfit] text-5xl font-light text-[#879fff]" aria-hidden="true">
                  {['◇', '⌘', '↗'][i]}
                </span>
                <span
                  class="text-[#647592] transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </div>
              <h3 class="font-[Outfit] text-2xl font-medium tracking-tight">{feature[0]}</h3>
              <p class="mt-3 max-w-[34ch] leading-relaxed text-[#9eabc0]">{feature[1]}</p>
            </article>
          ))}
        </div>
      </section>
      <section class="border-y border-[#202839] bg-[#0d1422]">
        <div
          class="mx-auto grid max-w-[1320px] gap-10 px-5 py-20 sm:px-8 md:grid-cols-[0.85fr_1.15fr] md:items-center md:py-24"
          data-reveal
        >
          <span class="font-[Outfit] text-[clamp(4rem,10vw,10rem)] leading-none tracking-[-0.08em] text-[#8199ff]">
            vira<span class="text-[#dce6ff]">.</span>
          </span>
          <div>
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#8199ff]">
              02 / {en ? 'Your space' : 'Seu espaço'}
            </span>
            <h2 class="mt-5 max-w-[17ch] font-[Outfit] text-[clamp(2.3rem,4vw,4.2rem)] leading-[1.08] tracking-[-0.05em]">
              {en ? 'Your idea deserves a place of its own.' : 'Sua ideia merece um lugar só dela.'}
            </h2>
            <p class="mt-6 max-w-[48ch] leading-relaxed text-[#a6b2c8]">
              {en
                ? 'Choose a layout, add your own images and connect your domain. What you see in the editor is the page you publish.'
                : 'Escolha um layout, adicione suas imagens e conecte seu domínio. O que você vê no editor é a página que publica.'}
            </p>
          </div>
        </div>
      </section>
      <section id="planos" class="mx-auto max-w-[1320px] scroll-mt-10 px-5 py-24 sm:px-8 md:py-32">
        <div class="mb-12 max-w-[720px]" data-reveal>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#8199ff]">
            03 / {en ? 'Pricing' : 'Preços'}
          </span>
          <h2 class="mt-5 font-[Outfit] text-[clamp(2.8rem,5vw,5rem)] leading-[1.04] tracking-[-0.05em]">
            {t.plans}
          </h2>
          <p class="mt-5 text-lg text-[#acb7ca]">{t.plansText}</p>
        </div>
        <div class="grid gap-4 lg:grid-cols-3">
          {[t.monthly, t.yearly, t.lifetime].map((name, i) => (
            <article
              data-reveal
              class:list={[
                'flex flex-col rounded-2xl border bg-[#111723] p-7 transition-transform duration-300 hover:-translate-y-1 sm:p-8',
                i === 1 ? 'border-[#8199ff] shadow-[0_0_50px_#536fca24]' : 'border-[#2a3448]',
              ]}
            >
              <div class="mb-8 flex items-center justify-between">
                <span class="font-mono text-xs text-[#8ea4ff]">0{i + 1} / 03</span>
                <span class="badge badge-outline border-[#3b4964] text-[#aab7ce]">
                  {i === 2
                    ? en
                      ? 'One payment'
                      : 'Pagamento único'
                    : en
                      ? 'Subscription'
                      : 'Assinatura'}
                </span>
              </div>
              <h3 class="font-[Outfit] text-2xl font-medium">{name}</h3>
              <p class="mt-3 min-h-14 leading-relaxed text-[#9eabc0]">
                {[t.monthlyDesc, t.yearlyDesc, t.lifetimeDesc][i]}
              </p>
              <div class="mt-8 border-b border-[#344055] pb-7 font-[Outfit] text-[clamp(1.9rem,3vw,2.7rem)] font-semibold tracking-tight text-white">
                {displayPrice((['monthly', 'yearly', 'lifetime'] as const)[i]) || t.priceLater}
              </div>
              <ul class="my-7 space-y-3 text-sm text-[#b5c1d4]">
                {t.included.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-[#8199ff]" aria-hidden="true">
                      ↗
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
              <a
                class:list={[
                  'btn mt-auto w-full font-bold',
                  i === 1
                    ? 'btn-primary'
                    : 'btn-outline border-[#4a5872] text-white hover:border-[#8199ff] hover:bg-[#1b2943]',
                ]}
                href="/login"
              >
                {t.select}
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>
    <footer class="border-t border-[#202839]">
      <div class="mx-auto flex max-w-[1320px] flex-col justify-between gap-4 px-5 py-8 text-sm text-[#8592a9] sm:flex-row sm:px-8">
        <span>
          © {new Date().getFullYear()} Vira. {t.footer}
        </span>
        <div class="flex gap-6">
          <a class="hover:text-white" href={en ? '/en/privacy' : '/privacidade'}>
            {en ? 'Privacy' : 'Privacidade'}
          </a>
          <a class="hover:text-white" href={en ? '/' : '/en'}>
            {en ? 'Português' : 'English'}
          </a>
        </div>
      </div>
    </footer>
  </div>
  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.animate(
              [
                { opacity: 0, transform: 'translateY(22px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              { duration: 650, easing: 'cubic-bezier(.2,.7,.2,1)' },
            );
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.14 },
      );
      document.querySelectorAll('[data-reveal]').forEach((node) => observer.observe(node));
      document
        .querySelector('#hero-symbol')
        ?.animate(
          [
            { transform: 'translateY(0)' },
            { transform: 'translateY(-14px)' },
            { transform: 'translateY(0)' },
          ],
          { duration: 6500, iterations: Infinity, easing: 'ease-in-out' },
        );
    }
  </script>
</Base>
