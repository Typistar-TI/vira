---
import Base from '@frontend/components/Base.astro';
import { getPublicPrices, type Plan } from '@frontend/api/billing/public-prices';
import { getRootDomain } from '@frontend/api/config/root-domain';
interface Props {
  lang: 'pt' | 'en';
}
const { lang } = Astro.props;
const en = lang === 'en';
const domain = await getRootDomain();
const prices = await getPublicPrices();
const currency = en ? 'usd' : 'brl';
const displayPrice = (plan: Plan) => {
  const row = prices.find((item) => item.plan === plan && item.currency === currency);
  return row?.amount_minor
    ? new Intl.NumberFormat(en ? 'en-US' : 'pt-BR', {
        style: 'currency',
        currency: currency.toUpperCase(),
      }).format(row.amount_minor / 100)
    : null;
};
const t = en
  ? {
      nav: 'Start free',
      eyebrow: 'Your next page starts here',
      titleA: 'Put your idea',
      titleB: 'out there.',
      intro:
        'A page that looks like your business. Choose a layout, edit every detail, and publish in minutes.',
      cta: 'Try 7 days free',
      demo: 'See how it works',
      section: 'Everything in one place',
      sectionText: 'From the first draft to your own domain, Vira keeps the work simple.',
      features: [
        ['Choose a layout', 'Three responsive starting points with room for your content.'],
        ['Make it yours', 'Edit images, benefits, numbers, testimonials and a product catalog.'],
        ['Publish and learn', 'Use your domain and see page views and button clicks.'],
      ],
      plans: 'Choose your plan',
      plansText: 'Start without a card. Pick a plan when you are ready.',
      monthly: 'Monthly',
      yearly: 'Yearly',
      lifetime: 'Lifetime',
      monthlyDesc: 'Keep your page live with a flexible monthly subscription.',
      yearlyDesc: 'One annual payment for a full year.',
      lifetimeDesc: 'Pay once and keep access to your page.',
      priceLater: 'Price at checkout',
      included: [
        'One published page',
        'Three layouts',
        'Your own www domain',
        'Images and basic analytics',
      ],
      select: 'Select plan',
      footer: 'A clear place for what you do.',
    }
  : {
      nav: 'Começar grátis',
      eyebrow: 'Sua próxima página começa aqui',
      titleA: 'Coloque sua ideia',
      titleB: 'no mundo.',
      intro:
        'Uma página com a cara do seu negócio. Escolha um layout, edite cada detalhe e publique em minutos.',
      cta: 'Testar 7 dias grátis',
      demo: 'Ver como funciona',
      section: 'Tudo em um só lugar',
      sectionText: 'Do primeiro rascunho ao seu domínio, o Vira deixa o caminho simples.',
      features: [
        ['Escolha um layout', 'Três pontos de partida responsivos com espaço para seu conteúdo.'],
        ['Deixe com a sua cara', 'Edite imagens, benefícios, números, depoimentos e um catálogo.'],
        ['Publique e acompanhe', 'Use seu domínio e veja visualizações e cliques nos botões.'],
      ],
      plans: 'Escolha seu plano',
      plansText: 'Comece sem cartão. Escolha um plano quando estiver pronto.',
      monthly: 'Mensal',
      yearly: 'Anual',
      lifetime: 'Vitalício',
      monthlyDesc: 'Mantenha sua página no ar com uma assinatura flexível.',
      yearlyDesc: 'Um pagamento para o ano inteiro.',
      lifetimeDesc: 'Pague uma vez e mantenha o acesso à sua página.',
      priceLater: 'Valor no checkout',
      included: [
        'Uma página publicada',
        'Três layouts',
        'Domínio www próprio',
        'Imagens e estatísticas básicas',
      ],
      select: 'Escolher plano',
      footer: 'Um lugar claro para mostrar o que você faz.',
    };
---

<Base
  title={en ? 'Vira — Put your idea out there' : 'Vira — Coloque sua ideia no mundo'}
  description={t.intro}
  lang={lang}
>
  <link slot="head" rel="alternate" hreflang="pt-BR" href={`https://${domain}/`} />
  <link slot="head" rel="alternate" hreflang="en-US" href={`https://${domain}/en/`} />
  <link slot="head" rel="alternate" hreflang="x-default" href={`https://${domain}/`} />
  <div class="min-h-screen bg-[#f3eefa] text-[#292534] font-['DM_Sans',sans-serif]">
    <header class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-5 px-6 py-5">
      <a
        class="inline-flex items-center gap-1.5 font-[Outfit] text-[31px] leading-none font-extrabold tracking-[-0.08em] text-[#513b70] no-underline [&_span]:text-[#f27668]"
        href={en ? '/en' : '/'}
        aria-label="Vira"
      >
        vira<span>.</span>
      </a>
      <nav class="flex gap-5 items-center">
        <a href="#como-funciona" class="hidden sm:inline">
          {en ? 'How it works' : 'Como funciona'}
        </a>
        <a href="#planos" class="hidden sm:inline">
          {en ? 'Plans' : 'Planos'}
        </a>
        <a href={en ? '/' : '/en'} aria-label={en ? 'Português' : 'English'}>
          {en ? 'PT' : 'EN'}
        </a>
        <a href="/login" class="btn btn-primary rounded-xl border-0 font-bold shadow-none">
          {t.nav}
        </a>
      </nav>
    </header>
    <main class="mx-auto max-w-[1180px] px-6 pt-11 pb-24">
      <section class="grid items-center gap-[6vw] pt-8 pb-20 md:grid-cols-[1.15fr_0.85fr] md:pt-16 md:pb-28 [&_h1]:mt-4 [&_h1]:mb-6 [&_h1]:max-w-[11ch] [&_h1]:font-[Outfit] [&_h1]:text-[clamp(3.4rem,7vw,6.7rem)] [&_h1]:leading-[0.98] [&_h1]:tracking-tight [&_h1]:text-[#513b70] [&_em]:not-italic [&_em]:text-[#f27668] [&_p]:max-w-[55ch] [&_p]:leading-relaxed">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#513b70]">
            {t.eyebrow}
          </span>
          <h1>
            {t.titleA} <em>{t.titleB}</em>
          </h1>
          <p>{t.intro}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="btn btn-primary rounded-xl border-0 font-bold shadow-none btn-secondary text-[#292534]"
              href="/login"
            >
              {t.cta} <span aria-hidden="true">↗</span>
            </a>
            <a
              class="btn btn-outline rounded-xl bg-white font-bold text-[#513b70]"
              href="#como-funciona"
            >
              {t.demo}
            </a>
          </div>
          <p class="text-sm mt-5">
            {en
              ? 'No card required · Email or Google sign-in'
              : 'Sem cartão · Entre por e-mail ou Google'}
          </p>
        </div>
        <div
          class="relative min-h-[330px] max-w-[520px] rotate-2 rounded-[30px] border border-[#ded3ea] bg-white p-5 shadow-[0_30px_70px_#513b7021] md:min-h-[420px] md:max-w-none"
          aria-label={en ? 'Page preview' : 'Prévia de uma página'}
        >
          <div class="h-full overflow-hidden rounded-[18px] bg-[#f8f6fc]">
            <div class="flex h-9 items-center gap-1 bg-[#eee8f4] px-3.5 [&_i]:h-[7px] [&_i]:w-[7px] [&_i]:rounded-full [&_i]:bg-[#b8a8cb]">
              <i></i>
              <i></i>
              <i></i>
            </div>
            <div class="p-8">
              <span class="badge badge-secondary h-auto rounded-full px-3 py-2 text-xs font-bold">
                {en ? 'Your space' : 'Seu espaço'}
              </span>
              <div class="my-3 h-[13px] rounded-lg bg-[#dfd3eb] h-[42px] w-3/4 bg-[#513b70]"></div>
              <div class="my-3 h-[13px] w-[90%] rounded-lg bg-[#dfd3eb]"></div>
              <div class="my-3 h-[13px] w-[65%] rounded-lg bg-[#dfd3eb]"></div>
              <div class="mt-7 h-[145px] rounded-[14px] bg-gradient-to-br from-[#f9b7b5] to-[#c6afe1]"></div>
              <div class="flex gap-3 mt-6">
                <span class="badge badge-secondary h-auto rounded-full px-3 py-2 text-xs font-bold">
                  ✦ {en ? 'Beautiful' : 'Bonito'}
                </span>
                <span class="badge badge-secondary h-auto rounded-full px-3 py-2 text-xs font-bold">
                  ↗ {en ? 'Ready to share' : 'Pronto para compartilhar'}
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section id="como-funciona" class="py-16">
        <div class="mb-8 max-w-[700px] [&_h2]:my-2.5 [&_h2]:font-[Outfit] [&_h2]:text-[clamp(2.3rem,4vw,3.6rem)] [&_h2]:leading-tight [&_h2]:text-[#513b70]">
          <span class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#513b70]">
            Vira
          </span>
          <h2>{t.section}</h2>
          <p class="text-[#6f647d]">{t.sectionText}</p>
        </div>
        <div class="grid gap-[18px] md:grid-cols-3">
          {t.features.map((feature, i) => (
            <article class="card rounded-[22px] border border-[#e3daed] bg-white p-[30px] shadow-sm [&_strong]:my-3 [&_strong]:block [&_strong]:font-[Outfit] [&_strong]:text-[22px] [&_strong]:font-bold [&_p]:leading-relaxed [&_p]:text-[#6f647d]">
              <span
                class="grid h-[45px] w-[45px] place-items-center rounded-[13px] bg-[#fbe6e6] text-2xl text-[#a34257]"
                aria-hidden="true"
              >
                {['◇', '✳', '↗'][i]}
              </span>
              <strong>{feature[0]}</strong>
              <p>{feature[1]}</p>
            </article>
          ))}
        </div>
      </section>
      <section id="planos" class="py-16">
        <div class="mb-8 max-w-[700px] [&_h2]:my-2.5 [&_h2]:font-[Outfit] [&_h2]:text-[clamp(2.3rem,4vw,3.6rem)] [&_h2]:leading-tight [&_h2]:text-[#513b70]">
          <span class="text-xs font-extrabold uppercase tracking-[0.15em] text-[#513b70]">
            {en ? 'Simple plans' : 'Planos simples'}
          </span>
          <h2>{t.plans}</h2>
          <p class="text-[#6f647d]">{t.plansText}</p>
        </div>
        <div class="grid gap-[18px] md:grid-cols-3">
          {[t.monthly, t.yearly, t.lifetime].map((name, i) => (
            <article
              class:list={[
                'card rounded-[22px] border border-[#e3daed] bg-white p-[30px] shadow-sm [&_h3]:my-2.5 [&_h3]:text-[1.6rem] [&_p]:leading-relaxed [&_p]:text-[#6f647d] [&_ul]:min-h-[130px] [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:leading-loose [&_ul]:text-[#6f647d]',
                i === 1 && 'border-2 border-[#f27668] md:-translate-y-2',
              ]}
            >
              <span class="badge badge-secondary h-auto rounded-full px-3 py-2 text-xs font-bold">
                {i === 2
                  ? en
                    ? 'One payment'
                    : 'Pagamento único'
                  : en
                    ? 'Subscription'
                    : 'Assinatura'}
              </span>
              <h3>{name}</h3>
              <p>{[t.monthlyDesc, t.yearlyDesc, t.lifetimeDesc][i]}</p>
              <div class="my-7 font-[Outfit] text-[1.8rem] font-bold text-[#513b70]">
                {displayPrice((['monthly', 'yearly', 'lifetime'] as const)[i]) || t.priceLater}
              </div>
              <ul>
                {t.included.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a class="btn btn-primary rounded-xl border-0 font-bold shadow-none" href="/login">
                {t.select}
              </a>
            </article>
          ))}
        </div>
      </section>
    </main>
    <footer class="mx-auto flex max-w-[1180px] flex-col justify-between gap-4 border-t border-[#e4dcec] px-6 py-8 text-[#6f647d] sm:flex-row">
      <span>
        © {new Date().getFullYear()} Vira. {t.footer}
      </span>
      <div class="flex gap-4">
        <a href={en ? '/en/privacy' : '/privacidade'}>{en ? 'Privacy' : 'Privacidade'}</a>
        <a href={en ? '/' : '/en'}>{en ? 'Português' : 'English'}</a>
      </div>
    </footer>
  </div>
</Base>
